<?xml version="1.0" encoding="utf-8" ?>
<!--
  全局样式（对齐 MAUI 壳 Styles.xaml）：品牌黄强调 + 圆角体系对齐桌面（控件 12 / 卡片 20）。
  WinUI 方言：Border 用 CornerRadius / BorderBrush / BorderThickness；Label → TextBlock。
-->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- 页面背景渐变：配合半透明卡片形成毛玻璃层次（对标桌面窗口亚克力 + 遮罩体系） -->
    <LinearGradientBrush x:Key="PageBackgroundBrush" StartPoint="0,0" EndPoint="1,1">
        <GradientStop Color="#1E1E1E" Offset="0.0" />
        <GradientStop Color="#161616" Offset="0.55" />
        <GradientStop Color="#101010" Offset="1.0" />
    </LinearGradientBrush>

    <!-- 隐式样式：正文一律浅色文字 -->
    <Style TargetType="TextBlock">
        <Setter Property="Foreground" Value="{StaticResource TextPrimary}" />
    </Style>
    <Style TargetType="TextBox">
        <Setter Property="Foreground" Value="{StaticResource TextPrimary}" />
        <Setter Property="PlaceholderForeground" Value="{StaticResource TextSecondary}" />
        <Setter Property="Background" Value="Transparent" />
    </Style>
    <Style TargetType="Slider">
        <Setter Property="Foreground" Value="{StaticResource Primary}" />
    </Style>
    <Style TargetType="ProgressBar">
        <Setter Property="Foreground" Value="{StaticResource Primary}" />
    </Style>

    <!-- 卡片：毛玻璃半透明底（对标桌面 GlassCardBrush）+ 圆角 20 + 细描边 -->
    <Style x:Key="CardStyle" TargetType="Border">
        <Setter Property="Background" Value="{StaticResource GlassCard}" />
        <Setter Property="BorderBrush" Value="{StaticResource CardStroke}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="20" />
        <Setter Property="Padding" Value="16" />
    </Style>

    <!-- 主按钮：品牌黄底深字加粗 -->
    <Style x:Key="PrimaryButtonStyle" TargetType="Button">
        <Setter Property="Background" Value="{StaticResource Primary}" />
        <Setter Property="Foreground" Value="{StaticResource OnPrimary}" />
        <Setter Property="FontWeight" Value="Bold" />
        <Setter Property="CornerRadius" Value="12" />
        <Setter Property="Padding" Value="16,12" />
        <Setter Property="BorderThickness" Value="0" />
    </Style>

    <!-- 次按钮：描边幽灵样式 -->
    <Style x:Key="OutlineButtonStyle" TargetType="Button">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="Foreground" Value="{StaticResource TextPrimary}" />
        <Setter Property="BorderBrush" Value="{StaticResource CardStroke}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="12" />
        <Setter Property="Padding" Value="14,8" />
    </Style>

    <!-- 文本层级 -->
    <Style x:Key="PageTitleStyle" TargetType="TextBlock">
        <Setter Property="FontSize" Value="24" />
        <Setter Property="FontWeight" Value="Bold" />
        <Setter Property="Margin" Value="0,8,0,4" />
    </Style>
    <Style x:Key="SectionTitleStyle" TargetType="TextBlock">
        <Setter Property="FontSize" Value="15" />
        <Setter Property="FontWeight" Value="Bold" />
    </Style>
    <Style x:Key="SecondaryLabelStyle" TargetType="TextBlock">
        <Setter Property="FontSize" Value="13" />
        <Setter Property="Foreground" Value="{StaticResource TextSecondary}" />
    </Style>

    <!-- 芯片：小圆角描边 Border + 内部文字用 ChipTextStyle -->
    <Style x:Key="ChipStyle" TargetType="Border">
        <Setter Property="BorderBrush" Value="{StaticResource CardStroke}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="99" />
        <Setter Property="Padding" Value="8,2" />
        <Setter Property="Background" Value="Transparent" />
    </Style>
    <Style x:Key="ChipTextStyle" TargetType="TextBlock">
        <Setter Property="FontSize" Value="11" />
        <Setter Property="Foreground" Value="{StaticResource TextSecondary}" />
    </Style>

</ResourceDictionary>
