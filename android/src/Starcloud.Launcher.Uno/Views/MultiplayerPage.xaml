<?xml version="1.0" encoding="utf-8"?>
<!-- 联机页：内置陶瓦联机 + 第三方联机 SDK（建房 / 进房 / 状态 / 日志）。
     设计：docs/designs/2026-09-21-multiplayer-sdk-design.md

     ── 一屏只留「现在要做什么」────────────────────────────────────────────
     常驻三块：页头（选联机方案）→ 状态卡（核心/会话/状态）→ 操作卡（装核心 或 建房进房 或 停止）。
     其余全部折叠：高级选项（玩家名 / 节点地区）、核心日志、使用步骤、第三方 SDK 说明。
     联机详情（邀请码 / 加入侧提示 / 异常）只在真的有内容时出现在操作卡里，平时不占位置。

     卡片外壳 = ScCard｜小节抬头 = ScSectionSpine + ScSectionTitle｜说明 = ScCardHint
     行尾数据 = ScMetaLabel + ScMetaValue -->
<Page
    x:Class="Starcloud.Launcher.Uno.Views.MultiplayerPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:beh="using:Starcloud.Launcher.Uno.Views.Behaviors"
    xmlns:ctrl="using:Starcloud.Launcher.Uno.Views.Controls"
    xmlns:loc="using:Starcloud.Launcher.Uno.Localization"
    NavigationCacheMode="Enabled">

    <Grid MaxWidth="880" HorizontalAlignment="Stretch">
        <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="0,0,8,0">
            <StackPanel Spacing="16">

                <!-- 页头 -->
                <Grid ColumnSpacing="12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                        <TextBlock loc:Loc.Text="联机方案" Style="{StaticResource ScMetaLabel}"
                                   VerticalAlignment="Center" />
                        <ComboBox x:Name="ProviderCombo" MinWidth="190" VerticalAlignment="Center"
                                  SelectionChanged="Provider_Changed" />
                    </StackPanel>
                </Grid>

                <InfoBar x:Name="NoticeBar" IsOpen="False" IsClosable="True" />

                <!-- 状态卡：一行三个状态，长说明放下面一行 -->
                <Border Style="{StaticResource ScCard}">
                    <StackPanel Spacing="12">
                        <Grid ColumnSpacing="24">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Spacing="4">
                                <TextBlock loc:Loc.Text="联机核心" Style="{StaticResource ScMetaLabel}" />
                                <TextBlock x:Name="CoreText" Style="{StaticResource ScMetaValue}" />
                            </StackPanel>
                            <StackPanel Grid.Column="1" Spacing="4">
                                <TextBlock loc:Loc.Text="核心会话" Style="{StaticResource ScMetaLabel}" />
                                <TextBlock x:Name="SessionText" Style="{StaticResource ScMetaValue}" />
                            </StackPanel>
                            <StackPanel Grid.Column="2" Spacing="4">
                                <TextBlock loc:Loc.Text="当前状态" Style="{StaticResource ScMetaLabel}" />
                                <TextBlock x:Name="PhaseText" Style="{StaticResource ScMetaValue}" />
                            </StackPanel>
                        </Grid>

                        <TextBlock x:Name="StatusHint" Style="{StaticResource ScCardHint}"
                                   Visibility="Collapsed" />

                        <!-- 安装进度：只在装核心时出现 -->
                        <StackPanel x:Name="InstallPanel" Spacing="6" Visibility="Collapsed">
                            <ProgressBar x:Name="InstallBar" Minimum="0" Maximum="100" Value="0" />
                            <TextBlock x:Name="InstallText" Style="{StaticResource ScCardHint}" />
                        </StackPanel>

                        <!-- 高级选项：玩家名与节点地区，平时收起。
                             抽屉机制与下载页「大版本抽屉」一致：Button 做头 + 箭头旋转 + ExpandBehavior 高度过渡。
                             （框架自带 Expander 的展开/收起是单帧硬跳，没有高度动画，收起会"卡一下"） -->
                        <StackPanel HorizontalAlignment="Stretch">
                            <ctrl:GlowButton Click="SectionHeader_Click" Tag="advanced"
                                    Style="{StaticResource ScGlowCardButtonStyle}"
                                    beh:RowHoverBehavior.IsEnabled="True"
                                    beh:RowHoverBehavior.Overlay="{Binding ElementName=AdvancedHover}">
                                <Grid>
                                    <!-- 悬停高亮层：常态 Opacity=0，由 RowHoverBehavior 在合成线程渐显
                                         （卡片底色由 ScGlowCardButtonStyle 给到按钮本身，光斑由模板负责） -->
                                    <Border x:Name="AdvancedHover" CornerRadius="10" Opacity="0"
                                            IsHitTestVisible="False"
                                            Background="{ThemeResource ControlFillColorDefaultBrush}" />
                                    <Grid Padding="13,11" ColumnSpacing="10">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock loc:Loc.Text="高级选项" FontWeight="Medium" FontSize="13"
                                                   VerticalAlignment="Center" />
                                        <FontIcon x:Name="AdvancedChevron" Grid.Column="1"
                                                  FontFamily="{StaticResource ScIconFont}" Glyph="&#xE904;"
                                                  FontSize="12" VerticalAlignment="Center"
                                                  Loaded="SectionChevron_Loaded"
                                                  Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                    </Grid>
                                </Grid>
                            </ctrl:GlowButton>
                            <Grid x:Name="AdvancedPane" Visibility="Collapsed" Margin="0,0,0,2">
                                <StackPanel Spacing="8" Padding="0,4,0,8">
                                    <Grid ColumnSpacing="24">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Spacing="6">
                                            <TextBlock loc:Loc.Text="玩家名" Style="{StaticResource ScMetaLabel}" />
                                            <TextBox x:Name="NicknameBox" HorizontalAlignment="Stretch"
                                                     LostFocus="Nickname_LostFocus" />
                                        </StackPanel>
                                        <StackPanel Grid.Column="1" Spacing="6">
                                            <TextBlock loc:Loc.Text="节点地区" Style="{StaticResource ScMetaLabel}" />
                                            <ComboBox x:Name="NodeRegionCombo" HorizontalAlignment="Stretch"
                                                      SelectionChanged="NodeRegion_Changed" />
                                        </StackPanel>
                                    </Grid>
                                    <TextBlock loc:Loc.Text="玩家名留空则跟随当前账户；同一房间的玩家建议选同一地区节点，跨地区节点之间常常互不联通。"
                                               Style="{StaticResource ScCardHint}" />
                                </StackPanel>
                            </Grid>
                        </StackPanel>
                    </StackPanel>
                </Border>

                <!-- 操作卡：一屏只回答「现在点哪个」 -->
                <Border Style="{StaticResource ScCard}">
                    <StackPanel Spacing="12">
                        <!-- 未装核心 -->
                        <StackPanel x:Name="InstallActions" Spacing="10">
                            <TextBlock x:Name="InstallHint" Style="{StaticResource ScCardHint}" />
                            <StackPanel Orientation="Horizontal" Spacing="10">
                                <Button x:Name="InstallBtn" loc:Loc.Text="安装联机核心"
                                        Style="{StaticResource AccentButtonStyle}" FontWeight="Medium"
                                        MinWidth="140" Click="Install_Click" />
                                <ctrl:GlowButton x:Name="CancelInstallBtn" loc:Loc.Text="取消安装"
                                        Visibility="Collapsed" Click="CancelInstall_Click" />
                            </StackPanel>
                        </StackPanel>

                        <!-- 已装核心：建房 / 进房 -->
                        <StackPanel x:Name="PlayActions" Spacing="10" Visibility="Collapsed">
                            <StackPanel Orientation="Horizontal" Spacing="10">
                                <Button x:Name="HostBtn" loc:Loc.Text="创建房间"
                                        Style="{StaticResource AccentButtonStyle}" FontWeight="Medium"
                                        MinWidth="120" Click="Host_Click" />
                                <ctrl:GlowButton x:Name="JoinToggleBtn" loc:Loc.Text="加入好友的房间" MinWidth="140"
                                        Click="JoinToggle_Click" />
                                <ctrl:GlowButton x:Name="LogsBtn" loc:Loc.Text="查看日志" Click="Logs_Click" />
                            </StackPanel>
                        </StackPanel>

                        <!-- 会话运行中 -->
                        <StackPanel x:Name="StopActions" Spacing="10" Visibility="Collapsed">
                            <StackPanel Orientation="Horizontal" Spacing="10">
                                <ctrl:GlowButton x:Name="StopBtn" loc:Loc.Text="停止联机" MinWidth="120"
                                        Click="Stop_Click" />
                                <ctrl:GlowButton x:Name="IdleBtn" loc:Loc.Text="回到空闲" MinWidth="100"
                                        Click="Idle_Click" />
                            </StackPanel>
                        </StackPanel>

                        <!-- 联机详情：邀请码 / 加入侧提示 / 异常，按需出现 -->
                        <StackPanel x:Name="DetailsPanel" Spacing="10" Visibility="Collapsed">
                            <Border Height="1" Background="{ThemeResource CardStrokeColorDefaultBrush}" />

                            <StackPanel x:Name="RoomBlock" Spacing="8" Visibility="Collapsed">
                                <TextBlock loc:Loc.Text="房间已创建，把邀请码发给好友"
                                           Style="{StaticResource ScSectionTitle}" />
                                <StackPanel Orientation="Horizontal" Spacing="10">
                                    <Border Style="{StaticResource ScChip}" Padding="10,6">
                                        <TextBlock x:Name="RoomCodeText" FontFamily="Consolas" FontSize="14"
                                                   IsTextSelectionEnabled="True" />
                                    </Border>
                                    <ctrl:GlowButton x:Name="CopyRoomBtn" loc:Loc.Text="复制邀请码" Click="CopyRoom_Click" />
                                </StackPanel>
                                <TextBlock loc:Loc.Text="好友在本页点「加入好友的房间」，把邀请码粘贴进弹出的窗口即可。"
                                           Style="{StaticResource ScCardHint}" />
                            </StackPanel>

                            <StackPanel x:Name="GuestBlock" Spacing="6" Visibility="Collapsed">
                                <TextBlock x:Name="GuestTitle" Style="{StaticResource ScSectionTitle}" />
                                <TextBlock x:Name="GuestHint" Style="{StaticResource ScCardHint}" />
                                <TextBlock x:Name="GuestPlayers" Style="{StaticResource ScCardHint}"
                                           Visibility="Collapsed" />
                            </StackPanel>

                            <StackPanel x:Name="ErrorBlock" Spacing="8" Visibility="Collapsed">
                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <Border Style="{StaticResource ScSectionSpine}"
                                            Background="{ThemeResource DangerBrush}" />
                                    <TextBlock x:Name="ErrorTitle" Style="{StaticResource ScSectionTitle}" />
                                </StackPanel>
                                <TextBlock x:Name="ErrorHint" Style="{StaticResource ScCardHint}"
                                           TextWrapping="Wrap" />
                                <ctrl:GlowButton x:Name="ErrorResetBtn" loc:Loc.Text="回到空闲重试" HorizontalAlignment="Left"
                                        Click="Idle_Click" />
                            </StackPanel>
                        </StackPanel>
                    </StackPanel>
                </Border>

                <!-- 折叠区：日志 / 使用步骤 / 第三方 SDK（抽屉机制同下载页：Button 头 + 箭头旋转 + ExpandBehavior） -->
                <StackPanel HorizontalAlignment="Stretch">
                    <ctrl:GlowButton Click="SectionHeader_Click" Tag="log"
                            Style="{StaticResource ScGlowCardButtonStyle}"
                            beh:RowHoverBehavior.IsEnabled="True"
                            beh:RowHoverBehavior.Overlay="{Binding ElementName=LogHover}">
                        <Grid>
                            <Border x:Name="LogHover" CornerRadius="10" Opacity="0" IsHitTestVisible="False"
                                    Background="{ThemeResource ControlFillColorDefaultBrush}" />
                            <Grid Padding="13,11" ColumnSpacing="10">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBlock loc:Loc.Text="联机核心日志" FontWeight="Medium" FontSize="13"
                                           VerticalAlignment="Center" />
                                <FontIcon x:Name="LogChevron" Grid.Column="1"
                                          FontFamily="{StaticResource ScIconFont}" Glyph="&#xE904;"
                                          FontSize="12" VerticalAlignment="Center"
                                          Loaded="SectionChevron_Loaded"
                                          Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                            </Grid>
                        </Grid>
                    </ctrl:GlowButton>
                    <Grid x:Name="LogPane" Visibility="Collapsed" Margin="0,0,0,2">
                        <StackPanel Spacing="8" Padding="0,4,0,8">
                            <TextBox x:Name="LogBox" IsReadOnly="True" AcceptsReturn="True" TextWrapping="NoWrap"
                                     FontFamily="Consolas" FontSize="11" Height="180"
                                     ScrollViewer.VerticalScrollBarVisibility="Auto"
                                     ScrollViewer.HorizontalScrollBarVisibility="Auto" />
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <ctrl:GlowButton loc:Loc.Text="刷新" Click="Logs_Click" />
                                <ctrl:GlowButton loc:Loc.Text="收起" Click="CloseLogs_Click" />
                            </StackPanel>
                        </StackPanel>
                    </Grid>
                </StackPanel>

                <StackPanel HorizontalAlignment="Stretch">
                    <ctrl:GlowButton Click="SectionHeader_Click" Tag="steps"
                            Style="{StaticResource ScGlowCardButtonStyle}"
                            beh:RowHoverBehavior.IsEnabled="True"
                            beh:RowHoverBehavior.Overlay="{Binding ElementName=StepsHover}">
                        <Grid>
                            <Border x:Name="StepsHover" CornerRadius="10" Opacity="0" IsHitTestVisible="False"
                                    Background="{ThemeResource ControlFillColorDefaultBrush}" />
                            <Grid Padding="13,11" ColumnSpacing="10">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBlock loc:Loc.Text="使用步骤" FontWeight="Medium" FontSize="13"
                                           VerticalAlignment="Center" />
                                <FontIcon x:Name="StepsChevron" Grid.Column="1"
                                          FontFamily="{StaticResource ScIconFont}" Glyph="&#xE904;"
                                          FontSize="12" VerticalAlignment="Center"
                                          Loaded="SectionChevron_Loaded"
                                          Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                            </Grid>
                        </Grid>
                    </ctrl:GlowButton>
                    <Grid x:Name="StepsPane" Visibility="Collapsed" Margin="0,0,0,2">
                        <StackPanel Spacing="8" Padding="0,4,0,8">
                            <TextBlock loc:Loc.Text="① 房主：游戏内「对局域网开放」→ 回启动器点「创建房间」。"
                                       Style="{StaticResource ScCardHint}" />
                            <TextBlock loc:Loc.Text="② 房主：状态变成「房间已创建」后，把邀请码发给好友。"
                                       Style="{StaticResource ScCardHint}" />
                            <TextBlock loc:Loc.Text="③ 好友：在本页点「加入好友的房间」，在弹出的窗口里粘贴邀请码。"
                                       Style="{StaticResource ScCardHint}" />
                            <TextBlock loc:Loc.Text="④ 双方：状态变成「已进入虚拟局域网」后，在游戏内「多人游戏」的局域网列表里进入房主的世界。"
                                       Style="{StaticResource ScCardHint}" />
                            <TextBlock loc:Loc.Text="联机核心由厂商官方发布，启动器只按官方方式下载并驱动它，不随安装包分发。"
                                       Style="{StaticResource ScCardHint}" />
                        </StackPanel>
                    </Grid>
                </StackPanel>

                <StackPanel HorizontalAlignment="Stretch">
                    <ctrl:GlowButton Click="SectionHeader_Click" Tag="sdk"
                            Style="{StaticResource ScGlowCardButtonStyle}"
                            beh:RowHoverBehavior.IsEnabled="True"
                            beh:RowHoverBehavior.Overlay="{Binding ElementName=SdkHover}">
                        <Grid>
                            <Border x:Name="SdkHover" CornerRadius="10" Opacity="0" IsHitTestVisible="False"
                                    Background="{ThemeResource ControlFillColorDefaultBrush}" />
                            <Grid Padding="13,11" ColumnSpacing="10">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBlock loc:Loc.Text="第三方联机 SDK" FontWeight="Medium" FontSize="13"
                                           VerticalAlignment="Center" />
                                <FontIcon x:Name="SdkChevron" Grid.Column="1"
                                          FontFamily="{StaticResource ScIconFont}" Glyph="&#xE904;"
                                          FontSize="12" VerticalAlignment="Center"
                                          Loaded="SectionChevron_Loaded"
                                          Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                            </Grid>
                        </Grid>
                    </ctrl:GlowButton>
                    <Grid x:Name="SdkPane" Visibility="Collapsed" Margin="0,0,0,2">
                        <StackPanel Spacing="10" Padding="0,4,0,8">
                            <TextBlock loc:Loc.Text="把第三方联机 SDK 的清单（JSON）放进下面这个目录，重启启动器后它就会出现在上方的「联机方案」里，无需等启动器更新。"
                                       Style="{StaticResource ScCardHint}" />
                            <StackPanel Orientation="Horizontal" Spacing="10">
                                <ctrl:GlowButton loc:Loc.Text="打开清单目录" Click="OpenSdkDir_Click" />
                                <TextBlock x:Name="SdkDirText" Style="{StaticResource ScCardHint}"
                                           VerticalAlignment="Center" IsTextSelectionEnabled="True" />
                            </StackPanel>
                            <TextBlock x:Name="SdkListText" Style="{StaticResource ScCardHint}" />
                        </StackPanel>
                    </Grid>
                </StackPanel>

                <TextBlock x:Name="VendorLine" Style="{StaticResource ScCardHint}"
                           HorizontalAlignment="Center" Margin="0,0,0,8"
                           beh:TextOutlineBehavior.IsEnabled="True" />
            </StackPanel>
        </ScrollViewer>
    </Grid>
</Page>
