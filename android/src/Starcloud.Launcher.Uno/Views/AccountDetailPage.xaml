<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="Starcloud.Launcher.Uno.Views.AccountDetailPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:beh="using:Starcloud.Launcher.Uno.Views.Behaviors"
    xmlns:ctrl="using:Starcloud.Launcher.Uno.Views.Controls"
    xmlns:rows="using:Starcloud.Launcher.Uno.Views.Rows"
    xmlns:loc="using:Starcloud.Launcher.Uno.Localization"
    NavigationCacheMode="Enabled">

    <!-- 账户详情（二级页）：左分区菜单 + 右内容，与下载页同一套交互。
         皮肤区的版式照主流启动器的"皮肤选择器"来：
           左：3D 形象（可拖拽转视角）+ 当前皮肤信息 + 应用到该账户
           右：「我的皮肤」卡片网格（首格是「添加皮肤」占位卡）
              +「默认皮肤」卡片网格（启动器自带的官方皮肤，可折叠，点一下即加入衣柜并应用）
         衣柜（皮肤库）在所有账户之间共用一份，每个账户只记自己选了哪张 ——
         所以同一张皮肤在这里换个账户照样能选，而"当前账户在用哪张"各行其是。
         卡片缩略图不用原始纹理，而是走 Core 的软件光栅化器渲染成小立绘（见 SkinThumbnails）。
         移植自桌面 Starcloud.App.Views.AccountDetailPage.xaml（结构与样式 1:1），适配点：
           - 桌面的整页拖放导入（AllowDrop/DragOver/Drop）在触屏端无对应交互，已移除，
             导入走占位卡 /「导入皮肤…」/「从链接导入」；
           - 占位卡副文案「拖放 PNG」随之改为「点此导入」；
           - 预览提示去掉「滚轮缩放」（触屏无滚轮）。 -->
    <!-- 整页一个滚动条：内容比窗口高时若交给外层居中，顶部（返回键）会被切掉。 -->
    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollMode="Disabled"
                  HorizontalContentAlignment="Stretch">
    <Grid MaxWidth="1280" HorizontalAlignment="Stretch" RowSpacing="16" Padding="0,0,0,16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- 页头：返回 + 身份 + 设为首选 -->
        <StackPanel Grid.Row="0" Spacing="12">
            <ctrl:GlowButton Click="Back_Click" loc:Loc.Name="返回账户列表"
                    Background="Transparent" BorderThickness="0" Padding="8,4"
                    Margin="-8,0,0,0" HorizontalAlignment="Left">
                <StackPanel Orientation="Horizontal" Spacing="6">
                    <FontIcon FontFamily="{StaticResource ScIconFont}" Glyph="&#xE908;" FontSize="14" />
                    <TextBlock loc:Loc.Text="返回账户列表" />
                </StackPanel>
            </ctrl:GlowButton>
            <Grid ColumnSpacing="16">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <Border Grid.Column="0" Width="52" Height="52" CornerRadius="12"
                        Background="{ThemeResource AccentFillColorDefaultBrush}">
                    <Grid>
                        <TextBlock x:Name="HeaderInitial" FontSize="22" FontWeight="Medium"
                                   Foreground="{ThemeResource TextOnAccentFillColorPrimaryBrush}"
                                   HorizontalAlignment="Center" VerticalAlignment="Center" />
                        <Image x:Name="HeaderAvatar" Stretch="UniformToFill" />
                    </Grid>
                </Border>

                <StackPanel Grid.Column="1" Spacing="4" VerticalAlignment="Center">
                    <StackPanel Orientation="Horizontal" Spacing="6">
                        <Border Style="{StaticResource ScChip}">
                            <TextBlock x:Name="HeaderType" Style="{StaticResource ScChipText}" />
                        </Border>
                        <Border x:Name="HeaderDefaultBadge" Style="{StaticResource ScChipAccent}"
                                Visibility="Collapsed">
                            <TextBlock loc:Loc.Text="首选账户" Style="{StaticResource ScChipAccentText}" />
                        </Border>
                    </StackPanel>
                </StackPanel>

                <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                    <ctrl:GlowButton x:Name="SetDefaultBtn" Click="SetDefault_Click" />
                </StackPanel>
            </Grid>
        </StackPanel>

        <!-- 状态条 -->
        <StackPanel Grid.Row="1" Spacing="8">
            <InfoBar x:Name="ErrorBar" Severity="Error" IsOpen="False" IsClosable="True" loc:Loc.Title="操作失败" />
            <InfoBar x:Name="StatusBar" Severity="Success" IsOpen="False" IsClosable="True" loc:Loc.Title="完成" />
        </StackPanel>

        <!-- 主体：左分区 + 右内容 -->
        <Grid Grid.Row="2" ColumnSpacing="16">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="180" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0" VerticalAlignment="Top"
                    Background="{ThemeResource AppPaneBackgroundBrush}"
                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                    BorderThickness="1" CornerRadius="8" Padding="8">
                <ListView x:Name="SectionList" SelectionMode="Single"
                          SelectionChanged="Section_SelectionChanged">
                    <ListView.ItemContainerStyle>
                        <Style TargetType="ListViewItem">
                            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                            <Setter Property="MinHeight" Value="40" />
                            <Setter Property="Padding" Value="0" />
                        </Style>
                    </ListView.ItemContainerStyle>
                    <ListViewItem Tag="skin" IsSelected="True">
                        <StackPanel Orientation="Horizontal" Spacing="10" Padding="8,0">
                            <FontIcon FontFamily="{StaticResource ScIconFont}" Glyph="&#xEAA3;" FontSize="14" />
                            <TextBlock loc:Loc.Text="形象与皮肤" VerticalAlignment="Center" />
                        </StackPanel>
                    </ListViewItem>
                    <ListViewItem Tag="info">
                        <StackPanel Orientation="Horizontal" Spacing="10" Padding="8,0">
                            <FontIcon FontFamily="{StaticResource ScIconFont}" Glyph="&#xEB8F;" FontSize="14" />
                            <TextBlock loc:Loc.Text="账户信息" VerticalAlignment="Center" />
                        </StackPanel>
                    </ListViewItem>
                </ListView>
            </Border>

            <!-- ── 形象与皮肤：左预览 + 右皮肤选择器（我的皮肤 / 默认皮肤，卡片网格） ── -->
            <Grid x:Name="SkinPanel" Grid.Column="1" ColumnSpacing="20" MinHeight="460">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="300" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <!-- 左：3D 形象 + 当前皮肤信息与操作（一整块表面，不再往里套第二层卡片） -->
                <!-- 卡靠左站定，不做水平居中：居中会让它两侧各空出一大片，
                     菜单到卡片之间那道空白比页面本身还显眼。 -->
                <Border Grid.Column="0" VerticalAlignment="Top"
                        Style="{StaticResource ScCard}" Padding="14,16">
                    <StackPanel Spacing="10">
                        <ctrl:SkinFigureView x:Name="PlayerView" Height="310"
                                             HorizontalAlignment="Stretch" />
                        <TextBlock loc:Loc.Text="拖动以旋转" FontSize="11"
                                   HorizontalAlignment="Center"
                                   Foreground="{ThemeResource TextFillColorTertiaryBrush}" />
                        <Border Height="1" Margin="2,4"
                                Background="{ThemeResource CardStrokeColorDefaultBrush}" />
                        <StackPanel Spacing="6">
                            <TextBlock x:Name="SkinNameText" FontSize="16" FontWeight="Medium"
                                       TextWrapping="Wrap" />
                            <TextBlock x:Name="SkinMetaText" FontSize="11" TextWrapping="Wrap"
                                       Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                            <!-- 这张皮肤是不是当前账户在用的（各账户各选各的，一眼看清差别） -->
                            <TextBlock x:Name="SkinUsageText" FontSize="11" TextWrapping="Wrap"
                                       Foreground="{ThemeResource TextFillColorTertiaryBrush}" />
                        </StackPanel>
                        <!-- 本地皮肤库的操作对离线与正版账户开放（第三方归皮肤站，这一整块收起，见 ApplySkinMode。
                             正版"应用到该账户"每次都会先弹强制警告：只改本机看到的形象，不动微软账号上的官方皮肤）。 -->
                        <StackPanel x:Name="SkinActions" Spacing="10">
                            <Grid ColumnSpacing="8">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <TextBlock loc:Loc.Text="型号" VerticalAlignment="Center"
                                           Style="{StaticResource ScMetaLabel}" />
                                <ComboBox x:Name="ModelBox" Grid.Column="1" MinWidth="0"
                                          HorizontalAlignment="Stretch"
                                          SelectionChanged="Model_SelectionChanged" />
                            </Grid>
                            <Button x:Name="ApplyBtn" loc:Loc.Text="应用到该账户"
                                    Style="{StaticResource AccentButtonStyle}" FontWeight="Medium"
                                    HorizontalAlignment="Stretch" Click="Apply_Click" />
                            <!-- 「同步到账号」已移除：上传到微软账号 / 皮肤站与"本机换肤"是两件事，
                                 这里只做本机注入（正版会先警告），不需要上传按钮。 -->
                            <StackPanel Orientation="Horizontal" Spacing="2" HorizontalAlignment="Center">
                                <HyperlinkButton x:Name="ImportBtn" loc:Loc.Text="导入皮肤…"
                                                 Padding="8,4" Click="Import_Click" />
                                <HyperlinkButton x:Name="UnbindBtn" loc:Loc.Text="取消使用"
                                                 Padding="8,4" Visibility="Collapsed"
                                                 Click="Unbind_Click" />
                            </StackPanel>
                        </StackPanel>
                        <TextBlock x:Name="SkinNote" FontSize="11" TextWrapping="Wrap"
                                   Foreground="{ThemeResource TextFillColorTertiaryBrush}" />
                    </StackPanel>
                </Border>

                <!-- 右：皮肤选择器（卡片网格）。卡片直接坐在页面上，靠小节标题分段，不套外层卡片容器。 -->
                <Grid Grid.Column="1">
                <StackPanel Spacing="12" Padding="0,0,4,0" x:Name="LocalSkinLibrary">

                    <!-- 我的皮肤（衣柜）：所有账户共用一份，每个账户各选各的 -->
                    <Grid ColumnSpacing="8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <Border Grid.Column="0" Style="{StaticResource ScSectionSpine}" />
                        <TextBlock Grid.Column="1" loc:Loc.Text="我的皮肤" FontWeight="Medium"
                                   Style="{StaticResource ScSectionTitle}" />
                        <Border Grid.Column="2" Style="{StaticResource ScChip}" Margin="2,0,0,0">
                            <TextBlock x:Name="SavedCountText" Style="{StaticResource ScChipText}" />
                        </Border>
                        <TextBlock Grid.Column="3" VerticalAlignment="Center"
                                   Style="{StaticResource ScCardHint}"
                                   loc:Loc.Text="衣柜在所有账户间共用（皮肤只存一份），每个账户各选各的。" />
                        <HyperlinkButton Grid.Column="4" loc:Loc.Text="从链接导入" Padding="8,4"
                                         Click="UrlImport_Click" />
                    </Grid>

                    <!-- 卡片网格的高度由代码按列数算（Uno 无 ItemsWrapGrid，网格已降级为横向单行，
                         高度只作占位），屏幕再矮也不会把「我的皮肤」压没；整页滚动由页面最外层负责 -->
                    <GridView x:Name="SavedList" SelectionMode="None" IsItemClickEnabled="True"
                              ItemClick="Saved_ItemClick"
                              ContextRequested="SavedList_ContextRequested"
                              Padding="0" Margin="-4,0"
                              ScrollViewer.HorizontalScrollMode="Enabled" ScrollViewer.HorizontalScrollBarVisibility="Hidden"
                              SizeChanged="CardGrid_SizeChanged">
                        <GridView.Resources>
                            <!-- 悬停/选中反馈只由卡片的跟手光斑表达，框架整卡底色一律关掉
                                 （框架给的是硬边直角矩形，压上圆角光斑后四个角互相啃掉一块） -->
                            <SolidColorBrush x:Key="GridViewItemBackground" Color="Transparent" />
                            <SolidColorBrush x:Key="GridViewItemBackgroundPointerOver" Color="Transparent" />
                            <SolidColorBrush x:Key="GridViewItemBackgroundPressed" Color="Transparent" />
                            <SolidColorBrush x:Key="GridViewItemBackgroundSelected" Color="Transparent" />
                            <SolidColorBrush x:Key="GridViewItemBackgroundSelectedPointerOver" Color="Transparent" />
                            <SolidColorBrush x:Key="GridViewItemBackgroundSelectedPressed" Color="Transparent" />
                        </GridView.Resources>
                        <!-- Uno Skia 未实现 ItemsWrapGrid（桌面 GridView 的换行网格面板）：降级为横向单行，
                             卡片节距与桌面一致（104x152 + 4,2 外边距），放不下的卡横向滑动查看 -->
                        <GridView.ItemsPanel>
                            <ItemsPanelTemplate>
                                <StackPanel Orientation="Horizontal" />
                            </ItemsPanelTemplate>
                        </GridView.ItemsPanel>
                        <GridView.ItemContainerStyle>
                            <Style TargetType="GridViewItem">
                                <Setter Property="Padding" Value="0" />
                                <Setter Property="Margin" Value="4,2" />
                                <Setter Property="Width" Value="104" />
                                <Setter Property="Height" Value="152" />
                                <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                                <Setter Property="VerticalContentAlignment" Value="Stretch" />
                            </Style>
                        </GridView.ItemContainerStyle>
                        <GridView.ItemTemplate>
                            <DataTemplate x:DataType="rows:SkinCardRow">
                                <Grid>
                                    <Border CornerRadius="10"
                                            beh:HoverShadowBehavior.IsEnabled="True"
                                            beh:HoverShadowBehavior.Carrier="{Binding ElementName=SkinCardGlow}"
                                            Background="{ThemeResource LayerFillColorDefaultBrush}"
                                            BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                            BorderThickness="1">
                                        <Grid>
                                            <!-- 跟手光斑（与账户卡同一套观感） -->
                                            <Border x:Name="SkinCardGlow" CornerRadius="10"
                                                    Opacity="0" IsHitTestVisible="False">
                                                <Border.Background>
                                                    <RadialGradientBrush Center="0.5,0.5" RadiusX="0.9" RadiusY="0.9">
                                                        <GradientStop Color="#28000000" Offset="0" />
                                                        <GradientStop Color="#1F000000" Offset="0.18" />
                                                        <GradientStop Color="#16000000" Offset="0.40" />
                                                        <GradientStop Color="#0D000000" Offset="0.62" />
                                                        <GradientStop Color="#05000000" Offset="0.82" />
                                                        <GradientStop Color="#00000000" Offset="1" />
                                                    </RadialGradientBrush>
                                                </Border.Background>
                                            </Border>

                                            <!-- 添加皮肤（首位占位卡） -->
                                            <StackPanel Spacing="4" Padding="8"
                                                        HorizontalAlignment="Center" VerticalAlignment="Center"
                                                        Visibility="{x:Bind AddVisibility}">
                                                <!-- 加号用文本而不是图标字形：图标库里没有"添加"，字体缺字就是方框 -->
                                                <TextBlock Text="+" FontSize="26" HorizontalAlignment="Center"
                                                           Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                                <TextBlock loc:Loc.Text="添加皮肤" FontSize="12"
                                                           HorizontalAlignment="Center" />
                                                <TextBlock loc:Loc.Text="点此导入" FontSize="10"
                                                           HorizontalAlignment="Center"
                                                           Foreground="{ThemeResource TextFillColorTertiaryBrush}" />
                                            </StackPanel>

                                            <!-- 皮肤卡 -->
                                            <Grid Padding="6,6,6,4" Visibility="{x:Bind CardVisibility}"
                                                  ToolTipService.ToolTip="{x:Bind Detail}">
                                                <Grid.RowDefinitions>
                                                    <RowDefinition Height="*" />
                                                    <RowDefinition Height="Auto" />
                                                </Grid.RowDefinitions>
                                                <Image Source="{x:Bind Preview}" Stretch="Uniform"
                                                       HorizontalAlignment="Center" />
                                                <TextBlock Grid.Row="1" Text="{x:Bind Name}" FontSize="11"
                                                           HorizontalAlignment="Center"
                                                           TextTrimming="CharacterEllipsis" />
                                                <Border Grid.Row="0" Padding="5,1" CornerRadius="4"
                                                        VerticalAlignment="Top" HorizontalAlignment="Right"
                                                        Style="{StaticResource ScChipAccent}"
                                                        Visibility="{x:Bind InUseVisibility}">
                                                    <TextBlock loc:Loc.Text="使用中" FontSize="9"
                                                               Style="{StaticResource ScChipAccentText}" />
                                                </Border>
                                            </Grid>
                                        </Grid>
                                    </Border>
                                    <!-- 选中态：叠一层强调色描边。
                                         与"使用中"徽标分开表达两件事——选中=左侧预览对准它，使用=这个账户就在用它。 -->
                                    <Border CornerRadius="10" IsHitTestVisible="False"
                                            BorderBrush="{ThemeResource AccentFillColorDefaultBrush}"
                                            BorderThickness="2"
                                            Visibility="{x:Bind SelectionVisibility, Mode=OneWay}" />
                                </Grid>
                            </DataTemplate>
                        </GridView.ItemTemplate>
                    </GridView>

                    <!-- 默认皮肤：可折叠（点标题行切换），省下的高度留给"我的皮肤" -->
                    <ctrl:GlowButton x:Name="PresetToggleBtn" Click="PresetToggle_Click"
                            Background="Transparent" BorderThickness="0" Padding="0"
                            HorizontalAlignment="Stretch" HorizontalContentAlignment="Left">
                        <Grid ColumnSpacing="8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <FontIcon x:Name="PresetChevron" FontFamily="{StaticResource ScIconFont}"
                                      Glyph="&#xE904;" FontSize="12" VerticalAlignment="Center"
                                      Loaded="PresetChevron_Loaded"
                                      Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                            <TextBlock Grid.Column="1" loc:Loc.Text="默认皮肤" FontWeight="Medium"
                                       Style="{StaticResource ScSectionTitle}" />
                            <TextBlock Grid.Column="2" VerticalAlignment="Center"
                                       Style="{StaticResource ScCardHint}"
                                       loc:Loc.Text="启动器自带的官方皮肤；点一张即加入衣柜并应用到当前账户。" />
                        </Grid>
                    </ctrl:GlowButton>

                    <Grid x:Name="PresetPane">
                        <GridView x:Name="PresetList" SelectionMode="None" IsItemClickEnabled="True"
                                      ItemClick="Preset_ItemClick"
                                      Padding="0" Margin="-4,0"
                                      ScrollViewer.HorizontalScrollMode="Enabled" ScrollViewer.HorizontalScrollBarVisibility="Hidden"
                                      SizeChanged="CardGrid_SizeChanged">
                            <GridView.Resources>
                                <!-- 悬停/选中反馈只由卡片的跟手光斑表达，框架整卡底色一律关掉
                                     （框架给的是硬边直角矩形，压上圆角光斑后四个角互相啃掉一块） -->
                                <SolidColorBrush x:Key="GridViewItemBackground" Color="Transparent" />
                                <SolidColorBrush x:Key="GridViewItemBackgroundPointerOver" Color="Transparent" />
                                <SolidColorBrush x:Key="GridViewItemBackgroundPressed" Color="Transparent" />
                                <SolidColorBrush x:Key="GridViewItemBackgroundSelected" Color="Transparent" />
                                <SolidColorBrush x:Key="GridViewItemBackgroundSelectedPointerOver" Color="Transparent" />
                                <SolidColorBrush x:Key="GridViewItemBackgroundSelectedPressed" Color="Transparent" />
                            </GridView.Resources>
                            <!-- 同上：Uno Skia 无 ItemsWrapGrid，降级为横向单行滑动（卡片 104x146 + 4,2 外边距） -->
                            <GridView.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <StackPanel Orientation="Horizontal" />
                                </ItemsPanelTemplate>
                            </GridView.ItemsPanel>
                            <GridView.ItemContainerStyle>
                                <Style TargetType="GridViewItem">
                                    <Setter Property="Padding" Value="0" />
                                    <Setter Property="Margin" Value="4,2" />
                                    <Setter Property="Width" Value="104" />
                                    <Setter Property="Height" Value="146" />
                                    <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                                    <Setter Property="VerticalContentAlignment" Value="Stretch" />
                                </Style>
                            </GridView.ItemContainerStyle>
                            <GridView.ItemTemplate>
                                <DataTemplate x:DataType="rows:SkinPresetRow">
                                    <Border CornerRadius="10"
                                            beh:HoverShadowBehavior.IsEnabled="True"
                                            beh:HoverShadowBehavior.Carrier="{Binding ElementName=PresetGlow}"
                                            Background="{ThemeResource LayerFillColorDefaultBrush}"
                                            BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                            BorderThickness="1">
                                        <Grid>
                                            <Border x:Name="PresetGlow" CornerRadius="10"
                                                    Opacity="0" IsHitTestVisible="False">
                                                <Border.Background>
                                                    <RadialGradientBrush Center="0.5,0.5" RadiusX="0.9" RadiusY="0.9">
                                                        <GradientStop Color="#28000000" Offset="0" />
                                                        <GradientStop Color="#1F000000" Offset="0.18" />
                                                        <GradientStop Color="#16000000" Offset="0.40" />
                                                        <GradientStop Color="#0D000000" Offset="0.62" />
                                                        <GradientStop Color="#05000000" Offset="0.82" />
                                                        <GradientStop Color="#00000000" Offset="1" />
                                                    </RadialGradientBrush>
                                                </Border.Background>
                                            </Border>
                                            <Grid Padding="6" ToolTipService.ToolTip="{x:Bind ActionText}">
                                                <Grid.RowDefinitions>
                                                    <RowDefinition Height="*" />
                                                    <RowDefinition Height="Auto" />
                                                </Grid.RowDefinitions>
                                                <Image Source="{x:Bind Preview}" Stretch="Uniform"
                                                       HorizontalAlignment="Center" />
                                                <TextBlock Grid.Row="1" Text="{x:Bind Name}" FontSize="11"
                                                           HorizontalAlignment="Center"
                                                           TextTrimming="CharacterEllipsis" />
                                                <!-- 点过之后状态就地可见：只在悬停 ToolTip 里说，用户点了会以为没生效 -->
                                                <Border Grid.Row="0" Padding="5,1" CornerRadius="4"
                                                        VerticalAlignment="Top" HorizontalAlignment="Right"
                                                        Style="{StaticResource ScChipAccent}"
                                                        Visibility="{x:Bind InUseVisibility}">
                                                    <TextBlock loc:Loc.Text="使用中" FontSize="9"
                                                               Style="{StaticResource ScChipAccentText}" />
                                                </Border>
                                                <Border Grid.Row="0" Padding="5,1" CornerRadius="4"
                                                        VerticalAlignment="Top" HorizontalAlignment="Left"
                                                        Style="{StaticResource ScChip}"
                                                        Visibility="{x:Bind InLibraryVisibility}">
                                                    <TextBlock loc:Loc.Text="已在库中" FontSize="9"
                                                               Style="{StaticResource ScChipText}" />
                                                </Border>
                                            </Grid>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </GridView.ItemTemplate>
                        </GridView>
                    </Grid>

                    <TextBlock x:Name="SkinStatus" FontSize="12" TextWrapping="Wrap"
                               Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                </StackPanel>

                <!-- 右：皮肤站衣柜（第三方账户专用）。第三方账号的皮肤存在皮肤站上，
                     所以这里列出站上"我的皮肤"，点一张就设为当前皮肤——本地皮肤库对第三方没有意义。 -->
                <Border x:Name="StationSkinLibrary" Visibility="Collapsed"
                        Background="{ThemeResource GlassCardBrush}"
                        BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                        BorderThickness="1" CornerRadius="16" Padding="16">
                    <StackPanel Spacing="10" Padding="0,0,4,0">
                        <StackPanel Spacing="4">
                            <TextBlock loc:Loc.Text="皮肤站衣柜" FontWeight="Medium" />
                            <TextBlock loc:Loc.Text="这里列的是这个账号在皮肤站上的皮肤；点一张就换成它，游戏里（用启动器启动后）看到的就是这张。"
                                       FontSize="12" TextWrapping="Wrap"
                                       Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                        </StackPanel>

                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <ctrl:GlowButton x:Name="StationRefreshBtn" loc:Loc.Text="刷新衣柜"
                                    Click="Station_Refresh_Click" />
                            <ctrl:GlowButton x:Name="StationLoginBtn" loc:Loc.Text="重新登录该账号"
                                    Click="Station_Login_Click" />
                            <ProgressRing x:Name="StationBusy" Width="20" Height="20"
                                          IsActive="False" Visibility="Collapsed" />
                        </StackPanel>

                        <GridView x:Name="StationList" SelectionMode="None" IsItemClickEnabled="True"
                                  ItemClick="Station_ItemClick"
                                  Padding="0" Margin="-4,0" MinHeight="160"
                                  ScrollViewer.HorizontalScrollMode="Enabled" ScrollViewer.HorizontalScrollBarVisibility="Hidden"
                                  SizeChanged="Station_SizeChanged">
                            <GridView.Resources>
                                <!-- 悬停/选中反馈只由卡片的跟手光斑表达，框架整卡底色一律关掉
                                     （框架给的是硬边直角矩形，压上圆角光斑后四个角互相啃掉一块） -->
                                <SolidColorBrush x:Key="GridViewItemBackground" Color="Transparent" />
                                <SolidColorBrush x:Key="GridViewItemBackgroundPointerOver" Color="Transparent" />
                                <SolidColorBrush x:Key="GridViewItemBackgroundPressed" Color="Transparent" />
                                <SolidColorBrush x:Key="GridViewItemBackgroundSelected" Color="Transparent" />
                                <SolidColorBrush x:Key="GridViewItemBackgroundSelectedPointerOver" Color="Transparent" />
                                <SolidColorBrush x:Key="GridViewItemBackgroundSelectedPressed" Color="Transparent" />
                            </GridView.Resources>
                            <!-- 同上：Uno Skia 无 ItemsWrapGrid，降级为横向单行滑动（卡片 104x152 + 4,2 外边距） -->
                            <GridView.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <StackPanel Orientation="Horizontal" />
                                </ItemsPanelTemplate>
                            </GridView.ItemsPanel>
                            <GridView.ItemContainerStyle>
                                <Style TargetType="GridViewItem">
                                    <Setter Property="Padding" Value="0" />
                                    <Setter Property="Margin" Value="4,2" />
                                    <Setter Property="Width" Value="104" />
                                    <Setter Property="Height" Value="152" />
                                    <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                                    <Setter Property="VerticalContentAlignment" Value="Stretch" />
                                </Style>
                            </GridView.ItemContainerStyle>
                            <GridView.ItemTemplate>
                                <DataTemplate x:DataType="rows:StationSkinRow">
                                    <Border CornerRadius="10"
                                            beh:HoverShadowBehavior.IsEnabled="True"
                                            beh:HoverShadowBehavior.Carrier="{Binding ElementName=StationGlow}"
                                            Background="{ThemeResource LayerFillColorDefaultBrush}"
                                            BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                            BorderThickness="1">
                                        <Grid>
                                            <Border x:Name="StationGlow" CornerRadius="10"
                                                    Opacity="0" IsHitTestVisible="False">
                                                <Border.Background>
                                                    <RadialGradientBrush Center="0.5,0.5" RadiusX="0.9" RadiusY="0.9">
                                                        <GradientStop Color="#28000000" Offset="0" />
                                                        <GradientStop Color="#1F000000" Offset="0.18" />
                                                        <GradientStop Color="#16000000" Offset="0.40" />
                                                        <GradientStop Color="#0D000000" Offset="0.62" />
                                                        <GradientStop Color="#05000000" Offset="0.82" />
                                                        <GradientStop Color="#00000000" Offset="1" />
                                                    </RadialGradientBrush>
                                                </Border.Background>
                                            </Border>
                                            <Grid Padding="6" ToolTipService.ToolTip="{x:Bind ModelText}">
                                                <Grid.RowDefinitions>
                                                    <RowDefinition Height="*" />
                                                    <RowDefinition Height="Auto" />
                                                </Grid.RowDefinitions>
                                                <Image Source="{x:Bind Preview}" Stretch="Uniform"
                                                       HorizontalAlignment="Center" />
                                                <TextBlock Grid.Row="1" Text="{x:Bind Name}" FontSize="11"
                                                           HorizontalAlignment="Center"
                                                           TextTrimming="CharacterEllipsis" />
                                            </Grid>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </GridView.ItemTemplate>
                        </GridView>

                        <TextBlock x:Name="StationStatus" FontSize="12" TextWrapping="Wrap"
                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                    </StackPanel>
                </Border>
                </Grid>
            </Grid>

            <!-- ── 账户信息 ── -->
            <ScrollViewer x:Name="InfoPanel" Grid.Column="1" Visibility="Collapsed"
                          VerticalScrollBarVisibility="Auto"
                          HorizontalScrollMode="Disabled" HorizontalContentAlignment="Stretch">
                <StackPanel Spacing="12" Padding="0,0,0,24">
                    <TextBlock loc:Loc.Text="账户信息" FontWeight="Medium" />
                    <Border Background="{ThemeResource GlassCardBrush}"
                            BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                            BorderThickness="1" CornerRadius="16" Padding="20">
                        <StackPanel x:Name="InfoRows" Spacing="12" />
                    </Border>

                    <TextBlock loc:Loc.Text="账户操作" FontWeight="Medium" />
                    <Border Background="{ThemeResource GlassCardBrush}"
                            BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                            BorderThickness="1" CornerRadius="16" Padding="20">
                        <StackPanel Spacing="10">
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <ctrl:GlowButton x:Name="InfoSetDefaultBtn"
                                        Click="SetDefault_Click" />
                                <ctrl:GlowButton x:Name="DeleteAccountBtn" loc:Loc.Text="删除账户"
                                        Background="Transparent" BorderThickness="0"
                                        Foreground="{ThemeResource SystemFillColorCriticalBrush}"
                                        Click="DeleteAccount_Click" />
                            </StackPanel>
                            <TextBlock loc:Loc.Text="删除只移除本机保存的身份信息，不动游戏存档与版本文件。"
                                       FontSize="12" TextWrapping="Wrap"
                                       Foreground="{ThemeResource TextFillColorTertiaryBrush}" />
                        </StackPanel>
                    </Border>
                </StackPanel>
            </ScrollViewer>
        </Grid>
    </Grid>
    </ScrollViewer>
</Page>
