<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="Starcloud.Launcher.Uno.Views.VersionsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:Starcloud.Launcher.Uno.Views"
    xmlns:beh="using:Starcloud.Launcher.Uno.Views.Behaviors"
    xmlns:ctrl="using:Starcloud.Launcher.Uno.Views.Controls"
    xmlns:rows="using:Starcloud.Launcher.Uno.Views.Rows"
    xmlns:loc="using:Starcloud.Launcher.Uno.Localization"
    NavigationCacheMode="Enabled">

    <Page.Resources>
        <!-- 行菜单：长按行与「…」按钮共用（Opening 时从 Target.DataContext 取行数据） -->
        <MenuFlyout x:Key="RowMenu" Opening="RowMenu_Opening">
            <MenuFlyoutItem loc:Loc.Text="启动" Click="Launch_Click">
                <MenuFlyoutItem.Icon>
                    <FontIcon FontFamily="{StaticResource ScIconFont}" Glyph="&#xEBDF;" />
                </MenuFlyoutItem.Icon>
            </MenuFlyoutItem>
            <MenuFlyoutItem loc:Loc.Text="版本详情" Click="Detail_Click">
                <MenuFlyoutItem.Icon>
                    <FontIcon FontFamily="{StaticResource ScIconFont}" Glyph="&#xEBA0;" />
                </MenuFlyoutItem.Icon>
            </MenuFlyoutItem>
            <!-- 文件夹入口：版本目录固定 versions/<id>，存档 / 模组跟随实例根
                 （隔离实例各自持有一份，共享实例落在 .minecraft 下） -->
            <MenuFlyoutItem loc:Loc.Text="打开版本文件夹" Tag="version" Click="OpenFolder_Click">
                <MenuFlyoutItem.Icon>
                    <FontIcon FontFamily="{StaticResource ScIconFont}" Glyph="&#xEA94;" />
                </MenuFlyoutItem.Icon>
            </MenuFlyoutItem>
            <MenuFlyoutItem loc:Loc.Text="打开存档文件夹" Tag="saves" Click="OpenFolder_Click">
                <MenuFlyoutItem.Icon>
                    <FontIcon FontFamily="{StaticResource ScIconFont}" Glyph="&#xEA90;" />
                </MenuFlyoutItem.Icon>
            </MenuFlyoutItem>
            <MenuFlyoutItem loc:Loc.Text="打开模组文件夹" Tag="mods" Click="OpenFolder_Click">
                <MenuFlyoutItem.Icon>
                    <FontIcon FontFamily="{StaticResource ScIconFont}" Glyph="&#xEA93;" />
                </MenuFlyoutItem.Icon>
            </MenuFlyoutItem>
            <MenuFlyoutSeparator />
            <MenuFlyoutItem loc:Loc.Text="重命名" Click="Rename_Click">
                <MenuFlyoutItem.Icon>
                    <FontIcon FontFamily="{StaticResource ScIconFont}" Glyph="&#xEA97;" />
                </MenuFlyoutItem.Icon>
            </MenuFlyoutItem>
            <MenuFlyoutItem loc:Loc.Text="复制版本" Click="Copy_Click">
                <MenuFlyoutItem.Icon>
                    <FontIcon FontFamily="{StaticResource ScIconFont}" Glyph="&#xEA9F;" />
                </MenuFlyoutItem.Icon>
            </MenuFlyoutItem>
            <MenuFlyoutItem loc:Loc.Text="导出整合包" Click="Export_Click">
                <MenuFlyoutItem.Icon>
                    <FontIcon FontFamily="{StaticResource ScIconFont}" Glyph="&#xE90A;" />
                </MenuFlyoutItem.Icon>
            </MenuFlyoutItem>
            <MenuFlyoutItem loc:Loc.Text="导入整合包" Click="Import_Click">
                <MenuFlyoutItem.Icon>
                    <FontIcon FontFamily="{StaticResource ScIconFont}" Glyph="&#xE90C;" />
                </MenuFlyoutItem.Icon>
            </MenuFlyoutItem>
            <MenuFlyoutItem loc:Loc.Text="从链接导入" Click="ImportFromLink_Click">
                <MenuFlyoutItem.Icon>
                    <FontIcon FontFamily="{StaticResource ScIconFont}" Glyph="&#xE71B;" />
                </MenuFlyoutItem.Icon>
            </MenuFlyoutItem>
            <MenuFlyoutItem loc:Loc.Text="备份与回档" Click="Backup_Click">
                <MenuFlyoutItem.Icon>
                    <FontIcon FontFamily="{StaticResource ScIconFont}" Glyph="&#xEC68;" />
                </MenuFlyoutItem.Icon>
            </MenuFlyoutItem>
            <MenuFlyoutSeparator />
            <MenuFlyoutItem loc:Loc.Text="问 Nova" Click="AskNova_Click">
                <MenuFlyoutItem.Icon>
                    <ImageIcon Source="{StaticResource NovaMarkSmall}" />
                </MenuFlyoutItem.Icon>
            </MenuFlyoutItem>
            <MenuFlyoutItem loc:Loc.Text="删除" Click="Delete_Click">
                <MenuFlyoutItem.Icon>
                    <FontIcon FontFamily="{StaticResource ScIconFont}" Glyph="&#xEAA5;" />
                </MenuFlyoutItem.Icon>
            </MenuFlyoutItem>
        </MenuFlyout>
    </Page.Resources>

    <Grid MaxWidth="1280" HorizontalAlignment="Stretch" RowSpacing="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- 目录与工具行（+ 插件挂载区 versions.top，没贡献时整块不占位） -->
        <StackPanel Spacing="12">
        <Grid ColumnSpacing="12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <Border Background="{ThemeResource GlassCardBrush}"
                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                    BorderThickness="1" CornerRadius="8" Padding="12,8">
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <FontIcon FontFamily="{StaticResource ScIconFont}" Glyph="&#xEA90;" FontSize="14"
                              Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                    <TextBlock x:Name="DirText" VerticalAlignment="Center" FontSize="12"
                               TextTrimming="CharacterEllipsis"
                               Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                </StackPanel>
            </Border>
            <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8">
                <ctrl:GlowButton Click="Import_Click">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <FontIcon FontFamily="{StaticResource ScIconFont}" Glyph="&#xE90C;" FontSize="14" />
                        <TextBlock loc:Loc.Text="导入整合包" />
                    </StackPanel>
                </ctrl:GlowButton>
                <ctrl:GlowButton Click="ImportFromLink_Click" loc:Loc.Name="从链接导入整合包">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <FontIcon FontFamily="{StaticResource ScIconFont}" Glyph="&#xE71B;" FontSize="14" />
                        <TextBlock loc:Loc.Text="从链接导入" />
                    </StackPanel>
                </ctrl:GlowButton>
                <TextBox x:Name="SearchBox" loc:Loc.Placeholder="搜索版本 / 类别"
                         Width="180" loc:Loc.Name="搜索版本"
                         TextChanged="SearchBox_TextChanged" />
                <ComboBox x:Name="CategoryFilter" Width="130" SelectedIndex="0"
                          loc:Loc.Name="按类别筛选"
                          SelectionChanged="CategoryFilter_SelectionChanged" />
                <ctrl:GlowButton Click="Refresh_Click">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <FontIcon FontFamily="{StaticResource ScIconFont}" Glyph="&#xE918;" FontSize="14" />
                        <TextBlock loc:Loc.Text="刷新" />
                    </StackPanel>
                </ctrl:GlowButton>
                <ctrl:GlowButton Click="OpenDir_Click">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <FontIcon FontFamily="{StaticResource ScIconFont}" Glyph="&#xEA90;" FontSize="14" />
                        <TextBlock loc:Loc.Text="打开游戏目录" />
                    </StackPanel>
                </ctrl:GlowButton>
            </StackPanel>
        </Grid>

        <ctrl:PluginContributionPanel Point="versions.top" />
        </StackPanel>

        <!-- 本地版本列表 -->
        <Border Grid.Row="1"
                Background="{ThemeResource GlassCardBrush}"
                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                BorderThickness="1" CornerRadius="16" Padding="4">
            <Grid>
                <ListView x:Name="VersionListView" SelectionMode="Single"
                          IsItemClickEnabled="True" ItemClick="VersionList_ItemClick">
                    <ListView.Resources>
                        <!-- 悬停/选中反馈只由行内的跟手光斑表达：框架给的整行底色是一块硬边矩形，
                             和光斑的圆角、羽化对不齐，叠在一起就是"两层框"（红框反馈的那个问题）。
                             这里把框架底色全部置空，页面上该列表的选中态没有语义（点行直接进详情）。 -->
                        <SolidColorBrush x:Key="ListViewItemBackground" Color="Transparent" />
                        <SolidColorBrush x:Key="ListViewItemBackgroundPointerOver" Color="Transparent" />
                        <SolidColorBrush x:Key="ListViewItemBackgroundPressed" Color="Transparent" />
                        <SolidColorBrush x:Key="ListViewItemBackgroundSelected" Color="Transparent" />
                        <SolidColorBrush x:Key="ListViewItemBackgroundSelectedPointerOver" Color="Transparent" />
                        <SolidColorBrush x:Key="ListViewItemBackgroundSelectedPressed" Color="Transparent" />
                    </ListView.Resources>
                    <ListView.ItemContainerStyle>
                        <Style TargetType="ListViewItem">
                            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                            <!-- 竖向也必须撑满：默认 Center 会让承载光斑的行 Border 比行矮一圈，
                                 上下留下不亮光斑的死区，鼠标从两行交界处掠过时完全没反应。 -->
                            <Setter Property="VerticalContentAlignment" Value="Stretch" />
                            <Setter Property="MinHeight" Value="64" />
                            <Setter Property="Padding" Value="0" />
                            <Setter Property="Margin" Value="0,1" />
                        </Style>
                    </ListView.ItemContainerStyle>
                    <ListView.ItemTemplate>
                        <DataTemplate x:DataType="rows:LocalVersionRow">
                            <Grid beh:HoverShadowBehavior.IsEnabled="True"
                                  beh:HoverShadowBehavior.Carrier="{Binding ElementName=VersionRowGlow}"
                                  ContextFlyout="{StaticResource RowMenu}">
                            <!-- 跟手光斑层铺满整行宽度（不带行内边距），圆角与行一致；内容再靠 Padding 让开
                                 （光斑若跟内容一起内缩，就会比行小一圈，外面露出框架底色 → 两层框）。
                                 竖向刻意内缩 4：悬停时光斑不贴行上下边缘，相邻两行之间留出可见留白。 -->
                            <Border x:Name="VersionRowGlow" CornerRadius="8"
                                    Margin="0,4"
                                    Opacity="0" IsHitTestVisible="False">
                                <Border.Background>
                                    <RadialGradientBrush Center="0.5,0.5" RadiusX="0.9" RadiusY="0.9">
                                        <GradientStop Color="#28000000" Offset="0" />
                                        <GradientStop Color="#1F000000" Offset="0.18" />
                                        <GradientStop Color="#16000000" Offset="0.40" />
                                        <GradientStop Color="#0D000000" Offset="0.62" />
                                        <GradientStop Color="#05000000" Offset="0.82" />
                                        <GradientStop Color="#00000000" Offset="1" />
                                    </RadialGradientBrush>
                                </Border.Background>
                            </Border>
                            <Grid Padding="12,8" ColumnSpacing="12">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />   <!-- 图标块 -->
                                    <ColumnDefinition Width="300" />    <!-- 版本名：固定列宽，右侧芯片/数值跨行对齐成列 -->
                                    <ColumnDefinition Width="*" />      <!-- 类型 / 类别 / 隔离 芯片 -->
                                    <ColumnDefinition Width="Auto" />   <!-- 上次启动 / 大小 -->
                                    <ColumnDefinition Width="Auto" />   <!-- 更多操作 -->
                                    <ColumnDefinition Width="Auto" />   <!-- 删除 -->
                                </Grid.ColumnDefinitions>
                                <Border Grid.Column="0" Width="32" Height="32" CornerRadius="8"
                                        VerticalAlignment="Center"
                                        Background="{ThemeResource SubtleFillColorSecondaryBrush}">
                                    <Grid>
                                        <Image Source="{x:Bind Icon}" Width="32" Height="32"
                                               Stretch="Uniform"
                                               Visibility="{x:Bind IconImageVisibility}" />
                                        <FontIcon FontFamily="{StaticResource ScIconFont}" Glyph="&#xEC62;" FontSize="14"
                                                  Visibility="{x:Bind IconFontVisibility}"
                                                  Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                    </Grid>
                                </Border>
                                <TextBlock Grid.Column="1" Text="{x:Bind Id}" FontWeight="Medium"
                                           VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                                <!-- 元信息芯片：类型 / 类别 / 隔离 同一套形态，跨行左对齐成列 -->
                                <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="6"
                                            VerticalAlignment="Center">
                                    <Border Style="{StaticResource ScChip}">
                                        <TextBlock Text="{x:Bind KindText}" Style="{StaticResource ScChipText}" />
                                    </Border>
                                    <Border Style="{StaticResource ScChip}"
                                            Visibility="{x:Bind CategoryVisibility}">
                                        <TextBlock Text="{x:Bind Category}" Style="{StaticResource ScChipText}" />
                                    </Border>
                                    <Border Style="{StaticResource ScChip}"
                                            Visibility="{x:Bind IsolatedVisibility}">
                                        <TextBlock loc:Loc.Text="版本隔离" Style="{StaticResource ScChipText}" />
                                    </Border>
                                </StackPanel>
                                <!-- 数据列：11px 标签 + 12px 数值，标签右对齐、数值定宽 → 跨行成列 -->
                                <Grid Grid.Column="3" ColumnSpacing="8" VerticalAlignment="Center"
                                      HorizontalAlignment="Right">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="64" />
                                    </Grid.ColumnDefinitions>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                    </Grid.RowDefinitions>
                                    <TextBlock Grid.Row="0" Grid.Column="0" HorizontalAlignment="Right"
                                               loc:Loc.Text="上次启动" Style="{StaticResource ScMetaLabel}" />
                                    <TextBlock Grid.Row="0" Grid.Column="1" HorizontalAlignment="Right"
                                               Text="{x:Bind LastPlayedText}" Style="{StaticResource ScMetaValue}" />
                                    <TextBlock Grid.Row="1" Grid.Column="0" HorizontalAlignment="Right"
                                               loc:Loc.Text="大小" Style="{StaticResource ScMetaLabel}" />
                                    <TextBlock Grid.Row="1" Grid.Column="1" HorizontalAlignment="Right"
                                               Text="{x:Bind SizeText}" Style="{StaticResource ScMetaValue}" />
                                </Grid>
                                <ctrl:GlowButton Grid.Column="4" VerticalAlignment="Center" Padding="6"
                                        Background="Transparent" BorderThickness="0"
                                        Flyout="{StaticResource RowMenu}"
                                        loc:Loc.Name="更多操作"
                                        loc:Loc.Tip="更多操作">
                                    <FontIcon FontFamily="{StaticResource ScIconFont}" Glyph="&#xEAA7;" FontSize="14"
                                              Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                </ctrl:GlowButton>
                                <!-- 删除保留独立快键（沿用旧交互） -->
                                <ctrl:GlowButton Grid.Column="5" VerticalAlignment="Center" Padding="6"
                                        Background="Transparent" BorderThickness="0" Click="Delete_Click"
                                        loc:Loc.Name="删除该版本"
                                        loc:Loc.Tip="删除该版本">
                                    <FontIcon FontFamily="{StaticResource ScIconFont}" Glyph="&#xEAA5;" FontSize="14"
                                              Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                </ctrl:GlowButton>
                            </Grid>
                            </Grid>
                        </DataTemplate>
                    </ListView.ItemTemplate>
                </ListView>
                <ctrl:EmptyStateView x:Name="EmptyHint" Visibility="Collapsed"
                                      HorizontalAlignment="Center" VerticalAlignment="Center"
                                      Glyph="&#xEA94;" />
            </Grid>
        </Border>
    </Grid>
</Page>
