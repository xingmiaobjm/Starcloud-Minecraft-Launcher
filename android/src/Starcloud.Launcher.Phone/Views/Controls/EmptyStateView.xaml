<?xml version="1.0" encoding="utf-8"?>
<UserControl
    x:Class="Starcloud.Launcher.Phone.Views.Controls.EmptyStateView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- 统一空状态：图标 + 标题 + 副标题 + 可选操作按钮（D2 设计 §7） -->
    <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="6">
        <FontIcon FontFamily="{StaticResource ScIconFont}" x:Name="Icon" FontSize="28" HorizontalAlignment="Center"
                  Foreground="{ThemeResource TextFillColorTertiaryBrush}" />
        <!-- 品牌标记类图标（Nova）：字形画不出多色标记，走 IconImage 换图片 -->
        <Image x:Name="IconPicture" Width="28" Height="28" HorizontalAlignment="Center"
               Visibility="Collapsed" />
        <TextBlock x:Name="TitleText" FontSize="14" FontWeight="Medium"
                   HorizontalAlignment="Center" TextAlignment="Center" TextWrapping="Wrap" />
        <TextBlock x:Name="SubtitleText" FontSize="12" HorizontalAlignment="Center"
                   TextAlignment="Center" TextWrapping="Wrap"
                   Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
        <!-- 默认折叠：显示与否由 ActionText 的变更回调决定（不设默认值会在无文案时留下 accent 空按钮） -->
        <Button x:Name="ActionButton" Visibility="Collapsed"
                Style="{StaticResource AccentButtonStyle}" FontWeight="Medium"
                HorizontalAlignment="Center" Margin="0,4,0,0"
                Click="ActionButton_Click" />
    </StackPanel>
</UserControl>
