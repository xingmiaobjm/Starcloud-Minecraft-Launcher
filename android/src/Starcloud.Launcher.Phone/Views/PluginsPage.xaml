<?xml version="1.0" encoding="utf-8"?>
<!-- 插件管理页（plugin-spec.md）：安装 .mclplug / 启用停用（免责确认） / 卸载 / 插件面板入口 -->
<Page
    x:Class="Starcloud.Launcher.Phone.Views.PluginsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:Starcloud.Launcher.Phone.Views"
    xmlns:beh="using:Starcloud.Launcher.Phone.Views.Behaviors"
    xmlns:ctrl="using:Starcloud.Launcher.Phone.Views.Controls"
    xmlns:loc="using:Starcloud.Launcher.Phone.Localization"
    NavigationCacheMode="Enabled">

    <Grid MaxWidth="1280" HorizontalAlignment="Stretch">
        <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="0,0,8,0">
            <StackPanel Spacing="16">

                <!-- 页头 -->
                <Grid ColumnSpacing="12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <Button x:Name="InstallBtn" Grid.Column="1" loc:Loc.Text="安装插件…"
                            Style="{StaticResource AccentButtonStyle}" FontWeight="Medium"
                            MinWidth="120" VerticalAlignment="Center" Click="Install_Click" />
                </Grid>

                <!-- 免责声明（规范 §4 §7）：看过一次后不再常驻 -->
                <InfoBar x:Name="DisclaimerBar" IsOpen="True" IsClosable="True" Severity="Warning"
                         loc:Loc.Title="插件由第三方独立开发"
                         loc:Loc.Message="启动器本体不对插件内容、合法性负责；插件无权修改游戏认证、UUID 与登录校验逻辑。加载第三方插件前会再次向你确认。" />

                <!-- 插件面板（launcher:ui_panel 注册） -->
                <Border Background="{ThemeResource GlassCardBrush}"
                        BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                        BorderThickness="1" CornerRadius="16" Padding="16"
                        Visibility="{x:Bind PanelsCardVisible, Mode=OneWay}">
                    <StackPanel Spacing="8">
                        <TextBlock loc:Loc.Text="插件面板" FontWeight="Medium" FontSize="13" />
                        <ItemsControl ItemsSource="{x:Bind PanelRows, Mode=OneWay}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate x:DataType="local:PluginPanelRow">
                                    <ctrl:GlowButton Margin="0,2,6,2" Padding="12,6" Click="OpenPanel_Click"
                                            Tag="{x:Bind Id}">
                                        <StackPanel Orientation="Horizontal" Spacing="8">
                                            <FontIcon FontFamily="{StaticResource ScIconFont}" Glyph="&#xEABC;" FontSize="14"
                                                      Foreground="{ThemeResource BrandBlueBrush}" />
                                            <TextBlock Text="{x:Bind Title}" VerticalAlignment="Center" />
                                            <TextBlock Text="{x:Bind PluginName}" FontSize="11"
                                                       Opacity="0.6" VerticalAlignment="Center" />
                                        </StackPanel>
                                    </ctrl:GlowButton>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </Border>

                <!-- 已安装插件 -->
                <Border Background="{ThemeResource GlassCardBrush}"
                        BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                        BorderThickness="1" CornerRadius="16" Padding="16">
                    <StackPanel Spacing="8">
                        <TextBlock loc:Loc.Text="已安装" FontWeight="Medium" FontSize="13" />
                        <ListView x:Name="PluginList" SelectionMode="None">
                            <ListView.Resources>
                                <!-- 悬停/选中反馈只由控件模板里那三层表达，框架整行底色一律关掉
                                     （框架给的是硬边直角矩形，压上圆角光斑后四个角互相啃掉一块） -->
                                <SolidColorBrush x:Key="ListViewItemBackground" Color="Transparent" />
                                <SolidColorBrush x:Key="ListViewItemBackgroundPointerOver" Color="Transparent" />
                                <SolidColorBrush x:Key="ListViewItemBackgroundPressed" Color="Transparent" />
                                <SolidColorBrush x:Key="ListViewItemBackgroundSelected" Color="Transparent" />
                                <SolidColorBrush x:Key="ListViewItemBackgroundSelectedPointerOver" Color="Transparent" />
                                <SolidColorBrush x:Key="ListViewItemBackgroundSelectedPressed" Color="Transparent" />
                            </ListView.Resources>
                            <!-- Uno 未实现 ItemContainerTransitions：安装/卸载后的行增删/让位转场省略
                                 （与「动效可关」公约一致） -->
                            <ListView.ItemContainerStyle>
                                <Style TargetType="ListViewItem">
                                    <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                                    <!-- 竖向也必须撑满：默认 Center 会让承载光斑的卡片 Border 比行矮一圈，
                                         上下留下不亮光斑的死区，鼠标从两卡交界处掠过时完全没反应。 -->
                                    <Setter Property="VerticalContentAlignment" Value="Stretch" />
                                    <Setter Property="MinHeight" Value="0" />
                                    <Setter Property="Padding" Value="0" />
                                    <Setter Property="Margin" Value="0,2" />
                                </Style>
                            </ListView.ItemContainerStyle>
                            <ListView.ItemTemplate>
                                <DataTemplate x:DataType="local:PluginRow">
                                    <Grid CornerRadius="8"
                                          Background="{ThemeResource LayerFillColorDefaultBrush}"
                                          beh:HoverShadowBehavior.IsEnabled="True"
                                          beh:HoverShadowBehavior.Carrier="{Binding ElementName=PluginCardGlow}">
                                        <!-- 跟随光标的卡片光斑：铺满整卡（不带内边距），圆角与卡片一致；
                                             内容再靠内层的 Padding 让开，否则光斑会被排布到内边距里、比卡片小一圈 -->
                                        <Border x:Name="PluginCardGlow" CornerRadius="8"
                                                Opacity="0" IsHitTestVisible="False">
                                            <Border.Background>
                                                <RadialGradientBrush Center="0.5,0.5" RadiusX="0.9" RadiusY="0.9">
                                                    <GradientStop Color="#28000000" Offset="0" />
                                                    <GradientStop Color="#1F000000" Offset="0.18" />
                                                    <GradientStop Color="#16000000" Offset="0.40" />
                                                    <GradientStop Color="#0D000000" Offset="0.62" />
                                                    <GradientStop Color="#05000000" Offset="0.82" />
                                                    <GradientStop Color="#00000000" Offset="1" />
                                                </RadialGradientBrush>
                                            </Border.Background>
                                        </Border>
                                        <Grid ColumnSpacing="12" Padding="12,10">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <StackPanel Grid.Column="0" Spacing="2">
                                                <StackPanel Orientation="Horizontal" Spacing="6">
                                                    <TextBlock Text="{x:Bind Name}" FontWeight="Medium" />
                                                    <TextBlock Text="{x:Bind Version}" FontSize="11" Opacity="0.65"
                                                               VerticalAlignment="Center" />
                                                    <Border Style="{StaticResource ScChipAccent}"
                                                            Visibility="{x:Bind OfficialVisibility}">
                                                        <TextBlock loc:Loc.Text="官方"
                                                                   Style="{StaticResource ScChipAccentText}" />
                                                    </Border>
                                                    <!-- 提示芯片：与版本页的类型/隔离芯片同一套形态（App.xaml 视觉基元），
                                                         语义色只说"需要留意"，不做成错误 -->
                                                    <Border Style="{StaticResource ScChipCaution}"
                                                            Visibility="{x:Bind UnverifiedVisibility}">
                                                        <TextBlock loc:Loc.Text="第三方未验证"
                                                                   Style="{StaticResource ScChipCautionText}" />
                                                    </Border>
                                                    <!-- API 版本芯片（规范 2.0）：文案在代码里由 Loc.T 拼好（含「暂不可启用」），
                                                         这里用 Text 绑定而非 loc:Loc，因为值是运行时决定的 -->
                                                    <Border Style="{StaticResource ScChip}"
                                                            Visibility="{x:Bind ApiChipVisibility}">
                                                        <TextBlock Text="{x:Bind ApiChip}"
                                                                   Style="{StaticResource ScChipText}" />
                                                    </Border>
                                                </StackPanel>
                                                <TextBlock Text="{x:Bind Description}" FontSize="12"
                                                           TextWrapping="Wrap" Opacity="0.75"
                                                           Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                                <TextBlock Text="{x:Bind Detail}" FontSize="11" TextWrapping="Wrap"
                                                           Foreground="{ThemeResource TextFillColorTertiaryBrush}" />
                                            </StackPanel>
                                            <ctrl:GlowButton Grid.Column="1" loc:Loc.Text="打开面板" FontSize="12"
                                                    Padding="10,4" VerticalAlignment="Center"
                                                    Visibility="{x:Bind PanelsVisibility}"
                                                    Tag="{x:Bind Id}" Click="OpenPanel_Click" />
                                            <ctrl:GlowButton Grid.Column="2" loc:Loc.Text="卸载" FontSize="12"
                                                    Padding="10,4" VerticalAlignment="Center"
                                                    Tag="{x:Bind Id}" Click="Uninstall_Click" />
                                            <!-- 行对象每次刷新都重建，OneTime 即可（回写由 Toggled 事件走服务层） -->
                                            <ToggleSwitch Grid.Column="3" MinWidth="0" Margin="4,0,0,0"
                                                          OnContent="" OffContent=""
                                                          IsOn="{x:Bind Enabled}"
                                                          Toggled="PluginToggle_Toggled" Tag="{x:Bind Id}" />
                                        </Grid>
                                    </Grid>
                                </DataTemplate>
                            </ListView.ItemTemplate>
                        </ListView>
                        <ctrl:EmptyStateView x:Name="EmptyText" HorizontalAlignment="Left"
                                              Glyph="&#xEABC;"
                                              loc:Loc.Title="还没有安装插件" />
                    </StackPanel>
                </Border>

                <!-- 放置说明：原先在卡片最后一行，读起来像卡片内容的一部分；
                     挪到卡片外当页面注脚，形态与空状态提示一致 -->
                <TextBlock loc:Loc.Text="把 .mclplug 文件放到这里：点「安装插件…」选择插件包，安装后打开开关启用。"
                           FontSize="12" TextWrapping="Wrap" Margin="4,0,0,0"
                           Foreground="{ThemeResource TextFillColorTertiaryBrush}" />

                <!-- 安装结果提示 -->
                <InfoBar x:Name="NotifyBar" IsOpen="False" IsClosable="True" Severity="Success" />
            </StackPanel>
        </ScrollViewer>
    </Grid>
</Page>
