<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="Starcloud.Launcher.Phone.Views.LogsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:ctrl="using:Starcloud.Launcher.Phone.Views.Controls"
    xmlns:beh="using:Starcloud.Launcher.Phone.Views.Behaviors"
    xmlns:loc="using:Starcloud.Launcher.Phone.Localization"
    NavigationCacheMode="Enabled">

    <Grid MaxWidth="1280" HorizontalAlignment="Stretch" RowSpacing="16">
        <!-- 内容行必须是 * ：日志卡片落在 Auto 行上时 ScrollViewer 的视口等于内容高度，
             整页会被父容器裁掉且滚不动（删掉页面抬头后漏改过这里） -->
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- 来源切换（选项文案在 code-behind 按语言重建，见 LogsPage.xaml.cs）
             手机版：RadioButtons + 240 宽日志下拉 + 目录按钮的横排在竖屏放不下，改竖排 ——
             来源单选一行，游戏日志下拉（整宽拉伸）与目录按钮一行 -->
        <StackPanel Grid.Row="0" Spacing="8">
            <RadioButtons x:Name="LogSource" MaxColumns="2"
                          SelectionChanged="LogSource_SelectionChanged">
            </RadioButtons>
            <Grid ColumnSpacing="8">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <ComboBox x:Name="GameLogCombo" MinWidth="240" Visibility="Collapsed"
                          HorizontalAlignment="Stretch"
                          loc:Loc.Placeholder="选择一局游戏日志" SelectionChanged="GameLogCombo_SelectionChanged" />
                <ctrl:GlowButton x:Name="OpenLogDirBtn" Grid.Column="1" loc:Loc.Text="打开日志目录" Click="OpenLogDir_Click" />
            </Grid>
        </StackPanel>

        <Border Grid.Row="1" Background="{ThemeResource GlassCardBrush}"
                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                BorderThickness="1" CornerRadius="16" Padding="12">
            <!-- 日志正文不换行：一行日志就是一行（时间戳 / 类别 / 正文三列才对得齐），
                长行走横向滚动。顺带省掉换行排版——400 行折行文本的测量是这类页面的主要开销。 -->
            <ScrollViewer x:Name="LogScroll" HorizontalScrollBarVisibility="Auto">
                <TextBlock x:Name="LogText" FontFamily="Cascadia Code" FontSize="12"
                           IsTextSelectionEnabled="True" TextWrapping="NoWrap" />
            </ScrollViewer>
        </Border>
    </Grid>
</Page>
