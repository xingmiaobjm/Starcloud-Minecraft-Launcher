<?xml version="1.0" encoding="utf-8"?>
<!--
  首页 · 手机版（横屏卡片贴边布局）：由平板版（Starcloud.Launcher.Uno）重排而来。
  与平板版（双列 + 卡片收起/展开补间 + MaxWidth 1280 居中）的差异：
    · 双列卡片直接贴边撑满视口（无 MaxWidth 居中）：左列通知/插件区 + 版本库，
      右列账户/启动卡与内容区同高；
    · 去掉两栏卡片的收起/展开动画与窄条 Dock（手机横屏高度有限，卡片按列铺满）；
    · 账户区改横排紧凑（头像 44 + 切换按钮常显——触屏无悬停浮现）；
    · 版本行名称列交给 * 自适应；启动页覆盖层固定宽改 MaxWidth + 拉伸。
-->
<Page
    x:Class="Starcloud.Launcher.Phone.Views.HomePage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:Starcloud.Launcher.Phone.Views"
    xmlns:beh="using:Starcloud.Launcher.Phone.Views.Behaviors"
    xmlns:ctrl="using:Starcloud.Launcher.Phone.Views.Controls"
    xmlns:rows="using:Starcloud.Launcher.Phone.Views.Rows"
    xmlns:loc="using:Starcloud.Launcher.Phone.Localization"
    NavigationCacheMode="Enabled">

    <Page.Resources>
        <!-- 版本行模板：与平板版同一份语汇（图标 / 芯片 / 上次启动 / 大小 / 长按菜单），
             差异只有名称列：平板写死 260 保证两栏对齐，手机交给 * 自适应。 -->
        <DataTemplate x:Key="VersionRowTemplate" x:DataType="rows:LocalVersionRow">
            <Border CornerRadius="8"
                    beh:HoverShadowBehavior.IsEnabled="True"
                    beh:HoverShadowBehavior.Carrier="{Binding ElementName=VersionRowGlow}"
                    RightTapped="VersionRow_RightTapped">
                <Border.ContextFlyout>
                    <MenuFlyout>
                        <MenuFlyoutItem loc:Loc.Text="问 Nova"
                                        Tag="{x:Bind Id}"
                                        Click="AskNova_Click">
                            <MenuFlyoutItem.Icon>
                                <ImageIcon Source="{StaticResource NovaMarkSmall}" />
                            </MenuFlyoutItem.Icon>
                        </MenuFlyoutItem>
                        <MenuFlyoutSeparator />
                        <MenuFlyoutItem loc:Loc.Text="版本详情"
                                        Tag="{x:Bind Id}"
                                        Click="VersionDetail_Click">
                            <MenuFlyoutItem.Icon>
                                <FontIcon FontFamily="{StaticResource ScIconFont}" Glyph="&#xEBA0;" />
                            </MenuFlyoutItem.Icon>
                        </MenuFlyoutItem>
                        <MenuFlyoutItem loc:Loc.Text="打开游戏目录"
                                        Tag="{x:Bind Id}"
                                        Click="OpenVersionFolder_Click">
                            <MenuFlyoutItem.Icon>
                                <FontIcon FontFamily="{StaticResource ScIconFont}" Glyph="&#xEA90;" />
                            </MenuFlyoutItem.Icon>
                        </MenuFlyoutItem>
                        <MenuFlyoutItem loc:Loc.Text="删除此版本"
                                        Tag="{x:Bind Id}"
                                        Click="DeleteVersion_Click">
                            <MenuFlyoutItem.Icon>
                                <FontIcon FontFamily="{StaticResource ScIconFont}" Glyph="&#xEAA5;" />
                            </MenuFlyoutItem.Icon>
                        </MenuFlyoutItem>
                    </MenuFlyout>
                </Border.ContextFlyout>
                <Grid>
                    <!-- 跟随光标的卡片内阴影：只画落在本行内的那一段（文字在它之上） -->
                    <Border x:Name="VersionRowGlow" CornerRadius="8"
                            Margin="0,4"
                            Opacity="0" IsHitTestVisible="False">
                        <Border.Background>
                            <RadialGradientBrush Center="0.5,0.5" RadiusX="0.9" RadiusY="0.9">
                                <GradientStop Color="#28000000" Offset="0" />
                                <GradientStop Color="#1F000000" Offset="0.18" />
                                <GradientStop Color="#16000000" Offset="0.40" />
                                <GradientStop Color="#0D000000" Offset="0.62" />
                                <GradientStop Color="#05000000" Offset="0.82" />
                                <GradientStop Color="#00000000" Offset="1" />
                            </RadialGradientBrush>
                        </Border.Background>
                    </Border>
                    <Grid Padding="10,8" ColumnSpacing="12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <!-- 名称列：手机版不再写死 260，交给 * 自适应（超长省略号截断） -->
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <!-- 版本方块图标块：加载器图标优先，原版按类型；取不到图标时留空底块 -->
                        <Border Width="24" Height="24" CornerRadius="6"
                                Background="{ThemeResource SubtleFillColorSecondaryBrush}">
                            <Grid>
                                <Image Source="{x:Bind Icon}" Width="24" Height="24"
                                       Stretch="Uniform" />
                                <FontIcon FontFamily="{StaticResource ScIconFont}" Glyph="&#xEC62;" FontSize="14"
                                          Visibility="{x:Bind IconFontVisibility}"
                                          Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                            </Grid>
                        </Border>
                        <TextBlock Grid.Column="1" Text="{x:Bind Id}" FontWeight="Medium"
                                   VerticalAlignment="Center"
                                   TextTrimming="CharacterEllipsis" />
                        <!-- 元信息芯片：类型 / 类别（手机竖屏宽度紧，芯片列与名称列同排，超宽时收进省略号） -->
                        <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="6"
                                    VerticalAlignment="Center">
                            <Border Style="{StaticResource ScChip}">
                                <TextBlock Text="{x:Bind KindText}"
                                           Style="{StaticResource ScChipText}" />
                            </Border>
                            <Border Style="{StaticResource ScChip}"
                                    Visibility="{x:Bind CategoryVisibility}">
                                <TextBlock Text="{x:Bind Category}"
                                           Style="{StaticResource ScChipText}" />
                            </Border>
                        </StackPanel>
                    </Grid>
                </Grid>
            </Border>
        </DataTemplate>
    </Page.Resources>

    <!-- 根节点两层：HomeContent（主页双列贴边卡片）+ LaunchOverlay（启动页覆盖层，见文件尾） -->
    <Grid>
        <!-- 手机版横屏卡片贴边布局：无 MaxWidth 居中，两列直接撑满视口 ——
             左列 = 通知/自检 + 插件挂载区/卡片带 + 版本库（撑满余高，列表卡内滚动）；
             右列 = 账户/启动卡（与内容区同高，启动 CTA 常驻可见）。
             P40 Pro 横屏约 960×436 逻辑：右列 340 后左列约 570，版本行两列信息都放得下。 -->
        <Grid x:Name="HomeContent" HorizontalAlignment="Stretch">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="168" />
            </Grid.ColumnDefinitions>

            <!-- ═══ 账户/启动卡（右列）：分段条 + 账户横排 + 启动大 CTA（与内容区同高，贴边撑满） ═══ -->
            <Border x:Name="AccountCard" Grid.Column="1"
                    Background="{ThemeResource GlassCardBrush}"
                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                    BorderThickness="1" CornerRadius="10" Padding="6">
                <!-- 行间距走元素级 Margin 而不是 Grid.RowSpacing：状态文字（Row3）收起成 Collapsed
                     时不露一份空行距（与平板版同理由）。账户区（Row1）取 *：卡片同高时头像块弹性居中。 -->
                <Grid x:Name="CardBody">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <!-- 账户模式：正版 / 第三方外置 / 离线（与平板版同一套分段控件语汇：
                         外框圆角 10、内缩 2，三段等宽无边框，选中态是品牌色药丸 + 黑字，指示器随点击平移；
                         药丸位置由 ModeGrid_SizeChanged 按实测宽度分配，语言切换不跑偏）。 -->
                    <Border x:Name="ModeBar" Grid.Row="0"
                            Background="{ThemeResource ControlFillColorSecondaryBrush}"
                            BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                            BorderThickness="1" CornerRadius="10" Padding="2"
                            beh:HoverShadowBehavior.IsEnabled="True"
                            beh:HoverShadowBehavior.Carrier="{Binding ElementName=ModeBarGlow}"
                            beh:HoverShadowBehavior.GlowRadius="30">
                        <Grid x:Name="ModeGrid" SizeChanged="ModeGrid_SizeChanged">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <!-- 跟手光斑：只画落在分段条内的那一段（触屏上作为按下反馈仍然有效） -->
                            <Border x:Name="ModeBarGlow" CornerRadius="7"
                                    Grid.ColumnSpan="3"
                                    Opacity="0" IsHitTestVisible="False">
                                <Border.Background>
                                    <RadialGradientBrush Center="0.5,0.5" RadiusX="0.9" RadiusY="0.9">
                                        <GradientStop Color="#28000000" Offset="0" />
                                        <GradientStop Color="#1F000000" Offset="0.18" />
                                        <GradientStop Color="#16000000" Offset="0.40" />
                                        <GradientStop Color="#0D000000" Offset="0.62" />
                                        <GradientStop Color="#05000000" Offset="0.82" />
                                        <GradientStop Color="#00000000" Offset="1" />
                                    </RadialGradientBrush>
                                </Border.Background>
                            </Border>
                            <!-- 选中指示器：品牌强调色药丸，位置由合成动画平移（260ms / 进场曲线） -->
                            <Border x:Name="ModeIndicator" Height="24" CornerRadius="4"
                                    Grid.ColumnSpan="3"
                                    HorizontalAlignment="Left" VerticalAlignment="Center"
                                    IsHitTestVisible="False"
                                    Background="{ThemeResource AccentFillColorDefaultBrush}" />
                            <ToggleButton x:Name="ModeMsBtn" Tag="microsoft"
                                          Grid.Column="0" Height="24" Padding="0" MinWidth="0"
                                          HorizontalAlignment="Stretch"
                                          FontSize="11" CornerRadius="5" BorderThickness="0"
                                          Background="Transparent"
                                          Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                          loc:Loc.Text="正版" loc:Loc.Name="正版"
                                          Click="ModeMs_Click">
                                <ToggleButton.Resources>
                                    <SolidColorBrush x:Key="ToggleButtonBackgroundPointerOver" Color="Transparent" />
                                    <SolidColorBrush x:Key="ToggleButtonBackgroundPressed" Color="Transparent" />
                                    <SolidColorBrush x:Key="ToggleButtonBackgroundChecked" Color="Transparent" />
                                    <SolidColorBrush x:Key="ToggleButtonBackgroundCheckedPointerOver" Color="Transparent" />
                                    <SolidColorBrush x:Key="ToggleButtonBackgroundCheckedPressed" Color="Transparent" />
                                    <SolidColorBrush x:Key="ToggleButtonBorderBrushChecked" Color="Transparent" />
                                    <SolidColorBrush x:Key="ToggleButtonForegroundChecked" Color="#E61A1A1A" />
                                    <SolidColorBrush x:Key="ToggleButtonForegroundCheckedPointerOver" Color="#E61A1A1A" />
                                    <SolidColorBrush x:Key="ToggleButtonForegroundCheckedPressed" Color="#E61A1A1A" />
                                </ToggleButton.Resources>
                            </ToggleButton>
                            <ToggleButton x:Name="ModeExternalBtn" Tag="external"
                                          Grid.Column="1" Height="24" Padding="0" MinWidth="0"
                                          HorizontalAlignment="Stretch"
                                          FontSize="11" CornerRadius="5" BorderThickness="0"
                                          Background="Transparent"
                                          Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                          loc:Loc.Text="外置" loc:Loc.Name="外置"
                                          Click="ModeExternal_Click">
                                <ToggleButton.Resources>
                                    <SolidColorBrush x:Key="ToggleButtonBackgroundPointerOver" Color="Transparent" />
                                    <SolidColorBrush x:Key="ToggleButtonBackgroundPressed" Color="Transparent" />
                                    <SolidColorBrush x:Key="ToggleButtonBackgroundChecked" Color="Transparent" />
                                    <SolidColorBrush x:Key="ToggleButtonBackgroundCheckedPointerOver" Color="Transparent" />
                                    <SolidColorBrush x:Key="ToggleButtonBackgroundCheckedPressed" Color="Transparent" />
                                    <SolidColorBrush x:Key="ToggleButtonBorderBrushChecked" Color="Transparent" />
                                    <SolidColorBrush x:Key="ToggleButtonForegroundChecked" Color="#E61A1A1A" />
                                    <SolidColorBrush x:Key="ToggleButtonForegroundCheckedPointerOver" Color="#E61A1A1A" />
                                    <SolidColorBrush x:Key="ToggleButtonForegroundCheckedPressed" Color="#E61A1A1A" />
                                </ToggleButton.Resources>
                            </ToggleButton>
                            <ToggleButton x:Name="ModeOfflineBtn" Tag="offline"
                                          Grid.Column="2" Height="24" Padding="0" MinWidth="0"
                                          HorizontalAlignment="Stretch"
                                          FontSize="11" CornerRadius="5" BorderThickness="0"
                                          Background="Transparent"
                                          Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                          loc:Loc.Text="离线" loc:Loc.Name="离线"
                                          Click="ModeOffline_Click">
                                <ToggleButton.Resources>
                                    <SolidColorBrush x:Key="ToggleButtonBackgroundPointerOver" Color="Transparent" />
                                    <SolidColorBrush x:Key="ToggleButtonBackgroundPressed" Color="Transparent" />
                                    <SolidColorBrush x:Key="ToggleButtonBackgroundChecked" Color="Transparent" />
                                    <SolidColorBrush x:Key="ToggleButtonBackgroundCheckedPointerOver" Color="Transparent" />
                                    <SolidColorBrush x:Key="ToggleButtonBackgroundCheckedPressed" Color="Transparent" />
                                    <SolidColorBrush x:Key="ToggleButtonBorderBrushChecked" Color="Transparent" />
                                    <SolidColorBrush x:Key="ToggleButtonForegroundChecked" Color="#E61A1A1A" />
                                    <SolidColorBrush x:Key="ToggleButtonForegroundCheckedPointerOver" Color="#E61A1A1A" />
                                    <SolidColorBrush x:Key="ToggleButtonForegroundCheckedPressed" Color="#E61A1A1A" />
                                </ToggleButton.Resources>
                            </ToggleButton>
                        </Grid>
                    </Border>

                    <!-- 账户横排：头像 + 账户名 + 切换按钮（与平板版 72 头像竖排居中的差异：
                         竖屏按行分配，头像缩到 44、切换按钮常显——触屏没有悬停浮现的时机）。 -->
                    <StackPanel x:Name="AccountArea" Grid.Row="1" Margin="0,6,0,0" Spacing="5">
                        <Grid ColumnSpacing="12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <Border Grid.Column="0" Width="28" Height="28" CornerRadius="7"
                                    VerticalAlignment="Center"
                                    Background="{ThemeResource AccentFillColorDefaultBrush}">
                                <Grid>
                                    <!-- 首字母兜底：未选账户 / 无网络 / 名字不存在时可见 -->
                                    <TextBlock x:Name="AvatarText" Text="?" FontSize="14" FontWeight="Medium"
                                               Foreground="{ThemeResource TextOnAccentFillColorPrimaryBrush}"
                                               HorizontalAlignment="Center" VerticalAlignment="Center" />
                                    <!-- 皮肤头像覆盖在色块上；加载失败不渲染，即露出下面的首字母 -->
                                    <Image x:Name="AvatarImage" Stretch="UniformToFill" />
                                </Grid>
                            </Border>
                            <TextBlock x:Name="AccountNameText" Grid.Column="1"
                                       loc:Loc.Text="未选择账户" FontWeight="Medium" FontSize="12"
                                       VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                            <!-- 切换账号：去账户页（手机版常显，无悬停浮现） -->
                            <ctrl:GlowButton x:Name="SwitchAccountBtn" Grid.Column="2"
                                    MinWidth="0" Height="24" Padding="8,0" FontSize="11"
                                    VerticalAlignment="Center" CornerRadius="8"
                                    loc:Loc.Text="切换" loc:Loc.Name="切换账号"
                                    Click="SwitchAccount_Click" />
                        </Grid>
                        <!-- 该模式还没有账户时不摆一句「尚无正版账户」堵在那里，直接给登录入口：
                             点开就地弹对应方式的登录框，登录成功即刷新上面这张卡（见 RefreshAccounts）。 -->
                        <ctrl:GlowButton x:Name="NoAccountBtn" Height="26"
                                HorizontalAlignment="Stretch" Visibility="Collapsed"
                                Click="NoAccountBtn_Click" />
                    </StackPanel>

                    <!-- 启动行：60 高的大 CTA 占卡片整宽（手机版不再挂右侧收起刻度）。
                         里面竖直摆两行：上面「播放/停止轮廓 + 启动游戏」，下面一行是当前选中版本名。 -->
                    <Grid Grid.Row="2" Margin="0,8,0,0">
                        <Button x:Name="LaunchBtn" HorizontalAlignment="Stretch" Height="36"
                                Style="{StaticResource AccentButtonStyle}" CornerRadius="9"
                                loc:Loc.Name="启动游戏"
                                Click="LaunchBtn_Click">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>
                                <StackPanel Grid.Row="0" Orientation="Horizontal" Spacing="8" HorizontalAlignment="Center">
                                    <!-- 轮廓播放/停止标记：自绘轮廓（形状与字形一致、不填充），
                                         切换播放/停止时不会跳位（与平板版同一份几何） -->
                                    <Grid VerticalAlignment="Center">
                                        <Path x:Name="LaunchPlayIcon" Data="M 2.6,0.3 L 13.65,6.15 L 2.6,11.99 Z"
                                              Stroke="{Binding Foreground, ElementName=LaunchBtn}"
                                              StrokeThickness="2" StrokeLineJoin="Round" Fill="Transparent" />
                                        <Path x:Name="LaunchStopIcon" Data="M 1.6,1.6 H 10.7 V 10.7 H 1.6 Z"
                                              Stroke="{Binding Foreground, ElementName=LaunchBtn}"
                                              StrokeThickness="2" StrokeLineJoin="Round" Fill="Transparent"
                                              Visibility="Collapsed" />
                                    </Grid>
                                    <!-- 黄底按钮上的文字一律跟随按钮 Foreground，不写死颜色 -->
                                    <TextBlock x:Name="LaunchTitleText" loc:Loc.Text="启动游戏" FontWeight="Medium" FontSize="12"
                                               Foreground="{Binding Foreground, ElementName=LaunchBtn}" />
                                </StackPanel>
                                <!-- 当前选中版本名：次级信息，空版本用「未选择版本」兜底 -->
                                <TextBlock x:Name="LaunchBtnVersionText" Grid.Row="1" Margin="0,0,0,0"
                                           loc:Loc.Text="未选择版本"
                                           FontSize="11" Opacity="0.72"
                                           TextTrimming="CharacterEllipsis"
                                           HorizontalAlignment="Center"
                                           Foreground="{Binding Foreground, ElementName=LaunchBtn}" />
                            </Grid>
                        </Button>
                    </Grid>

                    <!-- 进度与状态（仅启动链回写状态时出现） -->
                    <TextBlock x:Name="StatusText" Grid.Row="3" Margin="0,14,0,0" FontSize="12" TextAlignment="Center"
                               Visibility="Collapsed"
                               Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextWrapping="Wrap" />
                </Grid>
            </Border>

            <!-- ═══ 左列：通知/自检 → 插件挂载区/卡片带 → 版本库（撑满余高） ═══
                 行间距走元素级 Margin：通知区整块收起（Collapsed）时不照收一份 RowSpacing，
                 版本卡才能贴齐上方内容（与平板版同理由）。 -->
            <Grid Grid.Column="0" Margin="0,0,16,0">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

            <!-- ═══ 通知区：三张通知条 + 启动自检卡（全不可见时整块收成 Collapsed，不参与布局） ═══ -->
            <StackPanel x:Name="LeftNoticeArea" Grid.Row="0" Spacing="5" Margin="0,0,0,8" Visibility="Collapsed">
                <InfoBar x:Name="GlobalErrorBar" Severity="Error" IsOpen="False" IsClosable="True"
                         loc:Loc.Title="启动出错" />
                <InfoBar x:Name="LocalErrorBar" Severity="Error" IsOpen="False" IsClosable="True"
                         loc:Loc.Title="操作失败" />
                <InfoBar x:Name="WarnBar" Severity="Warning" IsOpen="False" IsClosable="True"
                         loc:Loc.Title="提示" />

                <!-- 启动自检：版本 / 账户 / Java，未就绪项可一键跳转 -->
                <Border x:Name="CheckCard" Visibility="Collapsed"
                        Background="{ThemeResource GlassCardBrush}"
                        BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                        BorderThickness="1" CornerRadius="8" Padding="12">
                    <StackPanel Spacing="2">
                        <Grid Margin="0,0,0,6" ColumnSpacing="8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBlock loc:Loc.Text="启动自检" FontWeight="Medium" FontSize="12"
                                       VerticalAlignment="Center" />
                            <ctrl:GlowButton Grid.Column="1" Padding="5" MinWidth="24" MinHeight="24"
                                    Background="Transparent" BorderThickness="0"
                                    Click="Recheck_Click" loc:Loc.Name="重新检测" loc:Loc.Tip="重新检测">
                                <FontIcon FontFamily="{StaticResource ScIconFont}" Glyph="&#xE918;" FontSize="14" />
                            </ctrl:GlowButton>
                        </Grid>
                        <Grid MinHeight="24" ColumnSpacing="6">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <FontIcon FontFamily="{StaticResource ScIconFont}" x:Name="CheckIconVersion" Glyph="&#xEA7C;" FontSize="14"
                                      VerticalAlignment="Center" />
                            <TextBlock x:Name="CheckTextVersion" Grid.Column="1" FontSize="12"
                                       VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                            <HyperlinkButton x:Name="CheckGoVersion" Grid.Column="2" Padding="0"
                                             MinHeight="0" FontSize="12"
                                             Click="CheckGoVersion_Click" />
                        </Grid>
                        <Grid MinHeight="24" ColumnSpacing="6">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <FontIcon FontFamily="{StaticResource ScIconFont}" x:Name="CheckIconAccount" Glyph="&#xEA7C;" FontSize="14"
                                      VerticalAlignment="Center" />
                            <TextBlock x:Name="CheckTextAccount" Grid.Column="1" FontSize="12"
                                       VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                            <HyperlinkButton x:Name="CheckGoAccount" Grid.Column="2" Padding="0"
                                             MinHeight="0" FontSize="12"
                                             Click="CheckGoAccount_Click" />
                        </Grid>
                        <Grid MinHeight="24" ColumnSpacing="6">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <FontIcon FontFamily="{StaticResource ScIconFont}" x:Name="CheckIconJava" Glyph="&#xEA7C;" FontSize="14"
                                      VerticalAlignment="Center" />
                            <TextBlock x:Name="CheckTextJava" Grid.Column="1" FontSize="12"
                                       VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                            <HyperlinkButton x:Name="CheckGoJava" Grid.Column="2" Padding="0"
                                             MinHeight="0" FontSize="12"
                                             Click="CheckGoJava_Click" />
                        </Grid>
                    </StackPanel>
                </Border>
            </StackPanel>

            <!-- 插件挂载区（home.top）：装在通知区与版本卡之间，没贡献时不占高度 -->
            <ctrl:PluginContributionPanel Grid.Row="1" Point="home.top" Margin="0,0,0,8" />

            <!-- 插件首页卡片带（homeCards）：固定 120 高、最多 3 张。
                 没装插件时整块 Collapsed，版本卡贴齐上方内容。 -->
            <ctrl:HomeCardStrip x:Name="HomeCards" Grid.Row="2" Margin="0,0,0,8" />

            <!-- ═══ 版本库卡（左列）：撑满余下整格，列表在卡内滚动（手机版没有收起态，卡头只留标题/计数/刷新） ═══ -->
            <Border x:Name="VersionCard" Grid.Row="3"
                    Background="{ThemeResource GlassCardBrush}"
                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                    BorderThickness="1" CornerRadius="12"
                    Padding="8">
                <Grid x:Name="VersionCardBody">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <!-- 卡头：标题 + 已安装数量 + 刷新 -->
                    <Grid x:Name="VersionHeader" Grid.Row="0" Padding="6,2,0,2" Margin="0,0,0,8" ColumnSpacing="8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock loc:Loc.Text="已安装版本" FontWeight="Medium" FontSize="12"
                                   VerticalAlignment="Center" />
                        <Border Grid.Column="1" CornerRadius="5" Padding="6,1" VerticalAlignment="Center"
                                Background="{ThemeResource SubtleFillColorSecondaryBrush}">
                            <TextBlock x:Name="VersionCountText" Text="(0)" FontSize="11"
                                       Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                        </Border>
                        <ctrl:GlowButton x:Name="RefreshVersionsBtn" Grid.Column="3" Padding="5" MinWidth="24" MinHeight="24"
                                Background="Transparent" BorderThickness="0"
                                Click="RefreshVersionsBtn_Click" loc:Loc.Name="刷新列表" loc:Loc.Tip="刷新列表">
                            <FontIcon FontFamily="{StaticResource ScIconFont}" Glyph="&#xE918;" FontSize="14" />
                        </ctrl:GlowButton>
                    </Grid>

                    <!-- 列表直接坐在卡片上，行与版本页同款（模板见 Page.Resources） -->
                    <Grid x:Name="VersionListArea" Grid.Row="1">
                        <ListView x:Name="VersionList" SelectionMode="Single" Padding="0"
                                  ItemTemplate="{StaticResource VersionRowTemplate}"
                                  SelectionChanged="VersionList_SelectionChanged">
                            <ListView.Resources>
                                <!-- 行的跟手光斑与行 Border 的圆角都是 8（与平板版同口径） -->
                                <CornerRadius x:Key="ListViewItemCornerRadius">8</CornerRadius>
                                <SolidColorBrush x:Key="ListViewItemBackground" Color="Transparent" />
                                <SolidColorBrush x:Key="ListViewItemBackgroundPointerOver" Color="Transparent" />
                                <SolidColorBrush x:Key="ListViewItemBackgroundPressed" Color="Transparent" />
                                <SolidColorBrush x:Key="ListViewItemBackgroundSelected" Color="Transparent" />
                                <SolidColorBrush x:Key="ListViewItemBackgroundSelectedPointerOver" Color="Transparent" />
                                <SolidColorBrush x:Key="ListViewItemBackgroundSelectedPressed" Color="Transparent" />
                            </ListView.Resources>
                            <ListView.ItemContainerStyle>
                                <Style TargetType="ListViewItem">
                                    <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                                    <Setter Property="VerticalContentAlignment" Value="Stretch" />
                                    <Setter Property="MinHeight" Value="40" />
                                    <Setter Property="Padding" Value="0" />
                                    <Setter Property="Margin" Value="0,1" />
                                </Style>
                            </ListView.ItemContainerStyle>
                        </ListView>
                        <ctrl:EmptyStateView x:Name="EmptyVersionHint" Visibility="Collapsed"
                                              MinHeight="200"
                                              HorizontalAlignment="Center" VerticalAlignment="Center"
                                              Glyph="&#xEA94;"
                                              loc:Loc.Title="暂无已安装版本"
                                              loc:Loc.ActionText="前往下载页安装"
                                              ActionClick="PickVersion_Click" />
                    </Grid>
                </Grid>
            </Border>
            </Grid>
        </Grid>

        <!-- ═══ 启动页覆盖层：点启动后盖住主页内容（结构与平板版一致；固定宽改 MaxWidth + 拉伸） ═══ -->
        <Grid x:Name="LaunchOverlay" Visibility="Collapsed"
              Background="{ThemeResource ApplicationPageBackgroundThemeBrush}">
            <StackPanel MaxWidth="480" HorizontalAlignment="Center" VerticalAlignment="Center"
                        Margin="24,0" Spacing="10">
                <!-- 像素镐图标：品牌色对角渐变（浅黄→深绿，两主题通用） -->
                <Path Width="40" Height="40" HorizontalAlignment="Center"
                      Data="M16,4 H32 V8 H36 V12 H40 V20 H36 V24 H32 V20 H28 V16 H24 V40 H20 V44 H16 V16 H12 V24 H8 V20 H12 V12 H16 Z"
                      Fill="{ThemeResource AccentFillColorDefaultBrush}" />

                <TextBlock x:Name="LaunchStageTitle" loc:Loc.Text="正在启动" FontSize="20"
                           FontWeight="Medium" HorizontalAlignment="Center" />
                <TextBlock x:Name="LaunchVersionText" FontSize="13" HorizontalAlignment="Center"
                           Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                           TextTrimming="CharacterEllipsis" />

                <ProgressBar x:Name="LaunchProgress" Height="4" CornerRadius="2"
                             Minimum="0" Maximum="100"
                             Foreground="{ThemeResource AccentFillColorDefaultBrush}" />

                <!-- 当前步骤 / 登录方式 -->
                <Grid ColumnSpacing="8" MaxWidth="340" HorizontalAlignment="Stretch">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <TextBlock loc:Loc.Text="当前步骤" FontSize="13" Opacity="0.7"
                               Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                               VerticalAlignment="Center" />
                    <TextBlock x:Name="LaunchStageStepText" Grid.Column="1" FontSize="13"
                               VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                    <TextBlock Grid.Row="1" loc:Loc.Text="登录方式" FontSize="13" Opacity="0.7"
                               Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                               VerticalAlignment="Center" />
                    <TextBlock x:Name="LaunchLoginModeText" Grid.Row="1" Grid.Column="1"
                               FontSize="13" VerticalAlignment="Center" />
                </Grid>

                <!-- 你知道吗（小贴士：静态池 + Nova 动态，见 LaunchTips.cs） -->
                <Border Background="{ThemeResource GlassCardBrush}"
                        BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                        BorderThickness="1" CornerRadius="8" Padding="12,10"
                        MaxWidth="340" HorizontalAlignment="Stretch">
                    <Grid ColumnSpacing="10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="4" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Rectangle RadiusX="2" RadiusY="2"
                                   Fill="{ThemeResource AccentFillColorDefaultBrush}" />
                        <TextBlock x:Name="LaunchTipText" Grid.Column="1" FontSize="12"
                                   TextWrapping="Wrap" LineHeight="18"
                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                    </Grid>
                </Border>

                <!-- 实时游戏日志（默认折叠） -->
                <ToggleButton x:Name="LaunchLogToggle" loc:Loc.Text="显示日志" FontSize="12"
                              HorizontalAlignment="Center"
                              Checked="LaunchLogToggle_Changed" Unchecked="LaunchLogToggle_Changed" />
                <TextBox x:Name="LaunchLogText" Visibility="Collapsed" MaxWidth="480" Height="140"
                         HorizontalAlignment="Stretch"
                         FontFamily="Consolas" FontSize="11" IsReadOnly="True" AcceptsReturn="True"
                         TextWrapping="NoWrap" ScrollViewer.VerticalScrollBarVisibility="Auto"
                         ScrollViewer.HorizontalScrollBarVisibility="Auto" />
                <HyperlinkButton x:Name="LaunchLogOpenBtn" loc:Loc.Text="打开日志文件" FontSize="12"
                                 Visibility="Collapsed" HorizontalAlignment="Center"
                                 Click="LaunchLogOpen_Click" />

                <TextBlock x:Name="LaunchErrorText" FontSize="12" TextWrapping="Wrap"
                           MaxLines="2" TextTrimming="CharacterEllipsis" TextAlignment="Center"
                           Visibility="Collapsed" HorizontalAlignment="Center"
                           Foreground="{ThemeResource SystemFillColorCriticalBrush}" />

                <!-- 取消（启动中）/ 返回主页（运行中、已退出、失败） -->
                <Grid ColumnSpacing="12" MaxWidth="340" HorizontalAlignment="Stretch">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <ctrl:GlowButton x:Name="LaunchCancelBtn" loc:Loc.Text="取消" HorizontalAlignment="Stretch"
                            Click="LaunchCancelBtn_Click" />
                    <Button x:Name="LaunchBackBtn" Grid.Column="1" loc:Loc.Text="返回主页"
                            HorizontalAlignment="Stretch" Visibility="Collapsed"
                            Style="{StaticResource AccentButtonStyle}" FontWeight="Medium"
                            Click="LaunchBackBtn_Click" />
                </Grid>
            </StackPanel>
        </Grid>
    </Grid>
</Page>
