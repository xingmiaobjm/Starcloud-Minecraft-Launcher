<?xml version="1.0" encoding="utf-8"?>
<!--
  我的 · 手机版聚合页（横屏延续竖屏版设计）：底部导航五个一级 tab 放不下的入口收进本页：
    账户卡（头像 + 名称 + 渠道副行，点击去账户页）
    → 插件导航组（contributes.navItems，最多 3 项，动态重建，与平板侧栏同口径）
    → 功能入口（存档 / 运行状态 / 插件 / Nova / 启动器日志 / 设置）
    → 页脚版本信息。
  横屏视觉：行高 48、头像 40、页边距与主页同口径（内容区已有 12 边距，这里不再加）。
-->
<Page
    x:Class="Starcloud.Launcher.Phone.Views.MorePage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:loc="using:Starcloud.Launcher.Phone.Localization"
    NavigationCacheMode="Enabled">

    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <!-- 横屏视觉：卡片列居中、宽 440-560（通栏一行字拉太长，贴左又偏仓）；
         MinWidth 是给卡片撑宽的——StackPanel 水平不拉伸时按内容收窄，行卡只剩 270 -->
        <StackPanel MinWidth="440" MaxWidth="560" HorizontalAlignment="Center" Spacing="10" Padding="0,2">

            <!-- ═══ 账户卡：头像 + 名称 + 渠道副行（登录态由 RefreshAccount 驱动） ═══ -->
            <Border x:Name="AccountCard" Background="{ThemeResource GlassCardBrush}"
                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                    BorderThickness="1" CornerRadius="12" Padding="12,10"
                    Tapped="AccountCard_Tapped">
                <Grid ColumnSpacing="10">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <Border Grid.Column="0" Width="40" Height="40" CornerRadius="9"
                            VerticalAlignment="Center"
                            Background="{ThemeResource AccentFillColorDefaultBrush}">
                        <Grid>
                            <TextBlock x:Name="AccountAvatarText" Text="?" FontSize="16" FontWeight="Medium"
                                       Foreground="{ThemeResource TextOnAccentFillColorPrimaryBrush}"
                                       HorizontalAlignment="Center" VerticalAlignment="Center" />
                            <FontIcon FontFamily="{StaticResource ScIconFont}" x:Name="AccountAvatarGlyph"
                                      Glyph="&#xEB8F;" FontSize="14"
                                      Foreground="{ThemeResource TextOnAccentFillColorPrimaryBrush}"
                                      HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Grid>
                    </Border>
                    <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="1">
                        <TextBlock x:Name="AccountNameText" loc:Loc.Text="未登录" FontWeight="Medium" FontSize="14"
                                   TextTrimming="CharacterEllipsis" />
                        <TextBlock x:Name="AccountSubText" loc:Loc.Text="点击前往账户页登录 Starcloud ID"
                                   FontSize="11" TextTrimming="CharacterEllipsis"
                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                    </StackPanel>
                    <FontIcon Grid.Column="2" FontFamily="{StaticResource ScIconFont}" Glyph="&#xE904;" FontSize="11"
                              Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                              VerticalAlignment="Center" />
                </Grid>
            </Border>

            <!-- ═══ 插件导航组：contributes.navItems（最多 3 项，超出写日志，与平板侧栏同口径）；
                 没有任何插件导航项时整块 Collapsed（由 cs 控制） ═══ -->
            <StackPanel x:Name="PluginNavHost" Spacing="6" Visibility="Collapsed">
                <TextBlock loc:Loc.Text="插件页面" FontSize="12" FontWeight="Medium" Margin="4,0"
                           Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                <Border Background="{ThemeResource GlassCardBrush}"
                        BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                        BorderThickness="1" CornerRadius="12" Padding="4,2">
                    <StackPanel x:Name="PluginNavList" />
                </Border>
            </StackPanel>

            <!-- ═══ 功能入口 ═══ -->
            <Border Background="{ThemeResource GlassCardBrush}"
                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                    BorderThickness="1" CornerRadius="12" Padding="4,2">
                <StackPanel>
                    <!-- 存档 -->
                    <Grid x:Name="RowSaves" Height="48" Padding="12,0" ColumnSpacing="12"
                          Background="Transparent" Tapped="RowSaves_Tapped">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <FontIcon Grid.Column="0" FontFamily="{StaticResource ScIconFont}" Glyph="&#xEA90;" FontSize="15"
                                  Foreground="{ThemeResource AccentFillColorDefaultBrush}" VerticalAlignment="Center" />
                        <TextBlock Grid.Column="1" loc:Loc.Text="存档管理" FontSize="13" VerticalAlignment="Center" />
                        <FontIcon Grid.Column="2" FontFamily="{StaticResource ScIconFont}" Glyph="&#xE904;" FontSize="10"
                                  Foreground="{ThemeResource TextFillColorTertiaryBrush}" VerticalAlignment="Center" />
                    </Grid>
                    <Rectangle Height="1" Margin="38,0,12,0"
                               Fill="{ThemeResource DividerStrokeColorDefaultBrush}" />
                    <!-- 运行状态（圆点 = 游戏运行中） -->
                    <Grid x:Name="RowRunning" Height="48" Padding="12,0" ColumnSpacing="12"
                          Background="Transparent" Tapped="RowRunning_Tapped">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <FontIcon Grid.Column="0" FontFamily="{StaticResource ScIconFont}" Glyph="&#xEC3B;" FontSize="15"
                                  Foreground="{ThemeResource AccentFillColorDefaultBrush}" VerticalAlignment="Center" />
                        <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                            <TextBlock loc:Loc.Text="运行状态" FontSize="13" />
                            <Ellipse x:Name="RunningDot" Width="6" Height="6" VerticalAlignment="Center"
                                     Visibility="Collapsed"
                                     Fill="{ThemeResource SystemFillColorSuccessBrush}" />
                        </StackPanel>
                        <FontIcon Grid.Column="2" FontFamily="{StaticResource ScIconFont}" Glyph="&#xE904;" FontSize="10"
                                  Foreground="{ThemeResource TextFillColorTertiaryBrush}" VerticalAlignment="Center" />
                    </Grid>
                    <Rectangle Height="1" Margin="38,0,12,0"
                               Fill="{ThemeResource DividerStrokeColorDefaultBrush}" />
                    <!-- 插件 -->
                    <Grid x:Name="RowPlugins" Height="48" Padding="12,0" ColumnSpacing="12"
                          Background="Transparent" Tapped="RowPlugins_Tapped">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <FontIcon Grid.Column="0" FontFamily="{StaticResource ScIconFont}" Glyph="&#xEABC;" FontSize="15"
                                  Foreground="{ThemeResource AccentFillColorDefaultBrush}" VerticalAlignment="Center" />
                        <TextBlock Grid.Column="1" loc:Loc.Text="插件" FontSize="13" VerticalAlignment="Center" />
                        <FontIcon Grid.Column="2" FontFamily="{StaticResource ScIconFont}" Glyph="&#xE904;" FontSize="10"
                                  Foreground="{ThemeResource TextFillColorTertiaryBrush}" VerticalAlignment="Center" />
                    </Grid>
                    <Rectangle Height="1" Margin="38,0,12,0"
                               Fill="{ThemeResource DividerStrokeColorDefaultBrush}" />
                    <!-- Nova（品牌标记图标，多色） -->
                    <Grid x:Name="RowNova" Height="48" Padding="12,0" ColumnSpacing="12"
                          Background="Transparent" Tapped="RowNova_Tapped">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <ImageIcon Grid.Column="0" Source="{StaticResource NovaMarkSmall}"
                                   Width="15" Height="15" VerticalAlignment="Center" />
                        <TextBlock Grid.Column="1" Text="Nova" FontSize="13" VerticalAlignment="Center" />
                        <FontIcon Grid.Column="2" FontFamily="{StaticResource ScIconFont}" Glyph="&#xE904;" FontSize="10"
                                  Foreground="{ThemeResource TextFillColorTertiaryBrush}" VerticalAlignment="Center" />
                    </Grid>
                    <Rectangle Height="1" Margin="38,0,12,0"
                               Fill="{ThemeResource DividerStrokeColorDefaultBrush}" />
                    <!-- 启动器日志 -->
                    <Grid x:Name="RowLogs" Height="48" Padding="12,0" ColumnSpacing="12"
                          Background="Transparent" Tapped="RowLogs_Tapped">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <FontIcon Grid.Column="0" FontFamily="{StaticResource ScIconFont}" Glyph="&#xEC64;" FontSize="15"
                                  Foreground="{ThemeResource AccentFillColorDefaultBrush}" VerticalAlignment="Center" />
                        <TextBlock Grid.Column="1" loc:Loc.Text="启动器日志" FontSize="13" VerticalAlignment="Center" />
                        <FontIcon Grid.Column="2" FontFamily="{StaticResource ScIconFont}" Glyph="&#xE904;" FontSize="10"
                                  Foreground="{ThemeResource TextFillColorTertiaryBrush}" VerticalAlignment="Center" />
                    </Grid>
                    <Rectangle Height="1" Margin="38,0,12,0"
                               Fill="{ThemeResource DividerStrokeColorDefaultBrush}" />
                    <!-- 设置 -->
                    <Grid x:Name="RowSettings" Height="48" Padding="12,0" ColumnSpacing="12"
                          Background="Transparent" Tapped="RowSettings_Tapped">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <FontIcon Grid.Column="0" FontFamily="{StaticResource ScIconFont}" Glyph="&#xEC04;" FontSize="15"
                                  Foreground="{ThemeResource AccentFillColorDefaultBrush}" VerticalAlignment="Center" />
                        <TextBlock Grid.Column="1" loc:Loc.Text="设置" FontSize="13" VerticalAlignment="Center" />
                        <FontIcon Grid.Column="2" FontFamily="{StaticResource ScIconFont}" Glyph="&#xE904;" FontSize="10"
                                  Foreground="{ThemeResource TextFillColorTertiaryBrush}" VerticalAlignment="Center" />
                    </Grid>
                </StackPanel>
            </Border>

            <!-- 页脚版本信息（对齐平板顶栏版本徽章） -->
            <TextBlock x:Name="VersionFooter" FontSize="10.5" HorizontalAlignment="Center" Margin="0,2,0,10"
                       Foreground="{ThemeResource TextFillColorTertiaryBrush}" />
        </StackPanel>
    </ScrollViewer>
</Page>
