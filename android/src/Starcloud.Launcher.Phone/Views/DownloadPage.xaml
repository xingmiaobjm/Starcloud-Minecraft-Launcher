                                    Click="StartDownload_Click">
                                <StackPanel Orientation="Horizontal" Spacing="10">
                                    <FontIcon FontFamily="{StaticResource ScIconFont}" Glyph="&#xE90C;" FontSize="16" />
                                    <TextBlock loc:Loc.Text="开始下载" FontSize="15" FontWeight="Medium" />
                                </StackPanel>
                            </Button>
                        </StackPanel>
                    </Grid>
                </Grid>

                <!-- ── 社区资源面板 ── -->
                <Grid x:Name="CommunityPanel" Grid.Row="2" RowSpacing="12" Visibility="Collapsed">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" MinHeight="260" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <!-- 筛选卡 -->
                    <Border Grid.Row="0"
                            Background="{ThemeResource GlassCardBrush}"
                            BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                            BorderThickness="1" CornerRadius="16" Padding="16">
                        <StackPanel Spacing="12">
                            <TextBlock x:Name="SearchTitle" loc:Loc.Text="搜索 Mod" FontSize="16" FontWeight="Medium" />
                            <!-- 手机版：筛选表单由两列网格改单列竖排 —— 右列「来源+排序」约 430 宽横排在竖屏
                                 放不下、左右两列互相挤压；标签在上、控件在下整宽拉伸（与设置页长文本行同款）。
                                 CategoryRow / LoaderRow 的 Visibility 切换逻辑（code-behind）不变 -->
                            <StackPanel Spacing="12">
                                <!-- 名称 -->
                                <StackPanel Spacing="6">
                                    <TextBlock loc:Loc.Text="名称" />
                                    <TextBox x:Name="CommunitySearchBox"
                                             loc:Loc.Placeholder="如：Sodium、JEI、Create…"
                                             KeyDown="SearchBox_KeyDown" />
                                </StackPanel>

                                <!-- 分类（按资源类型动态加载；无分类的类型隐藏） -->
                                <StackPanel x:Name="CategoryRow" Spacing="6">
                                    <TextBlock loc:Loc.Text="分类" />
                                    <ComboBox x:Name="CategoryCombo" HorizontalAlignment="Stretch"
                                              SelectionChanged="Filter_Changed" />
                                </StackPanel>

                                <!-- 版本（全部游戏大版本；Uno ComboBox 无 IsEditable，触屏端以选择代替自由输入，
                                     代码侧用首枚「全部」占位项承担桌面 Text 直写的同一语义） -->
                                <StackPanel Spacing="6">
                                    <TextBlock loc:Loc.Text="版本" />
                                    <ComboBox x:Name="VersionCombo" HorizontalAlignment="Stretch"
                                              MaxDropDownHeight="360"
                                              SelectionChanged="Filter_Changed" KeyDown="VersionBox_KeyDown" />
                                </StackPanel>

                                <!-- 加载器（仅 Mod 分区） -->
                                <StackPanel x:Name="LoaderRow" Spacing="6">
                                    <TextBlock loc:Loc.Text="加载器" />
                                    <ComboBox x:Name="LoaderCombo" HorizontalAlignment="Stretch"
                                              SelectionChanged="Filter_Changed">
                                        <ComboBoxItem loc:Loc.Text="自动检测" Tag="auto" IsSelected="True" />
                                        <ComboBoxItem loc:Loc.Text="全部" Tag="any" />
                                        <ComboBoxItem Content="Fabric" Tag="fabric" />
                                        <ComboBoxItem Content="Forge" Tag="forge" />
                                        <ComboBoxItem Content="NeoForge" Tag="neoforge" />
                                        <ComboBoxItem Content="Quilt" Tag="quilt" />
                                    </ComboBox>
                                </StackPanel>

                                <!-- 操作按钮 -->
                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <Button x:Name="SearchBtn" MinWidth="110"
                                            Style="{ThemeResource AccentButtonStyle}" FontWeight="Medium" Click="SearchBtn_Click">
                                        <StackPanel Orientation="Horizontal" Spacing="8">
                                            <FontIcon FontFamily="{StaticResource ScIconFont}" Glyph="&#xEA6F;" FontSize="14" />
                                            <TextBlock loc:Loc.Text="搜索" />
                                        </StackPanel>
                                    </Button>
                                    <ctrl:GlowButton x:Name="ResetBtn" MinWidth="110" loc:Loc.Text="重置条件" Click="ResetBtn_Click" />
                                </StackPanel>

                                <!-- 排序（手机版：来源 / 排序各自成行竖排，下拉整宽） -->
                                <StackPanel Spacing="12">
                                    <StackPanel Spacing="6">
                                        <TextBlock loc:Loc.Text="来源" />
                                        <ComboBox x:Name="SourceCombo" HorizontalAlignment="Stretch"
                                                  SelectionChanged="Filter_Changed">
                                            <ComboBoxItem Content="Modrinth" Tag="modrinth" IsSelected="True" />
                                            <ComboBoxItem Content="CurseForge" Tag="curseforge" />
                                        </ComboBox>
                                    </StackPanel>
                                    <StackPanel Spacing="6">
                                        <TextBlock loc:Loc.Text="排序" />
                                        <ComboBox x:Name="SortCombo" HorizontalAlignment="Stretch"
                                                  SelectionChanged="Filter_Changed">
                                            <ComboBoxItem loc:Loc.Text="相关性" Tag="relevance" IsSelected="True" />
                                            <ComboBoxItem loc:Loc.Text="下载最多" Tag="downloads" />
                                            <ComboBoxItem loc:Loc.Text="最新发布" Tag="newest" />
                                            <ComboBoxItem loc:Loc.Text="最近更新" Tag="updated" />
                                        </ComboBox>
                                    </StackPanel>
                                </StackPanel>
                            </StackPanel>
                        </StackPanel>
                    </Border>

                    <!-- 结果列表 -->
                    <Border Grid.Row="1"
                            Background="{ThemeResource GlassCardBrush}"
                            BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                            BorderThickness="1" CornerRadius="16" Padding="4">
                        <Grid>
                            <ListView x:Name="ModList" SelectionMode="None">
                                <ListView.Resources>
                                    <!-- 与版本页一致：悬停反馈只由行内的跟手光斑表达。
                                         框架给的整行底色是硬边矩形，和光斑的圆角、羽化对不齐，
                                         叠在一起就是"两层框"。 -->
                                    <SolidColorBrush x:Key="ListViewItemBackground" Color="Transparent" />
                                    <SolidColorBrush x:Key="ListViewItemBackgroundPointerOver" Color="Transparent" />
                                    <SolidColorBrush x:Key="ListViewItemBackgroundPressed" Color="Transparent" />
                                    <SolidColorBrush x:Key="ListViewItemBackgroundSelected" Color="Transparent" />
                                    <SolidColorBrush x:Key="ListViewItemBackgroundSelectedPointerOver" Color="Transparent" />
                                    <SolidColorBrush x:Key="ListViewItemBackgroundSelectedPressed" Color="Transparent" />
                                </ListView.Resources>
                                <ListView.ItemContainerStyle>
                                    <Style TargetType="ListViewItem">
                                        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                                        <!-- 竖向也必须撑满：默认 Center 会让承载光斑的行 Border 比行矮一圈，
                                             上下留下不亮光斑的死区，鼠标从两行交界处掠过时完全没反应。 -->
                                        <Setter Property="VerticalContentAlignment" Value="Stretch" />
                                        <Setter Property="MinHeight" Value="68" />
                                        <Setter Property="Padding" Value="0" />
                                        <Setter Property="Margin" Value="0,1" />
                                    </Style>
                                </ListView.ItemContainerStyle>
                                <ListView.ItemTemplate>
                                    <DataTemplate x:DataType="rows:ModRow">
                                        <!-- 整卡可点：点击资源卡片直接打开下载详情窗（PCL2 式） -->
                                        <Grid beh:HoverShadowBehavior.IsEnabled="True"
                                              beh:HoverShadowBehavior.Carrier="{Binding ElementName=ModRowGlow}"
                                              Tapped="ModRow_Tapped">
                                            <!-- 跟手光斑层铺满整行（不带行内边距），圆角与卡片一致；内容再靠 Padding 让开。
                                                 光斑若跟内容一起内缩，就会比行小一圈，外面露出框架底色 → 两层框。 -->
                                            <Border x:Name="ModRowGlow" CornerRadius="8"
                                                    Opacity="0" IsHitTestVisible="False">
                                                <Border.Background>
                                                    <RadialGradientBrush Center="0.5,0.5" RadiusX="0.9" RadiusY="0.9">
                                                        <GradientStop Color="#28000000" Offset="0" />
                                                        <GradientStop Color="#1F000000" Offset="0.18" />
                                                        <GradientStop Color="#16000000" Offset="0.40" />
                                                        <GradientStop Color="#0D000000" Offset="0.62" />
                                                        <GradientStop Color="#05000000" Offset="0.82" />
                                                        <GradientStop Color="#00000000" Offset="1" />
                                                    </RadialGradientBrush>
                                                </Border.Background>
                                            </Border>
                                        <Grid Padding="12,10" ColumnSpacing="12" Background="Transparent">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="*" />
                                            </Grid.ColumnDefinitions>

                                            <!-- 图标：底层字形兜底（图片解码失败时可见），上层图片覆盖 -->
                                            <Grid Width="48" Height="48" VerticalAlignment="Center" CornerRadius="8">
                                                <FontIcon FontFamily="{StaticResource ScIconFont}" Glyph="&#xEA93;" FontSize="20"
                                                          Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                                <Image Source="{x:Bind Icon}" Stretch="UniformToFill" />
                                            </Grid>

                                            <StackPanel Grid.Column="1" Spacing="3" VerticalAlignment="Center">
                                                <!-- 手机版：标题 + 标签由横排 StackPanel 改 Grid —— 标题占 * 自适应
                                                     （省略号截断、去 420 MaxWidth），标签靠右收尾；
                                                     原横排在竖屏会被长标题把标签挤出屏幕外 -->
                                                <Grid ColumnSpacing="8">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="*" />
                                                        <ColumnDefinition Width="Auto" />
                                                    </Grid.ColumnDefinitions>
                                                    <TextBlock Text="{x:Bind Title}" FontWeight="Medium" FontSize="14"
                                                               VerticalAlignment="Center"
                                                               TextTrimming="CharacterEllipsis" />
                                                    <ItemsControl Grid.Column="1" ItemsSource="{x:Bind Tags}" VerticalAlignment="Center"
                                                                  Visibility="{x:Bind TagsVisibility}">
                                                        <ItemsControl.ItemsPanel>
                                                            <ItemsPanelTemplate>
                                                                <StackPanel Orientation="Horizontal" Spacing="4" />
                                                            </ItemsPanelTemplate>
                                                        </ItemsControl.ItemsPanel>
                                                        <ItemsControl.ItemTemplate>
                                                            <DataTemplate x:DataType="x:String">
                                                                <Border Background="{ThemeResource ControlFillColorDefaultBrush}"
                                                                        BorderBrush="{ThemeResource ControlStrokeColorDefaultBrush}"
                                                                        BorderThickness="1" CornerRadius="4" Padding="6,1">
                                                                    <TextBlock Text="{x:Bind}" FontSize="11"
                                                                               Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                                                </Border>
                                                            </DataTemplate>
                                                        </ItemsControl.ItemTemplate>
                                                    </ItemsControl>
                                                </Grid>
                                                <TextBlock Text="{x:Bind Description, Mode=OneWay}" FontSize="12"
                                                           Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                                                           MaxLines="1" TextTrimming="CharacterEllipsis" />
                                                <StackPanel Orientation="Horizontal" Spacing="12">
                                                    <TextBlock Text="{x:Bind LoadersText}" FontSize="12"
                                                               Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                                               Visibility="{x:Bind LoadersVisibility}" />
                                                    <TextBlock Text="{x:Bind DownloadsText}" FontSize="12"
                                                               Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                                    <TextBlock Text="{x:Bind UpdatedText}" FontSize="12"
                                                               Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                                </StackPanel>
                                            </StackPanel>
                                        </Grid>
                                        </Grid>
                                    </DataTemplate>
                                </ListView.ItemTemplate>
                            </ListView>
                            <ctrl:EmptyStateView x:Name="EmptyHint" Visibility="Collapsed"
                                                  HorizontalAlignment="Center" VerticalAlignment="Center"
                                                  Glyph="&#xEA6F;"
                                                  loc:Loc.Title="没有找到相关资源，换个关键词或筛选条件试试" />
                        </Grid>
                    </Border>

                    <!-- 分页 -->
                    <Grid Grid.Row="2" ColumnSpacing="8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                            <TextBlock x:Name="ResultCountText" VerticalAlignment="Center" FontSize="12"
                                       Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                            <!-- 中文搜索词被翻译成英文时提示实际用于搜索的词（默认隐藏） -->
                            <TextBlock x:Name="TranslatedHint" Visibility="Collapsed" VerticalAlignment="Center"
                                       FontSize="12" TextTrimming="CharacterEllipsis"
                                       Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}" />
                            <Border x:Name="CacheBadge" Visibility="Collapsed" CornerRadius="4" Padding="8,2"
                                    VerticalAlignment="Center"
                                    Background="{ThemeResource AccentFillColorTertiaryBrush}">
                                <TextBlock loc:Loc.Text="缓存" FontSize="11"
                                           Foreground="{ThemeResource TextOnAccentFillColorPrimaryBrush}" />
                            </Border>
                        </StackPanel>
                        <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8">
                            <ctrl:GlowButton x:Name="PrevBtn" loc:Loc.Text="上一页" Click="PrevBtn_Click" />
                            <ctrl:GlowButton x:Name="NextBtn" loc:Loc.Text="下一页" Click="NextBtn_Click" />
                        </StackPanel>
                    </Grid>
                </Grid>
            </Grid>
        </Grid>

        <!-- 提示与进度浮层（手机版：主体已单列化，浮层不再分列，整宽贴顶）。
             VerticalAlignment=Top 让它贴在页面顶部，自身不参与主体布局：
             下载时进度条浮在内容上方，不会把内容区推下去。 -->
        <Grid>
            <StackPanel VerticalAlignment="Top" Spacing="8">
                <InfoBar x:Name="ErrorBar" Severity="Error" IsOpen="False" IsClosable="True" loc:Loc.Title="操作失败" />
                <InfoBar x:Name="OkBar" Severity="Success" IsOpen="False" IsClosable="True" loc:Loc.Title="完成" />
                <ProgressBar x:Name="InstallProgress" IsIndeterminate="True" Visibility="Collapsed" />
                <TextBlock x:Name="ProgressText" FontSize="12" Visibility="Collapsed"
                           Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                           TextTrimming="CharacterEllipsis" />
            </StackPanel>
        </Grid>
    </Grid>
</Page>
