<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="Starcloud.Launcher.Phone.Views.DownloadPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:Starcloud.Launcher.Phone.Views"
    xmlns:beh="using:Starcloud.Launcher.Phone.Views.Behaviors"
    xmlns:ctrl="using:Starcloud.Launcher.Phone.Views.Controls"
    xmlns:rows="using:Starcloud.Launcher.Phone.Views.Rows"
    xmlns:loc="using:Starcloud.Launcher.Phone.Localization"
    NavigationCacheMode="Enabled">

    <Grid MaxWidth="1280" HorizontalAlignment="Stretch">
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- 主体（手机版）：左侧 180px 分类竖栏改为顶部横条（与设置页同款做法，
             竖屏没有侧栏宽度预算），内容区在横条下方整宽铺开 -->
        <Grid RowSpacing="12">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <!-- 分类横条（PCL2 式：原版游戏 + 社区资源分组）。
                 底色用 GlassCardBrush，与设置页分类条同形态：页面底是 #232324 一档，
                 AppPaneBackgroundBrush(#161616) 比它更暗，会读成「挖下去一块」而不是卡片。
                 手机版：条内横向排列，超出可横向滑动（触屏平移），选择逻辑（Tag / Category_SelectionChanged）不变。 -->
            <Border Grid.Row="0"
                    Background="{ThemeResource GlassCardBrush}"
                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                    BorderThickness="1" CornerRadius="8" Padding="8">
                <ListView x:Name="CategoryList" SelectionMode="Single"
                          SelectionChanged="Category_SelectionChanged"
                          ScrollViewer.HorizontalScrollMode="Enabled"
                          ScrollViewer.HorizontalScrollBarVisibility="Hidden"
                          ScrollViewer.VerticalScrollMode="Disabled"
                          ScrollViewer.VerticalScrollBarVisibility="Disabled">
                    <ListView.ItemsPanel>
                        <ItemsPanelTemplate>
                            <ItemsStackPanel Orientation="Horizontal" />
                        </ItemsPanelTemplate>
                    </ListView.ItemsPanel>
                    <ListView.ItemContainerStyle>
                        <Style TargetType="ListViewItem">
                            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                            <Setter Property="VerticalContentAlignment" Value="Stretch" />
                            <Setter Property="MinHeight" Value="34" />
                            <Setter Property="Padding" Value="0" />
                            <Setter Property="Margin" Value="0" />
                        </Style>
                    </ListView.ItemContainerStyle>
                    <ListView.Resources>
                        <!-- 悬停/选中反馈只由控件模板里那三层表达，框架整行底色一律关掉
                             （框架给的是硬边直角矩形，压上圆角光斑后四个角互相啃掉一块） -->
                        <SolidColorBrush x:Key="ListViewItemBackground" Color="Transparent" />
                        <SolidColorBrush x:Key="ListViewItemBackgroundPointerOver" Color="Transparent" />
                        <SolidColorBrush x:Key="ListViewItemBackgroundPressed" Color="Transparent" />
                        <SolidColorBrush x:Key="ListViewItemBackgroundSelected" Color="Transparent" />
                        <SolidColorBrush x:Key="ListViewItemBackgroundSelectedPointerOver" Color="Transparent" />
                        <SolidColorBrush x:Key="ListViewItemBackgroundSelectedPressed" Color="Transparent" />
                    </ListView.Resources>
                    <!-- 每项都是 ctrl:CategoryNavItem：选中底 / 悬停底 / 跟手光斑都在控件模板里，
                         圆角读同一个 CornerRadius，三层严格重合。与设置页左侧分区菜单同一套手感。 -->
                    <ListViewItem Tag="vanilla" IsSelected="True">
                        <ctrl:CategoryNavItem x:Name="CatVanilla" IsActive="True"
                                              Glyph="&#xEC20;" loc:Loc.Text="原版游戏" />
                    </ListViewItem>
                    <ListViewItem Tag="mod">
                        <ctrl:CategoryNavItem x:Name="CatMod" Glyph="&#xEA93;" Content="Mod" />
                    </ListViewItem>
                    <ListViewItem Tag="modpack">
                        <ctrl:CategoryNavItem x:Name="CatModpack" Glyph="&#xECAF;" loc:Loc.Text="整合包" />
                    </ListViewItem>
                    <ListViewItem Tag="datapack">
                        <ctrl:CategoryNavItem x:Name="CatDatapack" Glyph="&#xEC24;" loc:Loc.Text="数据包" />
                    </ListViewItem>
                    <ListViewItem Tag="resourcepack">
                        <ctrl:CategoryNavItem x:Name="CatResourcepack" Glyph="&#xEC49;" loc:Loc.Text="资源包" />
                    </ListViewItem>
                    <ListViewItem Tag="shader">
                        <ctrl:CategoryNavItem x:Name="CatShader" Glyph="&#xEC0C;" loc:Loc.Text="光影包" />
                    </ListViewItem>
                </ListView>
            </Border>

            <!-- 内容区（手机版：单列整宽铺开） -->
            <Grid Grid.Row="1" RowSpacing="12">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <!-- 插件挂载区（download.top）：有插件贡献时才占位（2.0 声明式 / 1.x HTML 都由它渲染） -->
                <ctrl:PluginContributionPanel Grid.Row="1" Point="download.top" />

                <!-- 提示与进度（ErrorBar / OkBar / InstallProgress / ProgressText）已改成页面级浮层，
                     见本文件末尾的「提示与进度浮层」：它不再占右栏高度，下载时不会把内容区推下去。
                     本行（Row 0）因此没有子元素，只靠它的 RowSpacing 与左栏的上边距对齐。 -->

                <!-- ── 原版游戏面板 ── -->
                <Grid x:Name="VanillaPanel" Grid.Row="2" RowSpacing="12">

                    <!-- 列表视图 -->
                    <Grid x:Name="ListPanel" RowSpacing="12">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>
                        <!-- 工具条（手机版）：类型分段（3 段 × 88 = 264 宽）与 300 宽搜索框横排在竖屏放不下，
                             改竖排 —— 分段控件一行；搜索框去固定 300 改整宽拉伸，与「缓存」徽标一行 -->
                        <StackPanel Grid.Row="0" Spacing="10">

                            <Border VerticalAlignment="Center"
                                    Background="{ThemeResource ControlFillColorSecondaryBrush}"
                                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                    BorderThickness="1" CornerRadius="11" Padding="3">
                                <Grid>
                                    <!-- 选中指示器：品牌强调色药丸，位置由合成动画平移（分段自带的选中底色已置空，避免两个指示器重叠） -->
                                    <Border x:Name="TypeIndicator" Width="88" Height="30" CornerRadius="8"
                                            HorizontalAlignment="Left" VerticalAlignment="Center"
                                            IsHitTestVisible="False"
                                            Background="{ThemeResource AccentFillColorDefaultBrush}" />
                                    <StackPanel Orientation="Horizontal">
                                        <ToggleButton x:Name="TypeReleaseBtn" Tag="release" IsChecked="True"
                                                      Width="88" Height="30" Padding="0" MinWidth="0"
                                                      FontSize="13" CornerRadius="8" BorderThickness="0"
                                                      Background="Transparent"
                                                      Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                                      loc:Loc.Text="正式版" loc:Loc.Name="正式版"
                                                      Click="TypeSegment_Click">
                                            <ToggleButton.Resources>
                                                <!-- 选中态由滑动指示器表达：这里只保留黑字（accent 面强制黑字） -->
                                                <SolidColorBrush x:Key="ToggleButtonBackgroundChecked" Color="Transparent" />
                                                <SolidColorBrush x:Key="ToggleButtonBackgroundCheckedPointerOver" Color="Transparent" />
                                                <SolidColorBrush x:Key="ToggleButtonBackgroundCheckedPressed" Color="Transparent" />
                                                <SolidColorBrush x:Key="ToggleButtonBorderBrushChecked" Color="Transparent" />
                                                <SolidColorBrush x:Key="ToggleButtonForegroundChecked" Color="#E61A1A1A" />
                                                <SolidColorBrush x:Key="ToggleButtonForegroundCheckedPointerOver" Color="#E61A1A1A" />
                                                <SolidColorBrush x:Key="ToggleButtonForegroundCheckedPressed" Color="#E61A1A1A" />
                                                <!-- 未选中段的悬停 / 按下：不写就吃默认的半透明白填充，
                                                     它按按钮自身的圆角矩形刷色、边缘是硬的，看着像一块脏斑；
                                                     选中反馈已经由滑动指示器表达，这里把两态底刷一并置空。 -->
                                                <SolidColorBrush x:Key="ToggleButtonBackgroundPointerOver" Color="Transparent" />
                                                <SolidColorBrush x:Key="ToggleButtonBackgroundPressed" Color="Transparent" />
                                            </ToggleButton.Resources>
                                        </ToggleButton>
                                        <ToggleButton x:Name="TypeSnapshotBtn" Tag="snapshot"
                                                      Width="88" Height="30" Padding="0" MinWidth="0"
                                                      FontSize="13" CornerRadius="8" BorderThickness="0"
                                                      Background="Transparent"
                                                      Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                                      loc:Loc.Text="快照版" loc:Loc.Name="快照版"
                                                      Click="TypeSegment_Click">
                                            <ToggleButton.Resources>
                                                <SolidColorBrush x:Key="ToggleButtonBackgroundChecked" Color="Transparent" />
                                                <SolidColorBrush x:Key="ToggleButtonBackgroundCheckedPointerOver" Color="Transparent" />
                                                <SolidColorBrush x:Key="ToggleButtonBackgroundCheckedPressed" Color="Transparent" />
                                                <SolidColorBrush x:Key="ToggleButtonBorderBrushChecked" Color="Transparent" />
                                                <SolidColorBrush x:Key="ToggleButtonForegroundChecked" Color="#E61A1A1A" />
                                                <SolidColorBrush x:Key="ToggleButtonForegroundCheckedPointerOver" Color="#E61A1A1A" />
                                                <SolidColorBrush x:Key="ToggleButtonForegroundCheckedPressed" Color="#E61A1A1A" />
                                                <!-- 未选中的悬停 / 按下底刷置空，见上方正式版段的说明 -->
                                                <SolidColorBrush x:Key="ToggleButtonBackgroundPointerOver" Color="Transparent" />
                                                <SolidColorBrush x:Key="ToggleButtonBackgroundPressed" Color="Transparent" />
                                            </ToggleButton.Resources>
                                        </ToggleButton>
                                        <ToggleButton x:Name="TypeOldBtn" Tag="old"
                                                      Width="88" Height="30" Padding="0" MinWidth="0"
                                                      FontSize="13" CornerRadius="8" BorderThickness="0"
                                                      Background="Transparent"
                                                      Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                                      loc:Loc.Text="远古版本" loc:Loc.Name="远古版本"
                                                      Click="TypeSegment_Click">
                                            <ToggleButton.Resources>
                                                <SolidColorBrush x:Key="ToggleButtonBackgroundChecked" Color="Transparent" />
                                                <SolidColorBrush x:Key="ToggleButtonBackgroundCheckedPointerOver" Color="Transparent" />
                                                <SolidColorBrush x:Key="ToggleButtonBackgroundCheckedPressed" Color="Transparent" />
                                                <SolidColorBrush x:Key="ToggleButtonBorderBrushChecked" Color="Transparent" />
                                                <SolidColorBrush x:Key="ToggleButtonForegroundChecked" Color="#E61A1A1A" />
                                                <SolidColorBrush x:Key="ToggleButtonForegroundCheckedPointerOver" Color="#E61A1A1A" />
                                                <SolidColorBrush x:Key="ToggleButtonForegroundCheckedPressed" Color="#E61A1A1A" />
                                                <!-- 未选中的悬停 / 按下底刷置空，见上方正式版段的说明 -->
                                                <SolidColorBrush x:Key="ToggleButtonBackgroundPointerOver" Color="Transparent" />
                                                <SolidColorBrush x:Key="ToggleButtonBackgroundPressed" Color="Transparent" />
                                            </ToggleButton.Resources>
                                        </ToggleButton>
                                    </StackPanel>
                                </Grid>
                            </Border>

                            <!-- 搜索框与「缓存」徽标成组同行：徽标紧贴搜索框，不再孤零零飘在最右 -->
                            <Grid ColumnSpacing="10">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <!-- 手机版：搜索框由固定 300 宽改整宽拉伸（MaxWidth 320 保留） -->
                                <Grid MaxWidth="320" HorizontalAlignment="Stretch">
                                    <!-- 尺寸与工具行其余控件对齐（32 高），边界形态走全局 TextBox 样式 -->
                                    <TextBox x:Name="SearchBox" Height="32"
                                             Padding="32,5,10,5" VerticalContentAlignment="Center"
                                             loc:Loc.Placeholder="搜索版本 ID…"
                                             TextChanged="SearchBox_TextChanged" />
                                    <FontIcon FontFamily="{StaticResource ScIconFont}" Glyph="&#xEA6F;" FontSize="14" Margin="12,0,0,0"
                                              HorizontalAlignment="Left" VerticalAlignment="Center"
                                              IsHitTestVisible="False"
                                              Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                </Grid>
                                <Border x:Name="VersionCacheBadge" Grid.Column="1" Visibility="Collapsed"
                                        CornerRadius="6" Padding="8,3" VerticalAlignment="Center"
                                        Background="{ThemeResource AccentFillColorTertiaryBrush}">
                                    <TextBlock loc:Loc.Text="缓存" FontSize="11"
                                               Foreground="{ThemeResource TextOnAccentFillColorPrimaryBrush}" />
                                </Border>
                            </Grid>
                        </StackPanel>

                        <!-- 最新版本：两枚 hero 瓦片（最新正式版 / 最新预览版），点击直接进详情 -->
                        <Grid x:Name="LatestCard" Grid.Row="1" Visibility="Collapsed" ColumnSpacing="12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>

                            <ctrl:GlowButton x:Name="LatestReleaseTile" Grid.Column="0" Tag=""
                                    Style="{StaticResource ScStaticCardButtonStyle}" Margin="0"
                                    HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch"
                                    Padding="14,12" CornerRadius="14"
                                    Background="{ThemeResource GlassCardBrush}"
                                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                    BorderThickness="1"
                                    Click="LatestTile_Click">
                                <Grid ColumnSpacing="14">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <Grid Width="36" Height="36" VerticalAlignment="Center">
                                        <FontIcon FontFamily="{StaticResource ScIconFont}" Glyph="&#xECAF;" FontSize="18"
                                                  Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                        <Image x:Name="LatestReleaseIcon" Width="36" Height="36"
                                               Stretch="Uniform" />
                                    </Grid>
                                    <StackPanel Grid.Column="1" Spacing="2" VerticalAlignment="Center">
                                        <TextBlock loc:Loc.Text="最新正式版" FontSize="11"
                                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                        <TextBlock x:Name="LatestReleaseId" FontSize="17" FontWeight="Medium"
                                                   TextTrimming="CharacterEllipsis" />
                                        <TextBlock x:Name="LatestReleaseMeta" FontSize="11"
                                                   TextTrimming="CharacterEllipsis"
                                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                    </StackPanel>
                                    <FontIcon FontFamily="{StaticResource ScIconFont}" Grid.Column="2" Glyph="&#xE904;" FontSize="12"
                                              VerticalAlignment="Center"
                                              Foreground="{ThemeResource TextFillColorTertiaryBrush}" />
                                </Grid>
                            </ctrl:GlowButton>

                            <ctrl:GlowButton x:Name="LatestSnapshotTile" Grid.Column="1" Tag=""
                                    Style="{StaticResource ScStaticCardButtonStyle}" Margin="0"
                                    HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch"
                                    Padding="14,12" CornerRadius="14"
                                    Background="{ThemeResource GlassCardBrush}"
                                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                    BorderThickness="1"
                                    Click="LatestTile_Click">
                                <Grid ColumnSpacing="14">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <Grid Width="36" Height="36" VerticalAlignment="Center">
                                        <FontIcon FontFamily="{StaticResource ScIconFont}" Glyph="&#xECAF;" FontSize="18"
                                                  Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                        <Image x:Name="LatestSnapshotIcon" Width="36" Height="36"
                                               Stretch="Uniform" />
                                    </Grid>
                                    <StackPanel Grid.Column="1" Spacing="2" VerticalAlignment="Center">
                                        <TextBlock loc:Loc.Text="最新预览版" FontSize="11"
                                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                        <TextBlock x:Name="LatestSnapshotId" FontSize="17" FontWeight="Medium"
                                                   TextTrimming="CharacterEllipsis" />
                                        <TextBlock x:Name="LatestSnapshotMeta" FontSize="11"
                                                   TextTrimming="CharacterEllipsis"
                                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                    </StackPanel>
                                    <FontIcon FontFamily="{StaticResource ScIconFont}" Grid.Column="2" Glyph="&#xE904;" FontSize="12"
                                              VerticalAlignment="Center"
                                              Foreground="{ThemeResource TextFillColorTertiaryBrush}" />
                                </Grid>
                            </ctrl:GlowButton>
                        </Grid>

                        <Border Grid.Row="2"
                                Background="{ThemeResource GlassCardBrush}"
                                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                BorderThickness="1" CornerRadius="16" Padding="4">
                            <ListView x:Name="VersionList" SelectionMode="Single"
                                      IsItemClickEnabled="True" ItemClick="VersionList_ItemClick">
                                <ListView.ItemContainerStyle>
                                    <Style TargetType="ListViewItem">
                                        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                                        <!-- 竖向也必须撑满：默认 Center 会让承载光斑的行 Border 比行矮一圈，
                                             上下留下不亮光斑的死区，鼠标从两行交界处掠过时完全没反应。 -->
                                        <Setter Property="VerticalContentAlignment" Value="Stretch" />
                                        <Setter Property="MinHeight" Value="48" />
                                        <Setter Property="Padding" Value="0" />
                                        <Setter Property="Margin" Value="0,1" />
                                    </Style>
                                </ListView.ItemContainerStyle>
                                <ListView.Resources>
                                    <!-- 悬停反馈只由行内的高亮层与跟手光斑表达：框架的整行底色是硬边矩形，会与光斑叠成两层框 -->
                                    <SolidColorBrush x:Key="ListViewItemBackground" Color="Transparent" />
                                    <SolidColorBrush x:Key="ListViewItemBackgroundPointerOver" Color="Transparent" />
                                    <SolidColorBrush x:Key="ListViewItemBackgroundPressed" Color="Transparent" />
                                    <SolidColorBrush x:Key="ListViewItemBackgroundSelected" Color="Transparent" />
                                    <SolidColorBrush x:Key="ListViewItemBackgroundSelectedPointerOver" Color="Transparent" />
                                    <SolidColorBrush x:Key="ListViewItemBackgroundSelectedPressed" Color="Transparent" />
                                    <!-- 版本行（全部版本统一平铺）：外观与主页版本行一致——无底色，悬停只由跟手光斑表达 -->
                                    <DataTemplate x:Key="VersionFlatTemplate" x:DataType="rows:DownloadRow">
                                        <Grid CornerRadius="8"
                                              beh:HoverShadowBehavior.IsEnabled="True"
                                              beh:HoverShadowBehavior.Carrier="{Binding ElementName=RowShadow}">
                                            <!-- 跟随光标的内阴影：只画落在本行内的那一段（文字在它之上）。
                                                 竖向刻意内缩 4：悬停时光斑不贴行上下边缘，相邻两行之间留出可见留白。 -->
                                            <Border x:Name="RowShadow" CornerRadius="8"
                                                    Margin="0,4"
                                                    Opacity="0" IsHitTestVisible="False">
                                                <Border.Background>
                                                    <RadialGradientBrush Center="0.5,0.5" RadiusX="0.9" RadiusY="0.9">
                                                        <GradientStop Color="#28000000" Offset="0" />
                                                        <GradientStop Color="#1F000000" Offset="0.18" />
                                                        <GradientStop Color="#16000000" Offset="0.40" />
                                                        <GradientStop Color="#0D000000" Offset="0.62" />
                                                        <GradientStop Color="#05000000" Offset="0.82" />
                                                        <GradientStop Color="#00000000" Offset="1" />
                                                    </RadialGradientBrush>
                                                </Border.Background>
                                            </Border>
                                            <!-- 手机版：卡片缩小一档（行高 48 / 图标 28 / 内边距 10,6），一屏多露两行 -->
                                            <Grid Padding="10,6" ColumnSpacing="10">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="Auto" />
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="Auto" />
                                                </Grid.ColumnDefinitions>
                                                <!-- 版本方块图标块：与主页同款（取不到图标时留空底块） -->
                                                <Border x:Name="RowIconHost" Width="28" Height="28" CornerRadius="7"
                                                        VerticalAlignment="Center"
                                                        Background="{ThemeResource SubtleFillColorSecondaryBrush}">
                                                    <Grid>
                                                        <FontIcon FontFamily="{StaticResource ScIconFont}" Glyph="&#xECAF;" FontSize="13"
                                                                  Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                                        <Image Source="{x:Bind Icon}" Width="28" Height="28"
                                                               Stretch="Uniform" />
                                                    </Grid>
                                                </Border>
                                                <StackPanel Grid.Column="1" Spacing="1" VerticalAlignment="Center">
                                                    <TextBlock Text="{x:Bind Id}" FontSize="13" FontWeight="Medium"
                                                               TextTrimming="CharacterEllipsis" />
                                                    <TextBlock Text="{x:Bind TimeText}" FontSize="10.5"
                                                               TextTrimming="CharacterEllipsis"
                                                               Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                                </StackPanel>
                                                <TextBlock Grid.Column="2" Text="{x:Bind Badge}" FontSize="11"
                                                           VerticalAlignment="Center" Margin="8,0,2,0"
                                                           Foreground="{x:Bind BadgeBrush}" />
                                            </Grid>
                                        </Grid>
                                    </DataTemplate>
                                </ListView.Resources>
                            </ListView>
                        </Border>
                    </Grid>

                    <!-- 详情视图（PCL2 式：标题行 + 加载器抽屉 + 底部开始下载） -->
                    <Grid x:Name="DetailPanel" RowSpacing="12" Visibility="Collapsed">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <!-- 标题行：返回 + 草方块 + 版本号框 -->
                        <Grid Grid.Row="0" ColumnSpacing="12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <ctrl:GlowButton Click="Back_Click" Padding="10,8" CornerRadius="8"
                                    VerticalAlignment="Center"
                                    loc:Loc.Name="返回" loc:Loc.Tip="返回">
                                <FontIcon FontFamily="{StaticResource ScIconFont}" Glyph="&#xE908;" FontSize="14" />
                            </ctrl:GlowButton>
                            <!-- 版本图标（按类型：正式版草方块 / 快照紫水晶 / 远古版圆石与泥土） -->
                            <Grid x:Name="DetailIconHost" Grid.Column="1" Width="36" Height="36"
                                  VerticalAlignment="Center">
                                <FontIcon FontFamily="{StaticResource ScIconFont}" Glyph="&#xECAF;" FontSize="18"
                                          Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                <Image x:Name="DetailIcon" Width="36" Height="36" Stretch="Uniform" />
                            </Grid>
                            <Border Grid.Column="2" VerticalAlignment="Center"
                                    Background="{ThemeResource ControlFillColorDefaultBrush}"
                                    BorderBrush="{ThemeResource ControlStrokeColorDefaultBrush}"
                                    BorderThickness="1" CornerRadius="8" Padding="16,8">
                                <StackPanel Spacing="1">
                                    <TextBlock x:Name="DetailTitle" FontSize="18" FontWeight="Medium" />
                                    <TextBlock x:Name="DetailMeta" FontSize="11"
                                               Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                </StackPanel>
                            </Border>
                        </Grid>

                        <!-- 加载器抽屉（手风琴；选中任一构建后其余加载器锁定点不动） -->
                        <ScrollViewer Grid.Row="1" VerticalAlignment="Top"
                                      HorizontalScrollMode="Disabled">
                            <StackPanel Spacing="10">

                                <!-- Forge -->
                                <Expander x:Name="ForgeExpander" HorizontalAlignment="Stretch"
                                          HorizontalContentAlignment="Stretch">
                                    <Expander.Header>
                                        <Grid ColumnSpacing="12">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="*" />
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Text="Forge" FontWeight="Medium" VerticalAlignment="Center" />
                                            <TextBlock x:Name="ForgeStatus" Grid.Column="1" loc:Loc.Text="获取中…" FontSize="12"
                                                       VerticalAlignment="Center"
                                                       Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                        </Grid>
                                    </Expander.Header>
                                    <StackPanel Spacing="10" Padding="4,4,4,8">
                                        <ctrl:GlowButton x:Name="ForgeRecBtn" HorizontalAlignment="Stretch"
                                                HorizontalContentAlignment="Stretch" CornerRadius="8"
