<?xml version="1.0" encoding="utf-8" ?>
<!--
  壳根视图 · 手机版（横屏 + 左侧导航）：延续竖屏版的五格 tab 设计（图标+文字纵排、选中强调色），
  排到屏幕左缘：结构 = 44px 顶栏（品牌左 + NovaOrb/调度中心/个人中心右）+ 64px 左侧导航栏
  （首页/版本/下载/联机/我的竖排）+ 内容区 + 全宽底部抽屉（调度中心）+ 全宽底部面板（Nova）
  + 浮窗提醒/插件通知 + 全窗覆盖层（游戏页）。
  次级入口（存档/运行状态/账户/插件/Nova/日志/设置/插件导航组）收进「我的」聚合页（MorePage）。
  挖孔屏适配（P40 Pro 前摄）：锁定横屏下前摄落在屏幕左或右缘（随重力换边），
  MainActivity 捕获 DisplayCutout 安全内边距，壳把 RootGrid.Padding 设为该值（px→DIP），
  顶栏/底栏/内容整体避开摄像头；转向切换时经 CutoutChanged 事件即时重排。
  深浅主题由 AppearanceService 按设置应用（App 构造期初始化）。
-->
<UserControl x:Class="Starcloud.Launcher.Phone.ShellRootView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:beh="using:Starcloud.Launcher.Phone.Views.Behaviors"
             xmlns:ctrl="using:Starcloud.Launcher.Phone.Views.Controls"
             xmlns:loc="using:Starcloud.Launcher.Phone.Localization">

    <Grid x:Name="RootGrid">
        <Grid.RowDefinitions>
            <RowDefinition Height="44" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <!-- 顶栏：品牌左 + 系统按钮右（Nova / 调度中心 / 个人中心，与桌面端同一套语汇）。
             两列根网格下必须显式跨两列，否则会被塞进左侧导航那一列（64px）里。 -->
        <Grid x:Name="AppTitleBar" Grid.Row="0" Grid.ColumnSpan="2"
              Background="{ThemeResource AppPaneBackgroundBrush}">
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="12,0,0,0" Spacing="9">
                <!-- 品牌标记：浅底/深底两份主标记按主题自动换源 -->
                <ctrl:BrandMark Width="20" Height="20" VerticalAlignment="Center" />
                <TextBlock Text="Starcloud" FontWeight="Medium" FontSize="13"
                           VerticalAlignment="Center" />
                <!-- 测试版标识：启动器自身版本号（读程序集版本，见 ShellRootView.xaml.cs） -->
                <Border CornerRadius="5" Padding="5,1" VerticalAlignment="Center"
                        Background="{ThemeResource ControlFillColorSecondaryBrush}">
                    <TextBlock x:Name="VersionBadgeText" FontSize="10"
                               Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                               VerticalAlignment="Center" />
                </Border>
            </StackPanel>
        </Grid>

        <!-- 顶栏右侧：NovaOrb（点击展开全宽底部面板）+ 调度中心入口 + 个人中心入口（跨两列贴右） -->
        <StackPanel Orientation="Horizontal" Spacing="0"
                    Grid.Row="0" Grid.ColumnSpan="2" HorizontalAlignment="Right" VerticalAlignment="Stretch">
            <Button x:Name="NovaOrb" Width="40" Height="32" VerticalAlignment="Center" Margin="0,0,4,0"
                     Padding="0" CornerRadius="7"
                     Background="Transparent" BorderThickness="0"
                     beh:HoverShadowBehavior.IsEnabled="True"
                     beh:HoverShadowBehavior.GlowRadius="16"
                     beh:HoverShadowBehavior.Carrier="{Binding ElementName=NovaShadow}"
                     loc:Loc.Name="Nova 助手"
                     loc:Loc.Tip="Nova：待命"
                     Click="NovaOrb_Click">
                <Grid Width="28" Height="28">
                    <Border x:Name="NovaOrbRing" CornerRadius="7"
                            Background="{ThemeResource GlassCardBrush}"
                            BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                            BorderThickness="1" />
                    <!-- 内阴影层：悬停时渐显（加强档），触屏上作为按下反馈 -->
                    <Border x:Name="NovaShadow" CornerRadius="7"
                            Opacity="0" IsHitTestVisible="False">
                        <Border.Background>
                            <RadialGradientBrush Center="0.5,0.5" RadiusX="0.9" RadiusY="0.9">
                                <GradientStop Color="#3E000000" Offset="0" />
                                <GradientStop Color="#30000000" Offset="0.18" />
                                <GradientStop Color="#22000000" Offset="0.40" />
                                <GradientStop Color="#14000000" Offset="0.62" />
                                <GradientStop Color="#08000000" Offset="0.82" />
                                <GradientStop Color="#00000000" Offset="1" />
                            </RadialGradientBrush>
                        </Border.Background>
                    </Border>
                    <!-- Nova 图标 = 品牌标记（小尺寸版）；五态着色画在外圈描边上 -->
                    <ctrl:BrandMark Small="True" Width="14" Height="14"
                                     HorizontalAlignment="Center" VerticalAlignment="Center" />
                    <!-- 有提案：右上角 amber 小圆点 -->
                    <Ellipse x:Name="NovaOrbDot" Width="7" Height="7" Fill="#F59E0B"
                             HorizontalAlignment="Right" VerticalAlignment="Top"
                             Margin="0,2,2,0" Visibility="Collapsed" />
                </Grid>
            </Button>

            <!-- 调度中心入口：徽标 = 运行中任务数 -->
            <Button x:Name="TaskCenterBtn" Width="40" Height="32" VerticalAlignment="Center" Margin="0,0,4,0"
                    Padding="0" CornerRadius="7"
                    Background="Transparent" BorderThickness="0"
                    beh:HoverShadowBehavior.IsEnabled="True"
                    beh:HoverShadowBehavior.GlowRadius="16"
                    beh:HoverShadowBehavior.Carrier="{Binding ElementName=TaskCenterShadow}"
                    loc:Loc.Name="调度中心" loc:Loc.Tip="调度中心"
                    Click="TaskCenterBtn_Click">
                <Grid Width="28" Height="28">
                    <Border CornerRadius="7"
                            Background="{ThemeResource GlassCardBrush}"
                            BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                            BorderThickness="1" />
                    <Border x:Name="TaskCenterShadow" CornerRadius="7"
                            Opacity="0" IsHitTestVisible="False">
                        <Border.Background>
                            <RadialGradientBrush Center="0.5,0.5" RadiusX="0.9" RadiusY="0.9">
                                <GradientStop Color="#3E000000" Offset="0" />
                                <GradientStop Color="#30000000" Offset="0.18" />
                                <GradientStop Color="#22000000" Offset="0.40" />
                                <GradientStop Color="#14000000" Offset="0.62" />
                                <GradientStop Color="#08000000" Offset="0.82" />
                                <GradientStop Color="#00000000" Offset="1" />
                            </RadialGradientBrush>
                        </Border.Background>
                    </Border>
                    <!-- ic_message_allread（消息已读）：一个「已处理」的意象 -->
                    <FontIcon FontFamily="{StaticResource ScIconFont}" Glyph="&#xEC89;" FontSize="13"
                              Foreground="{ThemeResource TextFillColorPrimaryBrush}" />
                    <Border x:Name="TaskBadge" Background="{ThemeResource AccentFillColorDefaultBrush}"
                            CornerRadius="6" MinWidth="14" Height="14"
                            HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,-2,-3,0"
                            Padding="3,0" Visibility="Collapsed">
                        <TextBlock x:Name="TaskBadgeText" FontSize="8.5" FontWeight="Medium"
                                   Foreground="{ThemeResource TextOnAccentFillColorPrimaryBrush}"
                                   HorizontalAlignment="Center" />
                    </Border>
                </Grid>
            </Button>

            <Button x:Name="AccountButton" Width="40" Height="32" VerticalAlignment="Center" Margin="0,0,6,0"
                    Padding="0" CornerRadius="7"
                    Background="Transparent" BorderThickness="0"
                    beh:HoverShadowBehavior.IsEnabled="True"
                    beh:HoverShadowBehavior.GlowRadius="16"
                    beh:HoverShadowBehavior.Carrier="{Binding ElementName=AccountShadow}"
                    loc:Loc.Name="个人中心"
                    loc:Loc.Tip="个人中心"
                    Click="AccountButton_Click">
                <Grid Width="28" Height="28">
                    <Ellipse Fill="{ThemeResource CardBackgroundFillColorSecondaryBrush}" />
                    <Border x:Name="AccountShadow" CornerRadius="14"
                            Opacity="0" IsHitTestVisible="False">
                        <Border.Background>
                            <RadialGradientBrush Center="0.5,0.5" RadiusX="0.9" RadiusY="0.9">
                                <GradientStop Color="#3E000000" Offset="0" />
                                <GradientStop Color="#30000000" Offset="0.18" />
                                <GradientStop Color="#22000000" Offset="0.40" />
                                <GradientStop Color="#14000000" Offset="0.62" />
                                <GradientStop Color="#08000000" Offset="0.82" />
                                <GradientStop Color="#00000000" Offset="1" />
                            </RadialGradientBrush>
                        </Border.Background>
                    </Border>
                    <TextBlock x:Name="AccountAvatarText" FontSize="12" FontWeight="Medium"
                               HorizontalAlignment="Center" VerticalAlignment="Center" />
                    <FontIcon FontFamily="{StaticResource ScIconFont}" x:Name="AccountAvatarGlyph" Glyph="&#xEB8F;" FontSize="13"
                              Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                </Grid>
            </Button>
        </StackPanel>

        <!-- 左侧导航栏（延续竖屏版五格设计，横屏排到左侧）：图标 + 文字纵排的五个 tab
             竖排在屏幕左缘（挖孔在左时被 RootGrid 安全边距整体推开）。宽 64，每格 56 高；
             存档/运行状态/账户/插件/Nova/日志/设置与插件导航组收进「我的」聚合页（MorePage）。
             右缘 1px 分隔线与内容区分界（取同款卡片描边色）。 -->
        <Border Grid.Row="1" Grid.Column="0" Width="64" HorizontalAlignment="Left"
                Background="{ThemeResource AppPaneBackgroundBrush}"
                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                BorderThickness="0,0,1,0">
            <StackPanel Orientation="Vertical" Margin="0,4">
                <ctrl:BottomTabButton x:Name="TabHome" Tag2="home" Glyph="&#xEC77;" Label="首页"
                                      IsSelected="True" Tapped="BottomTab_Tapped" />
                <ctrl:BottomTabButton x:Name="TabVersions" Tag2="versions" Glyph="&#xEA94;" Label="版本"
                                      Tapped="BottomTab_Tapped" />
                <ctrl:BottomTabButton x:Name="TabDownload" Tag2="download" Glyph="&#xE90C;" Label="下载"
                                      Tapped="BottomTab_Tapped" />
                <ctrl:BottomTabButton x:Name="TabMultiplayer" Tag2="multiplayer" Glyph="&#xEB91;" Label="联机"
                                      Tapped="BottomTab_Tapped" />
                <ctrl:BottomTabButton x:Name="TabMore" Tag2="more" Glyph="&#xEB8F;" Label="我的"
                                      Tapped="BottomTab_Tapped" />
            </StackPanel>
        </Border>

        <!-- 内容区：单 Frame 承载全部路由页（左侧让开导航栏，留白 12/8） -->
        <Grid Grid.Row="1" Grid.Column="1" Padding="12,8,12,0">
            <Grid x:Name="ContentHost" Background="Transparent" />
        </Grid>

        <!-- 调度中心（手机版：全宽底部抽屉）：上遮罩（点击关闭）+ 底部面板（横屏限高 340，
             436 逻辑高下留出顶栏可见）。结构与平板版一致 = 标题行 → 状态行 → 调度队列 + 历史通知；
             Esc 走 KeyboardAccelerator（Uno 触屏无键盘时自然不触发）。
             入场动效由 MotionService 开关控制（关闭动效时不加任何转场）。 -->
        <Grid x:Name="TaskCenterOverlay" Grid.Row="0" Grid.RowSpan="2" Visibility="Collapsed">
            <Grid.KeyboardAccelerators>
                <KeyboardAccelerator Key="Escape" Invoked="TaskCenterEscape_Invoked" />
            </Grid.KeyboardAccelerators>
            <Grid.RowDefinitions>
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>
            <Rectangle x:Name="TaskCenterScrim" Grid.Row="0" Fill="#5A000000"
                       Tapped="TaskCenterScrim_Tapped" />
            <Border x:Name="TaskCenterDrawer" Grid.Row="1" MaxHeight="340"
                    HorizontalAlignment="Stretch"
                    Background="{ThemeResource AppPaneBackgroundBrush}"
                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                    BorderThickness="0,1,0,0"
                    CornerRadius="14,14,0,0">
                <Grid Margin="16,12,12,10" RowSpacing="8">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <!-- 标题行 -->
                    <Grid Grid.Row="0" ColumnSpacing="9">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                            <FontIcon FontFamily="{StaticResource ScIconFont}" Glyph="&#xEC89;" FontSize="14"
                                      Foreground="{ThemeResource AccentFillColorDefaultBrush}" />
                            <TextBlock loc:Loc.Text="调度中心" FontSize="15" FontWeight="Medium"
                                       VerticalAlignment="Center" />
                        </StackPanel>
                        <ctrl:GlowButton x:Name="TaskCenterCloseBtn" Grid.Column="1"
                                         Padding="9" MinWidth="34" MinHeight="34" VerticalAlignment="Center"
                                         Background="Transparent" BorderThickness="0"
                                         loc:Loc.Name="关闭" Click="TaskCenterClose_Click">
                            <FontIcon FontFamily="{StaticResource ScIconFont}" Glyph="&#xEA86;" FontSize="12"
                                      Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                        </ctrl:GlowButton>
                    </Grid>

                    <!-- 状态行：进行中任务数 / 记录条数 -->
                    <TextBlock Grid.Row="1" x:Name="TaskSummaryText" FontSize="10.5"
                               Margin="2,-4,0,0" TextWrapping="NoWrap"
                               Foreground="{ThemeResource TextFillColorSecondaryBrush}" />

                    <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto"
                                  Padding="0,0,6,0" loc:Loc.Name="任务列表">
                        <StackPanel>
                            <!-- 调度队列：正在执行的任务卡（进度 / 速度 / 多源贡献带） -->
                            <TextBlock loc:Loc.Text="调度队列" FontSize="13" FontWeight="Medium"
                                       Margin="2,0,0,6" />
                            <StackPanel x:Name="TaskRunningHost" Spacing="2" />

                            <!-- 队列为空：极简空态（图标 + 无） -->
                            <StackPanel x:Name="QueueEmptyHost" Spacing="6" Margin="0,22,0,20">
                                <FontIcon FontFamily="{StaticResource ScIconFont}" Glyph="&#xEC70;" FontSize="20" HorizontalAlignment="Center"
                                          Foreground="{ThemeResource TextFillColorTertiaryBrush}" />
                                <TextBlock loc:Loc.Text="无" FontSize="12" HorizontalAlignment="Center"
                                           Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                            </StackPanel>

                            <!-- 历史通知：任务收尾与启动器提示的时间流水 -->
                            <Grid Margin="2,16,0,6">
                                <TextBlock loc:Loc.Text="历史通知" FontSize="13" FontWeight="Medium"
                                           VerticalAlignment="Center" />
                                <ctrl:GlowButton x:Name="NoticeClearBtn" HorizontalAlignment="Right"
                                                 Visibility="Collapsed" loc:Loc.Text="清空通知"
                                                 FontSize="12" Padding="8,2" MinWidth="0" MinHeight="0"
                                                 VerticalAlignment="Center"
                                                 Background="Transparent" BorderThickness="0"
                                                 Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                                 Click="NoticeClear_Click" />
                            </Grid>
                            <StackPanel x:Name="NoticeHost" Spacing="6" />
                        </StackPanel>
                    </ScrollViewer>
                </Grid>
            </Border>
        </Grid>

        <!-- ① Nova 面板：手机版全宽底部面板（左右留 12 边距、圆角顶边，横屏限高 400），复用 NovaChatView。
             安卓 Popup 天生限制在窗口内。 -->
        <Popup x:Name="NovaPopup" IsLightDismissEnabled="True" AllowFocusOnInteraction="True">
            <Border x:Name="NovaPanelHost" MaxHeight="400" CornerRadius="14" Padding="14"
                    Margin="12,0,12,0"
                    HorizontalAlignment="Stretch"
                    Background="{ThemeResource SolidBackgroundFillColorBaseBrush}"
                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                    BorderThickness="1">
                <Grid RowSpacing="8">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <!-- 标头：头像 + 名字 + 副标题 + 去 Nova 页 -->
                    <Grid Grid.Row="0" ColumnSpacing="9">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <Border Grid.Column="0" Width="30" Height="30" CornerRadius="7"
                                Background="{ThemeResource LayerFillColorDefaultBrush}"
                                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                BorderThickness="1">
                            <!-- Nova 图标 = 品牌标记（多色，字形画不出来） -->
                            <ctrl:BrandMark Small="True" Width="14" Height="14"
                                             HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="1">
                            <TextBlock Text="Nova" FontWeight="Medium" FontSize="13" />
                            <!-- 云端额度：登录后常驻一行（安卓暂无网关通道，保持隐藏，见 RefreshPanelQuota） -->
                            <TextBlock x:Name="NovaPanelQuota" FontSize="10.5" Visibility="Collapsed"
                                       TextTrimming="CharacterEllipsis"
                                       Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                        </StackPanel>
                        <ctrl:GlowButton Grid.Column="2" Padding="8" MinWidth="34" MinHeight="34" VerticalAlignment="Center"
                                         Background="Transparent" BorderThickness="0"
                                         loc:Loc.Name="打开 Nova 页"
                                         loc:Loc.Tip="打开 Nova 页（许可层 / 操作日志 / LLM 设置）"
                                         Click="NovaPanelSettings_Click">
                            <FontIcon FontFamily="{StaticResource ScIconFont}" Glyph="&#xEC04;" FontSize="12"
                                      Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                        </ctrl:GlowButton>
                    </Grid>

                    <!-- 未登录：引导去 Nova 页登录 -->
                    <StackPanel Grid.Row="1" x:Name="NovaPanelLogin" Spacing="8"
                                VerticalAlignment="Center" Visibility="Collapsed">
                        <TextBlock loc:Loc.Text="Nova 尚未登录" FontWeight="Medium" FontSize="13" />
                        <TextBlock loc:Loc.Text="登录 Starcloud ID 后可使用云端模型，以及邀请、时刻等在线能力；凭据只保存在本机。"
                                   FontSize="11.5" TextWrapping="Wrap"
                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                        <Button Style="{StaticResource AccentButtonStyle}" loc:Loc.Text="去 Nova 页登录"
                                Click="NovaPanelLogin_Click" />
                    </StackPanel>

                    <!-- 已登录：对话（复用 NovaChatView） -->
                    <ctrl:NovaChatView Grid.Row="1" x:Name="NovaPanelChat" />
                </Grid>
            </Border>
        </Popup>

        <!-- 浮窗提醒：替代原状态栏 Nova 指示（TeachingTip；运行期异常再降级 InfoBar） -->
        <TeachingTip x:Name="NovaToastTip" Grid.Row="0" IsOpen="False"
                     PreferredPlacement="Bottom" IsLightDismissEnabled="True" Title="Nova" />

        <!-- 插件通知（launcher:notification）：内容区底部自动收起的信息条 -->
        <InfoBar x:Name="PluginNotifyTip" Grid.Row="1" Grid.Column="1" IsOpen="False" IsClosable="True"
                 Severity="Informational" HorizontalAlignment="Stretch" VerticalAlignment="Bottom"
                 Margin="12,0,12,8" />

        <!-- 全窗覆盖层：游戏页（后声明 = 视觉在内容区与导航栏之上，铺满整窗） -->
        <ContentControl x:Name="OverlayHost" Grid.Row="0" Grid.RowSpan="2" Grid.ColumnSpan="2"
                        Visibility="Collapsed"
                        HorizontalContentAlignment="Stretch"
                        VerticalContentAlignment="Stretch" />
    </Grid>

</UserControl>
