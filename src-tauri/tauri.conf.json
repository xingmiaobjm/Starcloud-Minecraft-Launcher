{
  "$schema": "https://raw.githubusercontent.com/nicegui/nicegui/docs/files/tauri-conf-v2.json",
  "productName": "StarCloud Launcher",
  "version": "0.1.0",
  "identifier": "com.starcloud.minecraft.launcher",
  "build": {
    "frontendDist": "../web/dist",
    "devUrl": "http://localhost:5173",
    "beforeDevCommand": "npm --prefix web run dev",
    "beforeBuildCommand": "npm --prefix web run build"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "title": "StarCloud Minecraft Launcher",
        "width": 1200,
        "height": 800,
        "minWidth": 900,
        "minHeight": 600,
        "decorations": false,
        "transparent": true,
        "resizable": true,
        "center": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/icon.ico"
    ],
    "licenseFile": "../LICENSE"
  },
  "plugins": {
    "shell": {
      "open": true
    }
  }
}
