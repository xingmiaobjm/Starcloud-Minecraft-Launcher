<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows10.0.19041.0</TargetFramework>
    <TargetPlatformMinVersion>10.0.17763.0</TargetPlatformMinVersion>
    <RootNamespace>Starcloud.App</RootNamespace>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <Platforms>x64</Platforms>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <UseWinUI>true</UseWinUI>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <EnableMsixTooling>true</EnableMsixTooling>
    <WindowsPackageType>None</WindowsPackageType>
    <WindowsAppSdkSelfContained>true</WindowsAppSdkSelfContained>
    <SelfContained>true</SelfContained>
    <DefaultLanguage>zh-CN</DefaultLanguage>
    <!-- 启动器自身版本（当前为测试版）：标题栏「测试版 V0.2.1」标识与安装包命名的唯一来源 -->
    <Version>0.2.1</Version>
    <!-- 应用图标（占位符，由 tools/gen-app-icon.ps1 生成）：同时嵌入 exe 资源供资源管理器/安装器使用 -->
    <ApplicationIcon>Assets\AppIcon.ico</ApplicationIcon>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Graphics.Win2D" Version="1.4.0" />
    <PackageReference Include="Microsoft.WindowsAppSDK" Version="1.8.260804001" />
    <PackageReference Include="Microsoft.Windows.SDK.BuildTools" Version="10.0.26100.4654" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Starcloud.Core\Starcloud.Core.csproj" />
  </ItemGroup>

  <!-- 内置壁纸（D1 自定义背景）：随输出目录发布，按 AppContext.BaseDirectory 解析 -->
  <ItemGroup>
    <Content Include="Assets\Wallpapers\*.jpg" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <!-- 应用图标：MainWindow 用 AppWindow.SetIcon 按 AppContext.BaseDirectory 加载，须随输出目录发布 -->
  <ItemGroup>
    <Content Include="Assets\AppIcon.ico" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <!-- 本地化词典（D3）：嵌入式资源，逻辑名 Starcloud.App.Strings.<lang>.json -->
  <ItemGroup>
    <EmbeddedResource Include="Strings\*.json" />
  </ItemGroup>

  <!-- 版本图标（PCL2 式等距方块渲染图）：从仓库根 MC-Icons 链接发布到 Assets/MC-Icons，不复制源文件 -->
  <ItemGroup>
    <Content Include="..\..\..\MC-Icons\07-Mini-Blocks-128px\natural_grass_block.png"
             Link="Assets\MC-Icons\natural_grass_block.png" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="..\..\..\MC-Icons\07-Mini-Blocks-128px\block_of_amethyst.png"
             Link="Assets\MC-Icons\block_of_amethyst.png" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="..\..\..\MC-Icons\07-Mini-Blocks-128px\masonry_cobblestone.png"
             Link="Assets\MC-Icons\masonry_cobblestone.png" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="..\..\..\MC-Icons\07-Mini-Blocks-128px\natural_dirt.png"
             Link="Assets\MC-Icons\natural_dirt.png" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

</Project>
