<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows10.0.19041.0</TargetFramework>
    <TargetPlatformMinVersion>10.0.17763.0</TargetPlatformMinVersion>
    <RootNamespace>Starcloud.App</RootNamespace>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <Platforms>x64</Platforms>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <UseWinUI>true</UseWinUI>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <EnableMsixTooling>true</EnableMsixTooling>
    <WindowsPackageType>None</WindowsPackageType>
    <WindowsAppSdkSelfContained>true</WindowsAppSdkSelfContained>
    <SelfContained>true</SelfContained>
    <DefaultLanguage>zh-CN</DefaultLanguage>
    <!-- 启动器自身版本（当前为测试版 V0.3.2）：标题栏版本标识与安装包/更新清单命名的唯一来源 -->
    <Version>0.3.2</Version>
    <!-- 应用图标（品牌标记，由 tools/gen-app-icon.ps1 生成）：嵌入 exe 资源供资源管理器/任务栏/安装器使用 -->
    <ApplicationIcon>Assets\AppIcon.ico</ApplicationIcon>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Graphics.Win2D" Version="1.4.0" />
    <PackageReference Include="Microsoft.WindowsAppSDK" Version="1.8.260804001" />
    <PackageReference Include="Microsoft.Windows.SDK.BuildTools" Version="10.0.26100.4654" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Starcloud.Core\Starcloud.Core.csproj" />
  </ItemGroup>

  <!-- 内置壁纸（D1 自定义背景）：随输出目录发布，按 AppContext.BaseDirectory 解析 -->
  <ItemGroup>
    <Content Include="Assets\Wallpapers\*.jpg" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <!-- 应用图标：MainWindow 用 AppWindow.SetIcon 按 AppContext.BaseDirectory 加载，须随输出目录发布 -->
  <ItemGroup>
    <Content Include="Assets\AppIcon.ico" CopyToOutputDirectory="PreserveNewest" />
    <!-- 默认玩家皮肤（Steve）：账户页 3D 形象在无网络 / 皮肤源失败时的兜底 -->
    <Content Include="Assets\steve.png" CopyToOutputDirectory="PreserveNewest" />
    <!-- 默认皮肤（9 个官方默认角色，wide/slim 按官方版型各取一套）：账户详情页「默认皮肤」卡片 -->
    <Content Include="Assets\Skins\**\*" CopyToOutputDirectory="PreserveNewest" />
    <!-- 品牌标记：标题栏左上角按主题加载这两份；与 starcloud-brand/mark/export/ 下的同名文件一致，
         改品牌时整份替换即可。
         starcloud-mark-small.svg（16–24px 单块版）同时是 gen-app-icon.ps1 的输入和运行时的
         Nova 图标（BrandMark Small="True"、导航项 ImageIcon），所以也要随输出目录发布。 -->
    <Content Include="Assets\Brand\starcloud-mark-light.svg" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="Assets\Brand\starcloud-mark-dark.svg" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="Assets\Brand\starcloud-mark-small.svg" CopyToOutputDirectory="PreserveNewest" />
    <!-- 3D 玩家形象：skinview3d 引擎 bundle + 宿主页（WebView2 经 app3d.local 虚拟域加载） -->
    <Content Include="Assets\3d\**\*" CopyToOutputDirectory="PreserveNewest" />
    <!-- authlib-injector（第三方认证）：LaunchOptions -javaagent 注入，随输出目录发布 -->
    <Content Include="Assets\authlib-injector\**\*" CopyToOutputDirectory="PreserveNewest" />
    <!-- Python 插件宿主 SDK（plugin-spec.md）：main.py 插件经进程外协议加载 -->
    <Content Include="Assets\pluginsdk\**\*" CopyToOutputDirectory="PreserveNewest" />
    <!-- HarmonyOS 图标库字体（字体图标）：FontIcon 经 ms-appx 加载，必须随输出目录发布；
         同目录的 LICENSE 说明来源与许可（MIT）。 -->
    <Content Include="Assets\Fonts\**\*" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <!-- 本地化词典（D3）：嵌入式资源，逻辑名 Starcloud.App.Strings.<lang>.json -->
  <ItemGroup>
    <EmbeddedResource Include="Strings\*.json" />
  </ItemGroup>

  <!-- 版本图标（PCL2 式等距方块渲染图）：从仓库根 MC-Icons 链接发布到 Assets/MC-Icons，不复制源文件 -->
  <ItemGroup>
    <Content Include="..\..\..\MC-Icons\07-Mini-Blocks-128px\natural_grass_block.png"
             Link="Assets\MC-Icons\natural_grass_block.png" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="..\..\..\MC-Icons\07-Mini-Blocks-128px\block_of_amethyst.png"
             Link="Assets\MC-Icons\block_of_amethyst.png" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="..\..\..\MC-Icons\07-Mini-Blocks-128px\masonry_cobblestone.png"
             Link="Assets\MC-Icons\masonry_cobblestone.png" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="..\..\..\MC-Icons\07-Mini-Blocks-128px\natural_dirt.png"
             Link="Assets\MC-Icons\natural_dirt.png" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="..\..\..\MC-Icons\03-Loaders\fabric.png"
             Link="Assets\MC-Icons\fabric.png" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="..\..\..\MC-Icons\03-Loaders\forge.png"
             Link="Assets\MC-Icons\forge.png" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="..\..\..\MC-Icons\03-Loaders\neoforge.png"
             Link="Assets\MC-Icons\neoforge.png" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="..\..\..\MC-Icons\03-Loaders\quilt.png"
             Link="Assets\MC-Icons\quilt.png" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

</Project>
