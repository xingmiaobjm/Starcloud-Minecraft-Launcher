<ContentDialog
    x:Class="Starcloud.App.Views.Dialogs.ContentDownloadDialog"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:ctrl="using:Starcloud.App.Views.Controls"
    xmlns:loc="using:Starcloud.App.Localization"
    Style="{ThemeResource DefaultContentDialogStyle}">
    <ContentDialog.Resources>
        <!-- 版本芯片（参考 PCL2 版本筛选）：圆角矩形 + accent 文字，选中态由代码切换为 accent 实底 -->
        <Style x:Key="ChipStyle" TargetType="Button">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Foreground" Value="{ThemeResource AccentTextFillColorPrimaryBrush}" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="CornerRadius" Value="8" />
            <Setter Property="Padding" Value="12,5" />
            <Setter Property="FontSize" Value="13" />
        </Style>
    </ContentDialog.Resources>

    <Grid RowSpacing="12" Width="1240">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- 顶行：左 = 安装目标 + 返回搜索结果，右 = 搜索框 -->
        <Grid Grid.Row="0" ColumnSpacing="12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="14" VerticalAlignment="Center">
                <!-- 安装目标常显：主页选中的版本（整合包为新建版本说明） -->
                <TextBlock x:Name="DlTarget" FontSize="12" Opacity="0.85" VerticalAlignment="Center"
                           Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                <ctrl:GlowButton x:Name="DownloadBack" Click="DownloadBack_Click" loc:Loc.Name="返回搜索结果"
                        Background="Transparent" BorderThickness="0" Padding="6,2" Margin="-6,0,0,0"
                        VerticalAlignment="Center" Visibility="Collapsed">
                    <StackPanel Orientation="Horizontal" Spacing="6">
                        <FontIcon FontFamily="{StaticResource ScIconFont}" Glyph="&#xE908;" FontSize="13" />
                        <TextBlock loc:Loc.Text="返回搜索结果" FontSize="12" />
                    </StackPanel>
                </ctrl:GlowButton>
            </StackPanel>
            <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                <!-- 本弹窗只做「按版本筛选 + 安装」：来源由入口决定，搜索框已移除，
                     打开即展示该来源的默认列表（缓存优先），不再让用户手动触发 -->
            </StackPanel>
        </Grid>
        <InfoBar Grid.Row="1" x:Name="DlInfoBar" IsOpen="False" IsClosable="True" />
        <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto" MaxHeight="760"
                      HorizontalScrollMode="Disabled">
            <StackPanel Spacing="12">

                <!-- 项目详情卡（PCL2 样式） -->
                <StackPanel x:Name="DownloadDetail" Spacing="12" Visibility="Collapsed">
                    <Border Background="{ThemeResource SubtleFillColorSecondaryBrush}"
                            CornerRadius="12" Padding="12">
                        <StackPanel Spacing="10">
                            <Grid ColumnSpacing="12">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <Border Width="56" Height="56" CornerRadius="10"
                                        Background="{ThemeResource SubtleFillColorTertiaryBrush}">
                                    <Grid>
                                        <Image x:Name="DlIcon" Width="56" Height="56" Stretch="Uniform"
                                               Visibility="Collapsed" />
                                        <FontIcon FontFamily="{StaticResource ScIconFont}" x:Name="DlIconFallback" Glyph="&#xEC62;" FontSize="22"
                                                  Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                    </Grid>
                                </Border>
                                <StackPanel Grid.Column="1" Spacing="4">
                                    <TextBlock x:Name="DlTitle" FontSize="16" FontWeight="Medium"
                                               TextWrapping="Wrap" />
                                    <TextBlock x:Name="DlDesc" FontSize="12" TextWrapping="Wrap" MaxLines="2"
                                               TextTrimming="CharacterEllipsis"
                                               Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                    <StackPanel Orientation="Horizontal" Spacing="14">
                                        <TextBlock x:Name="DlMeta1" FontSize="12"
                                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                        <TextBlock x:Name="DlMeta2" FontSize="12"
                                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                        <TextBlock x:Name="DlMeta3" FontSize="12"
                                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                        <TextBlock x:Name="DlMeta4" FontSize="12"
                                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                    </StackPanel>
                                </StackPanel>
                            </Grid>
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <ctrl:GlowButton Click="DlModrinth_Click" loc:Loc.Name="转到 Modrinth">
                                    <StackPanel Orientation="Horizontal" Spacing="6">
                                        <FontIcon FontFamily="{StaticResource ScIconFont}" Glyph="&#xE973;" FontSize="13" />
                                        <TextBlock loc:Loc.Text="转到 Modrinth" FontSize="12" />
                                    </StackPanel>
                                </ctrl:GlowButton>
                                <ctrl:GlowButton Click="DlWiki_Click" loc:Loc.Name="转到 MC 百科">
                                    <StackPanel Orientation="Horizontal" Spacing="6">
                                        <FontIcon FontFamily="{StaticResource ScIconFont}" Glyph="&#xEBA2;" FontSize="13" />
                                        <TextBlock loc:Loc.Text="转到 MC 百科" FontSize="12" />
                                    </StackPanel>
                                </ctrl:GlowButton>
                                <ctrl:GlowButton Click="DlCopy_Click" loc:Loc.Name="复制名称">
                                    <StackPanel Orientation="Horizontal" Spacing="6">
                                        <FontIcon FontFamily="{StaticResource ScIconFont}" Glyph="&#xEA9F;" FontSize="13" />
                                        <TextBlock loc:Loc.Text="复制名称" FontSize="12" />
                                    </StackPanel>
                                </ctrl:GlowButton>
                            </StackPanel>
                        </StackPanel>
                    </Border>

                    <!-- 前置资源（PCL 风格）：和「自动安装前置」开关无关，始终展示 -->
                    <StackPanel x:Name="DlDepsSection" Spacing="6" Visibility="Collapsed">
                        <TextBlock loc:Loc.Text="前置资源" FontSize="13" FontWeight="Medium"
                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}" Margin="2,0,0,0" />
                        <StackPanel x:Name="DlDepsList" Spacing="6" />
                    </StackPanel>

                    <!-- 版本芯片行（MC 版本筛选，默认当前版本） -->
                    <ScrollViewer HorizontalScrollMode="Auto" HorizontalScrollBarVisibility="Hidden"
                                  VerticalScrollMode="Disabled">
                        <StackPanel x:Name="DlVersionChips" Orientation="Horizontal" Spacing="4" />
                    </ScrollViewer>

                    <!-- 版本分组（展开后可下载安装） -->
                    <StackPanel x:Name="DlVersionList" Spacing="8" />
                </StackPanel>

                <!-- 搜索结果列表 -->
                <StackPanel x:Name="DownloadResults" Spacing="8" />
                <TextBlock x:Name="DlEmpty" loc:Loc.Text="没有找到匹配的资源" FontSize="12" Margin="0,4"
                           HorizontalAlignment="Center" Visibility="Collapsed"
                           Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
            </StackPanel>
        </ScrollViewer>

        <!-- 缺少前置的确认层（版式对齐参考稿：标题 + 说明 + 逐项依赖行 + 三个操作按钮）。
             同一个 XamlRoot 不能再开第二个 ContentDialog，所以做成同窗浮层。 -->
        <Grid x:Name="DepPrompt" Grid.RowSpan="3" Visibility="Collapsed"
              Background="{ThemeResource SmokeFillColorDefaultBrush}" Canvas.ZIndex="10">
            <Border Background="{ThemeResource SolidBackgroundFillColorBaseBrush}"
                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1"
                    CornerRadius="16" Padding="28,24" Width="620" MaxHeight="640"
                    Translation="0,0,40"
                    HorizontalAlignment="Center" VerticalAlignment="Center">
                <Border.Shadow>
                    <ThemeShadow />
                </Border.Shadow>
                <StackPanel Spacing="14">
                    <StackPanel Spacing="6">
                        <TextBlock loc:Loc.Text="缺少前置模组" FontSize="22" FontWeight="SemiBold" />
                        <TextBlock loc:Loc.Text="当前的模组需要前置模组" FontSize="13"
                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                    </StackPanel>

                    <ScrollViewer VerticalScrollBarVisibility="Auto" MaxHeight="380">
                        <StackPanel x:Name="DepPromptList" Spacing="4" />
                    </ScrollViewer>

                    <StackPanel Orientation="Horizontal" Spacing="10" HorizontalAlignment="Right">
                        <ctrl:GlowButton Click="DepPromptCancel_Click" loc:Loc.Text="取消"
                                         MinWidth="96" Height="36" HorizontalContentAlignment="Center" />
                        <ctrl:GlowButton Click="DepPromptSkip_Click" loc:Loc.Text="不安装前置模组"
                                         MinWidth="148" Height="36" HorizontalContentAlignment="Center" />
                        <ctrl:GlowButton Click="DepPromptAuto_Click" loc:Loc.Text="自动安装前置模组"
                                         MinWidth="164" Height="36" HorizontalContentAlignment="Center"
                                         Background="{ThemeResource AccentFillColorDefaultBrush}"
                                         Foreground="{ThemeResource TextOnAccentFillColorPrimaryBrush}" />
                    </StackPanel>
                </StackPanel>
            </Border>
        </Grid>
    </Grid>
</ContentDialog>
