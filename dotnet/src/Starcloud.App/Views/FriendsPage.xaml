<?xml version="1.0" encoding="utf-8"?>
<!-- 好友页：严格按 QQ 的两栏交互 —— 左「会话列表」、右「聊天」。
     好友申请 / 联机邀请是会话列表顶部的系统会话；添加好友走左上「+」；
     聊天头「⋯」里是邀请联机 / 删除好友。联机板块嵌在第二个标签。
     后端：starcloudfur.cn /v1/friends/*（好友、申请、搜索、邀请、消息、SSE）。 -->
<Page
    x:Class="Starcloud.App.Views.FriendsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:ctrl="using:Starcloud.App.Views.Controls"
    xmlns:loc="using:Starcloud.App.Localization"
    NavigationCacheMode="Disabled">

    <Page.Resources>
        <!-- 会话行：头像 + 名字/最后一条消息 + 时间/未读 -->
        <DataTemplate x:Key="ConversationRowTemplate">
            <Grid ColumnSpacing="10" Padding="8,7">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <Border Width="38" Height="38" CornerRadius="19"
                        Background="{ThemeResource AccentFillColorDefaultBrush}">
                    <Grid>
                        <TextBlock Text="{Binding Initial}" FontSize="16" FontWeight="Medium"
                                   Foreground="{ThemeResource TextOnAccentFillColorPrimaryBrush}"
                                   HorizontalAlignment="Center" VerticalAlignment="Center"
                                   Visibility="{Binding LetterVisibility}" />
                        <Image Source="{Binding IconSource}" Width="22" Height="22"
                               Visibility="{Binding IconVisibility}" />
                    </Grid>
                </Border>
                <StackPanel Grid.Column="1" Spacing="2" VerticalAlignment="Center">
                    <TextBlock Text="{Binding Name}" FontSize="14" FontWeight="Medium"
                               TextTrimming="CharacterEllipsis" />
                    <TextBlock Text="{Binding Preview}" FontSize="11"
                               Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                               TextTrimming="CharacterEllipsis" />
                </StackPanel>
                <StackPanel Grid.Column="2" Spacing="4" VerticalAlignment="Center"
                            HorizontalAlignment="Right">
                    <TextBlock Text="{Binding TimeText}" FontSize="10"
                               Foreground="{ThemeResource TextFillColorTertiaryBrush}" />
                    <Border Style="{StaticResource ScChip}" HorizontalAlignment="Right"
                            Visibility="{Binding UnreadVisibility}"
                            Background="{ThemeResource SystemFillColorCriticalBrush}">
                        <TextBlock Text="{Binding UnreadText}" FontSize="10" Foreground="White" />
                    </Border>
                </StackPanel>
            </Grid>
        </DataTemplate>

        <!-- 对方消息：头像在左，灰底气泡 -->
        <DataTemplate x:Key="TheirBubble">
            <StackPanel Orientation="Horizontal" Spacing="8" HorizontalAlignment="Left">
                <Border Width="32" Height="32" CornerRadius="16" VerticalAlignment="Top"
                        Background="{ThemeResource AccentFillColorDefaultBrush}">
                    <TextBlock Text="{Binding SenderInitial}" FontSize="14"
                               Foreground="{ThemeResource TextOnAccentFillColorPrimaryBrush}"
                               HorizontalAlignment="Center" VerticalAlignment="Center" />
                </Border>
                <Border MaxWidth="520" CornerRadius="10" Padding="10,7"
                        Background="{ThemeResource ControlFillColorSecondaryBrush}">
                    <TextBlock Text="{Binding Content}" TextWrapping="Wrap" FontSize="13"
                               IsTextSelectionEnabled="True" />
                </Border>
            </StackPanel>
        </DataTemplate>

        <!-- 自己的消息：品牌色气泡在左，头像在右 -->
        <DataTemplate x:Key="MineBubble">
            <StackPanel Orientation="Horizontal" Spacing="8" HorizontalAlignment="Right">
                <Border MaxWidth="520" CornerRadius="10" Padding="10,7"
                        Background="{ThemeResource AccentFillColorDefaultBrush}">
                    <TextBlock Text="{Binding Content}" TextWrapping="Wrap" FontSize="13"
                               IsTextSelectionEnabled="True"
                               Foreground="{ThemeResource TextOnAccentFillColorPrimaryBrush}" />
                </Border>
                <Border Width="32" Height="32" CornerRadius="16" VerticalAlignment="Top"
                        Background="{ThemeResource ControlFillColorSecondaryBrush}">
                    <TextBlock Text="{Binding SenderInitial}" FontSize="14"
                               HorizontalAlignment="Center" VerticalAlignment="Center" />
                </Border>
            </StackPanel>
        </DataTemplate>

        <!-- 时间分隔：和 QQ 一样居中显示 -->
        <DataTemplate x:Key="TimeSeparator">
            <TextBlock Text="{Binding TimeText}" FontSize="10" Margin="0,6"
                       HorizontalAlignment="Center"
                       Foreground="{ThemeResource TextFillColorTertiaryBrush}" />
        </DataTemplate>

        <ctrl:ChatMessageTemplateSelector x:Key="MessageSelector"
                                          TheirsTemplate="{StaticResource TheirBubble}"
                                          MineTemplate="{StaticResource MineBubble}"
                                          SeparatorTemplate="{StaticResource TimeSeparator}" />
    </Page.Resources>

    <Grid MaxWidth="1500" HorizontalAlignment="Stretch">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <InfoBar x:Name="StatusBar" Grid.Row="0" Margin="0,0,0,12"
                 Severity="Informational" IsOpen="False" IsClosable="True" />

        <!-- 好友 / 联机 两个板块同页：联机页整页嵌在第二个标签里，导航栏不再单列「联机」 -->
        <SelectorBar x:Name="SectionSelector" Grid.Row="1" Margin="0,0,0,12">
            <SelectorBarItem x:Name="FriendsTab" IsSelected="True" />
            <SelectorBarItem x:Name="MultiplayerTab" />
        </SelectorBar>

        <Grid Grid.Row="2">
            <!-- 未登录 -->
            <Border x:Name="SignedOutCard" Style="{StaticResource ScCard}" Visibility="Collapsed"
                    VerticalAlignment="Top" HorizontalAlignment="Stretch">
                <StackPanel Spacing="12">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <Border Style="{StaticResource ScSectionSpine}" />
                        <TextBlock loc:Loc.Text="好友" Style="{StaticResource ScSectionTitle}" />
                    </StackPanel>
                    <TextBlock loc:Loc.Text="登录 Starcloud ID 后即可添加好友、聊天和接收联机邀请。"
                               Style="{StaticResource ScCardHint}" />
                    <Button x:Name="GoLoginBtn" loc:Loc.Text="去登录"
                            Style="{StaticResource ScAccentButtonStyle}" FontWeight="Medium"
                            Click="GoLogin_Click" />
                </StackPanel>
            </Border>

            <!-- 左：会话列表 | 右：聊天 -->
            <Grid x:Name="ChatRoot" ColumnSpacing="12">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="300" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <Border Grid.Column="0" Style="{StaticResource ScCard}" Padding="0">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>
                        <Grid Padding="12,10,8,6" ColumnSpacing="6">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBox x:Name="FilterBox" loc:Loc.Placeholder="搜索好友"
                                     TextChanged="FilterBox_TextChanged" />
                            <Button x:Name="AddBtn" Grid.Column="1" Width="34" Height="32" Padding="0"
                                    FontSize="18" VerticalAlignment="Center"
                                    loc:Loc.Name="添加好友">
                                <Button.Flyout>
                                    <MenuFlyout>
                                        <MenuFlyoutItem x:Name="AddFriendMenuItem" loc:Loc.Text="添加好友"
                                                        Click="AddFriendMenu_Click" />
                                        <MenuFlyoutItem x:Name="RequestsMenuItem" loc:Loc.Text="好友申请"
                                                        Click="RequestsMenu_Click" />
                                        <MenuFlyoutItem x:Name="InvitesMenuItem" loc:Loc.Text="联机邀请"
                                                        Click="InvitesMenu_Click" />
                                    </MenuFlyout>
                                </Button.Flyout>
                                <FontIcon Glyph="&#xE710;" FontSize="14" />
                            </Button>
                        </Grid>
                        <TextBlock Grid.Row="1" x:Name="FriendCountText" Margin="14,0,14,4"
                                   FontSize="11"
                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                        <ListView Grid.Row="2" x:Name="ConversationList"
                                  SelectionMode="Single"
                                  ItemTemplate="{StaticResource ConversationRowTemplate}"
                                  SelectionChanged="Conversation_SelectionChanged">
                            <ListView.ItemContainerStyle>
                                <Style TargetType="ListViewItem">
                                    <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                                    <Setter Property="MinHeight" Value="0" />
                                    <Setter Property="Padding" Value="0" />
                                    <Setter Property="Margin" Value="4,1" />
                                </Style>
                            </ListView.ItemContainerStyle>
                        </ListView>
                        <TextBlock Grid.Row="2" x:Name="FriendsEmpty"
                                   loc:Loc.Text="还没有好友。点左上「+ → 添加好友」搜索对方的 Starcloud ID。"
                                   Style="{StaticResource ScCardHint}"
                                   Margin="14,0,14,12" VerticalAlignment="Bottom" />
                    </Grid>
                </Border>

                <Border Grid.Column="1" Style="{StaticResource ScCard}" Padding="0">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <Grid x:Name="ChatHeader" Padding="14,10" ColumnSpacing="10"
                              BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                              BorderThickness="0,0,0,1">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <Border x:Name="ChatAvatar" Width="38" Height="38" CornerRadius="19"
                                    Background="{ThemeResource AccentFillColorDefaultBrush}">
                                <TextBlock x:Name="ChatAvatarText" FontSize="16" FontWeight="Medium"
                                           Foreground="{ThemeResource TextOnAccentFillColorPrimaryBrush}"
                                           HorizontalAlignment="Center" VerticalAlignment="Center" />
                            </Border>
                            <StackPanel Grid.Column="1" Spacing="2" VerticalAlignment="Center">
                                <TextBlock x:Name="ChatNameText" FontSize="15" FontWeight="Medium" />
                                <TextBlock x:Name="ChatIdText" FontSize="11"
                                           Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                            </StackPanel>
                            <Button x:Name="MoreBtn" Grid.Column="2" Width="34" Height="30" Padding="0"
                                    FontSize="16" VerticalAlignment="Center" loc:Loc.Name="更多操作">
                                <Button.Flyout>
                                    <MenuFlyout>
                                        <MenuFlyoutItem x:Name="LoadOlderItem" loc:Loc.Text="加载更早的消息"
                                                        Click="LoadOlder_Click" />
                                        <MenuFlyoutSeparator />
                                        <MenuFlyoutItem x:Name="InviteSelectedItem" loc:Loc.Text="邀请联机"
                                                        Click="InviteSelected_Click" />
                                        <MenuFlyoutItem x:Name="RemoveFriendItem" loc:Loc.Text="删除好友"
                                                        Click="RemoveFriend_Click" />
                                    </MenuFlyout>
                                </Button.Flyout>
                                <FontIcon Glyph="&#xE712;" FontSize="14" />
                            </Button>
                        </Grid>

                        <ListView Grid.Row="1" x:Name="MessageList" SelectionMode="None"
                                  ItemTemplateSelector="{StaticResource MessageSelector}"
                                  Padding="12,6">
                            <ListView.ItemContainerStyle>
                                <Style TargetType="ListViewItem">
                                    <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                                    <Setter Property="MinHeight" Value="0" />
                                    <Setter Property="Padding" Value="0" />
                                    <Setter Property="Margin" Value="0,3" />
                                </Style>
                            </ListView.ItemContainerStyle>
                        </ListView>
                        <!-- 空会话：和 QQ 一样整块留白，只在正中放一个很淡的品牌水印 -->
                        <Grid Grid.Row="1" x:Name="ChatEmpty">
                            <Image Source="ms-appx:///Assets/Brand/chat-empty.svg"
                                   Width="190" Height="190"
                                   Opacity="0.12"
                                   HorizontalAlignment="Center" VerticalAlignment="Center"
                                   IsHitTestVisible="False" />
                        </Grid>

                        <Grid x:Name="Composer" Grid.Row="2" Padding="12,8" ColumnSpacing="8"
                              BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                              BorderThickness="0,1,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBox x:Name="MessageInput" loc:Loc.Placeholder="输入消息，Enter 发送，Shift+Enter 换行"
                                     AcceptsReturn="True" TextWrapping="Wrap" MinHeight="36" MaxHeight="110"
                                     KeyDown="MessageInput_KeyDown" />
                            <Button x:Name="SendBtn" Grid.Column="1" loc:Loc.Text="发送"
                                    Height="36" Padding="18,0" VerticalAlignment="Bottom"
                                    Style="{StaticResource ScAccentButtonStyle}" FontWeight="Medium"
                                    Click="Send_Click" />
                        </Grid>
                    </Grid>
                </Border>
            </Grid>

            <!-- 联机板块：整页托管 MultiplayerPage（建房 / 进房 / 状态 / 日志全都在原页面里），
                 切走时保留页面实例，切回来不重开会话；页面自身的轮询随 OnUnloaded 停止。 -->
            <Grid x:Name="MultiplayerSection" Visibility="Collapsed">
                <Frame x:Name="MultiplayerHost" />
            </Grid>
        </Grid>
    </Grid>
</Page>
