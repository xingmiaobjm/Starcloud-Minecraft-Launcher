<?xml version="1.0" encoding="utf-8"?>
<!-- 投影管理页：列出全局与各版本实例里的投影，一键复制/移动到目标版本 -->
<Page
    x:Class="Starcloud.App.Views.ProjectionManagerPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:Starcloud.App.Views"
    xmlns:loc="using:Starcloud.App.Localization"
    NavigationCacheMode="Disabled">

    <Grid MaxWidth="1280" HorizontalAlignment="Stretch" Padding="0,0,8,8">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- 页头 -->
        <Grid Grid.Row="0" ColumnSpacing="12" Margin="0,0,0,14">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <StackPanel Spacing="2">
                <TextBlock loc:Loc.Text="投影管理" FontSize="22" FontWeight="SemiBold" />
                <TextBlock loc:Loc.Text="扫描全局与各版本实例的投影，可直接复制到需要使用的版本。"
                           FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
            </StackPanel>
            <Button Grid.Column="1" x:Name="RefreshBtn" loc:Loc.Text="刷新"
                    Style="{StaticResource ScAccentButtonStyle}" MinWidth="96"
                    VerticalAlignment="Center" Click="Refresh_Click" />
        </Grid>

        <Grid Grid.Row="1" ColumnSpacing="16">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="340" />
            </Grid.ColumnDefinitions>

            <!-- 投影列表 -->
            <Border Grid.Column="0" Background="{ThemeResource GlassCardBrush}"
                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                    BorderThickness="1" CornerRadius="16" Padding="8">
                <Grid>
                    <ListView x:Name="ProjectionList" SelectionMode="Single"
                              SelectionChanged="ProjectionList_SelectionChanged">
                        <ListView.ItemTemplate>
                            <DataTemplate x:DataType="local:ProjectionRow">
                                <Grid Padding="8,7" ColumnSpacing="8">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Spacing="2">
                                        <TextBlock Text="{x:Bind Name}" FontWeight="Medium" TextTrimming="CharacterEllipsis" />
                                        <TextBlock Text="{x:Bind Subtitle}" FontSize="11"
                                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                                   TextTrimming="CharacterEllipsis" />
                                        <TextBlock Text="{x:Bind FilePath}" FontSize="11" Opacity="0.55"
                                                   TextTrimming="CharacterEllipsis" />
                                    </StackPanel>
                                    <Border Grid.Column="1" CornerRadius="6" Padding="7,2"
                                            VerticalAlignment="Center"
                                            Background="{ThemeResource ControlFillColorSecondaryBrush}">
                                        <TextBlock Text="{x:Bind LocationText}" FontSize="11" />
                                    </Border>
                                </Grid>
                            </DataTemplate>
                        </ListView.ItemTemplate>
                    </ListView>
                    <TextBlock x:Name="EmptyText" loc:Loc.Text="没有找到投影文件"
                               HorizontalAlignment="Center" VerticalAlignment="Center"
                               Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                </Grid>
            </Border>

            <!-- 操作面板 -->
            <Border Grid.Column="1" Background="{ThemeResource GlassCardBrush}"
                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                    BorderThickness="1" CornerRadius="16" Padding="16"
                    VerticalAlignment="Top">
                <StackPanel Spacing="12">
                    <TextBlock loc:Loc.Text="目标版本" FontWeight="Medium" FontSize="13" />
                    <ComboBox x:Name="TargetCombo" HorizontalAlignment="Stretch" MinHeight="34" />

                    <Button x:Name="CopyBtn" loc:Loc.Text="复制到该版本"
                            Style="{StaticResource ScAccentButtonStyle}"
                            HorizontalAlignment="Stretch" Click="Copy_Click" />
                    <Button x:Name="MoveBtn" loc:Loc.Text="移动到该版本"
                            HorizontalAlignment="Stretch" Click="Move_Click" />
                    <Button x:Name="RevealBtn" loc:Loc.Text="在文件夹中显示"
                            HorizontalAlignment="Stretch" Click="Reveal_Click" />
                    <Button x:Name="DeleteBtn" loc:Loc.Text="删除"
                            HorizontalAlignment="Stretch" Click="Delete_Click" />

                    <TextBlock x:Name="StatusText" FontSize="12" TextWrapping="Wrap"
                               Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                </StackPanel>
            </Border>
        </Grid>
    </Grid>
</Page>
