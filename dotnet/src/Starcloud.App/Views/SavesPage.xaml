<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="Starcloud.App.Views.SavesPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:Starcloud.App.Views"
    xmlns:loc="using:Starcloud.App.Localization"
    NavigationCacheMode="Disabled">

    <Grid MaxWidth="1280" HorizontalAlignment="Stretch" RowSpacing="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- 页头 -->
        <StackPanel Grid.Row="0" Spacing="4">
            <TextBlock loc:Loc.Text="存档" FontSize="28" FontWeight="SemiBold" />
            <TextBlock loc:Loc.Text="备份、恢复与清理本地世界"
                       Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
        </StackPanel>

        <!-- 状态提示 -->
        <InfoBar x:Name="OkBar" Grid.Row="1" Severity="Success" IsOpen="False" IsClosable="True" />
        <InfoBar x:Name="ErrorBar" Grid.Row="1" Severity="Error" IsOpen="False" IsClosable="True" />

        <!-- 跨版本运行态 -->
        <InfoBar x:Name="RunBar" Grid.Row="2" Severity="Informational" IsOpen="False" IsClosable="False"
                 loc:Loc.Title="正在运行" Message="">
            <InfoBar.ActionButton>
                <Button loc:Loc.Text="停止游戏" Click="StopGame_Click" />
            </InfoBar.ActionButton>
        </InfoBar>

        <!-- 工具条 -->
        <Grid Grid.Row="3" ColumnSpacing="8">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <StackPanel Orientation="Horizontal" Spacing="8">
                <Button x:Name="LaunchOtherBtn" Style="{StaticResource AccentButtonStyle}" FontWeight="Bold"
                        loc:Loc.Text="用其他版本启动" IsEnabled="False" Click="LaunchOther_Click" />
                <Button x:Name="CopyOtherBtn" loc:Loc.Text="复制到其他版本" IsEnabled="False" Click="CopyOther_Click" />
                <Button x:Name="BackupBtn" loc:Loc.Text="备份所选世界" IsEnabled="False" Click="Backup_Click" />
                <Button x:Name="DeleteBtn" loc:Loc.Text="删除" IsEnabled="False" Click="Delete_Click" />
                <Button x:Name="OpenFolderBtn" loc:Loc.Text="打开世界文件夹" IsEnabled="False" Click="OpenFolder_Click" />
            </StackPanel>
            <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8">
                <AutoSuggestBox x:Name="SearchBox" Width="200" loc:Loc.Placeholder="搜索世界 / 版本"
                                QueryIcon="Find" TextChanged="SearchBox_TextChanged" />
                <ComboBox x:Name="VersionFilter" MinWidth="150" SelectionChanged="VersionFilter_SelectionChanged" />
                <Button loc:Loc.Text="打开存档目录" Click="OpenSavesDir_Click" />
                <Button Padding="6" MinWidth="32" Background="Transparent" BorderThickness="0"
                        Click="Refresh_Click" loc:Loc.Name="刷新" loc:Loc.Tip="刷新">
                    <FontIcon Glyph="&#xE72C;" FontSize="14" />
                </Button>
            </StackPanel>
        </Grid>

        <!-- 世界列表 -->
        <Border Grid.Row="4"
                Background="{ThemeResource GlassCardBrush}"
                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                BorderThickness="1" CornerRadius="16" Padding="12">
            <Grid>
                <ListView x:Name="SaveList" SelectionMode="Single" Padding="4"
                          SelectionChanged="SaveList_SelectionChanged">
                    <ListView.ItemContainerStyle>
                        <Style TargetType="ListViewItem">
                            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                            <Setter Property="MinHeight" Value="72" />
                            <Setter Property="Padding" Value="0" />
                            <Setter Property="Margin" Value="0,2" />
                        </Style>
                    </ListView.ItemContainerStyle>
                    <ListView.ItemTemplate>
                        <DataTemplate x:DataType="local:SaveRow">
                            <Border CornerRadius="8" Padding="12,8"
                                    local:CardHoverBehavior.IsEnabled="True">
                                <Grid ColumnSpacing="14">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <Border Width="56" Height="56" CornerRadius="8"
                                            Background="{ThemeResource LayerFillColorDefaultBrush}"
                                            BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                            BorderThickness="1">
                                        <Grid>
                                            <FontIcon Glyph="&#xE8B7;" FontSize="22"
                                                      Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                            <Image x:Name="WorldIcon" Source="{x:Bind Icon}" x:Load="{x:Bind HasIcon}"
                                                   Stretch="UniformToFill" />
                                        </Grid>
                                    </Border>
                                    <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="2">
                                        <Grid ColumnSpacing="8">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Text="{x:Bind Name}" FontWeight="SemiBold"
                                                       TextTrimming="CharacterEllipsis" />
                                            <Border Grid.Column="1" CornerRadius="4" Padding="8,2"
                                                    VerticalAlignment="Center"
                                                    Background="{ThemeResource CardBackgroundFillColorSecondaryBrush}">
                                                <TextBlock Text="{x:Bind VersionLabel}" FontSize="11"
                                                           Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                            </Border>
                                            <Border Grid.Column="2" CornerRadius="4" Padding="8,2"
                                                    VerticalAlignment="Center"
                                                    Visibility="{x:Bind IsolatedVisibility}"
                                                    Background="{ThemeResource CardBackgroundFillColorSecondaryBrush}">
                                                <TextBlock loc:Loc.Text="隔离" FontSize="11"
                                                           Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                            </Border>
                                        </Grid>
                                        <TextBlock Text="{x:Bind FolderName}" FontSize="12"
                                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                                   TextTrimming="CharacterEllipsis" />
                                        <StackPanel Orientation="Horizontal" Spacing="10">
                                            <TextBlock Text="{x:Bind LastPlayedText}" FontSize="12"
                                                       Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                            <TextBlock Text="{x:Bind SizeText}" FontSize="12"
                                                       Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                        </StackPanel>
                                    </StackPanel>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ListView.ItemTemplate>
                </ListView>
                <local:EmptyStateView x:Name="EmptyHint" Visibility="Collapsed"
                                      HorizontalAlignment="Center" VerticalAlignment="Center"
                                      Glyph="&#xE8B7;"
                                      loc:Loc.Title="暂无存档"
                                      loc:Loc.Subtitle="启动游戏创建世界后，可在此进行备份与管理" />
                <ProgressBar x:Name="BackupProgress" IsIndeterminate="True" VerticalAlignment="Bottom"
                             Visibility="Collapsed" />
            </Grid>
        </Border>
    </Grid>
</Page>
