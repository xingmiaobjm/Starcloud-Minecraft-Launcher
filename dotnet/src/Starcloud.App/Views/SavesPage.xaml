<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="Starcloud.App.Views.SavesPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:Starcloud.App.Views"
    xmlns:beh="using:Starcloud.App.Views.Behaviors"
    xmlns:ctrl="using:Starcloud.App.Views.Controls"
    xmlns:rows="using:Starcloud.App.Views.Rows"
    xmlns:loc="using:Starcloud.App.Localization"
       NavigationCacheMode="Disabled">

    <Grid MaxWidth="1280" HorizontalAlignment="Stretch" RowSpacing="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- 状态提示 -->
        <InfoBar x:Name="OkBar" Grid.Row="0" Severity="Success" IsOpen="False" IsClosable="True" />
        <InfoBar x:Name="ErrorBar" Grid.Row="0" Severity="Error" IsOpen="False" IsClosable="True" />

        <!-- 跨版本运行态 -->
        <InfoBar x:Name="RunBar" Grid.Row="1" Severity="Informational" IsOpen="False" IsClosable="False"
                 loc:Loc.Title="正在运行" Message="">
            <InfoBar.ActionButton>
                <ctrl:GlowButton loc:Loc.Text="停止游戏" Click="StopGame_Click" />
            </InfoBar.ActionButton>
        </InfoBar>

        <!-- 工具条 -->
        <Grid Grid.Row="2" ColumnSpacing="8">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <StackPanel Orientation="Horizontal" Spacing="8">
                <!-- 常用：启动存档对应的版本 / 同步 / 分享 / 删除 -->
                <Button x:Name="LaunchGameBtn" loc:Loc.Text="启动游戏"
                        Style="{StaticResource ScAccentButtonStyle}" FontWeight="Medium"
                        IsEnabled="False" Click="LaunchGame_Click" />
                <ctrl:GlowButton x:Name="SyncBtn" loc:Loc.Text="同步到设备…" IsEnabled="False" Click="SyncToDevice_Click" />
                <Button x:Name="ShareBtn" Style="{StaticResource ScLightButtonStyle}"
                        loc:Loc.Text="分享" IsEnabled="False" Padding="10,5">
                    <Button.Flyout>
                        <MenuFlyout>
                            <MenuFlyoutItem loc:Loc.Text="导出分享文件…" Click="ExportShare_Click" />
                        </MenuFlyout>
                    </Button.Flyout>
                </Button>
                <ctrl:GlowButton x:Name="DeleteBtn" loc:Loc.Text="删除" IsEnabled="False" Click="Delete_Click" />
            </StackPanel>
            <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8">
                <AutoSuggestBox x:Name="SearchBox" Width="200" loc:Loc.Placeholder="搜索世界 / 版本"
                                TextChanged="SearchBox_TextChanged">
                    <!-- 搜索框内的放大镜同样换成图标库字形（默认是 Segoe 的 Find 符号） -->
                    <AutoSuggestBox.QueryIcon>
                        <FontIcon FontFamily="{StaticResource ScIconFont}" Glyph="&#xEA6F;" FontSize="14" />
                    </AutoSuggestBox.QueryIcon>
                </AutoSuggestBox>
                <ComboBox x:Name="VersionFilter" MinWidth="150" SelectionChanged="VersionFilter_SelectionChanged" />
                <ctrl:GlowButton loc:Loc.Text="导入分享包" x:Name="ImportShareBtn" Click="ImportShare_Click" loc:Loc.Tip="从分享包文件导入世界（支持别人发来的任意 zip）" />
                <ctrl:GlowButton loc:Loc.Text="打开存档目录" Click="OpenSavesDir_Click" />
                <ctrl:GlowButton Padding="6" MinWidth="32" Background="Transparent" BorderThickness="0"
                        Click="Refresh_Click" loc:Loc.Name="刷新" loc:Loc.Tip="刷新">
                    <FontIcon FontFamily="{StaticResource ScIconFont}" Glyph="&#xE918;" FontSize="14" />
                </ctrl:GlowButton>
            </StackPanel>
        </Grid>

        <!-- 世界列表 -->
        <Border Grid.Row="3"
                Background="{ThemeResource GlassCardBrush}"
                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                BorderThickness="1" CornerRadius="16" Padding="12">
            <Grid>
                <ListView x:Name="SaveList" SelectionMode="Single" Padding="4"
                          SelectionChanged="SaveList_SelectionChanged">
                    <ListView.Resources>
                        <!-- 悬停/选中反馈只由控件模板里那三层表达，框架整行底色一律关掉
                             （框架给的是硬边直角矩形，压上圆角光斑后四个角互相啃掉一块） -->
                        <SolidColorBrush x:Key="ListViewItemBackground" Color="Transparent" />
                        <SolidColorBrush x:Key="ListViewItemBackgroundPointerOver" Color="Transparent" />
                        <SolidColorBrush x:Key="ListViewItemBackgroundPressed" Color="Transparent" />
                        <SolidColorBrush x:Key="ListViewItemBackgroundSelected" Color="Transparent" />
                        <SolidColorBrush x:Key="ListViewItemBackgroundSelectedPointerOver" Color="Transparent" />
                        <SolidColorBrush x:Key="ListViewItemBackgroundSelectedPressed" Color="Transparent" />
                    </ListView.Resources>
                    <ListView.ItemContainerStyle>
                        <Style TargetType="ListViewItem">
                            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                            <!-- 竖向也必须撑满：默认 Center 会让承载光斑的卡片 Border 比行矮一圈，
                                 上下留下不亮光斑的死区，鼠标从两卡交界处掠过时完全没反应。 -->
                            <Setter Property="VerticalContentAlignment" Value="Stretch" />
                            <Setter Property="MinHeight" Value="72" />
                            <Setter Property="Padding" Value="0" />
                            <Setter Property="Margin" Value="0,2" />
                        </Style>
                    </ListView.ItemContainerStyle>
                    <ListView.ItemTemplate>
                        <DataTemplate x:DataType="rows:SaveRow">
                            <Border CornerRadius="8"
                                    beh:HoverShadowBehavior.IsEnabled="True"
                                    beh:HoverShadowBehavior.Carrier="{Binding ElementName=SaveCardGlow}">
                                <Border.RenderTransform>
                                    <TranslateTransform />
                                </Border.RenderTransform>
                                <Grid>
                                    <!-- 跟随光标的卡片内阴影 -->
                                    <Border x:Name="SaveCardGlow" CornerRadius="8"
                                            Opacity="0" IsHitTestVisible="False">
                                        <Border.Background>
                                            <RadialGradientBrush Center="0.5,0.5" GradientOrigin="0.5,0.5" RadiusX="0.9" RadiusY="0.9">
                                                <GradientStop Color="#28000000" Offset="0" />
                                                <GradientStop Color="#1F000000" Offset="0.18" />
                                                <GradientStop Color="#16000000" Offset="0.40" />
                                                <GradientStop Color="#0D000000" Offset="0.62" />
                                                <GradientStop Color="#05000000" Offset="0.82" />
                                                <GradientStop Color="#00000000" Offset="1" />
                                            </RadialGradientBrush>
                                        </Border.Background>
                                    </Border>
                                    <!-- 选中淡底：与主页版本列表同款（主题色 6% 淡底），只对选中行可见。
                                         左侧竖条不在这里画，由列表外那层 Canvas 统一绘制（见 SelectionBarLayer）。 -->
                                    <Grid x:Name="SaveRowMark" Tag="inset" Visibility="Collapsed" IsHitTestVisible="False">
                                        <Border CornerRadius="8" Background="#10FFD322" />
                                    </Grid>
                                <Grid ColumnSpacing="14" Padding="12,8">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <Border Width="56" Height="56" CornerRadius="8"
                                            Background="{ThemeResource LayerFillColorDefaultBrush}"
                                            BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                            BorderThickness="1">
                                        <Grid>
                                            <FontIcon FontFamily="{StaticResource ScIconFont}" Glyph="&#xEA90;" FontSize="22"
                                                      Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                            <Image x:Name="WorldIcon" Source="{x:Bind Icon}" x:Load="{x:Bind HasIcon}"
                                                   Stretch="UniformToFill" />
                                        </Grid>
                                    </Border>
                                    <!-- 名称块：世界名 + 文件夹名 -->
                                    <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="2"
                                                MaxWidth="420" HorizontalAlignment="Left">
                                        <TextBlock Text="{x:Bind Name}" FontWeight="Medium"
                                                   TextTrimming="CharacterEllipsis" />
                                        <TextBlock Text="{x:Bind FolderName}" FontSize="12"
                                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                                   TextTrimming="CharacterEllipsis" />
                                    </StackPanel>
                                    <!-- 元信息芯片：所属版本 / 隔离（与版本页、首页同一套形态） -->
                                    <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="6"
                                                VerticalAlignment="Center">
                                        <Border Style="{StaticResource ScChip}">
                                            <TextBlock Text="{x:Bind VersionLabel}"
                                                       Style="{StaticResource ScChipText}" />
                                        </Border>
                                        <Border Style="{StaticResource ScChip}"
                                                Visibility="{x:Bind IsolatedVisibility}">
                                            <TextBlock loc:Loc.Text="隔离"
                                                       Style="{StaticResource ScChipText}" />
                                        </Border>
                                    </StackPanel>
                                    <!-- 数据列：标签 + 数值，跨行成列 -->
                                    <Grid Grid.Column="3" ColumnSpacing="8" VerticalAlignment="Center"
                                          HorizontalAlignment="Right" Margin="14,0,0,0">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="72" />
                                        </Grid.ColumnDefinitions>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="Auto" />
                                        </Grid.RowDefinitions>
                                        <TextBlock Grid.Row="0" Grid.Column="0" HorizontalAlignment="Right"
                                                   loc:Loc.Text="上次游玩" Style="{StaticResource ScMetaLabel}" />
                                        <TextBlock Grid.Row="0" Grid.Column="1" HorizontalAlignment="Right"
                                                   Text="{x:Bind LastPlayedText}"
                                                   Style="{StaticResource ScMetaValue}" />
                                        <TextBlock Grid.Row="1" Grid.Column="0" HorizontalAlignment="Right"
                                                   loc:Loc.Text="大小" Style="{StaticResource ScMetaLabel}" />
                                        <TextBlock Grid.Row="1" Grid.Column="1" HorizontalAlignment="Right"
                                                   Text="{x:Bind SizeText}"
                                                   Style="{StaticResource ScMetaValue}" />
                                    </Grid>
                                </Grid>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ListView.ItemTemplate>
                </ListView>
                <!-- 选中竖条：与主页版本列表同款，整块列表共用一根，换行时真实位移（拉伸 + 过冲回弹）。
                     铺在列表之上、不吃命中测试；行滚动时由代码同步位置。 -->
                <Canvas x:Name="SelectionBarLayer" IsHitTestVisible="False"
                        HorizontalAlignment="Stretch" VerticalAlignment="Stretch">
                    <Border x:Name="SelectionBar" Width="3" CornerRadius="2"
                            Background="#FFD322" RenderTransformOrigin="0.5,0.5">
                        <Border.RenderTransform>
                            <CompositeTransform />
                        </Border.RenderTransform>
                    </Border>
                </Canvas>
                <ctrl:EmptyStateView x:Name="EmptyHint" Visibility="Collapsed"
                                      HorizontalAlignment="Center" VerticalAlignment="Center"
                                      Glyph="&#xEA90;"
                                      loc:Loc.Title="暂无存档"
                                      loc:Loc.Subtitle="启动游戏创建世界后，可在此进行备份与管理" />
                <ProgressBar x:Name="BackupProgress" IsIndeterminate="True" VerticalAlignment="Bottom"
                             Visibility="Collapsed" />
            </Grid>
        </Border>
    </Grid>
</Page>
