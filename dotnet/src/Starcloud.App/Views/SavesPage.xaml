<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="Starcloud.App.Views.SavesPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:Starcloud.App.Views"
    NavigationCacheMode="Disabled">

    <Grid MaxWidth="1000" HorizontalAlignment="Stretch" RowSpacing="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- 页头 -->
        <StackPanel Grid.Row="0" Spacing="4">
            <TextBlock Text="存档" FontSize="28" FontWeight="SemiBold" />
            <TextBlock Text="备份、恢复与清理本地世界"
                       Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
        </StackPanel>

        <!-- 状态提示 -->
        <InfoBar x:Name="OkBar" Grid.Row="1" Severity="Success" IsOpen="False" IsClosable="True" />
        <InfoBar x:Name="ErrorBar" Grid.Row="1" Severity="Error" IsOpen="False" IsClosable="True" />

        <!-- 工具条 -->
        <Grid Grid.Row="2" ColumnSpacing="8">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <StackPanel Orientation="Horizontal" Spacing="8">
                <Button x:Name="BackupBtn" Style="{StaticResource AccentButtonStyle}"
                        Content="备份所选世界" IsEnabled="False" Click="Backup_Click" />
                <Button x:Name="DeleteBtn" Content="删除" IsEnabled="False" Click="Delete_Click" />
                <Button x:Name="OpenFolderBtn" Content="打开世界文件夹" IsEnabled="False" Click="OpenFolder_Click" />
            </StackPanel>
            <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8">
                <Button Content="打开存档目录" Click="OpenSavesDir_Click" />
                <Button Padding="6" MinWidth="32" Background="Transparent" BorderThickness="0"
                        Click="Refresh_Click" ToolTipService.ToolTip="刷新">
                    <FontIcon Glyph="&#xE72C;" FontSize="14" />
                </Button>
            </StackPanel>
        </Grid>

        <!-- 世界列表 -->
        <Border Grid.Row="3"
                Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                BorderThickness="1" CornerRadius="16" Padding="12">
            <Grid>
                <ListView x:Name="SaveList" SelectionMode="Single" Padding="4"
                          SelectionChanged="SaveList_SelectionChanged">
                    <ListView.ItemContainerStyle>
                        <Style TargetType="ListViewItem">
                            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                            <Setter Property="MinHeight" Value="72" />
                            <Setter Property="Padding" Value="0" />
                            <Setter Property="Margin" Value="0,2" />
                        </Style>
                    </ListView.ItemContainerStyle>
                    <ListView.ItemTemplate>
                        <DataTemplate x:DataType="local:SaveRow">
                            <Border CornerRadius="8" Padding="12,8">
                                <Grid ColumnSpacing="14">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <Border Width="56" Height="56" CornerRadius="8"
                                            Background="{ThemeResource LayerFillColorDefaultBrush}"
                                            BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                            BorderThickness="1">
                                        <Grid>
                                            <FontIcon Glyph="&#xE8B7;" FontSize="22"
                                                      Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                            <Image x:Name="WorldIcon" Source="{x:Bind IconPath}" x:Load="{x:Bind HasIcon}"
                                                   Stretch="UniformToFill" />
                                        </Grid>
                                    </Border>
                                    <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="2">
                                        <TextBlock Text="{x:Bind Name}" FontWeight="SemiBold"
                                                   TextTrimming="CharacterEllipsis" />
                                        <TextBlock Text="{x:Bind FolderName}" FontSize="12"
                                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                                   TextTrimming="CharacterEllipsis" />
                                        <StackPanel Orientation="Horizontal" Spacing="10">
                                            <TextBlock Text="{x:Bind LastPlayedText}" FontSize="12"
                                                       Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                            <TextBlock Text="{x:Bind SizeText}" FontSize="12"
                                                       Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                        </StackPanel>
                                    </StackPanel>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ListView.ItemTemplate>
                </ListView>
                <StackPanel x:Name="EmptyHint" Visibility="Collapsed"
                            HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="6">
                    <FontIcon Glyph="&#xE8B7;" FontSize="28" HorizontalAlignment="Center"
                              Foreground="{ThemeResource TextFillColorTertiaryBrush}" />
                    <TextBlock Text="暂无存档"
                               HorizontalAlignment="Center"
                               Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                    <TextBlock Text="启动游戏创建世界后，可在此进行备份与管理"
                               FontSize="12" HorizontalAlignment="Center"
                               Foreground="{ThemeResource TextFillColorTertiaryBrush}" />
                </StackPanel>
                <ProgressBar x:Name="BackupProgress" IsIndeterminate="True" VerticalAlignment="Bottom"
                             Visibility="Collapsed" />
            </Grid>
        </Border>
    </Grid>
</Page>
