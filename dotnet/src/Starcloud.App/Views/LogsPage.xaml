<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="Starcloud.App.Views.LogsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:loc="using:Starcloud.App.Localization"
    NavigationCacheMode="Disabled">

    <Grid MaxWidth="1280" HorizontalAlignment="Stretch" RowSpacing="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- 页头 -->
        <StackPanel Grid.Row="0" Spacing="4">
            <TextBlock loc:Loc.Text="日志" FontSize="28" FontWeight="SemiBold" />
            <TextBlock loc:Loc.Text="启动器运行日志与每一局游戏的原样输出"
                       Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
        </StackPanel>

        <!-- 来源切换（选项文案在 code-behind 按语言重建，见 LogsPage.xaml.cs） -->
        <StackPanel Grid.Row="1" Orientation="Horizontal" Spacing="12" VerticalAlignment="Center">
            <RadioButtons x:Name="LogSource" MaxColumns="2"
                          SelectionChanged="LogSource_SelectionChanged">
            </RadioButtons>
            <ComboBox x:Name="GameLogCombo" MinWidth="240" Visibility="Collapsed"
                      loc:Loc.Placeholder="选择一局游戏日志" SelectionChanged="GameLogCombo_SelectionChanged" />
            <Button x:Name="OpenLogDirBtn" loc:Loc.Text="打开日志目录" Click="OpenLogDir_Click" />
        </StackPanel>

        <Border Grid.Row="2" Background="{ThemeResource GlassCardBrush}"
                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                BorderThickness="1" CornerRadius="16" Padding="12">
            <ScrollViewer x:Name="LogScroll">
                <TextBlock x:Name="LogText" FontFamily="Cascadia Code" FontSize="12"
                           IsTextSelectionEnabled="True" TextWrapping="Wrap" />
            </ScrollViewer>
        </Border>
    </Grid>
</Page>
