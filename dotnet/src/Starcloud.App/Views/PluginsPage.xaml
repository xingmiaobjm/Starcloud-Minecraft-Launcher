<?xml version="1.0" encoding="utf-8"?>
<!-- 插件管理页（plugin-spec.md）：安装 .mclplug / 启用停用（免责确认） / 卸载 / 插件面板入口 -->
<Page
    x:Class="Starcloud.App.Views.PluginsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:Starcloud.App.Views"
    xmlns:beh="using:Starcloud.App.Views.Behaviors"
    xmlns:ctrl="using:Starcloud.App.Views.Controls"
    xmlns:loc="using:Starcloud.App.Localization"
    NavigationCacheMode="Disabled">

    <Grid MaxWidth="1280" HorizontalAlignment="Stretch">
        <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="0,0,8,0">
            <StackPanel Spacing="16">

                <!-- 页头 -->
                <Grid ColumnSpacing="12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel Spacing="4" beh:TextOutlineBehavior.IsEnabled="True">
                        <TextBlock loc:Loc.Text="插件" FontSize="28" FontWeight="Medium" />
                        <TextBlock loc:Loc.Text="安装 .mclplug 插件包扩展启动器（仅开放启动参数扩展与 UI 扩展，账号校验永不对插件开放）"
                                   TextWrapping="Wrap"
                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                    </StackPanel>
                    <Button x:Name="InstallBtn" Grid.Column="1" loc:Loc.Text="安装插件…"
                            Style="{StaticResource AccentButtonStyle}" FontWeight="Medium"
                            MinWidth="120" VerticalAlignment="Center" Click="Install_Click" />
                </Grid>

                <!-- 免责声明（规范 §4 §7）：看过一次后不再常驻 -->
                <InfoBar x:Name="DisclaimerBar" IsOpen="True" IsClosable="True" Severity="Warning"
                         loc:Loc.Title="插件由第三方独立开发"
                         loc:Loc.Message="启动器本体不对插件内容、合法性负责；插件无权修改游戏认证、UUID 与登录校验逻辑。加载第三方插件前会再次向你确认。" />

                <!-- 插件面板（launcher:ui_panel 注册） -->
                <Border Background="{ThemeResource GlassCardBrush}"
                        BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                        BorderThickness="1" CornerRadius="16" Padding="16"
                        Visibility="{x:Bind PanelsCardVisible, Mode=OneWay}">
                    <StackPanel Spacing="8">
                        <TextBlock loc:Loc.Text="插件面板" FontWeight="Medium" FontSize="13" />
                        <ItemsControl ItemsSource="{x:Bind PanelRows, Mode=OneWay}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate x:DataType="local:PluginPanelRow">
                                    <ctrl:GlowButton Margin="0,2,6,2" Padding="12,6" Click="OpenPanel_Click"
                                            Tag="{x:Bind Id}">
                                        <StackPanel Orientation="Horizontal" Spacing="8">
                                            <FontIcon FontFamily="{StaticResource ScIconFont}" Glyph="&#xEABC;" FontSize="14"
                                                      Foreground="{ThemeResource BrandBlueBrush}" />
                                            <TextBlock Text="{x:Bind Title}" VerticalAlignment="Center" />
                                            <TextBlock Text="{x:Bind PluginName}" FontSize="11"
                                                       Opacity="0.6" VerticalAlignment="Center" />
                                        </StackPanel>
                                    </ctrl:GlowButton>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </Border>

                <!-- 已安装插件 -->
                <Border Background="{ThemeResource GlassCardBrush}"
                        BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                        BorderThickness="1" CornerRadius="16" Padding="16">
                    <StackPanel Spacing="8">
                        <TextBlock loc:Loc.Text="已安装" FontWeight="Medium" FontSize="13" />
                        <ListView x:Name="PluginList" SelectionMode="None">
                            <!-- 框架原生增删/重排转场：安装/卸载后行淡入淡出并平滑让位 -->
                            <ListView.ItemContainerTransitions>
                                <TransitionCollection>
                                    <AddDeleteThemeTransition />
                                    <RepositionThemeTransition />
                                </TransitionCollection>
                            </ListView.ItemContainerTransitions>
                            <ListView.ItemContainerStyle>
                                <Style TargetType="ListViewItem">
                                    <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                                    <Setter Property="MinHeight" Value="0" />
                                    <Setter Property="Padding" Value="0" />
                                    <Setter Property="Margin" Value="0,2" />
                                </Style>
                            </ListView.ItemContainerStyle>
                            <ListView.ItemTemplate>
                                <DataTemplate x:DataType="local:PluginRow">
                                    <Grid ColumnSpacing="12" Padding="12,10" CornerRadius="8"
                                          Background="{ThemeResource LayerFillColorDefaultBrush}"
                                          beh:HoverShadowBehavior.IsEnabled="True"
                                          beh:HoverShadowBehavior.Carrier="{Binding ElementName=PluginCardGlow}">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <!-- 跟随光标的卡片内阴影 -->
                                        <ctrl:GlowLayer x:Name="PluginCardGlow" Grid.ColumnSpan="4" CornerRadius="8" />
                                        <StackPanel Grid.Column="0" Spacing="2">
                                            <StackPanel Orientation="Horizontal" Spacing="6">
                                                <TextBlock Text="{x:Bind Name}" FontWeight="Medium" />
                                                <TextBlock Text="{x:Bind Version}" FontSize="11" Opacity="0.65"
                                                           VerticalAlignment="Center" />
                                                <Border Style="{StaticResource ScChipAccent}"
                                                        Visibility="{x:Bind OfficialVisibility}">
                                                    <TextBlock loc:Loc.Text="官方"
                                                               Style="{StaticResource ScChipAccentText}" />
                                                </Border>
                                                <!-- 提示芯片：与版本页的类型/隔离芯片同一套形态（App.xaml 视觉基元），
                                                     语义色只说"需要留意"，不做成错误 -->
                                                <Border Style="{StaticResource ScChipCaution}"
                                                        Visibility="{x:Bind UnverifiedVisibility}">
                                                    <TextBlock loc:Loc.Text="第三方未验证"
                                                               Style="{StaticResource ScChipCautionText}" />
                                                </Border>
                                            </StackPanel>
                                            <TextBlock Text="{x:Bind Description}" FontSize="12"
                                                       TextWrapping="Wrap" Opacity="0.75"
                                                       Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                            <TextBlock Text="{x:Bind Detail}" FontSize="11" TextWrapping="Wrap"
                                                       Foreground="{ThemeResource TextFillColorTertiaryBrush}" />
                                        </StackPanel>
                                        <ctrl:GlowButton Grid.Column="1" loc:Loc.Text="打开面板" FontSize="12"
                                                Padding="10,4" VerticalAlignment="Center"
                                                Visibility="{x:Bind PanelsVisibility}"
                                                Tag="{x:Bind Id}" Click="OpenPanel_Click" />
                                        <ctrl:GlowButton Grid.Column="2" loc:Loc.Text="卸载" FontSize="12"
                                                Padding="10,4" VerticalAlignment="Center"
                                                Tag="{x:Bind Id}" Click="Uninstall_Click" />
                                        <!-- 行对象每次刷新都重建，OneTime 即可（回写由 Toggled 事件走服务层） -->
                                        <ToggleSwitch Grid.Column="3" MinWidth="0" Margin="4,0,0,0"
                                                      OnContent="" OffContent=""
                                                      IsOn="{x:Bind Enabled}"
                                                      Toggled="PluginToggle_Toggled" Tag="{x:Bind Id}" />
                                    </Grid>
                                </DataTemplate>
                            </ListView.ItemTemplate>
                        </ListView>
                        <ctrl:EmptyStateView x:Name="EmptyText" HorizontalAlignment="Left"
                                              Glyph="&#xEABC;"
                                              loc:Loc.Title="还没有安装插件" />
                    </StackPanel>
                </Border>

                <!-- 放置说明：原先在卡片最后一行，读起来像卡片内容的一部分；
                     挪到卡片外当页面注脚，形态与空状态提示一致 -->
                <TextBlock loc:Loc.Text="把 .mclplug 文件放到这里：点「安装插件…」选择插件包，安装后打开开关启用。"
                           FontSize="12" TextWrapping="Wrap" Margin="4,0,0,0"
                           Foreground="{ThemeResource TextFillColorTertiaryBrush}" />

                <!-- 安装结果提示 -->
                <InfoBar x:Name="NotifyBar" IsOpen="False" IsClosable="True" Severity="Success" />
            </StackPanel>
        </ScrollViewer>
    </Grid>
</Page>
