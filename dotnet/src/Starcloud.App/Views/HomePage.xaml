<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="Starcloud.App.Views.HomePage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:Starcloud.App.Views"
    xmlns:beh="using:Starcloud.App.Views.Behaviors"
    xmlns:ctrl="using:Starcloud.App.Views.Controls"
    xmlns:rows="using:Starcloud.App.Views.Rows"
    xmlns:loc="using:Starcloud.App.Localization"
    NavigationCacheMode="Disabled">

    <!-- 不用 ScrollViewer：整体填满视口，卡片与窗口同高（PCL2 式） -->
    <!-- 根节点两层：HomeContent（主页两列）+ LaunchOverlay（启动页覆盖层，见文件尾） -->
    <Grid>
        <Grid x:Name="HomeContent" MaxWidth="1280" HorizontalAlignment="Stretch">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="360" />
            </Grid.ColumnDefinitions>

        <!-- ═══ 左列：启动自检 + 版本库(贴内容) + 弹性留白 + 快捷入口(沉底) ═══ -->
        <Grid Grid.Column="0" RowSpacing="16" Margin="0,0,24,0">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <StackPanel Grid.Row="0" Spacing="8">
                <InfoBar x:Name="GlobalErrorBar" Severity="Error" IsOpen="False" IsClosable="True"
                         loc:Loc.Title="启动出错" />
                <InfoBar x:Name="LocalErrorBar" Severity="Error" IsOpen="False" IsClosable="True"
                         loc:Loc.Title="操作失败" />
                <InfoBar x:Name="WarnBar" Severity="Warning" IsOpen="False" IsClosable="True"
                         loc:Loc.Title="提示" />

                <!-- 启动自检：版本 / 账户 / Java，未就绪项可一键跳转 -->
                <Border x:Name="CheckCard" Visibility="Collapsed"
                        Background="{ThemeResource GlassCardBrush}"
                        BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                        BorderThickness="1" CornerRadius="8" Padding="16">
                    <StackPanel Spacing="2">
                        <Grid Margin="0,0,0,6" ColumnSpacing="8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBlock loc:Loc.Text="启动自检" FontWeight="Medium" FontSize="15"
                                       VerticalAlignment="Center" />
                            <ctrl:GlowButton Grid.Column="1" Padding="6" MinWidth="28" MinHeight="28"
                                    Background="Transparent" BorderThickness="0"
                                    Click="Recheck_Click" loc:Loc.Name="重新检测" loc:Loc.Tip="重新检测">
                                <FontIcon FontFamily="{StaticResource ScIconFont}" Glyph="&#xE918;" FontSize="14" />
                            </ctrl:GlowButton>
                        </Grid>
                        <Grid MinHeight="30" ColumnSpacing="8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <FontIcon FontFamily="{StaticResource ScIconFont}" x:Name="CheckIconVersion" Glyph="&#xEA7C;" FontSize="14"
                                      VerticalAlignment="Center" />
                            <TextBlock x:Name="CheckTextVersion" Grid.Column="1" FontSize="13"
                                       VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                            <HyperlinkButton x:Name="CheckGoVersion" Grid.Column="2" Padding="0"
                                             MinHeight="0" FontSize="12"
                                             Click="CheckGoVersion_Click" />
                        </Grid>
                        <Grid MinHeight="30" ColumnSpacing="8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <FontIcon FontFamily="{StaticResource ScIconFont}" x:Name="CheckIconAccount" Glyph="&#xEA7C;" FontSize="14"
                                      VerticalAlignment="Center" />
                            <TextBlock x:Name="CheckTextAccount" Grid.Column="1" FontSize="13"
                                       VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                            <HyperlinkButton x:Name="CheckGoAccount" Grid.Column="2" Padding="0"
                                             MinHeight="0" FontSize="12"
                                             Click="CheckGoAccount_Click" />
                        </Grid>
                        <Grid MinHeight="30" ColumnSpacing="8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <FontIcon FontFamily="{StaticResource ScIconFont}" x:Name="CheckIconJava" Glyph="&#xEA7C;" FontSize="14"
                                      VerticalAlignment="Center" />
                            <TextBlock x:Name="CheckTextJava" Grid.Column="1" FontSize="13"
                                       VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                            <HyperlinkButton x:Name="CheckGoJava" Grid.Column="2" Padding="0"
                                             MinHeight="0" FontSize="12"
                                             Click="CheckGoJava_Click" />
                        </Grid>
                    </StackPanel>
                </Border>
            </StackPanel>

            <!-- 版本库：卡片贴着内容高度（列表 MaxHeight 由代码按窗口高度封顶），列表在卡内滚动 -->
            <Border Grid.Row="1"
                    Background="{ThemeResource GlassCardBrush}"
                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                    BorderThickness="1" CornerRadius="16"
                    Padding="12">
                <Grid RowSpacing="8">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <!-- 卡头：标题 + 已安装数量 + 刷新 -->
                    <Grid Grid.Row="0" Padding="6,2,0,2" ColumnSpacing="8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock loc:Loc.Text="已安装版本" FontWeight="Medium" FontSize="15"
                                   VerticalAlignment="Center" />
                        <Border Grid.Column="1" CornerRadius="5" Padding="6,1" VerticalAlignment="Center"
                                Background="{ThemeResource SubtleFillColorSecondaryBrush}">
                            <TextBlock x:Name="VersionCountText" Text="(0)" FontSize="11"
                                       Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                        </Border>
                        <ctrl:GlowButton x:Name="RefreshVersionsBtn" Grid.Column="3" Padding="6"
                                Background="Transparent" BorderThickness="0"
                                Click="RefreshVersionsBtn_Click" loc:Loc.Name="刷新列表" loc:Loc.Tip="刷新列表">
                            <FontIcon FontFamily="{StaticResource ScIconFont}" Glyph="&#xE918;" FontSize="14" />
                        </ctrl:GlowButton>
                    </Grid>

                    <!-- 列表直接坐在卡片上（去掉原来的"盒中盒"），行与版本页同款 -->
                    <Grid Grid.Row="1">
                        <ListView x:Name="VersionList" SelectionMode="Single" Padding="0"
                                  SelectionChanged="VersionList_SelectionChanged">
                            <ListView.Resources>
                                <!-- 行的跟手光斑与行 Border 的圆角都是 8，但框架行底色的圆角来自
                                     ListViewItemCornerRadius（框架值 4）—— 底色的四个角比光斑更方，
                                     悬停/选中时会从角上漏出一圈。这里只把本列表的行圆角对齐到 8
                                     （同 App.xaml 覆写 ControlCornerRadius 的机制，不影响其它页面）。 -->
                                <CornerRadius x:Key="ListViewItemCornerRadius">8</CornerRadius>
                            </ListView.Resources>
                            <ListView.ItemContainerStyle>
                                <Style TargetType="ListViewItem">
                                    <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                                    <Setter Property="MinHeight" Value="60" />
                                    <Setter Property="Padding" Value="0" />
                                    <Setter Property="Margin" Value="0,1" />
                                </Style>
                            </ListView.ItemContainerStyle>
                            <ListView.ItemTemplate>
                                <DataTemplate x:DataType="rows:LocalVersionRow">
                                    <Border CornerRadius="8"
                                            beh:HoverShadowBehavior.IsEnabled="True"
                                            beh:HoverShadowBehavior.Carrier="{Binding ElementName=VersionRowGlow}"
                                            RightTapped="VersionRow_RightTapped">
                                        <Border.ContextFlyout>
                                            <MenuFlyout>
                                                <MenuFlyoutItem loc:Loc.Text="问 Nova"
                                                                Tag="{x:Bind Id}"
                                                                Click="AskNova_Click">
                                                    <MenuFlyoutItem.Icon>
                                                        <ImageIcon Source="{StaticResource NovaMarkSmall}" />
                                                    </MenuFlyoutItem.Icon>
                                                </MenuFlyoutItem>
                                                <MenuFlyoutSeparator />
                                                <MenuFlyoutItem loc:Loc.Text="打开游戏目录"
                                                                Tag="{x:Bind Id}"
                                                                Click="OpenVersionFolder_Click">
                                                    <MenuFlyoutItem.Icon>
                                                        <FontIcon FontFamily="{StaticResource ScIconFont}" Glyph="&#xEA90;" />
                                                    </MenuFlyoutItem.Icon>
                                                </MenuFlyoutItem>
                                                <MenuFlyoutItem loc:Loc.Text="删除此版本"
                                                                Tag="{x:Bind Id}"
                                                                Click="DeleteVersion_Click">
                                                    <MenuFlyoutItem.Icon>
                                                        <FontIcon FontFamily="{StaticResource ScIconFont}" Glyph="&#xEAA5;" />
                                                    </MenuFlyoutItem.Icon>
                                                </MenuFlyoutItem>
                                            </MenuFlyout>
                                        </Border.ContextFlyout>
                                        <Grid>
                                            <!-- 跟随光标的卡片内阴影：只画落在本行内的那一段（文字在它之上） -->
                                            <ctrl:GlowLayer x:Name="VersionRowGlow" CornerRadius="8" />
                                            <Grid Padding="10,8" ColumnSpacing="12">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="Auto" />
                                                    <ColumnDefinition Width="260" />
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="Auto" />
                                                </Grid.ColumnDefinitions>
                                                <!-- 版本方块图标块：加载器图标优先，原版按类型；取不到图标时留空底块 -->
                                                <Border Width="32" Height="32" CornerRadius="8"
                                                        Background="{ThemeResource SubtleFillColorSecondaryBrush}">
                                                    <Grid>
                                                        <Image Source="{x:Bind Icon}" Width="32" Height="32"
                                                               Stretch="Uniform" />
                                                        <FontIcon FontFamily="{StaticResource ScIconFont}" Glyph="&#xEC62;" FontSize="14"
                                                                  Visibility="{x:Bind IconFontVisibility}"
                                                                  Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                                    </Grid>
                                                </Border>
                                                <TextBlock Grid.Column="1" Text="{x:Bind Id}" FontWeight="Medium"
                                                           VerticalAlignment="Center"
                                                           TextTrimming="CharacterEllipsis" />
                                                <!-- 元信息芯片：与版本页同款（类型 / 类别） -->
                                                <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="6"
                                                            VerticalAlignment="Center">
                                                    <Border Style="{StaticResource ScChip}">
                                                        <TextBlock Text="{x:Bind KindText}"
                                                                   Style="{StaticResource ScChipText}" />
                                                    </Border>
                                                    <Border Style="{StaticResource ScChip}"
                                                            Visibility="{x:Bind CategoryVisibility}">
                                                        <TextBlock Text="{x:Bind Category}"
                                                                   Style="{StaticResource ScChipText}" />
                                                    </Border>
                                                </StackPanel>
                                                <!-- 数据列：标签 + 数值跨行成列 -->
                                                <Grid Grid.Column="3" ColumnSpacing="8" VerticalAlignment="Center"
                                                      HorizontalAlignment="Right">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="Auto" />
                                                        <ColumnDefinition Width="64" />
                                                    </Grid.ColumnDefinitions>
                                                    <Grid.RowDefinitions>
                                                        <RowDefinition Height="Auto" />
                                                        <RowDefinition Height="Auto" />
                                                    </Grid.RowDefinitions>
                                                    <TextBlock Grid.Row="0" Grid.Column="0" HorizontalAlignment="Right"
                                                               loc:Loc.Text="上次启动" Style="{StaticResource ScMetaLabel}" />
                                                    <TextBlock Grid.Row="0" Grid.Column="1" HorizontalAlignment="Right"
                                                               Text="{x:Bind LastPlayedText}"
                                                               Style="{StaticResource ScMetaValue}" />
                                                    <TextBlock Grid.Row="1" Grid.Column="0" HorizontalAlignment="Right"
                                                               loc:Loc.Text="大小" Style="{StaticResource ScMetaLabel}" />
                                                    <TextBlock Grid.Row="1" Grid.Column="1" HorizontalAlignment="Right"
                                                               Text="{x:Bind SizeText}"
                                                               Style="{StaticResource ScMetaValue}" />
                                                </Grid>
                                            </Grid>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ListView.ItemTemplate>
                        </ListView>
                        <ctrl:EmptyStateView x:Name="EmptyVersionHint" Visibility="Collapsed"
                                              MinHeight="200"
                                              HorizontalAlignment="Center" VerticalAlignment="Center"
                                              Glyph="&#xEA94;"
                                              loc:Loc.Title="暂无已安装版本"
                                              loc:Loc.ActionText="前往下载页安装"
                                              ActionClick="PickVersion_Click" />
                    </Grid>
                </Grid>
            </Border>

            <!-- 快捷入口（沉底） -->
            <Grid Grid.Row="3" ColumnSpacing="12">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <ctrl:GlowButton Grid.Column="0" Padding="0" HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch"
                        loc:Loc.Name="下载版本" Click="TileDownload_Click">
                    <StackPanel Orientation="Horizontal" Spacing="12" Padding="16">
                        <FontIcon FontFamily="{StaticResource ScIconFont}" Glyph="&#xE90C;" FontSize="18"
                                  Foreground="{ThemeResource BrandBlueBrush}" />
                        <StackPanel Spacing="4">
                            <TextBlock loc:Loc.Text="下载版本" FontWeight="Medium" />
                            <TextBlock loc:Loc.Text="获取官方版本与加载器" FontSize="12"
                                       Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextWrapping="Wrap" />
                        </StackPanel>
                    </StackPanel>
                </ctrl:GlowButton>
                <ctrl:GlowButton Grid.Column="1" Padding="0" HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch"
                        loc:Loc.Name="模组资源" Click="TileMods_Click">
                    <StackPanel Orientation="Horizontal" Spacing="12" Padding="16">
                        <FontIcon FontFamily="{StaticResource ScIconFont}" Glyph="&#xEA93;" FontSize="18"
                                  Foreground="{ThemeResource BrandBlueBrush}" />
                        <StackPanel Spacing="4">
                            <TextBlock loc:Loc.Text="模组资源" FontWeight="Medium" />
                            <TextBlock loc:Loc.Text="搜索并安装 Mod 与整合包" FontSize="12"
                                       Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextWrapping="Wrap" />
                        </StackPanel>
                    </StackPanel>
                </ctrl:GlowButton>
                <ctrl:GlowButton Grid.Column="2" Padding="0" HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch"
                        loc:Loc.Name="好友联机" Click="TileMultiplayer_Click">
                    <StackPanel Orientation="Horizontal" Spacing="12" Padding="16">
                        <FontIcon FontFamily="{StaticResource ScIconFont}" Glyph="&#xEB91;" FontSize="18"
                                  Foreground="{ThemeResource BrandBlueBrush}" />
                        <StackPanel Spacing="4">
                            <TextBlock loc:Loc.Text="好友联机" FontWeight="Medium" />
                            <TextBlock loc:Loc.Text="无需公网 IP，一键开黑" FontSize="12"
                                       Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextWrapping="Wrap" />
                        </StackPanel>
                    </StackPanel>
                </ctrl:GlowButton>
            </Grid>
        </Grid>

        <!-- ═══ 右列：PCL2 式账户/启动卡（与窗口同高） ═══ -->
        <Border Grid.Column="1"
                Background="{ThemeResource GlassCardBrush}"
                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                BorderThickness="1" CornerRadius="16" Padding="20">
            <Grid RowSpacing="14">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <!-- 账户模式：正版 / 第三方外置 / 离线 -->
                <Grid Grid.Row="0" ColumnSpacing="8" Width="240" HorizontalAlignment="Center">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <ToggleButton x:Name="ModeMsBtn" Grid.Column="0" loc:Loc.Text="正版"
                                  HorizontalAlignment="Stretch" Height="32"
                                  Click="ModeMs_Click" />
                    <ToggleButton x:Name="ModeExternalBtn" Grid.Column="1" loc:Loc.Text="外置"
                                  HorizontalAlignment="Stretch" Height="32"
                                  Click="ModeExternal_Click" />
                    <ToggleButton x:Name="ModeOfflineBtn" Grid.Column="2" loc:Loc.Text="离线"
                                  HorizontalAlignment="Stretch" Height="32"
                                  Click="ModeOffline_Click" />
                </Grid>

                <!-- 头像 + 账户（垂直居中，模拟 PCL2 卡片中部） -->
                <StackPanel Grid.Row="1" VerticalAlignment="Center" Spacing="10"
                            HorizontalAlignment="Center">
                    <Border Width="72" Height="72" CornerRadius="12"
                            HorizontalAlignment="Center"
                            Background="{ThemeResource AccentFillColorDefaultBrush}">
                        <Grid>
                            <!-- 首字母兜底：未选账户 / 无网络 / 名字不存在时可见 -->
                            <TextBlock x:Name="AvatarText" Text="?" FontSize="28" FontWeight="Medium"
                                       Foreground="{ThemeResource TextOnAccentFillColorPrimaryBrush}"
                                       HorizontalAlignment="Center" VerticalAlignment="Center" />
                            <!-- 皮肤头像覆盖在色块上；加载失败不渲染，即露出下面的首字母 -->
                            <Image x:Name="AvatarImage" Stretch="UniformToFill" />
                        </Grid>
                    </Border>
                    <TextBlock x:Name="AccountNameText" loc:Loc.Text="未选择账户" FontWeight="Medium"
                               FontSize="17" HorizontalAlignment="Center" TextTrimming="CharacterEllipsis" />
                    <ComboBox x:Name="AccountCombo" Width="220" HorizontalAlignment="Center"
                              SelectedValuePath="Value"
                              SelectionChanged="AccountCombo_SelectionChanged" />
                    <!-- 该模式还没有账户时不摆一句「尚无正版账户」堵在那里，直接给登录入口：
                         点开就地弹对应方式的登录框（微软设备码 / 第三方账密 / 离线填名字），
                         登录成功即刷新上面这张卡，不用再去账户页（见 RefreshAccounts）。 -->
                    <ctrl:GlowButton x:Name="NoAccountBtn" Width="220" Height="32"
                            HorizontalAlignment="Center" Visibility="Collapsed"
                            Click="NoAccountBtn_Click" />
                </StackPanel>

                <!-- 主按钮：PCL 式双行（启动游戏 + 当前版本） -->
                <Button x:Name="LaunchBtn" Grid.Row="2" HorizontalAlignment="Stretch" Height="64"
                        Style="{StaticResource AccentButtonStyle}" CornerRadius="14"
                        loc:Loc.Name="启动游戏"
                        Click="LaunchBtn_Click">
                    <StackPanel Spacing="2" HorizontalAlignment="Center">
                        <StackPanel Orientation="Horizontal" Spacing="8" HorizontalAlignment="Center">
                            <!-- 轮廓播放/停止标记：字体字形（E768 / E71A）只有一种线宽，
                                 在亮黄底的大按钮上显得太细。改自绘轮廓——形状与字形一致、不填充，
                                 粗细由 StrokeThickness 单独控制；3.2 在 16px 文字旁显得过于厚重，
                                 收到 2.2 与「启动游戏」的 Medium 字重相称；线细了以后视觉尺寸跟着缩水，
                                 所以几何体放大到约 12 × 13（含描边 ≈ 15），和 16px 文字同高。
                                 两个标记都按中心 (8,8) 对称放大，切换播放/停止时不会跳位。 -->
                            <Grid VerticalAlignment="Center">
                                <Path x:Name="LaunchPlayIcon" Data="M 4.5,1.6 L 16.2,8 L 4.5,14.4 Z"
                                      Stroke="{Binding Foreground, ElementName=LaunchBtn}"
                                      StrokeThickness="2.2" StrokeLineJoin="Round" Fill="Transparent" />
                                <Path x:Name="LaunchStopIcon" Data="M 2.8,2.8 H 13.2 V 13.2 H 2.8 Z"
                                      Stroke="{Binding Foreground, ElementName=LaunchBtn}"
                                      StrokeThickness="2.2" StrokeLineJoin="Round" Fill="Transparent"
                                      Visibility="Collapsed" />
                            </Grid>
                            <!-- 黄底按钮上的文字一律跟随按钮 Foreground（模板给的白字）。
                                 文字基样式故意不设 Foreground，这里再显式绑一次兜底：
                                 基样式里一旦写死前景色，这两行就会变成正文黑，而图标还是白的。 -->
                            <TextBlock x:Name="LaunchTitleText" loc:Loc.Text="启动游戏" FontWeight="Medium" FontSize="16"
                                       Foreground="{Binding Foreground, ElementName=LaunchBtn}" />
                        </StackPanel>
                        <TextBlock x:Name="LaunchSubText" loc:Loc.Text="未选择版本" FontSize="12"
                                   FontWeight="Medium" Opacity="0.88"
                                   HorizontalAlignment="Center"
                                   Foreground="{Binding Foreground, ElementName=LaunchBtn}" />
                    </StackPanel>
                </Button>

                <!-- 进度与状态 -->
                <TextBlock x:Name="StatusText" Grid.Row="3" FontSize="12" TextAlignment="Center"
                           Visibility="Collapsed"
                           Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextWrapping="Wrap" />

                <!-- 版本管理入口：版本选择 / 版本设置 -->
                <Grid Grid.Row="4" ColumnSpacing="8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <ctrl:GlowButton Grid.Column="0" loc:Loc.Text="版本选择" HorizontalAlignment="Stretch"
                            Click="PickVersion_Click" />
                    <ctrl:GlowButton Grid.Column="1" loc:Loc.Text="版本设置" HorizontalAlignment="Stretch"
                            Click="VersionSettings_Click" />
                </Grid>
            </Grid>
        </Border>
        </Grid>

        <!-- ═══ 启动页覆盖层：点启动后盖住两列内容（PCL2 式，设计：launch-overlay-design.md §3.1） ═══ -->
        <Grid x:Name="LaunchOverlay" Visibility="Collapsed"
              Background="{ThemeResource ApplicationPageBackgroundThemeBrush}">
            <StackPanel MaxWidth="480" HorizontalAlignment="Center" VerticalAlignment="Center"
                        Spacing="14">
                <!-- 像素镐图标：品牌色对角渐变（浅黄→深绿，两主题通用） -->
                <Path Width="48" Height="48" HorizontalAlignment="Center"
                      Data="M16,4 H32 V8 H36 V12 H40 V20 H36 V24 H32 V20 H28 V16 H24 V40 H20 V44 H16 V16 H12 V24 H8 V20 H12 V12 H16 Z"
                      Fill="{ThemeResource AccentFillColorDefaultBrush}" />

                <TextBlock x:Name="LaunchStageTitle" loc:Loc.Text="正在启动" FontSize="24"
                           FontWeight="Medium" HorizontalAlignment="Center" />
                <TextBlock x:Name="LaunchVersionText" FontSize="13" HorizontalAlignment="Center"
                           Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                           TextTrimming="CharacterEllipsis" />

                <ProgressBar x:Name="LaunchProgress" Height="4" CornerRadius="2"
                             Minimum="0" Maximum="100"
                             Foreground="{ThemeResource AccentFillColorDefaultBrush}" />

                <!-- 当前步骤 / 登录方式 -->
                <Grid ColumnSpacing="8" Width="340" HorizontalAlignment="Center">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <TextBlock loc:Loc.Text="当前步骤" FontSize="13" Opacity="0.7"
                               Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                               VerticalAlignment="Center" />
                    <TextBlock x:Name="LaunchStageStepText" Grid.Column="1" FontSize="13"
                               VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                    <TextBlock Grid.Row="1" loc:Loc.Text="登录方式" FontSize="13" Opacity="0.7"
                               Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                               VerticalAlignment="Center" />
                    <TextBlock x:Name="LaunchLoginModeText" Grid.Row="1" Grid.Column="1"
                               FontSize="13" VerticalAlignment="Center" />
                </Grid>

                <!-- 你知道吗（小贴士：静态池 + Nova 动态，见 LaunchTips.cs） -->
                <Border Background="{ThemeResource GlassCardBrush}"
                        BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                        BorderThickness="1" CornerRadius="8" Padding="12,10"
                        Width="340" HorizontalAlignment="Center">
                    <Grid ColumnSpacing="10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="4" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Rectangle RadiusX="2" RadiusY="2"
                                   Fill="{ThemeResource AccentFillColorDefaultBrush}" />
                        <TextBlock x:Name="LaunchTipText" Grid.Column="1" FontSize="12"
                                   TextWrapping="Wrap" LineHeight="18"
                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                    </Grid>
                </Border>

                <!-- 实时游戏日志（默认折叠；设计：launch-reliability-design.md §5） -->
                <ToggleButton x:Name="LaunchLogToggle" loc:Loc.Text="显示日志" FontSize="12"
                              HorizontalAlignment="Center"
                              Checked="LaunchLogToggle_Changed" Unchecked="LaunchLogToggle_Changed" />
                <TextBox x:Name="LaunchLogText" Visibility="Collapsed" Width="440" Height="180"
                         FontFamily="Consolas" FontSize="11" IsReadOnly="True" AcceptsReturn="True"
                         TextWrapping="NoWrap" ScrollViewer.VerticalScrollBarVisibility="Auto"
                         ScrollViewer.HorizontalScrollBarVisibility="Auto" />
                <HyperlinkButton x:Name="LaunchLogOpenBtn" loc:Loc.Text="打开日志文件" FontSize="12"
                                 Visibility="Collapsed" HorizontalAlignment="Center"
                                 Click="LaunchLogOpen_Click" />

                <TextBlock x:Name="LaunchErrorText" FontSize="12" TextWrapping="Wrap"
                           MaxLines="2" TextTrimming="CharacterEllipsis" TextAlignment="Center"
                           Visibility="Collapsed" HorizontalAlignment="Center"
                           Foreground="{ThemeResource SystemFillColorCriticalBrush}" />

                <!-- 取消（启动中）/ 返回主页（运行中、已退出、失败） -->
                <Grid ColumnSpacing="12" Width="340" HorizontalAlignment="Center">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <ctrl:GlowButton x:Name="LaunchCancelBtn" loc:Loc.Text="取消" HorizontalAlignment="Stretch"
                            Click="LaunchCancelBtn_Click" />
                    <Button x:Name="LaunchBackBtn" Grid.Column="1" loc:Loc.Text="返回主页"
                            HorizontalAlignment="Stretch" Visibility="Collapsed"
                            Style="{StaticResource AccentButtonStyle}" FontWeight="Medium"
                            Click="LaunchBackBtn_Click" />
                </Grid>
            </StackPanel>
        </Grid>
    </Grid>
</Page>
