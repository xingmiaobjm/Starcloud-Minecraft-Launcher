<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="Starcloud.App.Views.HomePage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:Starcloud.App.Views"
    xmlns:beh="using:Starcloud.App.Views.Behaviors"
    xmlns:ctrl="using:Starcloud.App.Views.Controls"
    xmlns:rows="using:Starcloud.App.Views.Rows"
    xmlns:loc="using:Starcloud.App.Localization"
    NavigationCacheMode="Disabled">

    <Page.Resources>
        <!-- 版本行模板：展开态的列表与折叠态的紧凑行共用同一份，两处的图标 / 名称 / 芯片 /
             「上次启动 / 大小」/ 右键菜单 / 悬停光斑因此完全一致，不会各写一套走样。 -->
        <DataTemplate x:Key="VersionRowTemplate" x:DataType="rows:LocalVersionRow">
            <Border CornerRadius="8"
                    Background="Transparent"
                    beh:HoverShadowBehavior.IsEnabled="True"
                    beh:HoverShadowBehavior.Carrier="{Binding ElementName=VersionRowGlow}"
                    beh:HoverShadowBehavior.SurfaceGlow="True"
                    RightTapped="VersionRow_RightTapped">
                <Border.RenderTransform>
                    <TranslateTransform />
                </Border.RenderTransform>
                <Border.ContextFlyout>
                    <!-- 与版本页右键菜单同构：启动 / 详细信息 / 三个文件夹入口 / 置顶·收藏 / 问 Nova / 删除 -->
                    <MenuFlyout Opening="VersionMenu_Opening">
                        <MenuFlyoutItem loc:Loc.Text="启动"
                                        Tag="{x:Bind Id}"
                                        Click="LaunchRow_Click">
                            <MenuFlyoutItem.Icon>
                                <FontIcon FontFamily="{StaticResource ScIconFont}" Glyph="&#xEBDF;" />
                            </MenuFlyoutItem.Icon>
                        </MenuFlyoutItem>
                        <MenuFlyoutItem loc:Loc.Text="打开详细信息"
                                        Tag="{x:Bind Id}"
                                        Click="VersionDetail_Click">
                            <MenuFlyoutItem.Icon>
                                <FontIcon FontFamily="{StaticResource ScIconFont}" Glyph="&#xEBA0;" />
                            </MenuFlyoutItem.Icon>
                        </MenuFlyoutItem>
                        <MenuFlyoutItem loc:Loc.Text="打开版本文件夹"
                                        Tag="{x:Bind Id}"
                                        Click="OpenVersionFolder_Click">
                            <MenuFlyoutItem.Icon>
                                <FontIcon FontFamily="{StaticResource ScIconFont}" Glyph="&#xEA94;" />
                            </MenuFlyoutItem.Icon>
                        </MenuFlyoutItem>
                        <MenuFlyoutItem loc:Loc.Text="打开存档文件夹"
                                        Tag="{x:Bind Id}"
                                        Click="OpenSavesFolder_Click">
                            <MenuFlyoutItem.Icon>
                                <FontIcon FontFamily="{StaticResource ScIconFont}" Glyph="&#xEA90;" />
                            </MenuFlyoutItem.Icon>
                        </MenuFlyoutItem>
                        <MenuFlyoutItem loc:Loc.Text="打开模组文件夹"
                                        Tag="{x:Bind Id}"
                                        Click="OpenModsFolder_Click">
                            <MenuFlyoutItem.Icon>
                                <FontIcon FontFamily="{StaticResource ScIconFont}" Glyph="&#xEA93;" />
                            </MenuFlyoutItem.Icon>
                        </MenuFlyoutItem>
                        <MenuFlyoutSeparator />
                        <MenuFlyoutItem Tag="{x:Bind PinTag}" Click="Pin_Click"
                                        loc:Loc.Text="置顶">
                            <MenuFlyoutItem.Icon>
                                <FontIcon FontFamily="{StaticResource ScIconFont}" Glyph="&#xE909;" />
                            </MenuFlyoutItem.Icon>
                        </MenuFlyoutItem>
                        <MenuFlyoutItem Tag="{x:Bind FavTag}" Click="Favorite_Click"
                                        loc:Loc.Text="收藏">
                            <MenuFlyoutItem.Icon>
                                <FontIcon FontFamily="Segoe MDL2 Assets" Glyph="&#xE734;" />
                            </MenuFlyoutItem.Icon>
                        </MenuFlyoutItem>
                        <MenuFlyoutSeparator />
                        <MenuFlyoutItem loc:Loc.Text="删除此版本"
                                        Tag="{x:Bind Id}"
                                        Click="DeleteVersion_Click">
                            <MenuFlyoutItem.Icon>
                                <FontIcon FontFamily="{StaticResource ScIconFont}" Glyph="&#xEAA5;" />
                            </MenuFlyoutItem.Icon>
                        </MenuFlyoutItem>
                    </MenuFlyout>
                </Border.ContextFlyout>
                <Grid>
                    <!-- 跟随光标的卡片内阴影：只画落在本行内的那一段（文字在它之上）。
                         竖向刻意内缩 4：悬停时光斑不贴到行的上下边缘，
                         相邻两行之间留出可见留白，不会看起来连成一片暗带。 -->
                    <Border x:Name="VersionRowGlow" CornerRadius="8"
                            Margin="0,4"
                            Opacity="0" IsHitTestVisible="False">
                        <Border.Background>
                            <RadialGradientBrush Center="0.5,0.5" GradientOrigin="0.5,0.5" RadiusX="0.9" RadiusY="0.9">
                                <GradientStop Color="#28000000" Offset="0" />
                                <GradientStop Color="#1F000000" Offset="0.18" />
                                <GradientStop Color="#16000000" Offset="0.40" />
                                <GradientStop Color="#0D000000" Offset="0.62" />
                                <GradientStop Color="#05000000" Offset="0.82" />
                                <GradientStop Color="#00000000" Offset="1" />
                            </RadialGradientBrush>
                        </Border.Background>
                    </Border>
                    <!-- 选中标记：主题色 6% 淡底（竖向位移由 VersionListArea 上那层共用竖条负责，
                         见 SelectionBarLayer）。选中行由 SyncSelectedInset 切可见性。 -->
                    <Grid x:Name="VersionRowMark" Tag="inset" Visibility="Collapsed" IsHitTestVisible="False">
                        <Border CornerRadius="8" Background="#10FFD322" />
                    </Grid>
                    <Grid Padding="10,8" ColumnSpacing="12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="260" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <!-- 版本方块图标块：加载器图标优先，原版按类型；取不到图标时留空底块 -->
                        <Border Width="32" Height="32" CornerRadius="8"
                                Background="{ThemeResource SubtleFillColorSecondaryBrush}">
                            <Grid>
                                <Image Source="{x:Bind Icon}" Width="32" Height="32"
                                       Stretch="Uniform" />
                                <FontIcon FontFamily="{StaticResource ScIconFont}" Glyph="&#xEC62;" FontSize="14"
                                          Visibility="{x:Bind IconFontVisibility}"
                                          Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                            </Grid>
                        </Border>
                        <TextBlock Grid.Column="1" Text="{x:Bind Id}" FontWeight="Medium"
                                   VerticalAlignment="Center"
                                   TextTrimming="CharacterEllipsis" />
                        <!-- 元信息芯片：与版本页同款（类型 / 类别） -->
                        <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="6"
                                    VerticalAlignment="Center">
                            <Border Style="{StaticResource ScChip}">
                                <TextBlock Text="{x:Bind KindText}"
                                           Style="{StaticResource ScChipText}" />
                            </Border>
                            <Border Style="{StaticResource ScChip}"
                                    Visibility="{x:Bind CategoryVisibility}">
                                <TextBlock Text="{x:Bind Category}"
                                           Style="{StaticResource ScChipText}" />
                            </Border>
                        </StackPanel>
                        <!-- 最右：收藏 / 置顶图标（只有设置了才出现，顺序：置顶在前、收藏在后）。
                             置顶用鸿蒙实心图钉（E909），收藏用鸿蒙圆角五角星（EC4D）——
                             比 Segoe E735 的尖角星柔和；颜色走主题主文字色。 -->
                        <StackPanel Grid.Column="3" Orientation="Horizontal" Spacing="8"
                                    VerticalAlignment="Center" HorizontalAlignment="Right"
                                    Margin="0,0,18,0">
                            <FontIcon FontFamily="{StaticResource ScIconFont}" Glyph="&#xE909;"
                                      FontSize="18" FontWeight="SemiBold"
                                      Foreground="{ThemeResource TextFillColorPrimaryBrush}"
                                      Visibility="{x:Bind PinVisibility}"
                                      ToolTipService.ToolTip="置顶" />
                            <FontIcon FontFamily="{StaticResource ScIconFont}" Glyph="&#xEC4D;"
                                      FontSize="18" FontWeight="SemiBold"
                                      Foreground="{ThemeResource TextFillColorPrimaryBrush}"
                                      Visibility="{x:Bind FavoriteVisibility}"
                                      ToolTipService.ToolTip="收藏" />
                        </StackPanel>
                    </Grid>
                </Grid>
            </Border>
        </DataTemplate>

        <!-- 折叠态紧凑行的内容：只留版本方块图标 + 版本名，宽度自适应、长了省略号截断。
             刻意不复用 VersionRowTemplate：那份里的名称列是写死的 260，加上芯片列与数据列
             会把只裹一条的窄卡（280）撑爆；这里只 x:Bind 两个字段，其余一概不出现。 -->
        <DataTemplate x:Key="VersionCompactTemplate" x:DataType="rows:LocalVersionRow">
            <Grid Padding="10,8" ColumnSpacing="12">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Border Width="32" Height="32" CornerRadius="8"
                        Background="{ThemeResource SubtleFillColorSecondaryBrush}">
                    <Grid>
                        <Image Source="{x:Bind Icon}" Width="32" Height="32"
                               Stretch="Uniform" />
                        <FontIcon FontFamily="{StaticResource ScIconFont}" Glyph="&#xEC62;" FontSize="14"
                                  Visibility="{x:Bind IconFontVisibility}"
                                  Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                    </Grid>
                </Border>
                <TextBlock Grid.Column="1" Text="{x:Bind Id}" FontWeight="Medium"
                           VerticalAlignment="Center"
                           TextTrimming="CharacterEllipsis" />
            </Grid>
        </DataTemplate>
    </Page.Resources>

    <!-- 不用 ScrollViewer：整体填满视口，卡片与窗口同高（PCL2 式） -->
    <!-- 根节点两层：HomeContent（主页两列）+ LaunchOverlay（启动页覆盖层，见文件尾） -->
    <Grid>
        <Grid x:Name="HomeContent" MaxWidth="1280" HorizontalAlignment="Stretch">
            <!-- 卡片网格：固定 12 列 × 6 行，主页永远不滚动。
                 卡片按固定尺寸档位摆放，放不下就提示，不靠拉高页面解决。 -->
            <ctrl:CardGridPanel x:Name="HomeGrid" Columns="12" Rows="6" ColumnGap="24" RowGap="16"
                                StretchRows="True"
                                HorizontalAlignment="Stretch" VerticalAlignment="Stretch">
            <ctrl:CardHost x:Name="VersionsHost" CardId="versions" CardType="versions"
                           Column="0" Row="0" ColumnSpan="8" RowSpan="6">

        <!-- ═══ 左列：通知/自检（按需占位） + 插件首页卡片 + 版本库（撑满余下高度） ═══
             各行之间的间距走元素自己的 Margin，不用 Grid.RowSpacing：
             RowSpacing 按行边界收取，通知区 / 挂载区 / 卡片带整块收起、行高为 0 时它照收一份，
             版本卡就被推下去一截，与右栏账户卡的上边缘对不齐。 -->
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <!-- 状态摘要条：只在收起态露面（展开态由版本卡自己占满整列） -->
                <RowDefinition Height="Auto" />
                <!-- 插件挂载区（home.top）：无贡献时整行高度为 0，版本卡的位置与从前一致 -->
                <RowDefinition Height="Auto" />
                <!-- 插件首页卡片带（contributes.homeCards）：同上，无贡献时整行高度为 0 -->
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <!-- 三张通知条 + 自检卡全不可见时整块收成 Collapsed（不参与布局），
                 版本卡才能贴齐右栏卡的上边缘；由 RefreshLeftNoticeArea 统一切换。
                 这里必须显式给 Collapsed：三根 InfoBar 初始就是 IsOpen=False、自检卡也是 Collapsed，
                 属性没变化 → 回调一次都不触发，若留给默认 Visible，零高 InfoBar 仍会被 Spacing 收
                 2×8 = 16 DIP 间距，版本卡正好被推下去这么多。 -->
            <StackPanel x:Name="LeftNoticeArea" Grid.Row="0" Spacing="8" Visibility="Collapsed">
                <InfoBar x:Name="GlobalErrorBar" Severity="Error" IsOpen="False" IsClosable="True"
                         loc:Loc.Title="启动出错" />
                <InfoBar x:Name="LocalErrorBar" Severity="Error" IsOpen="False" IsClosable="True"
                         loc:Loc.Title="操作失败" />
                <InfoBar x:Name="WarnBar" Severity="Warning" IsOpen="False" IsClosable="True"
                         loc:Loc.Title="提示" />

            </StackPanel>

            <!-- 插件挂载区（home.top）：装在左列通知区与版本卡之间，没贡献时不占高度 -->
            <ctrl:PluginContributionPanel Grid.Row="2" Point="home.top" Margin="0,0,0,16" />

            <!-- 插件首页卡片带（homeCards）：固定 120 高、最多 3 张，可收起成一条窄条。
                 没装插件时整块 Collapsed，版本卡的上边缘与从前一致。 -->
            <ctrl:HomeCardStrip x:Name="HomeCards" Grid.Row="3" Margin="0,0,0,16" />

            <!-- 版本库：卡片撑满左列余下的整格（上边缘与右栏账户卡齐平、下边缘贴列底），列表在卡内滚动。
                 卡片可收起：收起后只剩当前选中那一版的图标与版本名，卡收成 280 宽的窄条，
                 站到左列右沿、再整体右移一格右列空档，紧挨到启动卡左边（间距回到两列间的 24），
                 底边落在内容区底沿、与右栏启动卡齐平（两态页边距相等），
                 两栏因此读成一条底部工具条，而不是左上角孤零零挂着一块。
                 卡头与列表区一并让位，高度落到 88 = 边框 2 + 内边距 24 + 紧凑行 62。
                 七段尺寸（含卡宽、底部留白与右移量）的交替由 SetVersionsCollapsed 逐帧补间（见 HomePage.xaml.cs）。 -->

            <!-- 投影层：画在版本卡外沿之外的一圈环带（四条同心描边，越往外越淡），只在收起态露面 ——
                 收起后那条窄条整块浮起来，读成一整块而不是两块拼的。
                 刻意不做成垫在卡片背后的实底：卡片底色是半透明的亚克力（GlassCardBrush），
                 垫底会被透出来。环带靠负边距往外长、不参与布局（本层测出的期望尺寸是 0），
                 宽度、高度与底部留白在补间途中都跟着卡片走（见 SetVersionsCollapsed / StartVersionTween）；
                 必须 Bottom 对齐 + 显式高 —— 收起态窄条沉在列底、与右栏启动卡底边齐平，
                 Stretch 会让环带绷满整列，Top 则会把它顶到列顶去。横向与卡片同为 Right 对齐，
                 负右边距的右移量也照抄卡片（见 ApplyVersionTerminal）。 -->
            <Grid x:Name="VersionCardShadow" Grid.Row="4" Visibility="Collapsed" IsHitTestVisible="False"
                  HorizontalAlignment="Left" VerticalAlignment="Bottom">
                <Border Margin="-4" CornerRadius="20" Background="Transparent"
                        BorderThickness="4" BorderBrush="#0F000000" />
                <Border Margin="-8" CornerRadius="24" Background="Transparent"
                        BorderThickness="4" BorderBrush="#0B000000" />
                <Border Margin="-12" CornerRadius="28" Background="Transparent"
                        BorderThickness="4" BorderBrush="#08000000" />
                <Border Margin="-16" CornerRadius="32" Background="Transparent"
                        BorderThickness="4" BorderBrush="#04000000" />
            </Grid>

            <Border x:Name="VersionCard" Grid.Row="4"
                    Background="{ThemeResource GlassCardBrush}"
                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                    BorderThickness="1" CornerRadius="16"
                    Padding="12">
                <!-- 行间距走元素级 Margin 而不是 Grid.RowSpacing：RowSpacing 按行边界收取，
                     哪怕卡头收起成 Collapsed、行高为 0，它两侧的间距照收，空行反而把内容推开成双倍距离。
                     收起 / 展开时 Margin 与高度走同一条曲线一起归零（见 SetVersionsCollapsed）。 -->
                <!-- VersionCardBody 这个名字是给收起 / 展开动画用的：收缩途中紧凑行里那 60 高的行模板
                     会短暂超出该行，靠这里挂一层 RectangleGeometry 把溢出的部分切掉；稳态 Clip 置空。
                     裁剪框由补间逐帧直接算（见 SetVersionsCollapsed / StartVersionTween），不能再挂
                     SizeChanged 跟着 ActualHeight 走 —— 布局回调晚于补间帧，晚的那一拍裁剪框偏大，
                     溢出的紧凑行内容会被画到卡片外，看着就是抽搐。 -->
                <Grid x:Name="VersionCardBody">
                    <!-- 列表区那一行是 *：卡片撑满左列那一格后，多出来的高度全落在这里，
                         列表跟着长、由 ListView 自己在卡内滚动。 -->
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <!-- 卡头：标题 + 已安装数量 + 收起 / 展开 + 刷新 -->
                    <Grid x:Name="VersionHeader" Grid.Row="0" Padding="6,2,0,2" Margin="0,0,0,8" ColumnSpacing="8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock loc:Loc.Text="已安装版本" FontWeight="Medium" FontSize="15"
                                   VerticalAlignment="Center" />
                        <Border Grid.Column="1" CornerRadius="5" Padding="6,1" VerticalAlignment="Center"
                                Background="{ThemeResource SubtleFillColorSecondaryBrush}">
                            <TextBlock x:Name="VersionCountText" Text="(0)" FontSize="11"
                                       Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                        </Border>
                        <!-- 收起 / 展开：与刷新同一套「透明底图标按钮」，卡头高度分毫不动。
                             展开态刻度朝上（按一下把列表卷起来），收起态朝下 —— 与右栏那颗正好反向，
                             因为这一列的内容是往上收（底边上抬）、右栏那列是往下收。 -->
                        <ctrl:GlowButton x:Name="VersionCollapseBtn" Grid.Column="3" Padding="6"
                                MinWidth="0"
                                Background="Transparent" BorderThickness="0"
                                Click="VersionCollapseToggle_Click"
                                loc:Loc.Name="收起版本列表" loc:Loc.Tip="收起版本列表">
                            <Grid Width="14" Height="8">
                                <Path x:Name="VersionHeaderChevron" Data="M 0,0 L 6,6 L 12,0"
                                      Stroke="{ThemeResource TextFillColorSecondaryBrush}"
                                      StrokeThickness="1.6" StrokeLineJoin="Round"
                                      StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                                      HorizontalAlignment="Center" VerticalAlignment="Center"
                                      Fill="Transparent" />
                            </Grid>
                        </ctrl:GlowButton>
                        <ctrl:GlowButton x:Name="EditLayoutBtn" Grid.Column="4" Padding="6"
                                Background="Transparent" BorderThickness="0"
                                Click="EditLayout_Click" loc:Loc.Name="编辑布局" loc:Loc.Tip="编辑主页布局">
                            <TextBlock Text="布局" FontSize="12" />
                        </ctrl:GlowButton>
                        <ctrl:GlowButton x:Name="RefreshVersionsBtn" Grid.Column="5" Padding="6"
                                Background="Transparent" BorderThickness="0"
                                Click="RefreshVersionsBtn_Click" loc:Loc.Name="刷新列表" loc:Loc.Tip="刷新列表">
                            <FontIcon FontFamily="{StaticResource ScIconFont}" Glyph="&#xE918;" FontSize="14" />
                        </ctrl:GlowButton>
                    </Grid>

                    <!-- 列表直接坐在卡片上（去掉原来的"盒中盒"），行与版本页同款。
                         行模板提到 Page.Resources 里（VersionRowTemplate）：折叠态的紧凑行要复用同一份，
                         否则同一套 x:Bind 得在两个 DataTemplate 里各写一遍。 -->
                    <Grid x:Name="VersionListArea" Grid.Row="1">
                        <ListView x:Name="VersionList" SelectionMode="Single" Padding="0"
                                  ItemTemplate="{StaticResource VersionRowTemplate}"
                                  ContainerContentChanging="VersionList_ContainerContentChanging"
                                  SelectionChanged="VersionList_SelectionChanged">
                            <ListView.Resources>
                                <!-- 行的跟手光斑与行 Border 的圆角都是 8，但框架行底色的圆角来自
                                     ListViewItemCornerRadius（框架值 4）—— 底色的四个角比光斑更方，
                                     悬停/选中时会从角上漏出一圈。这里把本列表的行圆角对齐到 8
                                     （同 App.xaml 覆写 ControlCornerRadius 的机制，不影响其它页面）。 -->
                                <CornerRadius x:Key="ListViewItemCornerRadius">8</CornerRadius>
                                <!-- 悬停/选中反馈只由控件模板里那三层表达，框架整行底色一律关掉
                                     （框架给的是硬边直角矩形，压上圆角光斑后四个角互相啃掉一块） -->
                                <SolidColorBrush x:Key="ListViewItemBackground" Color="Transparent" />
                                <SolidColorBrush x:Key="ListViewItemBackgroundPointerOver" Color="Transparent" />
                                <!-- 按下反馈走框架的 Pressed 视觉态（悬停仍由跟手光斑负责）：
                                     圆角已由上面的 ListViewItemCornerRadius 对齐 8，不会出现直角底 -->
                                <SolidColorBrush x:Key="ListViewItemBackgroundPressed" Opacity="0.08"
                                                 Color="#808080" />
                                <SolidColorBrush x:Key="ListViewItemBackgroundSelected" Color="Transparent" />
                                <SolidColorBrush x:Key="ListViewItemBackgroundSelectedPointerOver" Color="Transparent" />
                                <SolidColorBrush x:Key="ListViewItemBackgroundSelectedPressed" Color="Transparent" />
                            </ListView.Resources>
                            <ListView.ItemContainerStyle>
                                <Style TargetType="ListViewItem">
                                    <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                                    <!-- 竖向也必须撑满：默认 Center 会把行内容（48 DIP）在 60 DIP 的行内居中，
                                         行 Border（兼作光斑载体）随之只有 48 DIP 高，上下各留 6 DIP 死区，
                                         鼠标从两行交界处掠过时落进死区、光斑完全不出现。 -->
                                    <Setter Property="VerticalContentAlignment" Value="Stretch" />
                                    <Setter Property="MinHeight" Value="60" />
                                    <Setter Property="Padding" Value="0" />
                                    <Setter Property="Margin" Value="0,1" />
                                </Style>
                            </ListView.ItemContainerStyle>
                        </ListView>
                        <!-- 选中竖条：整块列表共用一条，按行位置做真实位移（不是两条各自淡入淡出）。
                             铺在列表之上、不吃命中测试；行滚动时由代码同步位置。 -->
                        <Canvas x:Name="SelectionBarLayer" IsHitTestVisible="False"
                                HorizontalAlignment="Stretch" VerticalAlignment="Stretch">
                            <Border x:Name="SelectionBar" Width="3" CornerRadius="2"
                                    Background="#FFD322" RenderTransformOrigin="0.5,0.5">
                                <Border.RenderTransform>
                                    <CompositeTransform />
                                </Border.RenderTransform>
                            </Border>
                        </Canvas>
                        <ctrl:EmptyStateView x:Name="EmptyVersionHint" Visibility="Collapsed"
                                              MinHeight="200"
                                              HorizontalAlignment="Center" VerticalAlignment="Center"
                                              Glyph="&#xEA94;"
                                              loc:Loc.Title="暂无已安装版本"
                                              loc:Loc.ActionText="前往下载页安装"
                                              ActionClick="PickVersion_Click" />
                    </Grid>

                    <!-- 折叠态：只留当前选中那一版，行右端贴一颗刻度按钮（与右栏卡片里那颗对称） -->
                    <Grid x:Name="VersionCompactRow" Grid.Row="2" Height="0" Visibility="Collapsed"
                          ColumnSpacing="8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <!-- 行本体：图标 + 版本名（见 VersionCompactTemplate）。点击即展开卡片。
                             刻意不把刻度按钮包进来 —— 否则按刻度会先冒泡到这一层再展开一次，
                             按钮自己的点击就成了空转。 -->
                        <Grid Grid.Column="0" Background="Transparent" VerticalAlignment="Top"
                              Tapped="VersionCompactRow_Tapped">
                            <ContentPresenter x:Name="VersionCompactPresenter"
                                              Height="60" Margin="0,1"
                                              VerticalAlignment="Top"
                                              HorizontalContentAlignment="Stretch"
                                              VerticalContentAlignment="Stretch"
                                              ContentTemplate="{StaticResource VersionCompactTemplate}" />
                        </Grid>
                        <!-- 与卡头两颗图标按钮同款透明底、无边框：窄条因此读成一整块，
                             而不是「行 + 一颗有底色的按钮」两块拼接（悬停底色仍由模板给）。 -->
                        <ctrl:GlowButton x:Name="VersionCompactBtn" Grid.Column="1"
                                Width="32" Height="60" MinWidth="0" Padding="0"
                                Margin="0,1" VerticalAlignment="Top" CornerRadius="8"
                                Background="Transparent" BorderThickness="0"
                                loc:Loc.Name="展开版本列表" loc:Loc.Tip="展开版本列表"
                                Click="VersionCollapseToggle_Click">
                            <Grid Width="14" Height="8">
                                <Path x:Name="VersionCompactChevron" Data="M 0,0 L 6,6 L 12,0"
                                      Stroke="{ThemeResource TextFillColorSecondaryBrush}"
                                      StrokeThickness="1.6" StrokeLineJoin="Round"
                                      StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                                      HorizontalAlignment="Center" VerticalAlignment="Center"
                                      Fill="Transparent" />
                            </Grid>
                        </ctrl:GlowButton>
                    </Grid>
                </Grid>
            </Border>
        </Grid>
            </ctrl:CardHost>

            <ctrl:CardHost x:Name="AccountHost" CardId="account" CardType="account"
                           Column="8" Row="0" ColumnSpan="4" RowSpan="6">
        <!-- ═══ 右列：PCL2 式账户/启动卡（与窗口同高；可收起成一条只留启动按钮的 Dock） ═══ -->
        <!-- 展开态：Height=NaN + 拉伸，卡片跟着窗口同高；收起态：88 高 × 280 宽的窄条 + 右／底边对齐，
             与左栏版本窄条同尺寸（两角各一颗同宽同高的 Dock）。收起态底边就落在内容区底沿上，
             与展开态一致（两态页边距相等，不再多留一段底部缝）；由 SetCardExpanded 逐帧补间两者之间过渡
             （高度与宽度都是依赖型属性，上不了合成层）。宽度收起时右对齐 —— 右边缘始终贴着列右沿，
             与左栏窄条贴列左沿正好镜像。 -->
        <Border x:Name="AccountCard"
                Background="{ThemeResource GlassCardBrush}"
                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                BorderThickness="1" CornerRadius="16" Padding="12">
            <!-- 行间距走元素级 Margin 而不是 Grid.RowSpacing：RowSpacing 按行边界收取，
                 哪怕 StatusText（Row3）收起成 Collapsed、行高为 0，它两侧的间距照收，
                 空行反而把启动按钮推开成双倍距离。Margin 跟着元素一起收起，才不露白。 -->
            <!-- CardBody 这个名字是给收起/展开动画用的：折叠的中间帧里账户区所在的 * 行被压向 0，
                 内容的实高会短暂超出卡片，动画期间靠 CardBody_SizeChanged 挂一层 RectangleGeometry
                 把溢出的部分切掉；稳态 Clip 置空，既不参与布局也不裁任何东西。 -->
            <Grid x:Name="CardBody" SizeChanged="CardBody_SizeChanged">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <!-- 账户模式：正版 / 第三方外置 / 离线。
                     与下载页「正式版 / 快照版 / 远古版本」用同一套分段控件语汇（DESIGN.md §12 工具条）：
                     外框圆角 10、内缩 2，三段等宽无边框，选中态是品牌色药丸 + 黑字，指示器随点击平移。
                     这里是卡片顶部的整行控件，所以直接通栏（不再居中收成 270 宽）——与下面的账户下拉框、
                     启动按钮同为「卡片整宽」，三者的左右边缘因此对齐成一条竖线；三段也靠 * 列无缝连成一体，
                     不再有中间那道 8 DIP 的缝隙。段宽不写死，交给 ModeGrid_SizeChanged 按实测宽度分配，
                     窗口缩放 / 语言切换（文字变长）都不会跑偏。分段自带的选中底色已置空，避免两个指示器。
                     整条 40 高（1 边框 + 2 内缩 + 34 按钮 + 2 + 1），与启动行同为整宽、
                     左右边缘对齐；高度上刻意不跟启动行等高——底部那颗是 60 高的大 CTA。
                     悬停时条内浮起一层跟手光斑（ModeBarGlow），与列表行 / 卡片共用一套语汇。
                     光斑半径由 GlowRadius 显式给成 30：条内的可见区只有 34 高，自动半径
                     （短边 × 2.5 = 85）在竖直方向淡不完，会被条的上下沿硬切一刀，看起来
                     就是一条上下硬边的灰带（外观割裂）；30 仍有富余能淡到近乎零（上下沿
                     只剩 6% 的余量，看不出硬边），同时核心比原来的 20 明显铺开一圈——
                     20 时深色核心只有 16px 宽，在整宽的条里显小。
                     三段按钮自己的悬停 / 按下底刷也一并置空（见各自 Resources）——
                     WinUI 默认会在这颗按钮自己的圆角矩形里刷一层灰，与光斑叠起来又是一块硬边灰方块。 -->
                <Border x:Name="ModeBar" Grid.Row="0"
                        Background="{ThemeResource ControlFillColorSecondaryBrush}"
                        BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                        BorderThickness="1" CornerRadius="10" Padding="2"
                        beh:HoverShadowBehavior.IsEnabled="True"
                        beh:HoverShadowBehavior.Carrier="{Binding ElementName=ModeBarGlow}"
                        beh:HoverShadowBehavior.GlowRadius="30">
                    <Grid x:Name="ModeGrid" SizeChanged="ModeGrid_SizeChanged">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <!-- 跟手光斑：只画落在分段条内的那一段，三段按钮与药丸都在它之上。
                             与列表行同款——径向渐变的中心跟着指针走，深色核心就在光标下、往外渐淡；
                             内联的是叠黑色（浅色主题正确），深色主题下由行为统一改写成叠白。 -->
                        <Border x:Name="ModeBarGlow" CornerRadius="7"
                                Grid.ColumnSpan="3"
                                Opacity="0" IsHitTestVisible="False">
                            <Border.Background>
                                <RadialGradientBrush Center="0.5,0.5" GradientOrigin="0.5,0.5" RadiusX="0.9" RadiusY="0.9">
                                    <GradientStop Color="#28000000" Offset="0" />
                                    <GradientStop Color="#1F000000" Offset="0.18" />
                                    <GradientStop Color="#16000000" Offset="0.40" />
                                    <GradientStop Color="#0D000000" Offset="0.62" />
                                    <GradientStop Color="#05000000" Offset="0.82" />
                                    <GradientStop Color="#00000000" Offset="1" />
                                </RadialGradientBrush>
                            </Border.Background>
                        </Border>
                        <!-- 选中指示器：品牌强调色药丸，位置由合成动画平移（260ms / 进场曲线）。
                             宽度与段宽一致，由代码随容器实测宽度设置；横跨三列才不会被列裁剪。 -->
                        <Border x:Name="ModeIndicator" Height="34" CornerRadius="7"
                                Grid.ColumnSpan="3"
                                HorizontalAlignment="Left" VerticalAlignment="Center"
                                IsHitTestVisible="False"
                                Background="{ThemeResource AccentFillColorDefaultBrush}" />
                        <ToggleButton x:Name="ModeMsBtn" Tag="microsoft"
                                      Grid.Column="0" Height="34" Padding="0" MinWidth="0"
                                      HorizontalAlignment="Stretch"
                                      FontSize="13" CornerRadius="7" BorderThickness="0"
                                      Background="Transparent"
                                      Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                      loc:Loc.Text="正版" loc:Loc.Name="正版"
                                      Click="ModeMs_Click">
                            <ToggleButton.Resources>
                                <!-- 悬停 / 按下：不写就吃 WinUI 默认的半透明灰填充，它按按钮自身
                                     圆角矩形刷色，边缘是硬的；悬停反馈已经由条内的跟手光斑表达，
                                     这里把两态底刷一并置空，免得叠出一块硬边灰方块。 -->
                                <SolidColorBrush x:Key="ToggleButtonBackgroundPointerOver" Color="Transparent" />
                                <SolidColorBrush x:Key="ToggleButtonBackgroundPressed" Color="Transparent" />
                                <!-- 选中态由滑动指示器表达：这里只保留黑字（accent 面强制黑字） -->
                                <SolidColorBrush x:Key="ToggleButtonBackgroundChecked" Color="Transparent" />
                                <SolidColorBrush x:Key="ToggleButtonBackgroundCheckedPointerOver" Color="Transparent" />
                                <SolidColorBrush x:Key="ToggleButtonBackgroundCheckedPressed" Color="Transparent" />
                                <SolidColorBrush x:Key="ToggleButtonBorderBrushChecked" Color="Transparent" />
                                <SolidColorBrush x:Key="ToggleButtonForegroundChecked" Color="#E61A1A1A" />
                                <SolidColorBrush x:Key="ToggleButtonForegroundCheckedPointerOver" Color="#E61A1A1A" />
                                <SolidColorBrush x:Key="ToggleButtonForegroundCheckedPressed" Color="#E61A1A1A" />
                            </ToggleButton.Resources>
                        </ToggleButton>
                        <ToggleButton x:Name="ModeExternalBtn" Tag="external"
                                      Grid.Column="1" Height="34" Padding="0" MinWidth="0"
                                      HorizontalAlignment="Stretch"
                                      FontSize="13" CornerRadius="7" BorderThickness="0"
                                      Background="Transparent"
                                      Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                      loc:Loc.Text="外置" loc:Loc.Name="外置"
                                      Click="ModeExternal_Click">
                            <ToggleButton.Resources>
                                <!-- 同上：悬停 / 按下的默认灰底置空，反馈交给条内光斑 -->
                                <SolidColorBrush x:Key="ToggleButtonBackgroundPointerOver" Color="Transparent" />
                                <SolidColorBrush x:Key="ToggleButtonBackgroundPressed" Color="Transparent" />
                                <SolidColorBrush x:Key="ToggleButtonBackgroundChecked" Color="Transparent" />
                                <SolidColorBrush x:Key="ToggleButtonBackgroundCheckedPointerOver" Color="Transparent" />
                                <SolidColorBrush x:Key="ToggleButtonBackgroundCheckedPressed" Color="Transparent" />
                                <SolidColorBrush x:Key="ToggleButtonBorderBrushChecked" Color="Transparent" />
                                <SolidColorBrush x:Key="ToggleButtonForegroundChecked" Color="#E61A1A1A" />
                                <SolidColorBrush x:Key="ToggleButtonForegroundCheckedPointerOver" Color="#E61A1A1A" />
                                <SolidColorBrush x:Key="ToggleButtonForegroundCheckedPressed" Color="#E61A1A1A" />
                            </ToggleButton.Resources>
                        </ToggleButton>
                        <ToggleButton x:Name="ModeOfflineBtn" Tag="offline"
                                      Grid.Column="2" Height="34" Padding="0" MinWidth="0"
                                      HorizontalAlignment="Stretch"
                                      FontSize="13" CornerRadius="7" BorderThickness="0"
                                      Background="Transparent"
                                      Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                      loc:Loc.Text="离线" loc:Loc.Name="离线"
                                      Click="ModeOffline_Click">
                            <ToggleButton.Resources>
                                <!-- 同上：悬停 / 按下的默认灰底置空，反馈交给条内光斑 -->
                                <SolidColorBrush x:Key="ToggleButtonBackgroundPointerOver" Color="Transparent" />
                                <SolidColorBrush x:Key="ToggleButtonBackgroundPressed" Color="Transparent" />
                                <SolidColorBrush x:Key="ToggleButtonBackgroundChecked" Color="Transparent" />
                                <SolidColorBrush x:Key="ToggleButtonBackgroundCheckedPointerOver" Color="Transparent" />
                                <SolidColorBrush x:Key="ToggleButtonBackgroundCheckedPressed" Color="Transparent" />
                                <SolidColorBrush x:Key="ToggleButtonBorderBrushChecked" Color="Transparent" />
                                <SolidColorBrush x:Key="ToggleButtonForegroundChecked" Color="#E61A1A1A" />
                                <SolidColorBrush x:Key="ToggleButtonForegroundCheckedPointerOver" Color="#E61A1A1A" />
                                <SolidColorBrush x:Key="ToggleButtonForegroundCheckedPressed" Color="#E61A1A1A" />
                            </ToggleButton.Resources>
                        </ToggleButton>
                    </Grid>
                </Border>

                <!-- 头像 + 账户（垂直居中，模拟 PCL2 卡片中部）。
                     账户名只有一行，居中摆开；没有账户时把「登录/添加」按钮通栏摆出来，
                     与下方启动按钮的左右边缘对齐成一条竖线。
                     收起卡片时整块淡出并让位（账户信息与三态切换都只在展开态露面）。 -->
                <StackPanel x:Name="AccountArea" Grid.Row="1" VerticalAlignment="Center" Spacing="10">
                    <Border Width="72" Height="72" CornerRadius="12"
                            HorizontalAlignment="Center"
                            Background="{ThemeResource AccentFillColorDefaultBrush}">
                        <Grid>
                            <!-- 首字母兜底：未选账户 / 无网络 / 名字不存在时可见 -->
                            <TextBlock x:Name="AvatarText" Text="?" FontSize="28" FontWeight="Medium"
                                       Foreground="{ThemeResource TextOnAccentFillColorPrimaryBrush}"
                                       HorizontalAlignment="Center" VerticalAlignment="Center" />
                            <!-- 皮肤头像覆盖在色块上；加载失败不渲染，即露出下面的首字母 -->
                            <Image x:Name="AvatarImage" Stretch="UniformToFill" />
                        </Grid>
                    </Border>
                    <TextBlock x:Name="AccountNameText" loc:Loc.Text="未选择账户" FontWeight="Medium"
                               FontSize="17" HorizontalAlignment="Center" TextTrimming="CharacterEllipsis" />
                    <!-- 该模式还没有账户时不摆一句「尚无正版账户」堵在那里，直接给登录入口：
                         点开就地弹对应方式的登录框（微软设备码 / 第三方账密 / 离线填名字），
                         登录成功即刷新上面这张卡，不用再去账户页（见 RefreshAccounts）。 -->
                    <ctrl:GlowButton x:Name="NoAccountBtn" Height="32"
                            HorizontalAlignment="Stretch" Visibility="Collapsed"
                            Click="NoAccountBtn_Click" />
                    <!-- 切换账号：平时隐形，指针移到这一条才浮出来（PCL2 那套"藏着"的玩法）。 -->
                    <Grid Height="32" Background="Transparent"
                          PointerEntered="SwitchAccountArea_Entered"
                          PointerExited="SwitchAccountArea_Exited">
                        <ctrl:GlowButton x:Name="SwitchAccountBtn" Opacity="0"
                                MinWidth="0" Height="32" Padding="16,0"
                                HorizontalAlignment="Center" CornerRadius="8"
                                loc:Loc.Text="切换账号" loc:Loc.Name="切换账号"
                                Click="SwitchAccount_Click" />
                    </Grid>
                </StackPanel>

                <!-- 启动行：主按钮 + 右侧收起/展开刻度按钮，同一行等高拼在一起（间隙 8）。
                     主按钮是 60 高的大 CTA（占卡片整宽，只让出刻度按钮那 32 + 8），
                     里面竖直摆两行：上面「播放/停止轮廓 + 启动游戏」，下面一行是当前选中版本名。
                     刻度按钮跟着拉到同高、宽仍是 32。上面的分段控件维持 40 高不变，
                     所以卡片顶部（分段条）与底部（启动行）不等高。
                     收起态（见 SetCardExpanded）留下的就是这一行：分段控件与账户区淡出、
                     卡片高度收到 2 + 24 + 62 = 88（上下边框 + 上下内边距 + 启动行），
                     像一条只挂着启动按钮的紧凑 Dock。
                     上下各留 1 外边距，把启动行凑成 62 高 —— 与左栏紧凑行（行模板 60 + 上下各 1）
                     同一份，两角 Dock 才能严丝合缝地等高（2 + 24 + 62 = 88，与版本窄条一致）。
                     这份外边距被 Auto 行测进行高里、随行一起进卡，不属于「不参与高度动画的 Margin」，
                     收起时不会从卡片下沿糊出来。 -->
                <Grid Grid.Row="2" Margin="0,1" ColumnSpacing="8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <!-- 主按钮：两行内容，整块竖直居中。
                         上行是「播放/停止轮廓 + 启动游戏」，下行是当前选中版本名。
                         下行外面用 Grid 而不是再套一层 StackPanel：Grid 会撑满按钮内容区，
                         超长版本名才有确定的宽度可裁，TextTrimming 的省略号才生效。 -->
                    <Button x:Name="LaunchBtn" Grid.Column="0" HorizontalAlignment="Stretch" Height="60"
                            Style="{StaticResource ScAccentButtonStyle}"
                            loc:Loc.Name="启动游戏"
                            Click="LaunchBtn_Click">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>
                            <StackPanel Grid.Row="0" Orientation="Horizontal" Spacing="8" HorizontalAlignment="Center">
                                <!-- 轮廓播放/停止标记：字体字形（E768 / E71A）只有一种线宽，
                                     在亮黄底上显得太细。改自绘轮廓——形状与字形一致、不填充，
                                     粗细由 StrokeThickness 单独控制；线细了以后视觉尺寸跟着缩水，
                                     所以几何体定在约 13 × 12、描边 2，与 16px 文字同高。
                                     两个标记的形状与相对位置一致，切换播放/停止时不会跳位。 -->
                                <Grid VerticalAlignment="Center">
                                    <Path x:Name="LaunchPlayIcon" Data="M 2.6,0.3 L 13.65,6.15 L 2.6,11.99 Z"
                                          Stroke="{Binding Foreground, ElementName=LaunchBtn}"
                                          StrokeThickness="2" StrokeLineJoin="Round" Fill="Transparent" />
                                    <Path x:Name="LaunchStopIcon" Data="M 1.6,1.6 H 10.7 V 10.7 H 1.6 Z"
                                          Stroke="{Binding Foreground, ElementName=LaunchBtn}"
                                          StrokeThickness="2" StrokeLineJoin="Round" Fill="Transparent"
                                          Visibility="Collapsed" />
                                </Grid>
                                <!-- 黄底按钮上的文字一律跟随按钮 Foreground，不写死颜色：
                                     基样式里一旦定死前景色，这一行就会脱离按钮配色，而图标还跟着按钮走。
                                     accent 面的黑字由按钮自身的 Foreground 提供。 -->
                                <TextBlock x:Name="LaunchTitleText" loc:Loc.Text="启动游戏" FontWeight="Medium" FontSize="16"
                                           Foreground="{Binding Foreground, ElementName=LaunchBtn}" />
                            </StackPanel>
                            <!-- 当前选中版本名：同样跟随按钮 Foreground（accent 面黑字）。
                                 字号小一号 + 略降不透明度，读起来是主标题下面的次级信息；
                                 空版本用「未选择版本」兜底，文字由 UpdateVersionMeta 同步。 -->
                            <TextBlock x:Name="LaunchBtnVersionText" Grid.Row="1" Margin="0,1,0,0"
                                       loc:Loc.Text="未选择版本"
                                       FontSize="12" Opacity="0.72"
                                       TextTrimming="CharacterEllipsis"
                                       HorizontalAlignment="Center"
                                       Foreground="{Binding Foreground, ElementName=LaunchBtn}" />
                        </Grid>
                    </Button>

                    <!-- 收起 / 展开：与启动按钮同高的窄条刻度按钮（32 宽 × 60 高），拼在它右侧。
                         底色与描边取分段控件外框那一套（次填充 + 卡片描边）；chevron 在窄条里竖直居中，
                         展开态朝下、收起态旋到朝上（走合成层，见 AnimateChevron），
                         tooltip 与无障碍名随之在「收起卡片 / 展开卡片」之间切换（见 UpdateCollapseChrome）。 -->
                    <ctrl:GlowButton x:Name="CollapseBtn" Grid.Column="1"
                            Width="32" Height="60" MinWidth="0" Padding="0"
                            CornerRadius="9"
                            Background="{ThemeResource ControlFillColorSecondaryBrush}"
                            BorderThickness="1"
                            BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                            loc:Loc.Tip="收起卡片" loc:Loc.Name="收起卡片"
                            Click="CollapseToggle_Click">
                        <!-- 定尺寸的外框让 chevron 无论描边多粗都居中：几何体 12 × 6，
                             在 14 × 8 里居中后，1.6 的描边正好落在四周留出的一圈内。 -->
                        <Grid Width="14" Height="8">
                            <Path x:Name="CollapseChevron" Data="M 0,0 L 6,6 L 12,0"
                                  Stroke="{ThemeResource TextFillColorSecondaryBrush}"
                                  StrokeThickness="1.6" StrokeLineJoin="Round"
                                  StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                                  HorizontalAlignment="Center" VerticalAlignment="Center"
                                  Fill="Transparent" />
                        </Grid>
                    </ctrl:GlowButton>
                </Grid>

                <!-- 进度与状态（收起时连同上方间距一起消失） -->
                <TextBlock x:Name="StatusText" Grid.Row="3" Margin="0,14,0,0" FontSize="12" TextAlignment="Center"
                           Visibility="Collapsed"
                           Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextWrapping="Wrap" />
            </Grid>
        </Border>
            </ctrl:CardHost>

            <!-- ═══ 可选卡片：默认隐藏，通过编辑模式浮条里的「卡片」菜单添加 ═══
                 启动按钮：按钮本身按内容自适应大小并居中，不铺满整张卡 ——
                 铺满的话 4×2 的卡就是一大块纯黄色。 -->
            <ctrl:CardHost x:Name="LaunchHost" CardId="launch" CardType="launch"
                           Column="8" Row="0" ColumnSpan="2" RowSpan="3" Visibility="Collapsed">
                <ctrl:SizeAwareContent x:Name="LaunchCardBody">
                    <Border Background="{ThemeResource GlassCardBrush}"
                            BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                            BorderThickness="1" CornerRadius="16" Padding="8">
                        <Button x:Name="CardLaunchBtn" Click="CardLaunch_Click"
                                Style="{StaticResource ScAccentButtonStyle}"
                                HorizontalAlignment="Center" VerticalAlignment="Center"
                                HorizontalContentAlignment="Center" VerticalContentAlignment="Center"
                                Padding="16,10">
                            <StackPanel Spacing="3" HorizontalAlignment="Center" VerticalAlignment="Center">
                                <FontIcon FontFamily="{StaticResource ScIconFont}" Glyph="&#xEBDF;" FontSize="20" />
                                <TextBlock x:Name="CardLaunchTitle" Text="启动游戏" FontSize="13"
                                           FontWeight="Medium" HorizontalAlignment="Center" />
                                <TextBlock x:Name="CardLaunchVersion" FontSize="11" Opacity="0.75"
                                           HorizontalAlignment="Center" TextTrimming="CharacterEllipsis"
                                           MaxWidth="150" />
                            </StackPanel>
                        </Button>
                    </Border>
                </ctrl:SizeAwareContent>
            </ctrl:CardHost>

            <!-- 账户选择：模式分段（正版 / 外置 / 离线）+ 头像 + 名字，和账户卡里那一块同构。 -->
            <ctrl:CardHost x:Name="AccountPickerHost" CardId="account-picker" CardType="account-picker"
                           Column="8" Row="5" ColumnSpan="4" RowSpan="3" Visibility="Collapsed">
                <ctrl:SizeAwareContent x:Name="AccountPickerBody">
                    <Border Background="{ThemeResource GlassCardBrush}"
                            BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                            BorderThickness="1" CornerRadius="16" Padding="12">
                        <Grid RowSpacing="8">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="*" />
                            </Grid.RowDefinitions>
                            <Border Background="{ThemeResource SubtleFillColorSecondaryBrush}"
                                    CornerRadius="8" Padding="2">
                                <Grid ColumnSpacing="2">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <ToggleButton x:Name="PickerMsBtn" Grid.Column="0" Tag="microsoft"
                                                  Content="正版" Click="PickerMode_Click"
                                                  FontSize="11" Padding="6,3" MinWidth="0" BorderThickness="0"
                                                  HorizontalAlignment="Stretch" HorizontalContentAlignment="Center" />
                                    <ToggleButton x:Name="PickerExternalBtn" Grid.Column="1" Tag="external"
                                                  Content="外置" Click="PickerMode_Click"
                                                  FontSize="11" Padding="6,3" MinWidth="0" BorderThickness="0"
                                                  HorizontalAlignment="Stretch" HorizontalContentAlignment="Center" />
                                    <ToggleButton x:Name="PickerOfflineBtn" Grid.Column="2" Tag="offline"
                                                  Content="离线" Click="PickerMode_Click"
                                                  FontSize="11" Padding="6,3" MinWidth="0" BorderThickness="0"
                                                  HorizontalAlignment="Stretch" HorizontalContentAlignment="Center" />
                                </Grid>
                            </Border>
                            <Button x:Name="AccountPickerBtn" Grid.Row="1" Click="AccountPicker_Click"
                                    Background="Transparent" BorderThickness="0" Padding="0"
                                    HorizontalAlignment="Stretch" VerticalAlignment="Stretch"
                                    HorizontalContentAlignment="Stretch" VerticalContentAlignment="Center">
                                <StackPanel Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
                                    <Border Width="40" Height="40" CornerRadius="20"
                                            Background="{ThemeResource SubtleFillColorSecondaryBrush}">
                                        <Grid>
                                            <TextBlock x:Name="PickerAvatarText" FontSize="16" FontWeight="Medium"
                                                       HorizontalAlignment="Center" VerticalAlignment="Center" />
                                            <Image x:Name="PickerAvatarImage" Stretch="UniformToFill" />
                                        </Grid>
                                    </Border>
                                    <StackPanel VerticalAlignment="Center" Spacing="2">
                                        <TextBlock x:Name="PickerNameText" FontWeight="Medium" FontSize="13"
                                                   TextTrimming="CharacterEllipsis" MaxWidth="160" />
                                        <TextBlock x:Name="PickerHintText" Text="点击切换账户" FontSize="11"
                                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                    </StackPanel>
                                </StackPanel>
                            </Button>
                        </Grid>
                    </Border>
                </ctrl:SizeAwareContent>
            </ctrl:CardHost>

            <!-- 收藏 / 最近：同一套版本小列表，行数随卡片高度、芯片随宽度增减（见 RebuildMiniList）。 -->
            <ctrl:CardHost x:Name="FavoritesHost" CardId="favorites" CardType="favorites"
                           Column="0" Row="6" ColumnSpan="4" RowSpan="4" Visibility="Collapsed">
                <ctrl:SizeAwareContent x:Name="FavoritesBody">
                    <Border Background="{ThemeResource GlassCardBrush}"
                            BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                            BorderThickness="1" CornerRadius="16" Padding="12">
                        <Grid RowSpacing="6">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="*" />
                            </Grid.RowDefinitions>
                            <TextBlock x:Name="FavoritesTitle" Text="收藏的版本" FontWeight="Medium" FontSize="13" />
                            <StackPanel x:Name="FavoritesList" Grid.Row="1" Spacing="2" />
                        </Grid>
                    </Border>
                </ctrl:SizeAwareContent>
            </ctrl:CardHost>

            <ctrl:CardHost x:Name="RecentHost" CardId="recent" CardType="recent"
                           Column="0" Row="6" ColumnSpan="4" RowSpan="4" Visibility="Collapsed">
                <ctrl:SizeAwareContent x:Name="RecentBody">
                    <Border Background="{ThemeResource GlassCardBrush}"
                            BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                            BorderThickness="1" CornerRadius="16" Padding="12">
                        <Grid RowSpacing="6">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="*" />
                            </Grid.RowDefinitions>
                            <TextBlock x:Name="RecentTitle" Text="最近的版本" FontWeight="Medium" FontSize="13" />
                            <StackPanel x:Name="RecentList" Grid.Row="1" Spacing="2" />
                        </Grid>
                    </Border>
                </ctrl:SizeAwareContent>
            </ctrl:CardHost>

            <!-- 游玩时长排名：按累计游玩秒数倒序（秒数在游戏正常退出后入账）。 -->
            <ctrl:CardHost x:Name="MostPlayedHost" CardId="most-played" CardType="most-played"
                           Column="0" Row="6" ColumnSpan="4" RowSpan="4" Visibility="Collapsed">
                <ctrl:SizeAwareContent x:Name="MostPlayedBody">
                    <Border Background="{ThemeResource GlassCardBrush}"
                            BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                            BorderThickness="1" CornerRadius="16" Padding="12">
                        <Grid RowSpacing="6">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="*" />
                            </Grid.RowDefinitions>
                            <TextBlock x:Name="MostPlayedTitle" Text="游玩时长" FontWeight="Medium" FontSize="13" />
                            <StackPanel x:Name="MostPlayedList" Grid.Row="1" Spacing="2" />
                        </Grid>
                    </Border>
                </ctrl:SizeAwareContent>
            </ctrl:CardHost>
            </ctrl:CardGridPanel>
        </Grid>

        <!-- 布局编辑工具箱：竖条，贴着主页右沿悬浮在所有控件上方。
             所有卡片都预设在里面，从这里拖到主页任意格位落卡；
             点选某张卡后，尺寸档位 / 移除也在这一条里改。 -->
        <Grid x:Name="LayoutEditBar" Visibility="Collapsed"
              HorizontalAlignment="Right" VerticalAlignment="Stretch"
              Width="170" Margin="0,14,14,14"
              Canvas.ZIndex="10">
            <Border Background="{ThemeResource GlassCardBrush}"
                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                    BorderThickness="1" CornerRadius="16" Padding="12,12">
                <Grid RowSpacing="10">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <TextBlock loc:Loc.Text="拖到主页" FontSize="12"
                               Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                    <StackPanel x:Name="PaletteChips" Grid.Row="1" Orientation="Vertical" Spacing="6" />
                    <Border Grid.Row="2" Height="1" Background="{ThemeResource CardStrokeColorDefaultBrush}" />
                    <StackPanel x:Name="CardParams" Grid.Row="3" Orientation="Vertical" Spacing="6" />
                    <Button Grid.Row="5" Content="完成" Click="LayoutDone_Click"
                            Style="{StaticResource ScAccentButtonStyle}" Padding="8,4"
                            HorizontalAlignment="Stretch" />
                </Grid>
            </Border>
        </Grid>

        <!-- 页面级悬浮提示：卡片的操作结果（空间不足等）浮在所有控件之上，
             不再塞进某张卡片内部（卡片会被拖动/缩放/隐藏，提示跟着跑没有意义）。 -->
        <InfoBar x:Name="HomeToast" Severity="Error" IsOpen="False" IsClosable="True"
                 HorizontalAlignment="Center" VerticalAlignment="Top" Margin="0,14,0,0"
                 MaxWidth="560" Canvas.ZIndex="20" />

        <!-- ═══ 启动页覆盖层：点启动后盖住两列内容（PCL2 式，设计：launch-overlay-design.md §3.1） ═══ -->
        <Grid x:Name="LaunchOverlay" Visibility="Collapsed"
              Background="{ThemeResource ApplicationPageBackgroundThemeBrush}">
            <StackPanel MaxWidth="480" HorizontalAlignment="Center" VerticalAlignment="Center"
                        Spacing="14">
                <!-- 像素镐图标：品牌色对角渐变（浅黄→深绿，两主题通用） -->
                <Path Width="48" Height="48" HorizontalAlignment="Center"
                      Data="M16,4 H32 V8 H36 V12 H40 V20 H36 V24 H32 V20 H28 V16 H24 V40 H20 V44 H16 V16 H12 V24 H8 V20 H12 V12 H16 Z"
                      Fill="{ThemeResource AccentFillColorDefaultBrush}" />

                <TextBlock x:Name="LaunchStageTitle" loc:Loc.Text="正在启动" FontSize="24"
                           FontWeight="Medium" HorizontalAlignment="Center" />
                <TextBlock x:Name="LaunchVersionText" FontSize="13" HorizontalAlignment="Center"
                           Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                           TextTrimming="CharacterEllipsis" />

                <ProgressBar x:Name="LaunchProgress" Height="4" CornerRadius="2"
                             Minimum="0" Maximum="100"
                             Foreground="{ThemeResource AccentFillColorDefaultBrush}" />

                <!-- 当前步骤 / 登录方式 -->
                <Grid ColumnSpacing="8" Width="340" HorizontalAlignment="Center">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <TextBlock loc:Loc.Text="当前步骤" FontSize="13" Opacity="0.7"
                               Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                               VerticalAlignment="Center" />
                    <TextBlock x:Name="LaunchStageStepText" Grid.Column="1" FontSize="13"
                               VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                    <TextBlock Grid.Row="1" loc:Loc.Text="登录方式" FontSize="13" Opacity="0.7"
                               Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                               VerticalAlignment="Center" />
                    <TextBlock x:Name="LaunchLoginModeText" Grid.Row="1" Grid.Column="1"
                               FontSize="13" VerticalAlignment="Center" />
                </Grid>

                <!-- 你知道吗（小贴士：静态池 + Nova 动态，见 LaunchTips.cs） -->
                <Border Background="{ThemeResource GlassCardBrush}"
                        BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                        BorderThickness="1" CornerRadius="8" Padding="12,10"
                        Width="340" HorizontalAlignment="Center">
                    <Grid ColumnSpacing="10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="4" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Rectangle RadiusX="2" RadiusY="2"
                                   Fill="{ThemeResource AccentFillColorDefaultBrush}" />
                        <TextBlock x:Name="LaunchTipText" Grid.Column="1" FontSize="12"
                                   TextWrapping="Wrap" LineHeight="18"
                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                    </Grid>
                </Border>

                <!-- 实时游戏日志（默认折叠；设计：launch-reliability-design.md §5） -->
                <ToggleButton x:Name="LaunchLogToggle" loc:Loc.Text="显示日志" FontSize="12"
                              HorizontalAlignment="Center"
                              Checked="LaunchLogToggle_Changed" Unchecked="LaunchLogToggle_Changed" />
                <TextBox x:Name="LaunchLogText" Visibility="Collapsed" Width="440" Height="180"
                         FontFamily="Consolas" FontSize="11" IsReadOnly="True" AcceptsReturn="True"
                         TextWrapping="NoWrap" ScrollViewer.VerticalScrollBarVisibility="Auto"
                         ScrollViewer.HorizontalScrollBarVisibility="Auto" />
                <HyperlinkButton x:Name="LaunchLogOpenBtn" loc:Loc.Text="打开日志文件" FontSize="12"
                                 Visibility="Collapsed" HorizontalAlignment="Center"
                                 Click="LaunchLogOpen_Click" />

                <TextBlock x:Name="LaunchErrorText" FontSize="12" TextWrapping="Wrap"
                           MaxLines="2" TextTrimming="CharacterEllipsis" TextAlignment="Center"
                           Visibility="Collapsed" HorizontalAlignment="Center"
                           Foreground="{ThemeResource SystemFillColorCriticalBrush}" />

                <!-- 取消（启动中）/ 返回主页（运行中、已退出、失败） -->
                <Grid ColumnSpacing="12" Width="340" HorizontalAlignment="Center">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <ctrl:GlowButton x:Name="LaunchCancelBtn" loc:Loc.Text="取消" HorizontalAlignment="Stretch"
                            Click="LaunchCancelBtn_Click" />
                    <Button x:Name="LaunchBackBtn" Grid.Column="1" loc:Loc.Text="返回主页"
                            HorizontalAlignment="Stretch" Visibility="Collapsed"
                            Style="{StaticResource ScAccentButtonStyle}" FontWeight="Medium"
                            Click="LaunchBackBtn_Click" />
                </Grid>
            </StackPanel>
        </Grid>
    </Grid>
</Page>
