<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="Starcloud.App.Views.HomePage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:Starcloud.App.Views"
    NavigationCacheMode="Disabled">

    <!-- 不用 ScrollViewer：整体填满视口，卡片与窗口同高（PCL2 式） -->
    <!-- 根节点两层：HomeContent（主页两列）+ LaunchOverlay（启动页覆盖层，见文件尾） -->
    <Grid>
        <Grid x:Name="HomeContent" MaxWidth="1280" HorizontalAlignment="Stretch">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="360" />
            </Grid.ColumnDefinitions>

        <!-- ═══ 左列：欢迎 + 版本列表(弹性) + 快捷入口 ═══ -->
        <Grid Grid.Column="0" RowSpacing="16" Margin="0,0,24,0">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" MinHeight="160" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <StackPanel Grid.Row="0" Spacing="8">
                <InfoBar x:Name="GlobalErrorBar" Severity="Error" IsOpen="False" IsClosable="True"
                         Title="启动出错" />
                <InfoBar x:Name="LocalErrorBar" Severity="Error" IsOpen="False" IsClosable="True"
                         Title="操作失败" />
                <InfoBar x:Name="WarnBar" Severity="Warning" IsOpen="False" IsClosable="True"
                         Title="提示" />

                <!-- 启动自检：版本 / 账户 / Java，未就绪项可一键跳转 -->
                <Border x:Name="CheckCard" Visibility="Collapsed"
                        Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                        BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                        BorderThickness="1" CornerRadius="8" Padding="16">
                    <StackPanel Spacing="2">
                        <Grid Margin="0,0,0,6" ColumnSpacing="8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="启动自检" FontWeight="SemiBold" FontSize="15"
                                       VerticalAlignment="Center" />
                            <Button Grid.Column="1" Padding="6" MinWidth="28" MinHeight="28"
                                    Background="Transparent" BorderThickness="0"
                                    Click="Recheck_Click" ToolTipService.ToolTip="重新检测">
                                <FontIcon Glyph="&#xE72C;" FontSize="14" />
                            </Button>
                        </Grid>
                        <Grid MinHeight="30" ColumnSpacing="8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <FontIcon x:Name="CheckIconVersion" Glyph="&#xE73E;" FontSize="14"
                                      VerticalAlignment="Center" />
                            <TextBlock x:Name="CheckTextVersion" Grid.Column="1" FontSize="13"
                                       VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                            <HyperlinkButton x:Name="CheckGoVersion" Grid.Column="2" Padding="0"
                                             MinHeight="0" FontSize="12"
                                             Click="CheckGoVersion_Click" />
                        </Grid>
                        <Grid MinHeight="30" ColumnSpacing="8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <FontIcon x:Name="CheckIconAccount" Glyph="&#xE73E;" FontSize="14"
                                      VerticalAlignment="Center" />
                            <TextBlock x:Name="CheckTextAccount" Grid.Column="1" FontSize="13"
                                       VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                            <HyperlinkButton x:Name="CheckGoAccount" Grid.Column="2" Padding="0"
                                             MinHeight="0" FontSize="12"
                                             Click="CheckGoAccount_Click" />
                        </Grid>
                        <Grid MinHeight="30" ColumnSpacing="8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <FontIcon x:Name="CheckIconJava" Glyph="&#xE73E;" FontSize="14"
                                      VerticalAlignment="Center" />
                            <TextBlock x:Name="CheckTextJava" Grid.Column="1" FontSize="13"
                                       VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                            <HyperlinkButton x:Name="CheckGoJava" Grid.Column="2" Padding="0"
                                             MinHeight="0" FontSize="12"
                                             Click="CheckGoJava_Click" />
                        </Grid>
                    </StackPanel>
                </Border>
            </StackPanel>

            <!-- 版本列表（弹性填充剩余高度） -->
            <Border Grid.Row="1"
                    Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                    BorderThickness="1" CornerRadius="16"
                    Padding="16">
                <Grid RowSpacing="12">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <Grid Grid.Row="0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="版本列表" FontWeight="SemiBold" FontSize="15"
                                   VerticalAlignment="Center" />
                        <Button x:Name="RefreshVersionsBtn" Grid.Column="1" Padding="6"
                                Background="Transparent" BorderThickness="0"
                                Click="RefreshVersionsBtn_Click" ToolTipService.ToolTip="刷新列表">
                            <FontIcon Glyph="&#xE72C;" FontSize="14" />
                        </Button>
                    </Grid>

                    <Border Grid.Row="1"
                            Background="{ThemeResource LayerFillColorDefaultBrush}"
                            BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                            BorderThickness="1" CornerRadius="8">
                        <Grid>
                            <ListView x:Name="VersionList" SelectionMode="Single" Padding="4"
                                      SelectionChanged="VersionList_SelectionChanged">
                                <ListView.ItemContainerStyle>
                                    <Style TargetType="ListViewItem">
                                        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                                        <Setter Property="MinHeight" Value="40" />
                                        <Setter Property="Padding" Value="0" />
                                        <Setter Property="Margin" Value="0,2" />
                                    </Style>
                                </ListView.ItemContainerStyle>
                                <ListView.ItemTemplate>
                                    <DataTemplate x:DataType="local:VersionRow">
                                        <Border CornerRadius="4" Padding="10,7"
                                                RightTapped="VersionRow_RightTapped">
                                            <Border.ContextFlyout>
                                                <MenuFlyout>
                                                    <MenuFlyoutItem Text="问 Nova"
                                                                    Tag="{x:Bind Id}"
                                                                    Click="AskNova_Click">
                                                        <MenuFlyoutItem.Icon>
                                                            <FontIcon Glyph="&#xE99A;" />
                                                        </MenuFlyoutItem.Icon>
                                                    </MenuFlyoutItem>
                                                    <MenuFlyoutSeparator />
                                                    <MenuFlyoutItem Text="打开游戏目录"
                                                                    Tag="{x:Bind Id}"
                                                                    Click="OpenVersionFolder_Click">
                                                        <MenuFlyoutItem.Icon>
                                                            <FontIcon Glyph="&#xE838;" />
                                                        </MenuFlyoutItem.Icon>
                                                    </MenuFlyoutItem>
                                                    <MenuFlyoutItem Text="删除此版本"
                                                                    Tag="{x:Bind Id}"
                                                                    Click="DeleteVersion_Click">
                                                        <MenuFlyoutItem.Icon>
                                                            <FontIcon Glyph="&#xE74D;" />
                                                        </MenuFlyoutItem.Icon>
                                                    </MenuFlyoutItem>
                                                </MenuFlyout>
                                            </Border.ContextFlyout>
                                            <Grid ColumnSpacing="8">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="Auto" />
                                                </Grid.ColumnDefinitions>
                                                <TextBlock Text="{x:Bind Id}" FontWeight="SemiBold"
                                                           VerticalAlignment="Center"
                                                           TextTrimming="CharacterEllipsis" />
                                                <TextBlock Grid.Column="1" Text="{x:Bind SizeText}"
                                                           FontSize="11" VerticalAlignment="Center"
                                                           Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </ListView.ItemTemplate>
                            </ListView>
                            <StackPanel x:Name="EmptyVersionHint" Visibility="Collapsed"
                                        HorizontalAlignment="Center" VerticalAlignment="Center"
                                        Spacing="4">
                                <TextBlock Text="暂无已安装版本"
                                           Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                           HorizontalAlignment="Center" />
                                <HyperlinkButton Content="前往下载页安装" Padding="0"
                                                 HorizontalAlignment="Center"
                                                 Click="PickVersion_Click" />
                            </StackPanel>
                        </Grid>
                    </Border>
                </Grid>
            </Border>

            <!-- 快捷入口 -->
            <Grid Grid.Row="2" ColumnSpacing="12">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Button Grid.Column="0" Padding="14" HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch"
                        AutomationProperties.Name="下载版本" Click="TileDownload_Click">
                    <StackPanel Orientation="Horizontal" Spacing="12">
                        <FontIcon Glyph="&#xE896;" FontSize="18"
                                  Foreground="{ThemeResource BrandBlueBrush}" />
                        <StackPanel Spacing="4">
                            <TextBlock Text="下载版本" FontWeight="SemiBold" />
                            <TextBlock Text="获取官方版本与加载器" FontSize="12"
                                       Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextWrapping="Wrap" />
                        </StackPanel>
                    </StackPanel>
                </Button>
                <Button Grid.Column="1" Padding="14" HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch"
                        AutomationProperties.Name="模组资源" Click="TileMods_Click">
                    <StackPanel Orientation="Horizontal" Spacing="12">
                        <FontIcon Glyph="&#xE71D;" FontSize="18"
                                  Foreground="{ThemeResource BrandBlueBrush}" />
                        <StackPanel Spacing="4">
                            <TextBlock Text="模组资源" FontWeight="SemiBold" />
                            <TextBlock Text="搜索并安装 Mod 与整合包" FontSize="12"
                                       Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextWrapping="Wrap" />
                        </StackPanel>
                    </StackPanel>
                </Button>
                <Button Grid.Column="2" Padding="14" HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch"
                        AutomationProperties.Name="好友联机" Click="TileMultiplayer_Click">
                    <StackPanel Orientation="Horizontal" Spacing="12">
                        <FontIcon Glyph="&#xE716;" FontSize="18"
                                  Foreground="{ThemeResource BrandBlueBrush}" />
                        <StackPanel Spacing="4">
                            <TextBlock Text="好友联机" FontWeight="SemiBold" />
                            <TextBlock Text="无需公网 IP，一键开黑（规划中）" FontSize="12"
                                       Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextWrapping="Wrap" />
                        </StackPanel>
                    </StackPanel>
                </Button>
            </Grid>
        </Grid>

        <!-- ═══ 右列：PCL2 式账户/启动卡（与窗口同高） ═══ -->
        <Border Grid.Column="1"
                Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                BorderThickness="1" CornerRadius="16" Padding="20">
            <Grid RowSpacing="14">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <!-- 账户模式：正版 / 离线 -->
                <Grid Grid.Row="0" ColumnSpacing="8" Width="240" HorizontalAlignment="Center">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <ToggleButton x:Name="ModeMsBtn" Grid.Column="0" Content="正版"
                                  HorizontalAlignment="Stretch" Height="32"
                                  Click="ModeMs_Click" />
                    <ToggleButton x:Name="ModeOfflineBtn" Grid.Column="1" Content="离线"
                                  HorizontalAlignment="Stretch" Height="32"
                                  Click="ModeOffline_Click" />
                </Grid>

                <!-- 头像 + 账户（垂直居中，模拟 PCL2 卡片中部） -->
                <StackPanel Grid.Row="1" VerticalAlignment="Center" Spacing="10"
                            HorizontalAlignment="Center">
                    <Border Width="72" Height="72" CornerRadius="12"
                            HorizontalAlignment="Center"
                            Background="{ThemeResource AccentFillColorDefaultBrush}">
                        <TextBlock x:Name="AvatarText" Text="?" FontSize="28" FontWeight="SemiBold"
                                   Foreground="{ThemeResource TextOnAccentFillColorPrimaryBrush}"
                                   HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <TextBlock x:Name="AccountNameText" Text="未选择账户" FontWeight="SemiBold"
                               FontSize="17" HorizontalAlignment="Center" TextTrimming="CharacterEllipsis" />
                    <TextBox x:Name="PlayerNameBox" PlaceholderText="输入玩家名" Width="220"
                             MaxLength="16" Visibility="Collapsed" TextChanged="PlayerName_TextChanged" />
                    <ComboBox x:Name="AccountCombo" Width="220" HorizontalAlignment="Center"
                              SelectedValuePath="Value"
                              SelectionChanged="AccountCombo_SelectionChanged" />
                </StackPanel>

                <!-- 主按钮：PCL 式双行（启动游戏 + 当前版本） -->
                <Button x:Name="LaunchBtn" Grid.Row="2" HorizontalAlignment="Stretch" Height="64"
                        Style="{StaticResource AccentButtonStyle}" CornerRadius="12"
                        AutomationProperties.Name="启动游戏"
                        Click="LaunchBtn_Click">
                    <StackPanel Spacing="2" HorizontalAlignment="Center">
                        <StackPanel Orientation="Horizontal" Spacing="8" HorizontalAlignment="Center">
                            <FontIcon x:Name="LaunchIcon" Glyph="&#xE768;" FontSize="16" />
                            <TextBlock x:Name="LaunchTitleText" Text="启动游戏" FontWeight="SemiBold" FontSize="16" />
                        </StackPanel>
                        <TextBlock x:Name="LaunchSubText" Text="未选择版本" FontSize="12"
                                   HorizontalAlignment="Center"
                                   Foreground="{ThemeResource TextOnAccentFillColorSecondaryBrush}" />
                    </StackPanel>
                </Button>

                <!-- 进度与状态 -->
                <TextBlock x:Name="StatusText" Grid.Row="3" FontSize="12" TextAlignment="Center"
                           Visibility="Collapsed"
                           Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextWrapping="Wrap" />

                <!-- 版本管理入口：版本选择 / 版本设置 -->
                <Grid Grid.Row="4" ColumnSpacing="8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Button Grid.Column="0" Content="版本选择" HorizontalAlignment="Stretch"
                            Click="PickVersion_Click" />
                    <Button Grid.Column="1" Content="版本设置" HorizontalAlignment="Stretch"
                            Click="VersionSettings_Click" />
                </Grid>
            </Grid>
        </Border>
        </Grid>

        <!-- ═══ 启动页覆盖层：点启动后盖住两列内容（PCL2 式，设计：launch-overlay-design.md §3.1） ═══ -->
        <Grid x:Name="LaunchOverlay" Visibility="Collapsed"
              Background="{ThemeResource ApplicationPageBackgroundThemeBrush}">
            <StackPanel MaxWidth="480" HorizontalAlignment="Center" VerticalAlignment="Center"
                        Spacing="14">
                <!-- 像素镐图标：品牌色对角渐变（浅黄→深绿，两主题通用） -->
                <Path Width="48" Height="48" HorizontalAlignment="Center"
                      Data="M16,4 H32 V8 H36 V12 H40 V20 H36 V24 H32 V20 H28 V16 H24 V40 H20 V44 H16 V16 H12 V24 H8 V20 H12 V12 H16 Z"
                      Fill="{ThemeResource AccentFillColorDefaultBrush}" />

                <TextBlock x:Name="LaunchStageTitle" Text="正在启动" FontSize="24"
                           FontWeight="SemiBold" HorizontalAlignment="Center" />
                <TextBlock x:Name="LaunchVersionText" FontSize="13" HorizontalAlignment="Center"
                           Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                           TextTrimming="CharacterEllipsis" />

                <ProgressBar x:Name="LaunchProgress" Height="4" CornerRadius="2"
                             Minimum="0" Maximum="100"
                             Foreground="{ThemeResource AccentFillColorDefaultBrush}" />

                <!-- 当前步骤 / 登录方式 -->
                <Grid ColumnSpacing="8" Width="340" HorizontalAlignment="Center">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <TextBlock Text="当前步骤" FontSize="13" Opacity="0.7"
                               Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                               VerticalAlignment="Center" />
                    <TextBlock x:Name="LaunchStageStepText" Grid.Column="1" FontSize="13"
                               VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                    <TextBlock Grid.Row="1" Text="登录方式" FontSize="13" Opacity="0.7"
                               Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                               VerticalAlignment="Center" />
                    <TextBlock x:Name="LaunchLoginModeText" Grid.Row="1" Grid.Column="1"
                               FontSize="13" VerticalAlignment="Center" />
                </Grid>

                <!-- 你知道吗（小贴士：静态池 + Nova 动态，见 LaunchTips.cs） -->
                <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                        BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                        BorderThickness="1" CornerRadius="8" Padding="12,10"
                        Width="340" HorizontalAlignment="Center">
                    <Grid ColumnSpacing="10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="4" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Rectangle RadiusX="2" RadiusY="2"
                                   Fill="{ThemeResource AccentFillColorDefaultBrush}" />
                        <TextBlock x:Name="LaunchTipText" Grid.Column="1" FontSize="12"
                                   TextWrapping="Wrap" LineHeight="18"
                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                    </Grid>
                </Border>

                <TextBlock x:Name="LaunchErrorText" FontSize="12" TextWrapping="Wrap"
                           MaxLines="2" TextTrimming="CharacterEllipsis" TextAlignment="Center"
                           Visibility="Collapsed" HorizontalAlignment="Center"
                           Foreground="{ThemeResource SystemFillColorCriticalBrush}" />

                <!-- 取消（启动中）/ 返回主页（运行中、已退出、失败） -->
                <Grid ColumnSpacing="12" Width="340" HorizontalAlignment="Center">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Button x:Name="LaunchCancelBtn" Content="取消" HorizontalAlignment="Stretch"
                            Click="LaunchCancelBtn_Click" />
                    <Button x:Name="LaunchBackBtn" Grid.Column="1" Content="返回主页"
                            HorizontalAlignment="Stretch" Visibility="Collapsed"
                            Style="{StaticResource AccentButtonStyle}"
                            Click="LaunchBackBtn_Click" />
                </Grid>
            </StackPanel>
        </Grid>
    </Grid>
</Page>
