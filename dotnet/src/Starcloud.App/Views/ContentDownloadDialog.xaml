<ContentDialog
    x:Class="Starcloud.App.Views.ContentDownloadDialog"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:loc="using:Starcloud.App.Localization"
    Style="{ThemeResource DefaultContentDialogStyle}">
    <ContentDialog.Resources>
        <!-- 版本芯片（参考 PCL2 版本筛选）：圆角矩形 + accent 文字，选中态由代码切换为 accent 实底 -->
        <Style x:Key="ChipStyle" TargetType="Button">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Foreground" Value="{ThemeResource AccentTextFillColorPrimaryBrush}" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="CornerRadius" Value="8" />
            <Setter Property="Padding" Value="12,5" />
            <Setter Property="FontSize" Value="13" />
        </Style>
    </ContentDialog.Resources>

    <Grid RowSpacing="12" Width="1060">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- 顶行：左 = 安装目标 + 返回搜索结果，右 = 搜索框 -->
        <Grid Grid.Row="0" ColumnSpacing="12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="14" VerticalAlignment="Center">
                <!-- 安装目标常显：主页选中的版本（整合包为新建版本说明） -->
                <TextBlock x:Name="DlTarget" FontSize="12" Opacity="0.85" VerticalAlignment="Center"
                           Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                <Button x:Name="DownloadBack" Click="DownloadBack_Click" loc:Loc.Name="返回搜索结果"
                        Background="Transparent" BorderThickness="0" Padding="6,2" Margin="-6,0,0,0"
                        VerticalAlignment="Center" Visibility="Collapsed">
                    <StackPanel Orientation="Horizontal" Spacing="6">
                        <FontIcon Glyph="&#xE72B;" FontSize="13" />
                        <TextBlock loc:Loc.Text="返回搜索结果" FontSize="12" />
                    </StackPanel>
                </Button>
            </StackPanel>
            <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                <TextBox x:Name="SearchBox" loc:Loc.Placeholder="搜索 Modrinth…"
                         Width="260" KeyDown="DownloadSearch_KeyDown" loc:Loc.Name="搜索资源" />
                <Button Click="DownloadSearch_Click" loc:Loc.Name="搜索资源">
                    <StackPanel Orientation="Horizontal" Spacing="6">
                        <FontIcon Glyph="&#xE721;" FontSize="14" />
                        <TextBlock loc:Loc.Text="搜索" />
                    </StackPanel>
                </Button>
            </StackPanel>
        </Grid>
        <InfoBar Grid.Row="1" x:Name="DlInfoBar" IsOpen="False" IsClosable="True" />
        <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto" MaxHeight="720"
                      HorizontalScrollMode="Disabled">
            <StackPanel Spacing="12">

                <!-- 项目详情卡（PCL2 样式） -->
                <StackPanel x:Name="DownloadDetail" Spacing="12" Visibility="Collapsed">
                    <Border Background="{ThemeResource SubtleFillColorSecondaryBrush}"
                            CornerRadius="12" Padding="12">
                        <StackPanel Spacing="10">
                            <Grid ColumnSpacing="12">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <Border Width="56" Height="56" CornerRadius="10"
                                        Background="{ThemeResource SubtleFillColorTertiaryBrush}">
                                    <Grid>
                                        <Image x:Name="DlIcon" Width="56" Height="56" Stretch="Uniform"
                                               Visibility="Collapsed" />
                                        <FontIcon x:Name="DlIconFallback" Glyph="&#xE7E8;" FontSize="22"
                                                  Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                    </Grid>
                                </Border>
                                <StackPanel Grid.Column="1" Spacing="4">
                                    <TextBlock x:Name="DlTitle" FontSize="16" FontWeight="SemiBold"
                                               TextWrapping="Wrap" />
                                    <TextBlock x:Name="DlDesc" FontSize="12" TextWrapping="Wrap" MaxLines="2"
                                               TextTrimming="CharacterEllipsis"
                                               Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                    <StackPanel Orientation="Horizontal" Spacing="14">
                                        <TextBlock x:Name="DlMeta1" FontSize="12"
                                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                        <TextBlock x:Name="DlMeta2" FontSize="12"
                                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                        <TextBlock x:Name="DlMeta3" FontSize="12"
                                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                        <TextBlock x:Name="DlMeta4" FontSize="12"
                                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                    </StackPanel>
                                    <!-- 前置依赖（Mod 类别；拉取成功后填充显示） -->
                                    <TextBlock x:Name="DlDeps" FontSize="12" TextWrapping="Wrap"
                                               Visibility="Collapsed"
                                               Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                </StackPanel>
                            </Grid>
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <Button Click="DlModrinth_Click" loc:Loc.Name="转到 Modrinth">
                                    <StackPanel Orientation="Horizontal" Spacing="6">
                                        <FontIcon Glyph="&#xE774;" FontSize="13" />
                                        <TextBlock loc:Loc.Text="转到 Modrinth" FontSize="12" />
                                    </StackPanel>
                                </Button>
                                <Button Click="DlWiki_Click" loc:Loc.Name="转到 MC 百科">
                                    <StackPanel Orientation="Horizontal" Spacing="6">
                                        <FontIcon Glyph="&#xE82D;" FontSize="13" />
                                        <TextBlock loc:Loc.Text="转到 MC 百科" FontSize="12" />
                                    </StackPanel>
                                </Button>
                                <Button Click="DlCopy_Click" loc:Loc.Name="复制名称">
                                    <StackPanel Orientation="Horizontal" Spacing="6">
                                        <FontIcon Glyph="&#xE8C8;" FontSize="13" />
                                        <TextBlock loc:Loc.Text="复制名称" FontSize="12" />
                                    </StackPanel>
                                </Button>
                            </StackPanel>
                        </StackPanel>
                    </Border>

                    <!-- 版本芯片行（MC 版本筛选，默认当前版本） -->
                    <ScrollViewer HorizontalScrollMode="Auto" HorizontalScrollBarVisibility="Hidden"
                                  VerticalScrollMode="Disabled">
                        <StackPanel x:Name="DlVersionChips" Orientation="Horizontal" Spacing="4" />
                    </ScrollViewer>

                    <!-- 版本分组（展开后可下载安装） -->
                    <StackPanel x:Name="DlVersionList" Spacing="8" />
                </StackPanel>

                <!-- 搜索结果列表 -->
                <StackPanel x:Name="DownloadResults" Spacing="8" />
                <TextBlock x:Name="DlEmpty" loc:Loc.Text="没有找到匹配的资源" FontSize="12" Margin="0,4"
                           HorizontalAlignment="Center" Visibility="Collapsed"
                           Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
            </StackPanel>
        </ScrollViewer>
    </Grid>
</ContentDialog>
