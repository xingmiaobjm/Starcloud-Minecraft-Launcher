<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="Starcloud.App.Views.DownloadPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:Starcloud.App.Views"
    xmlns:loc="using:Starcloud.App.Localization"
    NavigationCacheMode="Disabled">

    <Grid MaxWidth="1280" HorizontalAlignment="Stretch" RowSpacing="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- 页头 -->
        <Grid Grid.Row="0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <StackPanel Grid.Column="0" Spacing="4">
                <TextBlock loc:Loc.Text="下载" FontSize="28" FontWeight="SemiBold" />
                <TextBlock loc:Loc.Text="下载原版与加载器，或在社区资源中查找 Mod 与整合包"
                           Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
            </StackPanel>
        </Grid>

        <!-- 主体：左分类 + 右内容 -->
        <Grid Grid.Row="1" ColumnSpacing="16">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="180" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <!-- 左侧分类（PCL2 式：原版游戏 + 社区资源分组）；不透明实色，与窗口框架统一 -->
            <Border Grid.Column="0" VerticalAlignment="Stretch"
                    Background="{ThemeResource AppPaneBackgroundBrush}"
                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                    BorderThickness="1" CornerRadius="8" Padding="8">
                <ListView x:Name="CategoryList" SelectionMode="Single"
                          SelectionChanged="Category_SelectionChanged">
                    <ListView.ItemContainerStyle>
                        <Style TargetType="ListViewItem">
                            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                            <Setter Property="MinHeight" Value="40" />
                            <Setter Property="Padding" Value="0" />
                        </Style>
                    </ListView.ItemContainerStyle>
                    <ListViewItem Tag="vanilla" IsSelected="True">
                        <StackPanel Orientation="Horizontal" Spacing="10" Padding="8,0">
                            <FontIcon Glyph="&#xE718;" FontSize="14" />
                            <TextBlock loc:Loc.Text="原版游戏" VerticalAlignment="Center" />
                        </StackPanel>
                    </ListViewItem>
                    <ListViewItem IsEnabled="False" IsHitTestVisible="False">
                        <TextBlock loc:Loc.Text="社区资源" FontSize="12" Margin="10,8,0,2"
                                   Foreground="{ThemeResource TextFillColorTertiaryBrush}" />
                    </ListViewItem>
                    <ListViewItem Tag="mod">
                        <StackPanel Orientation="Horizontal" Spacing="10" Padding="8,0">
                            <FontIcon Glyph="&#xE71D;" FontSize="14" />
                            <TextBlock Text="Mod" VerticalAlignment="Center" />
                        </StackPanel>
                    </ListViewItem>
                    <ListViewItem Tag="modpack">
                        <StackPanel Orientation="Horizontal" Spacing="10" Padding="8,0">
                            <FontIcon Glyph="&#xE7B8;" FontSize="14" />
                            <TextBlock loc:Loc.Text="整合包" VerticalAlignment="Center" />
                        </StackPanel>
                    </ListViewItem>
                    <ListViewItem Tag="datapack">
                        <StackPanel Orientation="Horizontal" Spacing="10" Padding="8,0">
                            <FontIcon Glyph="&#xE8A5;" FontSize="14" />
                            <TextBlock loc:Loc.Text="数据包" VerticalAlignment="Center" />
                        </StackPanel>
                    </ListViewItem>
                    <ListViewItem Tag="resourcepack">
                        <StackPanel Orientation="Horizontal" Spacing="10" Padding="8,0">
                            <FontIcon Glyph="&#xE91B;" FontSize="14" />
                            <TextBlock loc:Loc.Text="资源包" VerticalAlignment="Center" />
                        </StackPanel>
                    </ListViewItem>
                    <ListViewItem Tag="shader">
                        <StackPanel Orientation="Horizontal" Spacing="10" Padding="8,0">
                            <FontIcon Glyph="&#xE706;" FontSize="14" />
                            <TextBlock loc:Loc.Text="光影包" VerticalAlignment="Center" />
                        </StackPanel>
                    </ListViewItem>
                </ListView>
            </Border>

            <!-- 右侧内容 -->
            <Grid Grid.Column="1" RowSpacing="12">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <!-- 插件挂载区（download.top）：启用插件注册时显示 -->
                <StackPanel x:Name="PluginSlotHost" Grid.Row="1" Spacing="8" Visibility="Collapsed" />

                <!-- 提示与进度 -->
                <StackPanel Grid.Row="0" Spacing="8">
                    <InfoBar x:Name="ErrorBar" Severity="Error" IsOpen="False" IsClosable="True" loc:Loc.Title="操作失败" />
                    <InfoBar x:Name="OkBar" Severity="Success" IsOpen="False" IsClosable="True" loc:Loc.Title="完成" />
                    <ProgressBar x:Name="InstallProgress" IsIndeterminate="True" Visibility="Collapsed" />
                    <TextBlock x:Name="ProgressText" FontSize="12" Visibility="Collapsed"
                               Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                               TextTrimming="CharacterEllipsis" />
                </StackPanel>

                <!-- ── 原版游戏面板 ── -->
                <Grid x:Name="VanillaPanel" Grid.Row="2" RowSpacing="12">

                    <!-- 列表视图 -->
                    <Grid x:Name="ListPanel" RowSpacing="12">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>
                        <!-- 工具条：版本类型用等宽分段控件（选中指示器随点击平移），搜索框带前置放大镜 -->
                        <Grid Grid.Row="0" ColumnSpacing="12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>

                            <Border Grid.Column="0" VerticalAlignment="Center"
                                    Background="{ThemeResource ControlFillColorSecondaryBrush}"
                                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                    BorderThickness="1" CornerRadius="11" Padding="3">
                                <Grid>
                                    <!-- 选中指示器：品牌强调色药丸，位置由合成动画平移（分段自带的选中底色已置空，避免两个指示器重叠） -->
                                    <Border x:Name="TypeIndicator" Width="88" Height="30" CornerRadius="8"
                                            HorizontalAlignment="Left" VerticalAlignment="Center"
                                            IsHitTestVisible="False"
                                            Background="{ThemeResource AccentFillColorDefaultBrush}" />
                                    <StackPanel Orientation="Horizontal">
                                        <ToggleButton x:Name="TypeReleaseBtn" Tag="release" IsChecked="True"
                                                      Width="88" Height="30" Padding="0" MinWidth="0"
                                                      FontSize="13" CornerRadius="8" BorderThickness="0"
                                                      Background="Transparent"
                                                      Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                                      loc:Loc.Text="正式版" loc:Loc.Name="正式版"
                                                      Click="TypeSegment_Click">
                                            <ToggleButton.Resources>
                                                <!-- 选中态由滑动指示器表达：这里只保留黑字（accent 面强制黑字） -->
                                                <SolidColorBrush x:Key="ToggleButtonBackgroundChecked" Color="Transparent" />
                                                <SolidColorBrush x:Key="ToggleButtonBackgroundCheckedPointerOver" Color="Transparent" />
                                                <SolidColorBrush x:Key="ToggleButtonBackgroundCheckedPressed" Color="Transparent" />
                                                <SolidColorBrush x:Key="ToggleButtonBorderBrushChecked" Color="Transparent" />
                                                <SolidColorBrush x:Key="ToggleButtonForegroundChecked" Color="#E61A1A1A" />
                                                <SolidColorBrush x:Key="ToggleButtonForegroundCheckedPointerOver" Color="#E61A1A1A" />
                                                <SolidColorBrush x:Key="ToggleButtonForegroundCheckedPressed" Color="#E61A1A1A" />
                                            </ToggleButton.Resources>
                                        </ToggleButton>
                                        <ToggleButton x:Name="TypeSnapshotBtn" Tag="snapshot"
                                                      Width="88" Height="30" Padding="0" MinWidth="0"
                                                      FontSize="13" CornerRadius="8" BorderThickness="0"
                                                      Background="Transparent"
                                                      Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                                      loc:Loc.Text="快照版" loc:Loc.Name="快照版"
                                                      Click="TypeSegment_Click">
                                            <ToggleButton.Resources>
                                                <SolidColorBrush x:Key="ToggleButtonBackgroundChecked" Color="Transparent" />
                                                <SolidColorBrush x:Key="ToggleButtonBackgroundCheckedPointerOver" Color="Transparent" />
                                                <SolidColorBrush x:Key="ToggleButtonBackgroundCheckedPressed" Color="Transparent" />
                                                <SolidColorBrush x:Key="ToggleButtonBorderBrushChecked" Color="Transparent" />
                                                <SolidColorBrush x:Key="ToggleButtonForegroundChecked" Color="#E61A1A1A" />
                                                <SolidColorBrush x:Key="ToggleButtonForegroundCheckedPointerOver" Color="#E61A1A1A" />
                                                <SolidColorBrush x:Key="ToggleButtonForegroundCheckedPressed" Color="#E61A1A1A" />
                                            </ToggleButton.Resources>
                                        </ToggleButton>
                                        <ToggleButton x:Name="TypeOldBtn" Tag="old"
                                                      Width="88" Height="30" Padding="0" MinWidth="0"
                                                      FontSize="13" CornerRadius="8" BorderThickness="0"
                                                      Background="Transparent"
                                                      Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                                      loc:Loc.Text="远古版本" loc:Loc.Name="远古版本"
                                                      Click="TypeSegment_Click">
                                            <ToggleButton.Resources>
                                                <SolidColorBrush x:Key="ToggleButtonBackgroundChecked" Color="Transparent" />
                                                <SolidColorBrush x:Key="ToggleButtonBackgroundCheckedPointerOver" Color="Transparent" />
                                                <SolidColorBrush x:Key="ToggleButtonBackgroundCheckedPressed" Color="Transparent" />
                                                <SolidColorBrush x:Key="ToggleButtonBorderBrushChecked" Color="Transparent" />
                                                <SolidColorBrush x:Key="ToggleButtonForegroundChecked" Color="#E61A1A1A" />
                                                <SolidColorBrush x:Key="ToggleButtonForegroundCheckedPointerOver" Color="#E61A1A1A" />
                                                <SolidColorBrush x:Key="ToggleButtonForegroundCheckedPressed" Color="#E61A1A1A" />
                                            </ToggleButton.Resources>
                                        </ToggleButton>
                                    </StackPanel>
                                </Grid>
                            </Border>

                            <!-- 搜索框与「缓存」徽标成组靠左：徽标紧贴搜索框，不再孤零零飘在最右 -->
                            <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="10"
                                        VerticalAlignment="Center" HorizontalAlignment="Left">
                                <Grid MaxWidth="320" Width="300">
                                    <TextBox x:Name="SearchBox" Height="36" CornerRadius="10"
                                             Padding="34,0,10,0" VerticalContentAlignment="Center"
                                             loc:Loc.Placeholder="搜索版本 ID…"
                                             TextChanged="SearchBox_TextChanged" />
                                    <FontIcon Glyph="&#xE721;" FontSize="14" Margin="12,0,0,0"
                                              HorizontalAlignment="Left" VerticalAlignment="Center"
                                              IsHitTestVisible="False"
                                              Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                </Grid>
                                <Border x:Name="VersionCacheBadge" Visibility="Collapsed"
                                        CornerRadius="6" Padding="8,3" VerticalAlignment="Center"
                                        Background="{ThemeResource AccentFillColorTertiaryBrush}">
                                    <TextBlock loc:Loc.Text="缓存" FontSize="11"
                                               Foreground="{ThemeResource TextOnAccentFillColorPrimaryBrush}" />
                                </Border>
                            </StackPanel>
                        </Grid>

                        <!-- 最新版本：两枚 hero 瓦片（最新正式版 / 最新预览版），点击直接进详情 -->
                        <Grid x:Name="LatestCard" Grid.Row="1" Visibility="Collapsed" ColumnSpacing="12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>

                            <Button x:Name="LatestReleaseTile" Grid.Column="0" Tag=""
                                    HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch"
                                    Padding="14,12" CornerRadius="14"
                                    Background="{ThemeResource GlassCardBrush}"
                                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                    BorderThickness="1"
                                    local:HoverShadowBehavior.IsEnabled="True"
                                    local:HoverShadowBehavior.Carrier="{Binding ElementName=LatestReleaseShadow}"
                                    Click="LatestTile_Click">
                                <Grid ColumnSpacing="14">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <!-- 内阴影层：瓦片内部自上而下渐深，悬停时渐显 -->
                                    <Border x:Name="LatestReleaseShadow" Grid.ColumnSpan="3" CornerRadius="14"
                                            Opacity="0" IsHitTestVisible="False">
                                        <Border.Background>
                                            <RadialGradientBrush Center="0.5,0.5" GradientOrigin="0.5,0.5" RadiusX="0.9" RadiusY="0.9">
                                                <GradientStop Color="#38000000" Offset="0" />
                                                <GradientStop Color="#26000000" Offset="0.28" />
                                                <GradientStop Color="#15000000" Offset="0.55" />
                                                <GradientStop Color="#08000000" Offset="0.78" />
                                                <GradientStop Color="#00000000" Offset="1" />
                                            </RadialGradientBrush>
                                        </Border.Background>
                                    </Border>
                                    <Grid Width="44" Height="44" VerticalAlignment="Center">
                                        <FontIcon Glyph="&#xE7B8;" FontSize="22"
                                                  Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                        <Image x:Name="LatestReleaseIcon" Width="44" Height="44"
                                               Stretch="Uniform" />
                                    </Grid>
                                    <StackPanel Grid.Column="1" Spacing="2" VerticalAlignment="Center">
                                        <TextBlock loc:Loc.Text="最新正式版" FontSize="11"
                                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                        <TextBlock x:Name="LatestReleaseId" FontSize="17" FontWeight="SemiBold"
                                                   TextTrimming="CharacterEllipsis" />
                                        <TextBlock x:Name="LatestReleaseMeta" FontSize="11"
                                                   TextTrimming="CharacterEllipsis"
                                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                    </StackPanel>
                                    <FontIcon Grid.Column="2" Glyph="&#xE76C;" FontSize="12"
                                              VerticalAlignment="Center"
                                              Foreground="{ThemeResource TextFillColorTertiaryBrush}" />
                                </Grid>
                            </Button>

                            <Button x:Name="LatestSnapshotTile" Grid.Column="1" Tag=""
                                    HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch"
                                    Padding="14,12" CornerRadius="14"
                                    Background="{ThemeResource GlassCardBrush}"
                                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                    BorderThickness="1"
                                    local:HoverShadowBehavior.IsEnabled="True"
                                    local:HoverShadowBehavior.Carrier="{Binding ElementName=LatestSnapshotShadow}"
                                    Click="LatestTile_Click">
                                <Grid ColumnSpacing="14">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <Border x:Name="LatestSnapshotShadow" Grid.ColumnSpan="3" CornerRadius="14"
                                            Opacity="0" IsHitTestVisible="False">
                                        <Border.Background>
                                            <RadialGradientBrush Center="0.5,0.5" GradientOrigin="0.5,0.5" RadiusX="0.9" RadiusY="0.9">
                                                <GradientStop Color="#38000000" Offset="0" />
                                                <GradientStop Color="#26000000" Offset="0.28" />
                                                <GradientStop Color="#15000000" Offset="0.55" />
                                                <GradientStop Color="#08000000" Offset="0.78" />
                                                <GradientStop Color="#00000000" Offset="1" />
                                            </RadialGradientBrush>
                                        </Border.Background>
                                    </Border>
                                    <Grid Width="44" Height="44" VerticalAlignment="Center">
                                        <FontIcon Glyph="&#xE7B8;" FontSize="22"
                                                  Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                        <Image x:Name="LatestSnapshotIcon" Width="44" Height="44"
                                               Stretch="Uniform" />
                                    </Grid>
                                    <StackPanel Grid.Column="1" Spacing="2" VerticalAlignment="Center">
                                        <TextBlock loc:Loc.Text="最新预览版" FontSize="11"
                                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                        <TextBlock x:Name="LatestSnapshotId" FontSize="17" FontWeight="SemiBold"
                                                   TextTrimming="CharacterEllipsis" />
                                        <TextBlock x:Name="LatestSnapshotMeta" FontSize="11"
                                                   TextTrimming="CharacterEllipsis"
                                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                    </StackPanel>
                                    <FontIcon Grid.Column="2" Glyph="&#xE76C;" FontSize="12"
                                              VerticalAlignment="Center"
                                              Foreground="{ThemeResource TextFillColorTertiaryBrush}" />
                                </Grid>
                            </Button>
                        </Grid>

                        <Border Grid.Row="2"
                                Background="{ThemeResource GlassCardBrush}"
                                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                BorderThickness="1" CornerRadius="16" Padding="4">
                            <ListView x:Name="VersionList" SelectionMode="Single"
                                      IsItemClickEnabled="True" ItemClick="VersionList_ItemClick">
                                <ListView.ItemContainerStyle>
                                    <Style TargetType="ListViewItem">
                                        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                                        <Setter Property="MinHeight" Value="0" />
                                        <Setter Property="Padding" Value="0" />
                                        <Setter Property="Margin" Value="0" />
                                    </Style>
                                </ListView.ItemContainerStyle>
                                <ListView.Resources>
                                    <!-- 平铺行（快照/远古版/搜索结果）：圆角行卡 + 悬停抬升阴影 -->
                                    <DataTemplate x:Key="VersionFlatTemplate" x:DataType="local:DownloadRow">
                                        <Grid Margin="2,2" CornerRadius="10"
                                              Background="{ThemeResource ControlFillColorSecondaryBrush}"
                                              local:HoverShadowBehavior.IsEnabled="True"
                                              local:HoverShadowBehavior.Carrier="{Binding ElementName=RowShadow}"
                                              local:RowHoverBehavior.IsEnabled="True"
                                              local:RowHoverBehavior.Overlay="{Binding ElementName=HoverOverlay}">
                                            <!-- 悬停高亮层：常态 Opacity=0，由 RowHoverBehavior 在合成线程渐显 -->
                                            <Border x:Name="HoverOverlay" CornerRadius="10" Opacity="0"
                                                    IsHitTestVisible="False"
                                                    Background="{ThemeResource ControlFillColorDefaultBrush}" />
                                            <!-- 内阴影层：行内自上而下渐深，悬停时叠在高亮层之上 -->
                                            <Border x:Name="RowShadow" CornerRadius="10" Opacity="0"
                                                    IsHitTestVisible="False">
                                                <Border.Background>
                                                    <RadialGradientBrush Center="0.5,0.5" GradientOrigin="0.5,0.5" RadiusX="0.9" RadiusY="0.9">
                                                        <GradientStop Color="#38000000" Offset="0" />
                                                        <GradientStop Color="#26000000" Offset="0.28" />
                                                        <GradientStop Color="#15000000" Offset="0.55" />
                                                        <GradientStop Color="#08000000" Offset="0.78" />
                                                        <GradientStop Color="#00000000" Offset="1" />
                                                    </RadialGradientBrush>
                                                </Border.Background>
                                            </Border>
                                            <Grid Padding="12,9" ColumnSpacing="14">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="Auto" />
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="Auto" />
                                                </Grid.ColumnDefinitions>
                                                <!-- 等距方块图标（按版本类型），文件缺失时退回 FontIcon -->
                                                <Grid Width="34" Height="34" VerticalAlignment="Center">
                                                    <FontIcon Glyph="&#xE7B8;" FontSize="18"
                                                              Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                                    <Image Source="{x:Bind Icon}" Width="34" Height="34"
                                                           Stretch="Uniform" />
                                                </Grid>
                                                <StackPanel Grid.Column="1" Spacing="2" VerticalAlignment="Center">
                                                    <TextBlock Text="{x:Bind Id}" FontSize="14" FontWeight="SemiBold"
                                                               TextTrimming="CharacterEllipsis" />
                                                    <TextBlock Text="{x:Bind TimeText}" FontSize="11"
                                                               TextTrimming="CharacterEllipsis"
                                                               Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                                </StackPanel>
                                                <TextBlock Grid.Column="2" Text="{x:Bind Badge}" FontSize="11"
                                                           VerticalAlignment="Center" Margin="8,0,2,0"
                                                           Foreground="{x:Bind BadgeBrush}" />
                                            </Grid>
                                        </Grid>
                                    </DataTemplate>
                                    <!-- 大版本抽屉（正式版默认视图）：组头点击展开该大版本下的版本。
                                          展开/收起由 ExpandBehavior 做高度平滑过渡 + 内容淡入位移；箭头按展开态旋转。 -->
                                    <DataTemplate x:Key="VersionGroupTemplate" x:DataType="local:VersionGroupRow">
                                        <StackPanel HorizontalAlignment="Stretch">
                                            <Button Click="VersionGroupHeader_Click"
                                                    HorizontalAlignment="Stretch"
                                                    HorizontalContentAlignment="Stretch"
                                                    Background="Transparent" BorderThickness="0"
                                                    Margin="2,2" Padding="0" CornerRadius="10"
                                                    local:HoverShadowBehavior.IsEnabled="True"
                                                    local:HoverShadowBehavior.Carrier="{Binding ElementName=HeaderShadow}"
                                                    local:RowHoverBehavior.IsEnabled="True"
                                                    local:RowHoverBehavior.Overlay="{Binding ElementName=HeaderHover}">
                                                <Grid CornerRadius="10"
                                                      Background="{ThemeResource ControlFillColorSecondaryBrush}">
                                                    <!-- 悬停高亮层：常态 Opacity=0，由 RowHoverBehavior 在合成线程渐显 -->
                                                    <Border x:Name="HeaderHover" CornerRadius="10" Opacity="0"
                                                            IsHitTestVisible="False"
                                                            Background="{ThemeResource ControlFillColorDefaultBrush}" />
                                                    <!-- 内阴影层：组头内部自上而下渐深，悬停时叠在高亮层之上 -->
                                                    <Border x:Name="HeaderShadow" CornerRadius="10" Opacity="0"
                                                            IsHitTestVisible="False">
                                                        <Border.Background>
                                                            <RadialGradientBrush Center="0.5,0.5" GradientOrigin="0.5,0.5" RadiusX="0.9" RadiusY="0.9">
                                                                <GradientStop Color="#38000000" Offset="0" />
                                                                <GradientStop Color="#26000000" Offset="0.28" />
                                                                <GradientStop Color="#15000000" Offset="0.55" />
                                                                <GradientStop Color="#08000000" Offset="0.78" />
                                                                <GradientStop Color="#00000000" Offset="1" />
                                                            </RadialGradientBrush>
                                                        </Border.Background>
                                                    </Border>
                                                    <Grid Padding="13,11" ColumnSpacing="10">
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="Auto" />
                                                            <ColumnDefinition Width="Auto" />
                                                            <ColumnDefinition Width="*" />
                                                            <ColumnDefinition Width="Auto" />
                                                        </Grid.ColumnDefinitions>
                                                        <TextBlock Text="{x:Bind Major}" FontSize="16" FontWeight="SemiBold"
                                                                   VerticalAlignment="Center"
                                                                   Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}" />
                                                        <Border Grid.Column="1" CornerRadius="5" Padding="6,1"
                                                                VerticalAlignment="Center" Margin="2,0,0,0"
                                                                Background="{ThemeResource ControlFillColorSecondaryBrush}">
                                                            <TextBlock Text="{x:Bind CountText}" FontSize="11"
                                                                       Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                                        </Border>
                                                        <FontIcon x:Name="ChevronIcon" Grid.Column="3"
                                                                  Glyph="&#xE76C;" FontSize="12"
                                                                  VerticalAlignment="Center"
                                                                  Loaded="VersionChevron_Loaded"
                                                                  Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                                    </Grid>
                                                </Grid>
                                            </Button>
                                            <Grid Visibility="Collapsed" Margin="0,0,0,2"
                                                  local:ExpandBehavior.IsExpanded="{x:Bind IsExpanded, Mode=OneWay}">
                                                <ListView ItemsSource="{x:Bind Items}" SelectionMode="None"
                                                          IsItemClickEnabled="True"
                                                          ItemClick="VersionGroupItem_Click"
                                                          ScrollViewer.VerticalScrollMode="Disabled"
                                                          ScrollViewer.VerticalScrollBarVisibility="Disabled"
                                                          Padding="0">
                                                    <ListView.ItemContainerStyle>
                                                        <Style TargetType="ListViewItem">
                                                            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                                                            <Setter Property="MinHeight" Value="0" />
                                                            <Setter Property="Padding" Value="0" />
                                                            <Setter Property="Margin" Value="0" />
                                                        </Style>
                                                    </ListView.ItemContainerStyle>
                                                    <ListView.ItemTemplate>
                                                        <DataTemplate x:DataType="local:DownloadRow">
                                                            <Grid Margin="2,2" CornerRadius="10"
                                                                  Background="{ThemeResource ControlFillColorSecondaryBrush}"
                                                                  local:HoverShadowBehavior.IsEnabled="True"
                                                                  local:HoverShadowBehavior.Carrier="{Binding ElementName=ChildShadow}"
                                                                  local:RowHoverBehavior.IsEnabled="True"
                                                                  local:RowHoverBehavior.Overlay="{Binding ElementName=HoverOverlay}">
                                                                <!-- 悬停高亮层：常态 Opacity=0，由 RowHoverBehavior 在合成线程渐显 -->
                                                                <Border x:Name="HoverOverlay" CornerRadius="10" Opacity="0"
                                                                        IsHitTestVisible="False"
                                                                        Background="{ThemeResource ControlFillColorDefaultBrush}" />
                                                                <!-- 内阴影层：行内自上而下渐深 -->
                                                                <Border x:Name="ChildShadow" CornerRadius="10" Opacity="0"
                                                                        IsHitTestVisible="False">
                                                                    <Border.Background>
                                                                        <RadialGradientBrush Center="0.5,0.5" GradientOrigin="0.5,0.5" RadiusX="0.9" RadiusY="0.9">
                                                                            <GradientStop Color="#38000000" Offset="0" />
                                                                            <GradientStop Color="#26000000" Offset="0.28" />
                                                                            <GradientStop Color="#15000000" Offset="0.55" />
                                                                            <GradientStop Color="#08000000" Offset="0.78" />
                                                                            <GradientStop Color="#00000000" Offset="1" />
                                                                        </RadialGradientBrush>
                                                                    </Border.Background>
                                                                </Border>
                                                                <Grid Padding="12,9" ColumnSpacing="14">
                                                                    <Grid.ColumnDefinitions>
                                                                        <ColumnDefinition Width="Auto" />
                                                                        <ColumnDefinition Width="*" />
                                                                        <ColumnDefinition Width="Auto" />
                                                                    </Grid.ColumnDefinitions>
                                                                    <Grid Width="34" Height="34" VerticalAlignment="Center">
                                                                        <FontIcon Glyph="&#xE7B8;" FontSize="18"
                                                                                  Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                                                        <Image Source="{x:Bind Icon}" Width="34" Height="34"
                                                                               Stretch="Uniform" />
                                                                    </Grid>
                                                                    <StackPanel Grid.Column="1" Spacing="2" VerticalAlignment="Center">
                                                                        <TextBlock Text="{x:Bind Id}" FontSize="14" FontWeight="SemiBold"
                                                                                   TextTrimming="CharacterEllipsis" />
                                                                        <TextBlock Text="{x:Bind TimeText}" FontSize="11"
                                                                                   TextTrimming="CharacterEllipsis"
                                                                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                                                    </StackPanel>
                                                                    <TextBlock Grid.Column="2" Text="{x:Bind Badge}" FontSize="11"
                                                                               VerticalAlignment="Center" Margin="8,0,2,0"
                                                                               Foreground="{x:Bind BadgeBrush}" />
                                                                </Grid>
                                                            </Grid>
                                                        </DataTemplate>
                                                    </ListView.ItemTemplate>
                                                </ListView>
                                            </Grid>
                                        </StackPanel>
                                    </DataTemplate>
                                </ListView.Resources>
                            </ListView>
                        </Border>
                    </Grid>

                    <!-- 详情视图（PCL2 式：标题行 + 加载器抽屉 + 底部开始下载） -->
                    <Grid x:Name="DetailPanel" RowSpacing="12" Visibility="Collapsed">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <!-- 标题行：返回 + 草方块 + 版本号框 -->
                        <Grid Grid.Row="0" ColumnSpacing="12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Button Click="Back_Click" Padding="10,8" CornerRadius="8"
                                    VerticalAlignment="Center"
                                    loc:Loc.Name="返回" loc:Loc.Tip="返回">
                                <FontIcon Glyph="&#xE72B;" FontSize="14" />
                            </Button>
                            <!-- 版本图标（按类型：正式版草方块 / 快照紫水晶 / 远古版圆石与泥土） -->
                            <Grid Grid.Column="1" Width="44" Height="44" VerticalAlignment="Center">
                                <FontIcon Glyph="&#xE7B8;" FontSize="22"
                                          Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                <Image x:Name="DetailIcon" Width="44" Height="44" Stretch="Uniform" />
                            </Grid>
                            <Border Grid.Column="2" VerticalAlignment="Center"
                                    Background="{ThemeResource ControlFillColorDefaultBrush}"
                                    BorderBrush="{ThemeResource ControlStrokeColorDefaultBrush}"
                                    BorderThickness="1" CornerRadius="8" Padding="16,8">
                                <StackPanel Spacing="1">
                                    <TextBlock x:Name="DetailTitle" FontSize="18" FontWeight="SemiBold" />
                                    <TextBlock x:Name="DetailMeta" FontSize="11"
                                               Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                </StackPanel>
                            </Border>
                        </Grid>

                        <!-- 加载器抽屉（手风琴；选中任一构建后其余加载器锁定点不动） -->
                        <ScrollViewer Grid.Row="1" VerticalAlignment="Top"
                                      HorizontalScrollMode="Disabled">
                            <StackPanel Spacing="10">

                                <!-- Forge -->
                                <Expander x:Name="ForgeExpander" HorizontalAlignment="Stretch"
                                          HorizontalContentAlignment="Stretch">
                                    <Expander.Header>
                                        <Grid ColumnSpacing="12">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="*" />
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Text="Forge" FontWeight="SemiBold" VerticalAlignment="Center" />
                                            <TextBlock x:Name="ForgeStatus" Grid.Column="1" loc:Loc.Text="获取中…" FontSize="12"
                                                       VerticalAlignment="Center"
                                                       Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                        </Grid>
                                    </Expander.Header>
                                    <StackPanel Spacing="10" Padding="4,4,4,8">
                                        <Button x:Name="ForgeRecBtn" HorizontalAlignment="Stretch"
                                                HorizontalContentAlignment="Stretch" CornerRadius="8"
                                                Padding="12,9" BorderThickness="1"
                                                Click="ForgeRec_Click">
                                            <Grid ColumnSpacing="12">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="Auto" />
                                                </Grid.ColumnDefinitions>
                                                <StackPanel Spacing="2">
                                                    <TextBlock x:Name="ForgeRecVersion" FontWeight="SemiBold" />
                                                    <TextBlock x:Name="ForgeRecNote" FontSize="11"
                                                               Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                                </StackPanel>
                                                <Border x:Name="ForgeRecBadge" Grid.Column="1"
                                                        Background="{ThemeResource SystemFillColorSuccessBackgroundBrush}"
                                                        CornerRadius="4" Padding="7,2" VerticalAlignment="Center">
                                                    <TextBlock x:Name="ForgeRecBadgeText" loc:Loc.Text="推荐" FontSize="11"
                                                               Foreground="{ThemeResource SystemFillColorSuccessBrush}" />
                                                </Border>
                                            </Grid>
                                        </Button>
                                        <TextBlock x:Name="ForgeCountText" loc:Loc.Text="全部版本 (0)" FontSize="13"
                                                   FontWeight="SemiBold" Margin="4,0,0,0"
                                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                        <ListView x:Name="ForgeBuildList" SelectionMode="None"
                                                  IsItemClickEnabled="True" ItemClick="ForgeBuild_Click"
                                                  ScrollViewer.VerticalScrollMode="Disabled"
                                                  ScrollViewer.VerticalScrollBarVisibility="Disabled">
                                            <ListView.ItemContainerStyle>
                                                <Style TargetType="ListViewItem">
                                                    <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                                                    <Setter Property="MinHeight" Value="48" />
                                                    <Setter Property="Padding" Value="0" />
                                                    <Setter Property="Margin" Value="0,1" />
                                                </Style>
                                            </ListView.ItemContainerStyle>
                                            <ListView.ItemTemplate>
                                                <DataTemplate x:DataType="local:LoaderBuildRow">
                                                    <Grid Padding="10,7" ColumnSpacing="12"
                                                          CornerRadius="8"
                                                          Background="{ThemeResource ControlFillColorSecondaryBrush}">
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="*" />
                                                            <ColumnDefinition Width="Auto" />
                                                        </Grid.ColumnDefinitions>
                                                        <StackPanel Spacing="2">
                                                            <TextBlock Text="{x:Bind Version}" FontWeight="SemiBold" />
                                                            <TextBlock Text="{x:Bind Sub}" FontSize="11"
                                                                       Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                                        </StackPanel>
                                                        <Border Grid.Column="1" Visibility="{x:Bind SelectedVisibility}"
                                                                Background="{ThemeResource AccentFillColorDefaultBrush}"
                                                                CornerRadius="4" Padding="7,2" VerticalAlignment="Center">
                                                            <TextBlock loc:Loc.Text="已选" FontSize="11"
                                                                       Foreground="{ThemeResource TextOnAccentFillColorPrimaryBrush}" />
                                                        </Border>
                                                    </Grid>
                                                </DataTemplate>
                                            </ListView.ItemTemplate>
                                        </ListView>
                                        <TextBlock x:Name="ForgeEmptyText" loc:Loc.Text="暂无可用构建" Visibility="Collapsed"
                                                   FontSize="12" Margin="4,0,0,0"
                                                   Foreground="{ThemeResource TextFillColorTertiaryBrush}" />
                                    </StackPanel>
                                </Expander>

                                <!-- NeoForge -->
                                <Expander x:Name="NeoForgeExpander" HorizontalAlignment="Stretch"
                                          HorizontalContentAlignment="Stretch">
                                    <Expander.Header>
                                        <Grid ColumnSpacing="12">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="*" />
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Text="NeoForge" FontWeight="SemiBold" VerticalAlignment="Center" />
                                            <TextBlock x:Name="NeoForgeStatus" Grid.Column="1" loc:Loc.Text="获取中…" FontSize="12"
                                                       VerticalAlignment="Center"
                                                       Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                        </Grid>
                                    </Expander.Header>
                                    <StackPanel Spacing="10" Padding="4,4,4,8">
                                        <Button x:Name="NeoForgeRecBtn" HorizontalAlignment="Stretch"
                                                HorizontalContentAlignment="Stretch" CornerRadius="8"
                                                Padding="12,9" BorderThickness="1"
                                                Click="NeoForgeRec_Click">
                                            <Grid ColumnSpacing="12">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="Auto" />
                                                </Grid.ColumnDefinitions>
                                                <StackPanel Spacing="2">
                                                    <TextBlock x:Name="NeoForgeRecVersion" FontWeight="SemiBold" />
                                                    <TextBlock x:Name="NeoForgeRecNote" FontSize="11"
                                                               Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                                </StackPanel>
                                                <Border x:Name="NeoForgeRecBadge" Grid.Column="1"
                                                        Background="{ThemeResource SystemFillColorSuccessBackgroundBrush}"
                                                        CornerRadius="4" Padding="7,2" VerticalAlignment="Center">
                                                    <TextBlock x:Name="NeoForgeRecBadgeText" loc:Loc.Text="推荐" FontSize="11"
                                                               Foreground="{ThemeResource SystemFillColorSuccessBrush}" />
                                                </Border>
                                            </Grid>
                                        </Button>
                                        <TextBlock x:Name="NeoForgeCountText" loc:Loc.Text="全部版本 (0)" FontSize="13"
                                                   FontWeight="SemiBold" Margin="4,0,0,0"
                                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                        <ListView x:Name="NeoForgeBuildList" SelectionMode="None"
                                                  IsItemClickEnabled="True" ItemClick="NeoForgeBuild_Click"
                                                  ScrollViewer.VerticalScrollMode="Disabled"
                                                  ScrollViewer.VerticalScrollBarVisibility="Disabled">
                                            <ListView.ItemContainerStyle>
                                                <Style TargetType="ListViewItem">
                                                    <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                                                    <Setter Property="MinHeight" Value="48" />
                                                    <Setter Property="Padding" Value="0" />
                                                    <Setter Property="Margin" Value="0,1" />
                                                </Style>
                                            </ListView.ItemContainerStyle>
                                            <ListView.ItemTemplate>
                                                <DataTemplate x:DataType="local:LoaderBuildRow">
                                                    <Grid Padding="10,7" ColumnSpacing="12"
                                                          CornerRadius="8"
                                                          Background="{ThemeResource ControlFillColorSecondaryBrush}">
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="*" />
                                                            <ColumnDefinition Width="Auto" />
                                                        </Grid.ColumnDefinitions>
                                                        <StackPanel Spacing="2">
                                                            <TextBlock Text="{x:Bind Version}" FontWeight="SemiBold" />
                                                            <TextBlock Text="{x:Bind Sub}" FontSize="11"
                                                                       Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                                        </StackPanel>
                                                        <Border Grid.Column="1" Visibility="{x:Bind SelectedVisibility}"
                                                                Background="{ThemeResource AccentFillColorDefaultBrush}"
                                                                CornerRadius="4" Padding="7,2" VerticalAlignment="Center">
                                                            <TextBlock loc:Loc.Text="已选" FontSize="11"
                                                                       Foreground="{ThemeResource TextOnAccentFillColorPrimaryBrush}" />
                                                        </Border>
                                                    </Grid>
                                                </DataTemplate>
                                            </ListView.ItemTemplate>
                                        </ListView>
                                        <TextBlock x:Name="NeoForgeEmptyText" loc:Loc.Text="暂无可用构建" Visibility="Collapsed"
                                                   FontSize="12" Margin="4,0,0,0"
                                                   Foreground="{ThemeResource TextFillColorTertiaryBrush}" />
                                    </StackPanel>
                                </Expander>

                                <!-- Fabric -->
                                <Expander x:Name="FabricExpander" HorizontalAlignment="Stretch"
                                          HorizontalContentAlignment="Stretch">
                                    <Expander.Header>
                                        <Grid ColumnSpacing="12">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="*" />
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Text="Fabric" FontWeight="SemiBold" VerticalAlignment="Center" />
                                            <TextBlock x:Name="FabricStatus" Grid.Column="1" loc:Loc.Text="获取中…" FontSize="12"
                                                       VerticalAlignment="Center"
                                                       Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                        </Grid>
                                    </Expander.Header>
                                    <StackPanel Spacing="10" Padding="4,4,4,8">
                                        <Button x:Name="FabricRecBtn" HorizontalAlignment="Stretch"
                                                HorizontalContentAlignment="Stretch" CornerRadius="8"
                                                Padding="12,9" BorderThickness="1"
                                                Click="FabricRec_Click">
                                            <Grid ColumnSpacing="12">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="Auto" />
                                                </Grid.ColumnDefinitions>
                                                <StackPanel Spacing="2">
                                                    <TextBlock x:Name="FabricRecVersion" FontWeight="SemiBold" />
                                                    <TextBlock x:Name="FabricRecNote" FontSize="11"
                                                               Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                                </StackPanel>
                                                <Border x:Name="FabricRecBadge" Grid.Column="1"
                                                        Background="{ThemeResource SystemFillColorSuccessBackgroundBrush}"
                                                        CornerRadius="4" Padding="7,2" VerticalAlignment="Center">
                                                    <TextBlock x:Name="FabricRecBadgeText" loc:Loc.Text="推荐" FontSize="11"
                                                               Foreground="{ThemeResource SystemFillColorSuccessBrush}" />
                                                </Border>
                                            </Grid>
                                        </Button>
                                        <TextBlock x:Name="FabricCountText" loc:Loc.Text="全部版本 (0)" FontSize="13"
                                                   FontWeight="SemiBold" Margin="4,0,0,0"
                                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                        <ListView x:Name="FabricBuildList" SelectionMode="None"
                                                  IsItemClickEnabled="True" ItemClick="FabricBuild_Click"
                                                  ScrollViewer.VerticalScrollMode="Disabled"
                                                  ScrollViewer.VerticalScrollBarVisibility="Disabled">
                                            <ListView.ItemContainerStyle>
                                                <Style TargetType="ListViewItem">
                                                    <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                                                    <Setter Property="MinHeight" Value="48" />
                                                    <Setter Property="Padding" Value="0" />
                                                    <Setter Property="Margin" Value="0,1" />
                                                </Style>
                                            </ListView.ItemContainerStyle>
                                            <ListView.ItemTemplate>
                                                <DataTemplate x:DataType="local:LoaderBuildRow">
                                                    <Grid Padding="10,7" ColumnSpacing="12"
                                                          CornerRadius="8"
                                                          Background="{ThemeResource ControlFillColorSecondaryBrush}">
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="*" />
                                                            <ColumnDefinition Width="Auto" />
                                                        </Grid.ColumnDefinitions>
                                                        <StackPanel Spacing="2">
                                                            <TextBlock Text="{x:Bind Version}" FontWeight="SemiBold" />
                                                            <TextBlock Text="{x:Bind Sub}" FontSize="11"
                                                                       Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                                        </StackPanel>
                                                        <Border Grid.Column="1" Visibility="{x:Bind SelectedVisibility}"
                                                                Background="{ThemeResource AccentFillColorDefaultBrush}"
                                                                CornerRadius="4" Padding="7,2" VerticalAlignment="Center">
                                                            <TextBlock loc:Loc.Text="已选" FontSize="11"
                                                                       Foreground="{ThemeResource TextOnAccentFillColorPrimaryBrush}" />
                                                        </Border>
                                                    </Grid>
                                                </DataTemplate>
                                            </ListView.ItemTemplate>
                                        </ListView>
                                        <TextBlock x:Name="FabricEmptyText" loc:Loc.Text="暂无可用构建" Visibility="Collapsed"
                                                   FontSize="12" Margin="4,0,0,0"
                                                   Foreground="{ThemeResource TextFillColorTertiaryBrush}" />
                                    </StackPanel>
                                </Expander>

                                <!-- Quilt -->
                                <Expander x:Name="QuiltExpander" HorizontalAlignment="Stretch"
                                          HorizontalContentAlignment="Stretch">
                                    <Expander.Header>
                                        <Grid ColumnSpacing="12">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="*" />
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Text="Quilt" FontWeight="SemiBold" VerticalAlignment="Center" />
                                            <TextBlock x:Name="QuiltStatus" Grid.Column="1" loc:Loc.Text="获取中…" FontSize="12"
                                                       VerticalAlignment="Center"
                                                       Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                        </Grid>
                                    </Expander.Header>
                                    <StackPanel Spacing="10" Padding="4,4,4,8">
                                        <Button x:Name="QuiltRecBtn" HorizontalAlignment="Stretch"
                                                HorizontalContentAlignment="Stretch" CornerRadius="8"
                                                Padding="12,9" BorderThickness="1"
                                                Click="QuiltRec_Click">
                                            <Grid ColumnSpacing="12">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="Auto" />
                                                </Grid.ColumnDefinitions>
                                                <StackPanel Spacing="2">
                                                    <TextBlock x:Name="QuiltRecVersion" FontWeight="SemiBold" />
                                                    <TextBlock x:Name="QuiltRecNote" FontSize="11"
                                                               Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                                </StackPanel>
                                                <Border x:Name="QuiltRecBadge" Grid.Column="1"
                                                        Background="{ThemeResource SystemFillColorSuccessBackgroundBrush}"
                                                        CornerRadius="4" Padding="7,2" VerticalAlignment="Center">
                                                    <TextBlock x:Name="QuiltRecBadgeText" loc:Loc.Text="推荐" FontSize="11"
                                                               Foreground="{ThemeResource SystemFillColorSuccessBrush}" />
                                                </Border>
                                            </Grid>
                                        </Button>
                                        <TextBlock x:Name="QuiltCountText" loc:Loc.Text="全部版本 (0)" FontSize="13"
                                                   FontWeight="SemiBold" Margin="4,0,0,0"
                                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                        <ListView x:Name="QuiltBuildList" SelectionMode="None"
                                                  IsItemClickEnabled="True" ItemClick="QuiltBuild_Click"
                                                  ScrollViewer.VerticalScrollMode="Disabled"
                                                  ScrollViewer.VerticalScrollBarVisibility="Disabled">
                                            <ListView.ItemContainerStyle>
                                                <Style TargetType="ListViewItem">
                                                    <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                                                    <Setter Property="MinHeight" Value="48" />
                                                    <Setter Property="Padding" Value="0" />
                                                    <Setter Property="Margin" Value="0,1" />
                                                </Style>
                                            </ListView.ItemContainerStyle>
                                            <ListView.ItemTemplate>
                                                <DataTemplate x:DataType="local:LoaderBuildRow">
                                                    <Grid Padding="10,7" ColumnSpacing="12"
                                                          CornerRadius="8"
                                                          Background="{ThemeResource ControlFillColorSecondaryBrush}">
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="*" />
                                                            <ColumnDefinition Width="Auto" />
                                                        </Grid.ColumnDefinitions>
                                                        <StackPanel Spacing="2">
                                                            <TextBlock Text="{x:Bind Version}" FontWeight="SemiBold" />
                                                            <TextBlock Text="{x:Bind Sub}" FontSize="11"
                                                                       Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                                        </StackPanel>
                                                        <Border Grid.Column="1" Visibility="{x:Bind SelectedVisibility}"
                                                                Background="{ThemeResource AccentFillColorDefaultBrush}"
                                                                CornerRadius="4" Padding="7,2" VerticalAlignment="Center">
                                                            <TextBlock loc:Loc.Text="已选" FontSize="11"
                                                                       Foreground="{ThemeResource TextOnAccentFillColorPrimaryBrush}" />
                                                        </Border>
                                                    </Grid>
                                                </DataTemplate>
                                            </ListView.ItemTemplate>
                                        </ListView>
                                        <TextBlock x:Name="QuiltEmptyText" loc:Loc.Text="暂无可用构建" Visibility="Collapsed"
                                                   FontSize="12" Margin="4,0,0,0"
                                                   Foreground="{ThemeResource TextFillColorTertiaryBrush}" />
                                    </StackPanel>
                                </Expander>

                                <!-- OptiFine（暂不支持安装） -->
                                <Border Background="{ThemeResource GlassCardBrush}"
                                        BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                        BorderThickness="1" CornerRadius="8" Padding="16,12"
                                        Opacity="0.6">
                                    <Grid ColumnSpacing="12">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="OptiFine" FontWeight="SemiBold" VerticalAlignment="Center" />
                                        <TextBlock Grid.Column="1" loc:Loc.Text="暂不支持" VerticalAlignment="Center"
                                                   FontSize="12"
                                                   Foreground="{ThemeResource TextFillColorTertiaryBrush}" />
                                    </Grid>
                                </Border>
                            </StackPanel>
                        </ScrollViewer>

                        <!-- 底部：状态 + 开始下载（居中胶囊大按钮，PCL2 式） -->
                        <StackPanel Grid.Row="2" Spacing="6">
                            <TextBlock x:Name="DetailStateText" HorizontalAlignment="Center" FontSize="12"
                                       Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                            <Button x:Name="StartBtn" HorizontalAlignment="Center" Padding="30,10"
                                    CornerRadius="24" Style="{StaticResource AccentButtonStyle}" FontWeight="Bold"
                                    Click="StartDownload_Click">
                                <StackPanel Orientation="Horizontal" Spacing="10">
                                    <FontIcon Glyph="&#xE896;" FontSize="16" />
                                    <TextBlock loc:Loc.Text="开始下载" FontSize="15" FontWeight="Bold" />
                                </StackPanel>
                            </Button>
                        </StackPanel>
                    </Grid>
                </Grid>

                <!-- ── 社区资源面板 ── -->
                <Grid x:Name="CommunityPanel" Grid.Row="2" RowSpacing="12" Visibility="Collapsed">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" MinHeight="260" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <!-- 筛选卡 -->
                    <Border Grid.Row="0"
                            Background="{ThemeResource GlassCardBrush}"
                            BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                            BorderThickness="1" CornerRadius="16" Padding="16">
                        <StackPanel Spacing="12">
                            <TextBlock x:Name="SearchTitle" loc:Loc.Text="搜索 Mod" FontSize="16" FontWeight="SemiBold" />
                            <Grid ColumnSpacing="24" RowSpacing="12">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>

                                <!-- 名称 -->
                                <Grid Grid.Row="0" Grid.Column="0" ColumnSpacing="8">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock loc:Loc.Text="名称" MinWidth="36" VerticalAlignment="Center" />
                                    <TextBox x:Name="CommunitySearchBox" Grid.Column="1"
                                             loc:Loc.Placeholder="如：Sodium、JEI、Create…"
                                             KeyDown="SearchBox_KeyDown" />
                                </Grid>

                                <!-- 分类（按资源类型动态加载；无分类的类型隐藏） -->
                                <StackPanel x:Name="CategoryRow" Grid.Row="0" Grid.Column="1"
                                            Orientation="Horizontal" Spacing="8">
                                    <TextBlock loc:Loc.Text="分类" MinWidth="48" VerticalAlignment="Center" />
                                    <ComboBox x:Name="CategoryCombo" MinWidth="170" SelectionChanged="Filter_Changed" />
                                </StackPanel>

                                <!-- 版本（全部游戏大版本，可自行输入） -->
                                <Grid Grid.Row="1" Grid.Column="0" ColumnSpacing="8">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock loc:Loc.Text="版本" MinWidth="36" VerticalAlignment="Center" />
                                    <ComboBox x:Name="VersionCombo" Grid.Column="1" IsEditable="True"
                                              loc:Loc.Placeholder="全部 (也可自行输入)"
                                              MaxDropDownHeight="360"
                                              SelectionChanged="Filter_Changed" KeyDown="VersionBox_KeyDown" />
                                </Grid>

                                <!-- 加载器（仅 Mod 分区） -->
                                <StackPanel x:Name="LoaderRow" Grid.Row="1" Grid.Column="1"
                                            Orientation="Horizontal" Spacing="8">
                                    <TextBlock loc:Loc.Text="加载器" MinWidth="48" VerticalAlignment="Center" />
                                    <ComboBox x:Name="LoaderCombo" MinWidth="170" SelectionChanged="Filter_Changed">
                                        <ComboBoxItem loc:Loc.Text="自动检测" Tag="auto" IsSelected="True" />
                                        <ComboBoxItem loc:Loc.Text="全部" Tag="any" />
                                        <ComboBoxItem Content="Fabric" Tag="fabric" />
                                        <ComboBoxItem Content="Forge" Tag="forge" />
                                        <ComboBoxItem Content="NeoForge" Tag="neoforge" />
                                        <ComboBoxItem Content="Quilt" Tag="quilt" />
                                    </ComboBox>
                                </StackPanel>

                                <!-- 操作按钮 -->
                                <StackPanel Grid.Row="2" Grid.Column="0" Orientation="Horizontal" Spacing="8">
                                    <Button x:Name="SearchBtn" MinWidth="110"
                                            Style="{ThemeResource AccentButtonStyle}" FontWeight="Bold" Click="SearchBtn_Click">
                                        <StackPanel Orientation="Horizontal" Spacing="8">
                                            <FontIcon Glyph="&#xE721;" FontSize="14" />
                                            <TextBlock loc:Loc.Text="搜索" />
                                        </StackPanel>
                                    </Button>
                                    <Button x:Name="ResetBtn" MinWidth="110" loc:Loc.Text="重置条件" Click="ResetBtn_Click" />
                                </StackPanel>

                                <!-- 排序 -->
                                <StackPanel Grid.Row="2" Grid.Column="1" Orientation="Horizontal" Spacing="8">
                                    <TextBlock loc:Loc.Text="排序" MinWidth="48" VerticalAlignment="Center" />
                                    <ComboBox x:Name="SortCombo" MinWidth="170" SelectionChanged="Filter_Changed">
                                        <ComboBoxItem loc:Loc.Text="相关性" Tag="relevance" IsSelected="True" />
                                        <ComboBoxItem loc:Loc.Text="下载最多" Tag="downloads" />
                                        <ComboBoxItem loc:Loc.Text="最新发布" Tag="newest" />
                                        <ComboBoxItem loc:Loc.Text="最近更新" Tag="updated" />
                                    </ComboBox>
                                </StackPanel>
                            </Grid>
                        </StackPanel>
                    </Border>

                    <!-- 结果列表 -->
                    <Border Grid.Row="1"
                            Background="{ThemeResource GlassCardBrush}"
                            BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                            BorderThickness="1" CornerRadius="16" Padding="4">
                        <Grid>
                            <ListView x:Name="ModList" SelectionMode="None">
                                <ListView.ItemContainerStyle>
                                    <Style TargetType="ListViewItem">
                                        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                                        <Setter Property="MinHeight" Value="68" />
                                        <Setter Property="Padding" Value="0" />
                                        <Setter Property="Margin" Value="0,1" />
                                    </Style>
                                </ListView.ItemContainerStyle>
                                <ListView.ItemTemplate>
                                    <DataTemplate x:DataType="local:ModRow">
                                        <!-- 整卡可点：点击资源卡片直接打开下载详情窗（PCL2 式） -->
                                        <Grid Padding="12,10" ColumnSpacing="12"
                                              Background="Transparent" Tapped="ModRow_Tapped">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="*" />
                                            </Grid.ColumnDefinitions>

                                            <!-- 图标：底层字形兜底（图片解码失败时可见），上层图片覆盖 -->
                                            <Grid Width="48" Height="48" VerticalAlignment="Center" CornerRadius="8">
                                                <FontIcon Glyph="&#xE71D;" FontSize="20"
                                                          Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                                <Image Source="{x:Bind Icon}" Stretch="UniformToFill" />
                                            </Grid>

                                            <StackPanel Grid.Column="1" Spacing="3" VerticalAlignment="Center">
                                                <StackPanel Orientation="Horizontal" Spacing="8">
                                                    <TextBlock Text="{x:Bind Title}" FontWeight="SemiBold" FontSize="14"
                                                               MaxWidth="420" VerticalAlignment="Center"
                                                               TextTrimming="CharacterEllipsis" />
                                                    <ItemsControl ItemsSource="{x:Bind Tags}" VerticalAlignment="Center"
                                                                  Visibility="{x:Bind TagsVisibility}">
                                                        <ItemsControl.ItemsPanel>
                                                            <ItemsPanelTemplate>
                                                                <StackPanel Orientation="Horizontal" Spacing="4" />
                                                            </ItemsPanelTemplate>
                                                        </ItemsControl.ItemsPanel>
                                                        <ItemsControl.ItemTemplate>
                                                            <DataTemplate x:DataType="x:String">
                                                                <Border Background="{ThemeResource ControlFillColorDefaultBrush}"
                                                                        BorderBrush="{ThemeResource ControlStrokeColorDefaultBrush}"
                                                                        BorderThickness="1" CornerRadius="4" Padding="6,1">
                                                                    <TextBlock Text="{x:Bind}" FontSize="11"
                                                                               Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                                                </Border>
                                                            </DataTemplate>
                                                        </ItemsControl.ItemTemplate>
                                                    </ItemsControl>
                                                </StackPanel>
                                                <TextBlock Text="{x:Bind Description}" FontSize="12"
                                                           Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                                                           MaxLines="1" TextTrimming="CharacterEllipsis" />
                                                <StackPanel Orientation="Horizontal" Spacing="12">
                                                    <TextBlock Text="{x:Bind LoadersText}" FontSize="12"
                                                               Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                                               Visibility="{x:Bind LoadersVisibility}" />
                                                    <TextBlock Text="{x:Bind DownloadsText}" FontSize="12"
                                                               Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                                    <TextBlock Text="{x:Bind UpdatedText}" FontSize="12"
                                                               Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                                </StackPanel>
                                            </StackPanel>
                                        </Grid>
                                    </DataTemplate>
                                </ListView.ItemTemplate>
                            </ListView>
                            <local:EmptyStateView x:Name="EmptyHint" Visibility="Collapsed"
                                                  HorizontalAlignment="Center" VerticalAlignment="Center"
                                                  Glyph="&#xE721;"
                                                  loc:Loc.Title="没有找到相关资源，换个关键词或筛选条件试试" />
                        </Grid>
                    </Border>

                    <!-- 分页 -->
                    <Grid Grid.Row="2" ColumnSpacing="8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                            <TextBlock x:Name="ResultCountText" VerticalAlignment="Center" FontSize="12"
                                       Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                            <Border x:Name="CacheBadge" Visibility="Collapsed" CornerRadius="4" Padding="8,2"
                                    VerticalAlignment="Center"
                                    Background="{ThemeResource AccentFillColorTertiaryBrush}">
                                <TextBlock loc:Loc.Text="缓存" FontSize="11"
                                           Foreground="{ThemeResource TextOnAccentFillColorPrimaryBrush}" />
                            </Border>
                        </StackPanel>
                        <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8">
                            <Button x:Name="PrevBtn" loc:Loc.Text="上一页" Click="PrevBtn_Click" />
                            <Button x:Name="NextBtn" loc:Loc.Text="下一页" Click="NextBtn_Click" />
                        </StackPanel>
                    </Grid>
                </Grid>
            </Grid>
        </Grid>
    </Grid>
</Page>
