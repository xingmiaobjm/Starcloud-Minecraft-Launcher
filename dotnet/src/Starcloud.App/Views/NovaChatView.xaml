<?xml version="1.0" encoding="utf-8"?>
<!-- Nova 复用对话组件（NOVA_INTEGRATION.md：Nova 内嵌为助手，页面 / 顶栏面板 / 底部对话条共用）。
     自身不持有会话：直接订阅 NovaRuntime 全局消息流与状态机。 -->
<UserControl
    x:Class="Starcloud.App.Views.NovaChatView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:loc="using:Starcloud.App.Localization"
    xmlns:svc="using:Starcloud.App.Services"
    xmlns:core="using:Starcloud.Core.Services">

    <UserControl.Resources>
        <!-- 对话消息模板：文本气泡 + 动手确认清单卡（Plan 非空时展示） -->
        <DataTemplate x:Key="MessageTemplate" x:DataType="svc:NovaChatMessage">
            <StackPanel MaxWidth="720" HorizontalAlignment="{x:Bind Align}" Margin="0,2">
                <!-- 普通文本气泡 -->
                <Border Background="{x:Bind Bubble}" CornerRadius="{x:Bind Corners}" Padding="12,9"
                        Visibility="{x:Bind TextVisible}">
                    <StackPanel Spacing="2">
                        <TextBlock Text="{x:Bind Content}" TextWrapping="Wrap"
                                   Foreground="{x:Bind TextBrush}" />
                        <TextBlock Text="{x:Bind TimeText}" FontSize="11" Opacity="0.65"
                                   Foreground="{x:Bind TextBrush}"
                                   HorizontalAlignment="{x:Bind Align}" />
                    </StackPanel>
                </Border>

                <!-- 确认清单卡：动手前列给用户，点头才执行 -->
                <Border Background="{ThemeResource GlassCardBrush}"
                        BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                        BorderThickness="1" CornerRadius="12" Padding="16,12"
                        Visibility="{x:Bind HasPlanVisible}">
                    <StackPanel Spacing="8">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <FontIcon Glyph="&#xE73E;" FontSize="14"
                                      Foreground="{ThemeResource BrandBlueBrush}" />
                            <TextBlock Text="{x:Bind Content}" FontWeight="SemiBold"
                                       TextWrapping="Wrap" VerticalAlignment="Center" />
                        </StackPanel>
                        <ItemsControl ItemsSource="{x:Bind Plan.Items}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate x:DataType="core:NovaActionItem">
                                    <StackPanel Margin="0,4,0,0" Spacing="1">
                                        <TextBlock Text="{x:Bind Title}" FontSize="13"
                                                   FontWeight="SemiBold" />
                                        <TextBlock Text="{x:Bind Detail}" FontSize="12"
                                                   TextWrapping="Wrap" Opacity="0.75"
                                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                    </StackPanel>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                        <StackPanel Orientation="Horizontal" Spacing="8" Margin="0,2,0,0"
                                    Visibility="{x:Bind PlanButtonsVisible}">
                            <Button Style="{StaticResource AccentButtonStyle}" loc:Loc.Text="确认执行"
                                    loc:Loc.Name="确认执行" Click="PlanConfirm_Click" />
                            <Button loc:Loc.Text="取消" loc:Loc.Name="取消执行"
                                    Click="PlanCancel_Click" />
                        </StackPanel>
                        <TextBlock Text="{x:Bind PlanStateText}" FontSize="12"
                                   Visibility="{x:Bind PlanStateVisible}" TextWrapping="Wrap"
                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                        <TextBlock Text="{x:Bind TimeText}" FontSize="11" Opacity="0.65" />
                    </StackPanel>
                </Border>
            </StackPanel>
        </DataTemplate>
    </UserControl.Resources>

    <Grid RowSpacing="8">
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- 对话流 -->
        <Border Grid.Row="0"
                Background="{ThemeResource GlassCardBrush}"
                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                BorderThickness="1" CornerRadius="16" Padding="8">
            <ListView x:Name="ChatList" SelectionMode="None" Padding="4"
                      ItemTemplate="{StaticResource MessageTemplate}" />
        </Border>

        <!-- 快捷能力（NOVA_INTEGRATION.md 3.1：输入区下方的快捷按钮） -->
        <StackPanel Grid.Row="1" Orientation="Vertical" Spacing="4">
            <StackPanel Orientation="Horizontal" Spacing="6">
                <Button Tag="崩了" loc:Loc.Name="崩溃自愈" Click="Quick_Click"
                        Padding="10,4" MinWidth="0">
                    <StackPanel Orientation="Horizontal" Spacing="6">
                        <FontIcon Glyph="&#xE946;" FontSize="13" Foreground="{ThemeResource BrandBlueBrush}" />
                        <TextBlock loc:Loc.Text="崩了" FontSize="12" VerticalAlignment="Center" />
                    </StackPanel>
                </Button>
                <Button Tag="游戏体检" loc:Loc.Name="游戏体检" Click="Quick_Click"
                        Padding="10,4" MinWidth="0">
                    <StackPanel Orientation="Horizontal" Spacing="6">
                        <FontIcon Glyph="&#xE9D9;" FontSize="13" Foreground="{ThemeResource BrandBlueBrush}" />
                        <TextBlock loc:Loc.Text="游戏体检" FontSize="12" VerticalAlignment="Center" />
                    </StackPanel>
                </Button>
                <Button Tag="检查模组冲突" loc:Loc.Name="检查模组冲突" Click="Quick_Click"
                        Padding="10,4" MinWidth="0">
                    <StackPanel Orientation="Horizontal" Spacing="6">
                        <FontIcon Glyph="&#xE7BA;" FontSize="13" Foreground="{ThemeResource BrandBlueBrush}" />
                        <TextBlock loc:Loc.Text="模组冲突" FontSize="12" VerticalAlignment="Center" />
                    </StackPanel>
                </Button>
                <Button Tag="帧数体检" loc:Loc.Name="帧数体检" Click="Quick_Click"
                        Padding="10,4" MinWidth="0">
                    <StackPanel Orientation="Horizontal" Spacing="6">
                        <FontIcon Glyph="&#xE9D2;" FontSize="13" Foreground="{ThemeResource BrandBlueBrush}" />
                        <TextBlock loc:Loc.Text="调帧数" FontSize="12" VerticalAlignment="Center" />
                    </StackPanel>
                </Button>
            </StackPanel>
            <StackPanel Orientation="Horizontal" Spacing="6">
                <Button Tag="开箱即玩" loc:Loc.Name="开箱即玩" Click="Quick_Click"
                        Padding="10,4" MinWidth="0">
                    <StackPanel Orientation="Horizontal" Spacing="6">
                        <FontIcon Glyph="&#xE9F5;" FontSize="13" Foreground="{ThemeResource BrandBlueBrush}" />
                        <TextBlock loc:Loc.Text="开箱即玩" FontSize="12" VerticalAlignment="Center" />
                    </StackPanel>
                </Button>
                <Button Tag="找个整合包" loc:Loc.Name="找个整合包" Click="Quick_Click"
                        Padding="10,4" MinWidth="0">
                    <StackPanel Orientation="Horizontal" Spacing="6">
                        <FontIcon Glyph="&#xE896;" FontSize="13" Foreground="{ThemeResource BrandBlueBrush}" />
                        <TextBlock loc:Loc.Text="找整合包" FontSize="12" VerticalAlignment="Center" />
                    </StackPanel>
                </Button>
                <Button Tag="你能做什么" loc:Loc.Name="你能做什么" Click="Quick_Click"
                        Padding="10,4" MinWidth="0">
                    <StackPanel Orientation="Horizontal" Spacing="6">
                        <FontIcon Glyph="&#xE897;" FontSize="13" Foreground="{ThemeResource BrandBlueBrush}" />
                        <TextBlock loc:Loc.Text="你能做什么" FontSize="12" VerticalAlignment="Center" />
                    </StackPanel>
                </Button>
            </StackPanel>
        </StackPanel>

        <!-- 发送完整日志（规格 §5：默认关闭；打开后跳过崩溃日志裁剪，消耗更多积分） -->
        <StackPanel Grid.Row="2" Orientation="Horizontal" Spacing="10">
            <ToggleSwitch x:Name="FullLogSwitch" MinWidth="0"
                          OnContent="" OffContent="" Toggled="FullLog_Toggled" />
            <TextBlock loc:Loc.Text="发送完整日志" FontSize="13" VerticalAlignment="Center" />
            <TextBlock x:Name="FullLogHint" FontSize="12" VerticalAlignment="Center"
                       TextWrapping="Wrap" Visibility="Collapsed"
                       Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                       loc:Loc.Text="完整日志会显著增加积分消耗，仅在裁剪后仍无法定位时使用" />
        </StackPanel>

        <!-- 输入行 -->
        <Grid Grid.Row="3" ColumnSpacing="8">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <TextBox x:Name="InputBox" VerticalAlignment="Center"
                     loc:Loc.Placeholder="你说一句人话，我来打理脏活累活"
                     KeyDown="InputBox_KeyDown" />
            <ProgressRing x:Name="SendProgress" Grid.Column="1" IsActive="False"
                          Width="22" Height="22" VerticalAlignment="Center" />
            <Button x:Name="SendBtn" Grid.Column="2" Style="{StaticResource AccentButtonStyle}"
                    loc:Loc.Text="发送" Padding="16,5" MinWidth="80" Click="Send_Click"
                    VerticalAlignment="Center" />
        </Grid>
    </Grid>
</UserControl>
