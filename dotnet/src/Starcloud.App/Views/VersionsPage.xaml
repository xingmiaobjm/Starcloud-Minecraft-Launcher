<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="Starcloud.App.Views.VersionsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:Starcloud.App.Views"
    xmlns:loc="using:Starcloud.App.Localization"
    NavigationCacheMode="Disabled"
    AllowDrop="True" DragOver="Page_DragOver" Drop="Page_Drop">

    <Page.Resources>
        <!-- 行菜单：右键与「…」按钮共用（Opening 时从 Target.DataContext 取行数据） -->
        <MenuFlyout x:Key="RowMenu" Opening="RowMenu_Opening">
            <MenuFlyoutItem loc:Loc.Text="启动" Click="Launch_Click">
                <MenuFlyoutItem.Icon>
                    <FontIcon Glyph="&#xF5B0;" />
                </MenuFlyoutItem.Icon>
            </MenuFlyoutItem>
            <MenuFlyoutItem loc:Loc.Text="版本详情" Click="Detail_Click">
                <MenuFlyoutItem.Icon>
                    <FontIcon Glyph="&#xE8A9;" />
                </MenuFlyoutItem.Icon>
            </MenuFlyoutItem>
            <MenuFlyoutItem loc:Loc.Text="打开目录" Click="OpenVersionDir_Click">
                <MenuFlyoutItem.Icon>
                    <FontIcon Glyph="&#xE838;" />
                </MenuFlyoutItem.Icon>
            </MenuFlyoutItem>
            <MenuFlyoutSeparator />
            <MenuFlyoutItem loc:Loc.Text="重命名" Click="Rename_Click">
                <MenuFlyoutItem.Icon>
                    <FontIcon Glyph="&#xE8AC;" />
                </MenuFlyoutItem.Icon>
            </MenuFlyoutItem>
            <MenuFlyoutItem loc:Loc.Text="复制版本" Click="Copy_Click">
                <MenuFlyoutItem.Icon>
                    <FontIcon Glyph="&#xE8C9;" />
                </MenuFlyoutItem.Icon>
            </MenuFlyoutItem>
            <MenuFlyoutItem loc:Loc.Text="查看 JSON" Click="ViewJson_Click">
                <MenuFlyoutItem.Icon>
                    <FontIcon Glyph="&#xE943;" />
                </MenuFlyoutItem.Icon>
            </MenuFlyoutItem>
            <MenuFlyoutItem loc:Loc.Text="导出整合包" Click="Export_Click">
                <MenuFlyoutItem.Icon>
                    <FontIcon Glyph="&#xE8C1;" />
                </MenuFlyoutItem.Icon>
            </MenuFlyoutItem>
            <MenuFlyoutItem loc:Loc.Text="导入整合包" Click="Import_Click">
                <MenuFlyoutItem.Icon>
                    <FontIcon Glyph="&#xE896;" />
                </MenuFlyoutItem.Icon>
            </MenuFlyoutItem>
            <MenuFlyoutItem loc:Loc.Text="备份与回档" Click="Backup_Click">
                <MenuFlyoutItem.Icon>
                    <FontIcon Glyph="&#xE81C;" />
                </MenuFlyoutItem.Icon>
            </MenuFlyoutItem>
            <MenuFlyoutSeparator />
            <MenuFlyoutItem loc:Loc.Text="问 Nova" Click="AskNova_Click">
                <MenuFlyoutItem.Icon>
                    <FontIcon Glyph="&#xE99A;" />
                </MenuFlyoutItem.Icon>
            </MenuFlyoutItem>
            <MenuFlyoutItem loc:Loc.Text="删除" Click="Delete_Click">
                <MenuFlyoutItem.Icon>
                    <FontIcon Glyph="&#xE74D;" />
                </MenuFlyoutItem.Icon>
            </MenuFlyoutItem>
        </MenuFlyout>
    </Page.Resources>

    <Grid MaxWidth="1280" HorizontalAlignment="Stretch" RowSpacing="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- 页头 -->
        <StackPanel Grid.Row="0" Spacing="4">
            <TextBlock loc:Loc.Text="版本" FontSize="28" FontWeight="SemiBold" />
            <TextBlock loc:Loc.Text="管理本地已安装的游戏版本"
                       Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
        </StackPanel>

        <!-- 目录与工具行 -->
        <Grid Grid.Row="1" ColumnSpacing="12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <Border Background="{ThemeResource GlassCardBrush}"
                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                    BorderThickness="1" CornerRadius="8" Padding="12,8">
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <FontIcon Glyph="&#xE8B7;" FontSize="14"
                              Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                    <TextBlock x:Name="DirText" VerticalAlignment="Center" FontSize="12"
                               TextTrimming="CharacterEllipsis"
                               Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                </StackPanel>
            </Border>
            <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8">
                <Button Click="Import_Click">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <FontIcon Glyph="&#xE896;" FontSize="14" />
                        <TextBlock loc:Loc.Text="导入整合包" />
                    </StackPanel>
                </Button>
                <TextBox x:Name="SearchBox" loc:Loc.Placeholder="搜索版本 / 类别"
                         Width="180" loc:Loc.Name="搜索版本"
                         TextChanged="SearchBox_TextChanged" />
                <ComboBox x:Name="CategoryFilter" Width="130" SelectedIndex="0"
                          loc:Loc.Name="按类别筛选"
                          SelectionChanged="CategoryFilter_SelectionChanged" />
                <Button Click="Refresh_Click">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <FontIcon Glyph="&#xE72C;" FontSize="14" />
                        <TextBlock loc:Loc.Text="刷新" />
                    </StackPanel>
                </Button>
                <Button Click="OpenDir_Click">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <FontIcon Glyph="&#xE838;" FontSize="14" />
                        <TextBlock loc:Loc.Text="打开游戏目录" />
                    </StackPanel>
                </Button>
            </StackPanel>
        </Grid>

        <!-- 本地版本列表 -->
        <Border Grid.Row="2"
                Background="{ThemeResource GlassCardBrush}"
                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                BorderThickness="1" CornerRadius="16" Padding="4">
            <Grid>
                <ListView x:Name="VersionListView" SelectionMode="Single"
                          IsItemClickEnabled="True" ItemClick="VersionList_ItemClick">
                    <ListView.Resources>
                        <!-- 悬停/选中反馈只由行内的跟手光斑表达：框架给的整行底色是一块硬边矩形，
                             和光斑的圆角、羽化对不齐，叠在一起就是"两层框"（红框反馈的那个问题）。
                             这里把框架底色全部置空，页面上该列表的选中态没有语义（点行直接进详情）。 -->
                        <SolidColorBrush x:Key="ListViewItemBackground" Color="Transparent" />
                        <SolidColorBrush x:Key="ListViewItemBackgroundPointerOver" Color="Transparent" />
                        <SolidColorBrush x:Key="ListViewItemBackgroundPressed" Color="Transparent" />
                        <SolidColorBrush x:Key="ListViewItemBackgroundSelected" Color="Transparent" />
                        <SolidColorBrush x:Key="ListViewItemBackgroundSelectedPointerOver" Color="Transparent" />
                        <SolidColorBrush x:Key="ListViewItemBackgroundSelectedPressed" Color="Transparent" />
                    </ListView.Resources>
                    <ListView.ItemContainerStyle>
                        <Style TargetType="ListViewItem">
                            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                            <Setter Property="MinHeight" Value="64" />
                            <Setter Property="Padding" Value="0" />
                            <Setter Property="Margin" Value="0,1" />
                        </Style>
                    </ListView.ItemContainerStyle>
                    <ListView.ItemTemplate>
                        <DataTemplate x:DataType="local:LocalVersionRow">
                            <Grid local:CardHoverBehavior.IsEnabled="True"
                                  local:HoverShadowBehavior.IsEnabled="True"
                                  local:HoverShadowBehavior.Carrier="{Binding ElementName=VersionRowGlow}"
                                  ContextFlyout="{StaticResource RowMenu}">
                            <!-- 跟手光斑层铺满整行（不带行内边距），圆角与行一致；内容再靠 Padding 让开。
                                 光斑若跟内容一起内缩，就会比行小一圈，外面露出框架底色 → 两层框。 -->
                            <Border x:Name="VersionRowGlow" CornerRadius="8" Opacity="0"
                                    IsHitTestVisible="False">
                                <Border.Background>
                                    <RadialGradientBrush Center="0.5,0.5" GradientOrigin="0.5,0.5"
                                                         RadiusX="0.2" RadiusY="0.5">
                                        <GradientStop Color="#28000000" Offset="0" />
                                        <GradientStop Color="#1F000000" Offset="0.18" />
                                        <GradientStop Color="#16000000" Offset="0.40" />
                                        <GradientStop Color="#0D000000" Offset="0.62" />
                                        <GradientStop Color="#05000000" Offset="0.82" />
                                        <GradientStop Color="#00000000" Offset="1" />
                                    </RadialGradientBrush>
                                </Border.Background>
                            </Border>
                            <Grid Padding="12,8" ColumnSpacing="12">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <StackPanel Orientation="Horizontal" Spacing="12">
                                    <Border Width="32" Height="32" CornerRadius="8"
                                            Background="{ThemeResource SubtleFillColorSecondaryBrush}">
                                        <Grid>
                                            <Image Source="{x:Bind Icon}" Width="32" Height="32"
                                                   Stretch="Uniform"
                                                   Visibility="{x:Bind IconImageVisibility}" />
                                            <FontIcon Glyph="&#xE7E8;" FontSize="14"
                                                      Visibility="{x:Bind IconFontVisibility}"
                                                      Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                        </Grid>
                                    </Border>
                                    <StackPanel Spacing="2" VerticalAlignment="Center" MaxWidth="420">
                                        <TextBlock Text="{x:Bind Id}" FontWeight="SemiBold"
                                                   TextTrimming="CharacterEllipsis" />
                                        <StackPanel Orientation="Horizontal" Spacing="6">
                                            <TextBlock Text="{x:Bind KindText}" FontSize="11"
                                                       Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                            <Border Padding="6,1" CornerRadius="4"
                                                    Background="{ThemeResource SubtleFillColorTertiaryBrush}"
                                                    Visibility="{x:Bind CategoryVisibility}">
                                                <TextBlock Text="{x:Bind Category}" FontSize="11"
                                                           Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                            </Border>
                                            <Border Padding="6,1" CornerRadius="4"
                                                    Background="{ThemeResource SubtleFillColorSecondaryBrush}"
                                                    Visibility="{x:Bind IsolatedVisibility}">
                                                <TextBlock loc:Loc.Text="独立" FontSize="11"
                                                           Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                            </Border>
                                        </StackPanel>
                                    </StackPanel>
                                </StackPanel>
                                <StackPanel Grid.Column="1" Spacing="2" VerticalAlignment="Center"
                                            HorizontalAlignment="Right">
                                    <TextBlock Text="{x:Bind LastPlayedText}" FontSize="11"
                                               HorizontalAlignment="Right"
                                               Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                    <TextBlock Text="{x:Bind SizeText}" FontSize="11"
                                               HorizontalAlignment="Right"
                                               Foreground="{ThemeResource TextFillColorTertiaryBrush}" />
                                </StackPanel>
                                <Button Grid.Column="2" VerticalAlignment="Center" Padding="6"
                                        Background="Transparent" BorderThickness="0"
                                        Flyout="{StaticResource RowMenu}"
                                        loc:Loc.Name="更多操作"
                                        loc:Loc.Tip="更多操作">
                                    <FontIcon Glyph="&#xE712;" FontSize="14"
                                              Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                </Button>
                                <!-- 删除保留独立快键（沿用旧交互） -->
                                <Button Grid.Column="3" VerticalAlignment="Center" Padding="6"
                                        Background="Transparent" BorderThickness="0" Click="Delete_Click"
                                        loc:Loc.Name="删除该版本"
                                        loc:Loc.Tip="删除该版本">
                                    <FontIcon Glyph="&#xE74D;" FontSize="14"
                                              Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                </Button>
                            </Grid>
                            </Grid>
                        </DataTemplate>
                    </ListView.ItemTemplate>
                </ListView>
                <local:EmptyStateView x:Name="EmptyHint" Visibility="Collapsed"
                                      HorizontalAlignment="Center" VerticalAlignment="Center"
                                      Glyph="&#xE81C;" />
            </Grid>
        </Border>
    </Grid>
</Page>
