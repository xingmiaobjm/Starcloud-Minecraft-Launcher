<?xml version="1.0" encoding="utf-8"?>
<Window
    x:Class="Starcloud.App.Views.NovaOverlayWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:views="using:Starcloud.App.Views">

    <!--  Nova 游戏内浮窗（设计：nova-overlay-design.md §3.2）
          收起态 48×48 贴角 Orb（可拖动）/ Toast 一句话提醒（10s 自收）
          展开态 320×420 毛玻璃面板（内嵌 NovaChatView，对话/时刻确认全量可用）  -->
    <Grid x:Name="Root" Background="Transparent">
        <Grid x:Name="CollapsedHost" Visibility="Visible">
            <Grid.ColumnDefinitions>
                <!--  * 列：Toast 占位（ShowToast 时窗口加宽，Orb 恒贴右缘）  -->
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="8" />
                <ColumnDefinition Width="48" />
            </Grid.ColumnDefinitions>

            <!-- Toast：一句话提醒卡（Orb 左侧，10s 自动收） -->
            <Border x:Name="ToastHost" Grid.Column="0"
                    Background="{ThemeResource AcrylicBackgroundFillColorDefaultBrush}"
                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                    BorderThickness="1" CornerRadius="12"
                    Padding="12,8" MaxWidth="216" VerticalAlignment="Center"
                    Visibility="Collapsed">
                <TextBlock x:Name="ToastText" FontSize="12" TextWrapping="Wrap" MaxLines="3"
                           Foreground="{ThemeResource TextFillColorPrimaryBrush}" />
            </Border>

            <!-- 收起态 Orb：状态着色 + 有提案黄点，点击展开，按住可拖动 -->
            <Button x:Name="OrbBtn" Grid.Column="2"
                    AutomationProperties.Name="Nova 浮窗"
                    Width="48" Height="48" Padding="0" CornerRadius="24"
                    Background="{ThemeResource AcrylicBackgroundFillColorDefaultBrush}"
                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                    BorderThickness="1"
                    HorizontalContentAlignment="Center" VerticalContentAlignment="Center">
                <Grid>
                    <FontIcon x:Name="OrbGlyph" Glyph="&#xE99A;" FontSize="20" />
                    <Ellipse x:Name="OrbDot" Width="8" Height="8" Fill="#F59E0B"
                             HorizontalAlignment="Right" VerticalAlignment="Top"
                             Margin="0,6,6,0" Visibility="Collapsed" />
                </Grid>
            </Button>
        </Grid>

        <!-- 展开态面板：320×420，标头 + 复用对话组件 -->
        <Border x:Name="PanelHost" Width="320" Height="420" CornerRadius="16"
                Background="{ThemeResource AcrylicBackgroundFillColorDefaultBrush}"
                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                BorderThickness="1" Padding="12"
                Visibility="Collapsed">
            <Grid RowSpacing="8">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <Grid Grid.Row="0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBlock x:Name="PanelTitle" Grid.Column="0" Text="Nova" FontWeight="SemiBold"
                               VerticalAlignment="Center" />
                    <Button x:Name="CollapseBtn" Grid.Column="1" AutomationProperties.Name="收起浮窗"
                            Style="{StaticResource SubtleButtonStyle}" Padding="6">
                        <FontIcon Glyph="&#xE721;" FontSize="14" />
                    </Button>
                </Grid>

                <views:NovaChatView Grid.Row="1" />
            </Grid>
        </Border>
    </Grid>
</Window>
