<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="Starcloud.App.Views.SettingsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    NavigationCacheMode="Disabled">

    <Grid MaxWidth="1000" HorizontalAlignment="Stretch" RowSpacing="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- 页头 -->
        <StackPanel Grid.Row="0" Spacing="4">
            <TextBlock Text="设置" FontSize="28" FontWeight="SemiBold" />
            <TextBlock Text="游戏目录、内存、Java 与通用选项"
                       Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
        </StackPanel>

        <!-- 主体：左导航 + 右内容 -->
        <Grid Grid.Row="1" ColumnSpacing="16">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="180" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <!-- 左侧分类导航（PCL2 / LauncherX 式） -->
            <Border Grid.Column="0" VerticalAlignment="Stretch"
                    Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                    BorderThickness="1" CornerRadius="8" Padding="8">
                <ListView x:Name="CategoryList" SelectionMode="Single"
                          SelectionChanged="Category_SelectionChanged">
                    <ListView.ItemContainerStyle>
                        <Style TargetType="ListViewItem">
                            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                            <Setter Property="MinHeight" Value="40" />
                            <Setter Property="Padding" Value="0" />
                        </Style>
                    </ListView.ItemContainerStyle>
                    <ListViewItem Tag="game" IsSelected="True">
                        <StackPanel Orientation="Horizontal" Spacing="10" Padding="8,0">
                            <FontIcon Glyph="&#xE7FC;" FontSize="14" />
                            <TextBlock Text="游戏" VerticalAlignment="Center" />
                        </StackPanel>
                    </ListViewItem>
                    <ListViewItem Tag="java">
                        <StackPanel Orientation="Horizontal" Spacing="10" Padding="8,0">
                            <FontIcon Glyph="&#xEA4D;" FontSize="14" />
                            <TextBlock Text="Java" VerticalAlignment="Center" />
                        </StackPanel>
                    </ListViewItem>
                    <ListViewItem Tag="general">
                        <StackPanel Orientation="Horizontal" Spacing="10" Padding="8,0">
                            <FontIcon Glyph="&#xE713;" FontSize="14" />
                            <TextBlock Text="通用" VerticalAlignment="Center" />
                        </StackPanel>
                    </ListViewItem>
                </ListView>
            </Border>

            <!-- 右侧内容 -->
            <Grid Grid.Column="1" RowSpacing="12">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <StackPanel Grid.Row="0" Spacing="8">
                    <InfoBar x:Name="SavedBar" Severity="Success" Title="已保存" IsOpen="False" IsClosable="True" />
                    <InfoBar x:Name="ErrorBar" Severity="Error" IsOpen="False" IsClosable="True" Title="操作失败" />
                </StackPanel>

                <ScrollViewer Grid.Row="1">
                    <StackPanel Spacing="16">

                        <!-- ══ 游戏 ══ -->
                        <StackPanel x:Name="SectionGame" Spacing="16">
                            <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                    BorderThickness="1" CornerRadius="16" Padding="16">
                                <StackPanel Spacing="12">
                                    <TextBlock Text="游戏目录" FontWeight="SemiBold" />
                                    <TextBox x:Name="DotMcBox" PlaceholderText=".minecraft 目录路径" />
                                    <TextBlock Text="版本、资源与库文件将安装到该目录"
                                               FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                </StackPanel>
                            </Border>

                            <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                    BorderThickness="1" CornerRadius="16" Padding="16">
                                <StackPanel Spacing="12">
                                    <TextBlock Text="内存分配" FontWeight="SemiBold" />
                                    <Grid ColumnSpacing="12">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Grid.Column="0" Spacing="4">
                                            <TextBlock Text="最小内存 (MB)" FontSize="12" />
                                            <NumberBox x:Name="MinMemBox" Minimum="256" Maximum="24576" SpinButtonPlacementMode="Compact" />
                                        </StackPanel>
                                        <StackPanel Grid.Column="1" Spacing="4">
                                            <TextBlock Text="最大内存 (MB)" FontSize="12" />
                                            <NumberBox x:Name="MaxMemBox" Minimum="512" Maximum="24576" SpinButtonPlacementMode="Compact" />
                                        </StackPanel>
                                    </Grid>
                                </StackPanel>
                            </Border>
                        </StackPanel>

                        <!-- ══ Java ══ -->
                        <StackPanel x:Name="SectionJava" Spacing="16" Visibility="Collapsed">
                            <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                    BorderThickness="1" CornerRadius="16" Padding="16">
                                <StackPanel Spacing="12">
                                    <TextBlock Text="Java 运行时" FontWeight="SemiBold" />
                                    <TextBlock Text="留空使用系统 java；亦可下载启动器托管的 Java"
                                               FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                    <TextBox x:Name="JavaBox" PlaceholderText="java.exe 完整路径（可选）" />
                                    <StackPanel Orientation="Horizontal" Spacing="8">
                                        <Button Content="检测系统 Java" Click="DetectJava_Click" />
                                        <Button Content="下载 Java 21（Temurin）" Click="DownloadJava_Click" />
                                        <Button Content="下载 Java 8（Temurin）" Click="DownloadJava8_Click" />
                                    </StackPanel>
                                    <ProgressBar x:Name="JavaProgress" Visibility="Collapsed" />
                                    <TextBlock x:Name="JavaListText" FontSize="12" TextWrapping="Wrap"
                                               Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                </StackPanel>
                            </Border>
                        </StackPanel>

                        <!-- ══ 通用 ══ -->
                        <StackPanel x:Name="SectionGeneral" Spacing="16" Visibility="Collapsed">
                            <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                    BorderThickness="1" CornerRadius="16" Padding="16">
                                <StackPanel Spacing="12">
                                    <TextBlock Text="下载与外观" FontWeight="SemiBold" />
                                    <StackPanel Orientation="Horizontal" Spacing="8">
                                        <TextBlock Text="下载并发数" Width="120" VerticalAlignment="Center" />
                                        <NumberBox x:Name="ConcurrencyBox" Minimum="1" Maximum="64" SpinButtonPlacementMode="Compact" />
                                    </StackPanel>
                                    <StackPanel Orientation="Horizontal" Spacing="8">
                                        <TextBlock Text="外观" Width="120" VerticalAlignment="Center" />
                                        <ComboBox x:Name="ThemeCombo" Width="160" SelectionChanged="Theme_Changed">
                                            <ComboBoxItem Content="跟随系统" Tag="system" />
                                            <ComboBoxItem Content="浅色" Tag="light" />
                                            <ComboBoxItem Content="深色" Tag="dark" />
                                        </ComboBox>
                                    </StackPanel>
                                </StackPanel>
                            </Border>
                        </StackPanel>

                    </StackPanel>
                </ScrollViewer>

                <!-- 固定底部保存 -->
                <Button Grid.Row="2" Content="保存设置" HorizontalAlignment="Right" MinWidth="120"
                        Style="{StaticResource AccentButtonStyle}" Click="Save_Click" />
            </Grid>
        </Grid>
    </Grid>
</Page>
