<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="Starcloud.App.Views.SettingsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    NavigationCacheMode="Disabled">

    <Page.Resources>
        <!-- PCL 风格：白卡片 + 1px 描边 + 圆角 -->
        <Style x:Key="PclCard" TargetType="Border">
            <Setter Property="Background" Value="{ThemeResource CardBackgroundFillColorDefaultBrush}" />
            <Setter Property="BorderBrush" Value="{ThemeResource CardStrokeColorDefaultBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="8" />
            <Setter Property="Padding" Value="16" />
        </Style>
        <!-- PCL 风格：13px 加粗蓝色小节标题 -->
        <Style x:Key="PclSectionTitle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="13" />
            <Setter Property="FontWeight" Value="Bold" />
            <Setter Property="Foreground" Value="{ThemeResource AccentTextFillColorPrimaryBrush}" />
        </Style>
        <!-- PCL 风格：标签左固定 86px -->
        <Style x:Key="PclLabel" TargetType="TextBlock">
            <Setter Property="Width" Value="86" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>
        <!-- PCL 风格：3px 蓝色左竖线 + 浅色底信息条 -->
        <Style x:Key="PclInfoBar" TargetType="Border">
            <Setter Property="Background" Value="{ThemeResource AccentFillColorTertiaryBrush}" />
            <Setter Property="BorderBrush" Value="{ThemeResource AccentFillColorDefaultBrush}" />
            <Setter Property="BorderThickness" Value="3,0,0,0" />
            <Setter Property="CornerRadius" Value="4" />
            <Setter Property="Padding" Value="10,6" />
        </Style>
    </Page.Resources>

    <Grid MaxWidth="1280" HorizontalAlignment="Stretch" RowSpacing="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- 页头 -->
        <StackPanel Grid.Row="0" Spacing="4">
            <TextBlock Text="设置" FontSize="28" FontWeight="SemiBold" />
            <TextBlock Text="游戏目录、内存、Java、下载与通用选项"
                       Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
        </StackPanel>

        <!-- 主体：左导航 + 右内容 -->
        <Grid Grid.Row="1" ColumnSpacing="16">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="180" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <!-- 左侧分类导航（PCL2 / LauncherX 式） -->
            <Border Grid.Column="0" VerticalAlignment="Stretch"
                    Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                    BorderThickness="1" CornerRadius="8" Padding="8">
                <ListView x:Name="CategoryList" SelectionMode="Single"
                          SelectionChanged="Category_SelectionChanged">
                    <ListView.ItemContainerStyle>
                        <Style TargetType="ListViewItem">
                            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                            <Setter Property="MinHeight" Value="40" />
                            <Setter Property="Padding" Value="0" />
                        </Style>
                    </ListView.ItemContainerStyle>
                    <ListViewItem Tag="game" IsSelected="True">
                        <StackPanel Orientation="Horizontal" Spacing="10" Padding="8,0">
                            <FontIcon Glyph="&#xE7FC;" FontSize="14" />
                            <TextBlock Text="游戏" VerticalAlignment="Center" />
                        </StackPanel>
                    </ListViewItem>
                    <ListViewItem Tag="java">
                        <StackPanel Orientation="Horizontal" Spacing="10" Padding="8,0">
                            <FontIcon Glyph="&#xEA4D;" FontSize="14" />
                            <TextBlock Text="Java" VerticalAlignment="Center" />
                        </StackPanel>
                    </ListViewItem>
                    <ListViewItem Tag="download">
                        <StackPanel Orientation="Horizontal" Spacing="10" Padding="8,0">
                            <FontIcon Glyph="&#xE896;" FontSize="14" />
                            <TextBlock Text="下载与资源" VerticalAlignment="Center" />
                        </StackPanel>
                    </ListViewItem>
                    <ListViewItem Tag="general">
                        <StackPanel Orientation="Horizontal" Spacing="10" Padding="8,0">
                            <FontIcon Glyph="&#xE713;" FontSize="14" />
                            <TextBlock Text="通用" VerticalAlignment="Center" />
                        </StackPanel>
                    </ListViewItem>
                </ListView>
            </Border>

            <!-- 右侧内容 -->
            <Grid Grid.Column="1" RowSpacing="12">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <StackPanel Grid.Row="0" Spacing="8">
                    <InfoBar x:Name="SavedBar" Severity="Success" Title="已保存" IsOpen="False" IsClosable="True" />
                    <InfoBar x:Name="ErrorBar" Severity="Error" IsOpen="False" IsClosable="True" Title="操作失败" />
                </StackPanel>

                <ScrollViewer Grid.Row="1">
                    <StackPanel Spacing="16">

                        <!-- ══ 游戏 ══ -->
                        <StackPanel x:Name="SectionGame" Spacing="16">
                            <Border Style="{StaticResource PclCard}">
                                <StackPanel Spacing="10">
                                    <TextBlock Text="游戏目录" Style="{StaticResource PclSectionTitle}" />
                                    <TextBox x:Name="DotMcBox" PlaceholderText=".minecraft 目录路径" />
                                    <TextBlock Text="版本、资源与库文件将安装到该目录"
                                               FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                </StackPanel>
                            </Border>

                            <Border Style="{StaticResource PclCard}">
                                <StackPanel Spacing="10">
                                    <TextBlock Text="内存分配" Style="{StaticResource PclSectionTitle}" />
                                    <TextBlock Text="最大内存（整数 GB）" FontSize="12" />
                                    <Grid ColumnSpacing="12">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <Slider x:Name="MaxMemorySlider" Grid.Column="0"
                                                Minimum="1" Maximum="16" StepFrequency="1"
                                                SnapsTo="StepValues" TickFrequency="1"
                                                ValueChanged="MaxMemorySlider_ValueChanged" />
                                        <TextBlock x:Name="MaxMemoryText" Grid.Column="1" Width="72"
                                                   VerticalAlignment="Center" TextAlignment="Right"
                                                   FontWeight="SemiBold" />
                                    </Grid>
                                    <TextBlock x:Name="MemoryAutoHint" FontSize="12" TextWrapping="Wrap"
                                               Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                </StackPanel>
                            </Border>

                            <Border Style="{StaticResource PclCard}">
                                <StackPanel Spacing="10">
                                    <TextBlock Text="启动可靠性" Style="{StaticResource PclSectionTitle}" />
                                    <StackPanel Orientation="Horizontal" Spacing="8">
                                        <TextBlock Text="启动失败自动重试一次" Style="{StaticResource PclLabel}" />
                                        <ToggleSwitch x:Name="LaunchAutoRetrySwitch"
                                                      Toggled="LaunchAutoRetrySwitch_Toggled" />
                                    </StackPanel>
                                    <TextBlock Text="游戏启动后 8 秒内异常退出时，自动重试一次（不重复环境体检）。"
                                               FontSize="12" TextWrapping="Wrap"
                                               Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                    <StackPanel Orientation="Horizontal" Spacing="8">
                                        <TextBlock Text="启动页默认展开实时日志" Style="{StaticResource PclLabel}" />
                                        <ToggleSwitch x:Name="ShowGameLogSwitch"
                                                      Toggled="ShowGameLogSwitch_Toggled" />
                                    </StackPanel>
                                    <TextBlock Text="启动时在启动页显示游戏实时输出，便于排查启动问题。"
                                               FontSize="12" TextWrapping="Wrap"
                                               Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                    <TextBlock Text="智能内存推荐" FontSize="12" FontWeight="SemiBold" Margin="0,6,0,0" />
                                    <TextBlock x:Name="MemoryRecommendText" FontSize="12" TextWrapping="Wrap"
                                               Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                    <Button x:Name="ApplyMemoryRecommendBtn" Content="应用为默认最大内存"
                                            Click="ApplyMemoryRecommend_Click" />
                                </StackPanel>
                            </Border>

                            <Border Style="{StaticResource PclCard}">
                                <StackPanel Spacing="10">
                                    <TextBlock Text="默认窗口" Style="{StaticResource PclSectionTitle}" />
                                    <StackPanel Orientation="Horizontal" Spacing="8">
                                        <TextBlock Text="窗口尺寸" Style="{StaticResource PclLabel}" />
                                        <NumberBox x:Name="DefaultWidthBox" Minimum="320" Maximum="7680"
                                                   SpinButtonPlacementMode="Compact" Width="120" />
                                        <TextBlock Text="×" VerticalAlignment="Center" />
                                        <NumberBox x:Name="DefaultHeightBox" Minimum="240" Maximum="4320"
                                                   SpinButtonPlacementMode="Compact" Width="120" />
                                    </StackPanel>
                                    <StackPanel Orientation="Horizontal" Spacing="8">
                                        <TextBlock Text="全屏启动" Style="{StaticResource PclLabel}" />
                                        <ToggleSwitch x:Name="DefaultFullscreenSwitch" />
                                    </StackPanel>
                                </StackPanel>
                            </Border>

                            <Border Style="{StaticResource PclCard}">
                                <StackPanel Spacing="10">
                                    <TextBlock Text="启动参数" Style="{StaticResource PclSectionTitle}" />
                                    <TextBlock Text="额外 JVM 参数（每行一条）" FontSize="12" />
                                    <TextBox x:Name="ExtraJvmArgsBox" AcceptsReturn="True" TextWrapping="Wrap"
                                             Height="72" PlaceholderText="-Xss1M" />
                                    <StackPanel Orientation="Horizontal" Spacing="8">
                                        <TextBlock Text="内置 JVM 参数" Style="{StaticResource PclLabel}" />
                                        <ToggleSwitch x:Name="UseBuiltinJvmSwitch" />
                                        <TextBlock Text="关闭后将不再自动附加官方推荐 JVM 参数"
                                                   FontSize="12" VerticalAlignment="Center"
                                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                    </StackPanel>
                                </StackPanel>
                            </Border>

                            <Border Style="{StaticResource PclCard}">
                                <StackPanel Spacing="10">
                                    <TextBlock Text="全局环境变量" Style="{StaticResource PclSectionTitle}" />
                                    <TextBlock Text="对所有版本生效；版本级同名变量会覆盖此处。"
                                               FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                    <StackPanel x:Name="GlobalEnvPanel" Spacing="8" />
                                    <Button Content="添加环境变量" Click="GlobalEnvAdd_Click" />
                                </StackPanel>
                            </Border>

                            <Border Style="{StaticResource PclCard}">
                                <StackPanel Spacing="10">
                                    <TextBlock Text="版本隔离（默认）" Style="{StaticResource PclSectionTitle}" />
                                    <TextBlock Text="新版本的默认隔离方式。独立目录仅隔离 mods/存档/配置/资源包/光影 5 类内容，库与资源文件仍共享；单个版本可在其详情页覆盖此设置。"
                                               FontSize="12" TextWrapping="Wrap"
                                               Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                    <RadioButtons x:Name="IsolationDefaultRadio"
                                                  AutomationProperties.Name="默认版本隔离方式">
                                        <RadioButton Content="独立目录（推荐）" />
                                        <RadioButton Content="共享目录" />
                                    </RadioButtons>
                                </StackPanel>
                            </Border>
                        </StackPanel>

                        <!-- ══ Java ══ -->
                        <StackPanel x:Name="SectionJava" Spacing="16" Visibility="Collapsed">
                            <Border Style="{StaticResource PclCard}">
                                <StackPanel Spacing="10">
                                    <TextBlock Text="Java 运行时" Style="{StaticResource PclSectionTitle}" />
                                    <RadioButtons x:Name="JavaModeRadio" SelectionChanged="JavaMode_SelectionChanged">
                                        <RadioButton Content="自动选择（按版本推荐）" />
                                        <RadioButton Content="手动指定" />
                                    </RadioButtons>
                                    <Border Style="{StaticResource PclInfoBar}">
                                        <TextBlock x:Name="JavaWillUseText" FontSize="12" TextWrapping="Wrap" />
                                    </Border>
                                    <TextBox x:Name="JavaBox" PlaceholderText="java.exe 完整路径"
                                             TextChanged="JavaBox_TextChanged" />
                                    <StackPanel Orientation="Horizontal" Spacing="8">
                                        <Button Content="检测系统 Java" Click="DetectJava_Click" />
                                        <Button Content="浏览 java.exe…" Click="BrowseJava_Click" />
                                        <Button Content="下载 Java 21（Temurin）" Click="DownloadJava_Click" />
                                        <Button Content="下载 Java 8（Temurin）" Click="DownloadJava8_Click" />
                                    </StackPanel>
                                    <ProgressBar x:Name="JavaProgress" Visibility="Collapsed" />
                                    <TextBlock Text="已检测到的 Java 运行时" FontSize="12"
                                               Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                    <TextBlock x:Name="JavaListText" FontSize="12" TextWrapping="Wrap"
                                               Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                </StackPanel>
                            </Border>
                        </StackPanel>

                        <!-- ══ 下载与资源 ══ -->
                        <StackPanel x:Name="SectionDownload" Spacing="16" Visibility="Collapsed">
                            <Border Style="{StaticResource PclCard}">
                                <StackPanel Spacing="12">
                                    <TextBlock Text="下载" Style="{StaticResource PclSectionTitle}" />
                                    <StackPanel Orientation="Horizontal" Spacing="8">
                                        <TextBlock Text="下载并发数" Style="{StaticResource PclLabel}" />
                                        <NumberBox x:Name="ConcurrencyBox" Minimum="1" Maximum="64"
                                                   SpinButtonPlacementMode="Compact" />
                                    </StackPanel>
                                    <StackPanel Orientation="Horizontal" Spacing="8">
                                        <TextBlock Text="失败重试次数" Style="{StaticResource PclLabel}" />
                                        <NumberBox x:Name="RetriesBox" Minimum="0" Maximum="10"
                                                   SpinButtonPlacementMode="Compact" />
                                    </StackPanel>
                                </StackPanel>
                            </Border>

                            <Border Style="{StaticResource PclCard}">
                                <StackPanel Spacing="12">
                                    <TextBlock Text="资源列表缓存" Style="{StaticResource PclSectionTitle}" />
                                    <Grid ColumnSpacing="12">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Grid.Column="0" Spacing="2" VerticalAlignment="Center">
                                            <TextBlock Text="启用资源列表拉取缓存" />
                                            <TextBlock Text="打开资源页时先用缓存瞬时展示，后台拉到新内容后自动替换。关闭后完全不读不写缓存。"
                                                       FontSize="12" TextWrapping="Wrap"
                                                       Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                        </StackPanel>
                                        <ToggleSwitch x:Name="ResourceCacheSwitch" Grid.Column="1"
                                                      VerticalAlignment="Center"
                                                      AutomationProperties.Name="资源列表缓存开关" />
                                    </Grid>
                                    <Button Content="清空缓存" Click="ClearCache_Click" />
                                </StackPanel>
                            </Border>
                        </StackPanel>

                        <!-- ══ 通用 ══ -->
                        <StackPanel x:Name="SectionGeneral" Spacing="16" Visibility="Collapsed">
                            <Border Style="{StaticResource PclCard}">
                                <StackPanel Spacing="12">
                                    <TextBlock Text="主题外观" Style="{StaticResource PclSectionTitle}" />
                                    <StackPanel Orientation="Horizontal" Spacing="8">
                                        <TextBlock Text="外观" Style="{StaticResource PclLabel}" />
                                        <ComboBox x:Name="ThemeCombo" Width="160" SelectionChanged="Theme_Changed">
                                            <ComboBoxItem Content="跟随系统" Tag="system" />
                                            <ComboBoxItem Content="浅色" Tag="light" />
                                            <ComboBoxItem Content="深色" Tag="dark" />
                                        </ComboBox>
                                    </StackPanel>
                                </StackPanel>
                            </Border>

                            <!-- Nova 游戏内浮窗（设计：nova-overlay-plan.md T6；默认关 = 显式授权） -->
                            <Border Style="{StaticResource PclCard}">
                                <Grid ColumnSpacing="12">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0" Spacing="2" VerticalAlignment="Center">
                                        <TextBlock Text="Nova 游戏内浮窗" FontWeight="SemiBold" />
                                        <TextBlock Text="游戏运行时在屏幕角落显示 Nova 浮窗，Ctrl+N 随时呼出对话；下局游戏启动时生效。"
                                                   FontSize="12" TextWrapping="Wrap"
                                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                    </StackPanel>
                                    <ToggleSwitch x:Name="OverlaySwitch" Grid.Column="1" VerticalAlignment="Center"
                                                  AutomationProperties.Name="Nova 游戏内浮窗开关"
                                                  Toggled="OverlaySwitch_Toggled" />
                                </Grid>
                            </Border>
                        </StackPanel>

                    </StackPanel>
                </ScrollViewer>

                <!-- 固定底部保存 -->
                <Button Grid.Row="2" Content="保存设置" HorizontalAlignment="Right" MinWidth="120"
                        Style="{StaticResource AccentButtonStyle}" Click="Save_Click" />
            </Grid>
        </Grid>
    </Grid>
</Page>
