<?xml version="1.0" encoding="utf-8"?>
<Window
    x:Class="Starcloud.App.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:Starcloud.App.Views"
    xmlns:beh="using:Starcloud.App.Views.Behaviors"
    xmlns:ctrl="using:Starcloud.App.Views.Controls"
    xmlns:loc="using:Starcloud.App.Localization"
    Title="Starcloud Minecraft Launcher">

    <Grid x:Name="RootGrid">
        <Grid.RowDefinitions>
            <RowDefinition Height="48" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Grid.Resources>
            <!-- 自绘窗口按钮（SVG 路径图标）：尺寸与系统 caption 一致（46x48），
                 悬停反馈只由按钮内那层跟手光斑表达（见各按钮的 carrier），模板本身不画底色。 -->
            <!-- caption 按钮的自绘模板：只要"透明底 + 内容"。
                 WinUI 的默认按钮模板在 PointerOver/Pressed 状态下会把模板底色换成主题刷
                 （ButtonBackgroundPointerOver，整块 46×48）。那层跟跟手光斑不是一回事：
                 它不跟光标走、范围是整个按钮，叠在一起就成了大小两层。
                 与其一个个去覆写资源键（实测不可靠），不如换成这个模板——没有底色，就没有可显示的范围。 -->
            <ControlTemplate x:Key="CaptionButtonTemplate" TargetType="Button">
                <Grid Background="Transparent">
                    <VisualStateManager.VisualStateGroups>
                        <VisualStateGroup x:Name="CommonStates">
                            <VisualState x:Name="Normal" />
                            <VisualState x:Name="PointerOver" />
                            <VisualState x:Name="Pressed" />
                            <VisualState x:Name="Disabled">
                                <VisualState.Setters>
                                    <Setter Target="CaptionContent.Opacity" Value="0.4" />
                                </VisualState.Setters>
                            </VisualState>
                        </VisualStateGroup>
                    </VisualStateManager.VisualStateGroups>
                    <ContentPresenter x:Name="CaptionContent"
                                      Content="{TemplateBinding Content}"
                                      ContentTemplate="{TemplateBinding ContentTemplate}"
                                      Padding="{TemplateBinding Padding}"
                                      Foreground="{TemplateBinding Foreground}"
                                      HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                      VerticalAlignment="{TemplateBinding VerticalContentAlignment}" />
                </Grid>
            </ControlTemplate>

            <Style x:Key="CaptionButtonStyle" TargetType="Button">
                <Setter Property="Template" Value="{StaticResource CaptionButtonTemplate}" />
                <Setter Property="Width" Value="46" />
                <Setter Property="Height" Value="48" />
                <Setter Property="MinWidth" Value="0" />
                <Setter Property="MinHeight" Value="0" />
                <Setter Property="Padding" Value="0" />
                <Setter Property="CornerRadius" Value="8" />
                <Setter Property="BorderThickness" Value="0" />
                <Setter Property="Background" Value="Transparent" />
                <Setter Property="Foreground" Value="{ThemeResource TextFillColorPrimaryBrush}" />
                <Setter Property="HorizontalContentAlignment" Value="Center" />
                <Setter Property="VerticalContentAlignment" Value="Center" />
            </Style>
        </Grid.Resources>

        <!-- 自定义背景（D1）：亚克力之下、内容之上的三层——清晰图 / 模糊层 / 毛玻璃遮罩 -->
        <Grid x:Name="BackgroundLayer" Grid.RowSpan="2"
              IsHitTestVisible="False" Visibility="Collapsed">
            <Image x:Name="BackgroundImage" Stretch="UniformToFill" Opacity="0.7" />
            <Border x:Name="BackgroundBlurHost" />
            <Border x:Name="BackgroundMask" />
        </Grid>

        <!-- 标题栏：品牌左 + 系统按钮右（ExtendsContentIntoTitleBar）；不透明实色，不透视背景 -->
        <Grid x:Name="AppTitleBar" Grid.Row="0" Background="{ThemeResource AppPaneBackgroundBrush}">
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="16,0,0,0" Spacing="10">
                <!-- 品牌标记：浅底/深底两份主标记按主题自动换源 -->
                <ctrl:BrandMark Width="22" Height="22" VerticalAlignment="Center" />
                <TextBlock Text="Starcloud" FontWeight="Medium" FontSize="14"
                           VerticalAlignment="Center" />
                <!-- 开发版标识：启动器自身版本号（读 csproj <Version>，见 MainWindow.xaml.cs） -->
                <Border CornerRadius="6" Padding="6,2" VerticalAlignment="Center"
                        Background="{ThemeResource ControlFillColorSecondaryBrush}">
                    <TextBlock x:Name="VersionBadgeText" FontSize="11"
                               Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                               VerticalAlignment="Center" />
                </Border>
            </StackPanel>
        </Grid>

        <!-- 顶栏右侧：NovaOrb（点击展开面板）+ 个人中心入口 + 自绘窗口按钮（关闭/最大化/最小化） -->
        <StackPanel Orientation="Horizontal" Spacing="0"
                    Grid.Row="0" HorizontalAlignment="Right" VerticalAlignment="Stretch">
            <Button x:Name="NovaOrb" Width="44" Height="36" VerticalAlignment="Center" Margin="0,0,6,0"
                     Padding="0" CornerRadius="8"
                     Background="Transparent" BorderThickness="0"
                    beh:HoverShadowBehavior.IsEnabled="True"
                    beh:HoverShadowBehavior.GlowRadius="16"
                    beh:HoverShadowBehavior.Carrier="{Binding ElementName=NovaShadow}"
                     loc:Loc.Name="Nova 助手"
                    loc:Loc.Tip="Nova：待命"
                    Click="NovaOrb_Click">
                <Grid Width="32" Height="32">
                    <Border x:Name="NovaOrbRing" CornerRadius="8"
                            Background="{ThemeResource GlassCardBrush}"
                            BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                            BorderThickness="1" />
                    <!-- 内阴影层：卡片内部自上而下渐深的半透明覆盖，悬停时渐显（读作"按下/凹陷"）。
                         底色按主题由 HoverShadowBehavior 重写；这几档是"加强档"（约卡片档的 1.55×），
                         小圆块上才看得见。 -->
                    <Border x:Name="NovaShadow" CornerRadius="8"
                            Opacity="0" IsHitTestVisible="False">
                        <Border.Background>
                            <RadialGradientBrush Center="0.5,0.5" GradientOrigin="0.5,0.5" RadiusX="0.9" RadiusY="0.9">
                                <GradientStop Color="#3E000000" Offset="0" />
                                <GradientStop Color="#30000000" Offset="0.18" />
                                <GradientStop Color="#22000000" Offset="0.40" />
                                <GradientStop Color="#14000000" Offset="0.62" />
                                <GradientStop Color="#08000000" Offset="0.82" />
                                <GradientStop Color="#00000000" Offset="1" />
                            </RadialGradientBrush>
                        </Border.Background>
                    </Border>
                    <!-- Nova 图标 = 品牌标记（小尺寸版）。多色标记没法用字形，所以五态着色
                         改画在外圈描边上（见 MainWindow.xaml.cs 的 ApplyNovaState）。 -->
                    <ctrl:BrandMark Small="True" Width="15" Height="15"
                                     HorizontalAlignment="Center" VerticalAlignment="Center" />
                    <!-- 有提案：右上角 amber 小圆点 -->
                    <Ellipse x:Name="NovaOrbDot" Width="8" Height="8" Fill="#F59E0B"
                             HorizontalAlignment="Right" VerticalAlignment="Top"
                             Margin="0,3,3,0" Visibility="Collapsed" />
                </Grid>
            </Button>

            <!-- 调度中心入口：原 Starcloud ID 账户按钮旁，徽标 = 运行中任务数 -->
              <Button x:Name="TaskCenterBtn" Width="44" Height="36" VerticalAlignment="Center" Margin="0,0,6,0"
                      Padding="0" CornerRadius="8"
                      Background="Transparent" BorderThickness="0"
                     beh:HoverShadowBehavior.IsEnabled="True"
                     beh:HoverShadowBehavior.GlowRadius="16"
                     beh:HoverShadowBehavior.Carrier="{Binding ElementName=TaskCenterShadow}"
                      loc:Loc.Name="调度中心" loc:Loc.Tip="调度中心"
                     Click="TaskCenterBtn_Click">
                <Grid Width="32" Height="32">
                    <Border CornerRadius="8"
                            Background="{ThemeResource GlassCardBrush}"
                            BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                            BorderThickness="1" />
                    <!-- 内阴影层：卡片内部自上而下渐深的半透明覆盖，悬停时渐显（加强档） -->
                    <Border x:Name="TaskCenterShadow" CornerRadius="8"
                            Opacity="0" IsHitTestVisible="False">
                        <Border.Background>
                            <RadialGradientBrush Center="0.5,0.5" GradientOrigin="0.5,0.5" RadiusX="0.9" RadiusY="0.9">
                                <GradientStop Color="#3E000000" Offset="0" />
                                <GradientStop Color="#30000000" Offset="0.18" />
                                <GradientStop Color="#22000000" Offset="0.40" />
                                <GradientStop Color="#14000000" Offset="0.62" />
                                <GradientStop Color="#08000000" Offset="0.82" />
                                <GradientStop Color="#00000000" Offset="1" />
                            </RadialGradientBrush>
                        </Border.Background>
                    </Border>
                    <!-- ic_message_allread（消息已读）：一个「已处理」的意象，比计时器更贴任务列表 -->
                    <FontIcon FontFamily="{StaticResource ScIconFont}" Glyph="&#xEC89;" FontSize="14"
                              Foreground="{ThemeResource TextFillColorPrimaryBrush}" />
                    <!-- 徽标走主题强调色（暗色主题为品牌绿），accent 面上强制黑字加粗 -->
                    <Border x:Name="TaskBadge" Background="{ThemeResource AccentFillColorDefaultBrush}"
                            CornerRadius="7" MinWidth="15" Height="15"
                            HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,-2,-3,0"
                            Padding="3,0" Visibility="Collapsed">
                        <TextBlock x:Name="TaskBadgeText" FontSize="9" FontWeight="Medium"
                                   Foreground="{ThemeResource TextOnAccentFillColorPrimaryBrush}"
                                   HorizontalAlignment="Center" />
                    </Border>
                </Grid>
            </Button>

            <Button x:Name="AccountButton" Width="44" Height="36" VerticalAlignment="Center" Margin="0,0,8,0"
                    Padding="0" CornerRadius="8"
                    Background="Transparent" BorderThickness="0"
                   beh:HoverShadowBehavior.IsEnabled="True"
                   beh:HoverShadowBehavior.GlowRadius="16"
                   beh:HoverShadowBehavior.Carrier="{Binding ElementName=AccountShadow}"
                    loc:Loc.Name="个人中心"
                    loc:Loc.Tip="个人中心"
                    Click="AccountButton_Click">
                <Grid Width="32" Height="32">
                    <Ellipse Fill="{ThemeResource CardBackgroundFillColorSecondaryBrush}" />
                    <!-- 内阴影层：头像内部的渐深覆盖，悬停时渐显（加强档）。
                         圆角取 16 = 32×32 的半边长，等价于原先那个 Ellipse 的圆形轮廓。 -->
                    <Border x:Name="AccountShadow" CornerRadius="16"
                            Opacity="0" IsHitTestVisible="False">
                        <Border.Background>
                            <RadialGradientBrush Center="0.5,0.5" GradientOrigin="0.5,0.5" RadiusX="0.9" RadiusY="0.9">
                                <GradientStop Color="#3E000000" Offset="0" />
                                <GradientStop Color="#30000000" Offset="0.18" />
                                <GradientStop Color="#22000000" Offset="0.40" />
                                <GradientStop Color="#14000000" Offset="0.62" />
                                <GradientStop Color="#08000000" Offset="0.82" />
                                <GradientStop Color="#00000000" Offset="1" />
                            </RadialGradientBrush>
                        </Border.Background>
                    </Border>
                    <TextBlock x:Name="AccountAvatarText" FontSize="13" FontWeight="Medium"
                               HorizontalAlignment="Center" VerticalAlignment="Center" />
                    <FontIcon FontFamily="{StaticResource ScIconFont}" x:Name="AccountAvatarGlyph" Glyph="&#xEB8F;" FontSize="15"
                              Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                </Grid>
            </Button>

            <!-- 窗口按钮：系统 caption 已隐藏（见 MainWindow.xaml.cs），图标为内联 SVG 路径。
                 几何体必须内联在 PathIcon.Data 里——放在 ResourceDictionary 再 StaticResource
                 引用会在运行期抛 XamlParseException（Failed to assign to property 'PathIcon.Data'）。 -->
            <Button x:Name="MinimizeButton" Style="{StaticResource CaptionButtonStyle}"
                    loc:Loc.Name="最小化" loc:Loc.Tip="最小化" Click="MinimizeButton_Click"
                    beh:HoverShadowBehavior.IsEnabled="True"
                    beh:HoverShadowBehavior.GlowRadius="40"
                    beh:HoverShadowBehavior.TriggerInset="6"
                    beh:HoverShadowBehavior.Carrier="{Binding ElementName=MinimizeShadow}">
                <!-- 三层数字各管一件事：
                     ① 点击热区 = 按钮本体 46×48（CaptionButtonStyle 的 Width/Height）；
                     ② 点亮范围 = 热区四边各内收 TriggerInset=6 → 34×36，光标进到中间才亮；
                     ③ 亮起来的形状 = 40×40 的圆角方块（CornerRadius=8，同全站图标块的语言）。
                        半径必须大于方形半对角线（28.3），否则渐变在四个角之前就淡到 0，
                        视觉上只剩一个内切圆——GlowRadius=40 就是为了让四个角也被染到。 -->
                <Grid>
                    <Border x:Name="MinimizeShadow" Width="40" Height="40" CornerRadius="8"
                            HorizontalAlignment="Center" VerticalAlignment="Center"
                            Opacity="0" IsHitTestVisible="False">
                        <Border.Background>
                            <RadialGradientBrush Center="0.5,0.5" GradientOrigin="0.5,0.5" RadiusX="0.9" RadiusY="0.9">
                                <GradientStop Color="#3E000000" Offset="0" />
                                <GradientStop Color="#30000000" Offset="0.18" />
                                <GradientStop Color="#22000000" Offset="0.40" />
                                <GradientStop Color="#14000000" Offset="0.62" />
                                <GradientStop Color="#08000000" Offset="0.82" />
                                <GradientStop Color="#00000000" Offset="1" />
                            </RadialGradientBrush>
                        </Border.Background>
                    </Border>
                    <PathIcon Width="10" Height="10">
                        <PathIcon.Data>
                            <PathGeometry>
                                <PathFigure StartPoint="0,4.5" IsClosed="True">
                                    <LineSegment Point="10,4.5" />
                                    <LineSegment Point="10,5.5" />
                                    <LineSegment Point="0,5.5" />
                                </PathFigure>
                            </PathGeometry>
                        </PathIcon.Data>
                    </PathIcon>
                </Grid>
            </Button>
            <Button x:Name="MaximizeButton" Style="{StaticResource CaptionButtonStyle}"
                    loc:Loc.Name="最大化" loc:Loc.Tip="最大化" Click="MaximizeButton_Click"
                    beh:HoverShadowBehavior.IsEnabled="True"
                    beh:HoverShadowBehavior.GlowRadius="40"
                    beh:HoverShadowBehavior.TriggerInset="6"
                    beh:HoverShadowBehavior.Carrier="{Binding ElementName=MaximizeShadow}">
                <!-- 同最小化键：热区 46×48 / 点亮区 34×36 / 光斑载体 40×40 圆角方块（圆角 8） -->
                <Grid>
                    <Border x:Name="MaximizeShadow" Width="40" Height="40" CornerRadius="8"
                            HorizontalAlignment="Center" VerticalAlignment="Center"
                            Opacity="0" IsHitTestVisible="False">
                        <Border.Background>
                            <RadialGradientBrush Center="0.5,0.5" GradientOrigin="0.5,0.5" RadiusX="0.9" RadiusY="0.9">
                                <GradientStop Color="#3E000000" Offset="0" />
                                <GradientStop Color="#30000000" Offset="0.18" />
                                <GradientStop Color="#22000000" Offset="0.40" />
                                <GradientStop Color="#14000000" Offset="0.62" />
                                <GradientStop Color="#08000000" Offset="0.82" />
                                <GradientStop Color="#00000000" Offset="1" />
                            </RadialGradientBrush>
                        </Border.Background>
                    </Border>
                    <!-- 最大化 / 还原两个图标叠放，按窗口状态切显隐（见 UpdateMaximizeGlyph） -->
                    <Grid Width="10" Height="10">
                    <PathIcon x:Name="MaximizeIcon" Width="10" Height="10">
                        <PathIcon.Data>
                            <PathGeometry>
                                <PathFigure StartPoint="0,0" IsClosed="True">
                                    <LineSegment Point="10,0" />
                                    <LineSegment Point="10,10" />
                                    <LineSegment Point="0,10" />
                                </PathFigure>
                                <PathFigure StartPoint="1,1" IsClosed="True">
                                    <LineSegment Point="9,1" />
                                    <LineSegment Point="9,9" />
                                    <LineSegment Point="1,9" />
                                </PathFigure>
                            </PathGeometry>
                        </PathIcon.Data>
                    </PathIcon>
                    <PathIcon x:Name="RestoreIcon" Width="10" Height="10" Visibility="Collapsed">
                        <PathIcon.Data>
                            <PathGeometry>
                                <!-- 右上角窗口的左上露角 -->
                                <PathFigure StartPoint="2,0" IsClosed="True">
                                    <LineSegment Point="10,0" />
                                    <LineSegment Point="10,8" />
                                    <LineSegment Point="9,8" />
                                    <LineSegment Point="9,1" />
                                    <LineSegment Point="2,1" />
                                </PathFigure>
                                <!-- 左下角窗口（外框 + 内框挖空） -->
                                <PathFigure StartPoint="0,2" IsClosed="True">
                                    <LineSegment Point="8,2" />
                                    <LineSegment Point="8,10" />
                                    <LineSegment Point="0,10" />
                                </PathFigure>
                                <PathFigure StartPoint="1,3" IsClosed="True">
                                    <LineSegment Point="7,3" />
                                    <LineSegment Point="7,9" />
                                    <LineSegment Point="1,9" />
                                </PathFigure>
                            </PathGeometry>
                        </PathIcon.Data>
                    </PathIcon>
                    </Grid>
                </Grid>
            </Button>
            <Button x:Name="CloseButton" Style="{StaticResource CaptionButtonStyle}"
                    loc:Loc.Name="关闭" loc:Loc.Tip="关闭" Click="CloseButton_Click"
                    beh:HoverShadowBehavior.IsEnabled="True"
                    beh:HoverShadowBehavior.GlowRadius="40"
                    beh:HoverShadowBehavior.TriggerInset="6"
                    beh:HoverShadowBehavior.Carrier="{Binding ElementName=CloseShadow}">
                <Grid>
                    <!-- 同最小化键：热区 46×48 / 点亮区 34×36 / 光斑载体 40×40 圆角方块（圆角 8） -->
                    <Border x:Name="CloseShadow" Width="40" Height="40" CornerRadius="8"
                            HorizontalAlignment="Center" VerticalAlignment="Center"
                            Opacity="0" IsHitTestVisible="False">
                        <Border.Background>
                            <RadialGradientBrush Center="0.5,0.5" GradientOrigin="0.5,0.5" RadiusX="0.9" RadiusY="0.9">
                                <GradientStop Color="#3E000000" Offset="0" />
                                <GradientStop Color="#30000000" Offset="0.18" />
                                <GradientStop Color="#22000000" Offset="0.40" />
                                <GradientStop Color="#14000000" Offset="0.62" />
                                <GradientStop Color="#08000000" Offset="0.82" />
                                <GradientStop Color="#00000000" Offset="1" />
                            </RadialGradientBrush>
                        </Border.Background>
                    </Border>
                    <PathIcon Width="10" Height="10">
                        <PathIcon.Data>
                            <PathGeometry>
                                <PathFigure StartPoint="0,0" IsClosed="True">
                                    <LineSegment Point="1.2,0" />
                                    <LineSegment Point="10,8.8" />
                                    <LineSegment Point="10,10" />
                                    <LineSegment Point="8.8,10" />
                                    <LineSegment Point="0,1.2" />
                                </PathFigure>
                                <PathFigure StartPoint="8.8,0" IsClosed="True">
                                    <LineSegment Point="10,0" />
                                    <LineSegment Point="10,1.2" />
                                    <LineSegment Point="1.2,10" />
                                    <LineSegment Point="0,10" />
                                    <LineSegment Point="0,8.8" />
                                </PathFigure>
                            </PathGeometry>
                        </PathIcon.Data>
                    </PathIcon>
                </Grid>
            </Button>
        </StackPanel>

        <NavigationView
            x:Name="Nav"
            Grid.Row="1"
            PaneDisplayMode="LeftCompact"
            IsPaneOpen="False"
            OpenPaneLength="232"
            IsBackButtonVisible="Collapsed"
            IsSettingsVisible="False"
            IsTitleBarAutoPaddingEnabled="False"
            FontFamily="{StaticResource ScUiFontFamily}"
            FontWeight="Medium"
            SelectionChanged="Nav_SelectionChanged">
            <!-- 左侧导航栏底色：模板里 RootSplitView 用 {ThemeResource NavigationViewDefaultPaneBackground}
                 / NavigationViewExpandedPaneBackground 取色，这两个 key 由框架主题字典定义且优先级高于
                 应用级 ThemeDictionaries，只能在控件级资源里覆盖（否则侧栏仍透出亚克力）。
                 取值与 App.xaml 的 AppPaneBackgroundBrush 一致：浅色 #F6F6F6，深色 #161616。
                 注意：内容区 NavigationViewContentBackground 保持框架默认（LayerFillColorDefaultBrush，半透明），
                 让窗口的亚克力毛玻璃能从内容区透出来；一旦把它刷成不透明实色，整窗毛玻璃就没了。 -->
            <NavigationView.Resources>
                <ResourceDictionary>
                    <ResourceDictionary.ThemeDictionaries>
                        <ResourceDictionary x:Key="Light">
                            <SolidColorBrush x:Key="NavigationViewDefaultPaneBackground" Color="#FFF6F6F6" />
                            <SolidColorBrush x:Key="NavigationViewExpandedPaneBackground" Color="#FFF6F6F6" />
                        </ResourceDictionary>
                        <ResourceDictionary x:Key="Dark">
                            <SolidColorBrush x:Key="NavigationViewDefaultPaneBackground" Color="#FF161616" />
                            <SolidColorBrush x:Key="NavigationViewExpandedPaneBackground" Color="#FF161616" />
                        </ResourceDictionary>
                    </ResourceDictionary.ThemeDictionaries>

                    <!-- 去掉模板自带的 1px 描边：它们用深色 Separator/Stroke 画色，
                         在标题栏 / 侧栏 / 内容区交界处看起来就是一条条黑色拼接缝。
                         ① RootSplitView 的四边描边（NavigationViewBorderThickness 默认 1）；
                         ② ContentGrid 的上/左两道描边（默认 1,1,0,0）。 -->
                    <Thickness x:Key="NavigationViewBorderThickness">0</Thickness>
                    <Thickness x:Key="NavigationViewContentGridBorderThickness">0</Thickness>
                    <SolidColorBrush x:Key="NavigationViewContentGridBorderBrush" Color="Transparent" />
                    <!-- 内容区左上角默认有 8px 圆角（露出圆角外的亚克力），拉平以贴齐边框 -->
                    <CornerRadius x:Key="NavigationViewContentGridCornerRadius">0</CornerRadius>
                </ResourceDictionary>
            </NavigationView.Resources>
            <NavigationView.MenuItems>
                <!-- 分组排列：游戏（首页/版本/下载/存档）→ 分隔线 → 个人与扩展（账户/插件/Nova）；
                     设置与日志固定在底部 FooterMenuItems（设置全导航最底） -->
                <NavigationViewItem loc:Loc.Text="首页" Tag="home">
                    <NavigationViewItem.Icon>
                        <!-- 原先用 Icon="Home"（SymbolIcon → Segoe 字形），为了整条导航同一套图标改用图标库字形 -->
                        <FontIcon FontFamily="{StaticResource ScIconFont}" Glyph="&#xEC77;" />
                    </NavigationViewItem.Icon>
                </NavigationViewItem>
                <NavigationViewItem loc:Loc.Text="版本" Tag="versions">
                    <NavigationViewItem.Icon>
                        <FontIcon FontFamily="{StaticResource ScIconFont}" Glyph="&#xEA94;" />
                    </NavigationViewItem.Icon>
                </NavigationViewItem>
                <NavigationViewItem loc:Loc.Text="下载" Tag="download">
                    <NavigationViewItem.Icon>
                        <FontIcon FontFamily="{StaticResource ScIconFont}" Glyph="&#xE90C;" />
                    </NavigationViewItem.Icon>
                </NavigationViewItem>
                <NavigationViewItem loc:Loc.Text="存档" Tag="saves">
                    <NavigationViewItem.Icon>
                        <FontIcon FontFamily="{StaticResource ScIconFont}" Glyph="&#xEA90;" />
                    </NavigationViewItem.Icon>
                </NavigationViewItem>
                <NavigationViewItem loc:Loc.Text="联机" Tag="multiplayer">
                    <NavigationViewItem.Icon>
                        <FontIcon FontFamily="{StaticResource ScIconFont}" Glyph="&#xEB91;" />
                    </NavigationViewItem.Icon>
                </NavigationViewItem>
                <!-- 运行状态：Content 换成横排（文案 + 运行中圆点），故不能在条目上用 loc:Loc.Text
                     （ContentControl 分支会把 Content 整个覆盖掉），文案落在内部 TextBlock 上 -->
                <!-- SC 实验室：投影工坊 / 彩色文字 / 世吞生成器 / 指令助手（内置工具箱） -->
                <NavigationViewItem loc:Loc.Text="实验室" Tag="lab">
                    <NavigationViewItem.Icon>
                        <ImageIcon x:Name="LabNavIcon" Source="ms-appx:///Assets/Brand/lab-nav.svg" />
                    </NavigationViewItem.Icon>
                </NavigationViewItem>
                <!-- 投影管理：扫描全局/各实例 schematics，跨版本复制（内核插件 starcloud.projections 提供能力） -->
                <NavigationViewItem loc:Loc.Text="投影管理" Tag="projections">
                    <NavigationViewItem.Icon>
                        <ImageIcon x:Name="ProjectionNavIcon" Source="ms-appx:///Assets/Brand/projection-nav.svg" />
                    </NavigationViewItem.Icon>
                </NavigationViewItem>
                <NavigationViewItem Tag="running" loc:Loc.Name="运行状态">
                    <NavigationViewItem.Icon>
                        <FontIcon FontFamily="{StaticResource ScIconFont}" Glyph="&#xEC3B;" />
                    </NavigationViewItem.Icon>
                    <NavigationViewItem.Content>
                        <StackPanel Orientation="Horizontal">
                            <TextBlock loc:Loc.Text="运行状态" VerticalAlignment="Center" />
                            <Ellipse x:Name="RunningDot" Width="6" Height="6" Margin="8,0,0,0"
                                     VerticalAlignment="Center" Visibility="Collapsed"
                                     Fill="{ThemeResource SystemFillColorSuccessBrush}" />
                        </StackPanel>
                    </NavigationViewItem.Content>
                </NavigationViewItem>
                <NavigationViewItemSeparator />
                <NavigationViewItem loc:Loc.Text="账户" Tag="accounts">
                    <NavigationViewItem.Icon>
                        <FontIcon FontFamily="{StaticResource ScIconFont}" Glyph="&#xEB8F;" />
                    </NavigationViewItem.Icon>
                </NavigationViewItem>
                <NavigationViewItem loc:Loc.Text="插件" Tag="plugins">
                    <NavigationViewItem.Icon>
                        <FontIcon FontFamily="{StaticResource ScIconFont}" Glyph="&#xEABC;" />
                    </NavigationViewItem.Icon>
                </NavigationViewItem>
                <NavigationViewItem Content="Nova" Tag="ai">
                    <NavigationViewItem.Icon>
                        <!-- Nova = 品牌标记：IconElement 位只能用图片图标 -->
                        <ImageIcon Source="{StaticResource NovaMarkSmall}" />
                    </NavigationViewItem.Icon>
                </NavigationViewItem>
            </NavigationView.MenuItems>
            <NavigationView.FooterMenuItems>
                <NavigationViewItem loc:Loc.Text="启动器日志" Tag="logs">
                    <NavigationViewItem.Icon>
                        <FontIcon FontFamily="{StaticResource ScIconFont}" Glyph="&#xEC64;" />
                    </NavigationViewItem.Icon>
                </NavigationViewItem>
                <NavigationViewItem loc:Loc.Text="设置" Tag="settings">
                    <NavigationViewItem.Icon>
                        <FontIcon FontFamily="{StaticResource ScIconFont}" Glyph="&#xEC04;" />
                    </NavigationViewItem.Icon>
                </NavigationViewItem>
            </NavigationView.FooterMenuItems>

            <!-- 内容区留白：四边等边（左右上下统一 24），标题栏底到内容上沿不再比其它三边窄 -->
            <Grid Padding="24">
                <Frame x:Name="ContentFrame" Background="Transparent" />
            </Grid>
        </NavigationView>

        <!-- 调度中心（右侧任务抽屉）：左遮罩（点击关闭）+ 432px 面板。
             结构 = 标题行（标题 / 关闭）→ 状态行 → 两段：调度队列（正在跑的任务）+ 历史通知（时间流水）。
             任务结束不留在队列里，而是落成一条带时间的通知。
             Esc 走 KeyboardAccelerator（不依赖焦点）；Tab 由 TabFocusNavigation="Cycle" 锁在抽屉内；
             入场动效由 MotionService 开关控制（关闭动效时不加任何转场）。 -->
        <!-- KeyboardAcceleratorPlacementMode="Hidden"：加速键照常生效，但不渲染顶部的「Esc」键位提示徽标 -->
        <Grid x:Name="TaskCenterOverlay" Grid.Row="1" Visibility="Collapsed"
              KeyboardAcceleratorPlacementMode="Hidden">
            <Grid.KeyboardAccelerators>
                <KeyboardAccelerator Key="Escape" Invoked="TaskCenterEscape_Invoked" />
            </Grid.KeyboardAccelerators>
            <Rectangle x:Name="TaskCenterScrim" Fill="#5A000000"
                       Tapped="TaskCenterScrim_Tapped" />
            <Border x:Name="TaskCenterDrawer" Width="600" HorizontalAlignment="Right"
                    Background="{ThemeResource AppPaneBackgroundBrush}"
                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                    BorderThickness="1,0,0,0">
                <Grid Margin="20,16,14,12" RowSpacing="10" TabFocusNavigation="Cycle">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <!-- 标题行 -->
                    <Grid Grid.Row="0" ColumnSpacing="10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Orientation="Horizontal" Spacing="9" VerticalAlignment="Center">
                            <FontIcon FontFamily="{StaticResource ScIconFont}" Glyph="&#xEC89;" FontSize="15"
                                      Foreground="{ThemeResource AccentFillColorDefaultBrush}" />
                            <TextBlock loc:Loc.Text="调度中心" FontSize="17" FontWeight="Medium"
                                       VerticalAlignment="Center" />
                        </StackPanel>
                        <ctrl:GlowButton x:Name="TaskCenterCloseBtn" Grid.Column="1"
                                         Padding="8" MinWidth="0" MinHeight="0" VerticalAlignment="Center"
                                         Background="Transparent" BorderThickness="0"
                                         loc:Loc.Name="关闭" Click="TaskCenterClose_Click">
                            <FontIcon FontFamily="{StaticResource ScIconFont}" Glyph="&#xEA86;" FontSize="13"
                                      Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                        </ctrl:GlowButton>
                    </Grid>

                    <!-- 状态行：进行中任务数 / 记录条数 -->
                    <TextBlock Grid.Row="1" x:Name="TaskSummaryText" FontSize="11"
                               Margin="2,-6,0,0" TextWrapping="NoWrap"
                               Foreground="{ThemeResource TextFillColorSecondaryBrush}" />

                    <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto"
                                  Padding="0,0,6,0" loc:Loc.Name="任务列表">
                        <StackPanel>
                            <!-- 调度队列：正在执行的任务卡（进度 / 速度 / 多源贡献带） -->
                            <TextBlock loc:Loc.Text="调度队列" FontSize="14" FontWeight="Medium"
                                       Margin="2,0,0,8" />
                            <StackPanel x:Name="TaskRunningHost" Spacing="2" />

                            <!-- 队列为空：极简空态（图标 + 无） -->
                            <StackPanel x:Name="QueueEmptyHost" Spacing="8" Margin="0,30,0,26">
                                <FontIcon FontFamily="{StaticResource ScIconFont}" Glyph="&#xEC70;" FontSize="22" HorizontalAlignment="Center"
                                          Foreground="{ThemeResource TextFillColorTertiaryBrush}" />
                                <TextBlock loc:Loc.Text="无" FontSize="13" HorizontalAlignment="Center"
                                           Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                            </StackPanel>

                            <!-- 历史通知：任务收尾与启动器提示的时间流水 -->
                            <Grid Margin="2,20,0,8">
                                <TextBlock loc:Loc.Text="历史通知" FontSize="14" FontWeight="Medium"
                                           VerticalAlignment="Center" />
                                <ctrl:GlowButton x:Name="NoticeClearBtn" HorizontalAlignment="Right"
                                                 Visibility="Collapsed" loc:Loc.Text="清空通知"
                                                 FontSize="12" Padding="8,2" MinWidth="0" MinHeight="0"
                                                 VerticalAlignment="Center"
                                                 Background="Transparent" BorderThickness="0"
                                                 Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                                 Click="NoticeClear_Click" />
                            </Grid>
                            <StackPanel x:Name="NoticeHost" Spacing="7" />
                        </StackPanel>
                    </ScrollViewer>
                </Grid>
            </Border>
        </Grid>

        <!-- 状态栏（实例指示）已移除：底部不再有「未选择实例」条 -->

        <!-- ① Nova 面板（顶栏 NovaOrb 下方弹出，440px 毛玻璃）。
             注意：不要设 ShouldConstrainToRootBounds=False —— 那会命中 WinUI 的 IME bug（中文只出拼音字母），
             面板因此保持「限制在窗口内」。 -->
        <Popup x:Name="NovaPopup" IsLightDismissEnabled="True" AllowFocusOnInteraction="True">
            <Border x:Name="NovaPanelHost" Width="440" CornerRadius="20" Padding="16"
                    Background="{ThemeResource SolidBackgroundFillColorBaseBrush}"
                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                    BorderThickness="1">
                <Grid RowSpacing="10">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <!-- 标头：头像 + 名字 + 副标题 + 去 Nova 页 -->
                    <Grid Grid.Row="0" ColumnSpacing="10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <Border Grid.Column="0" Width="32" Height="32" CornerRadius="8"
                                Background="{ThemeResource LayerFillColorDefaultBrush}"
                                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                BorderThickness="1">
                            <!-- Nova 图标 = 品牌标记（多色，字形画不出来） -->
                            <ctrl:BrandMark Small="True" Width="15" Height="15"
                                             HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="1">
                            <TextBlock Text="Nova" FontWeight="Medium" FontSize="14" />
                            <!-- 云端额度：登录后常驻一行，用户不用翻设置页也知道还能用多少 -->
                            <TextBlock x:Name="NovaPanelQuota" FontSize="11" Visibility="Collapsed"
                                       TextTrimming="CharacterEllipsis"
                                       Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                        </StackPanel>
                        <ctrl:GlowButton Grid.Column="2" Padding="6,2" MinWidth="0" VerticalAlignment="Center"
                                         Background="Transparent" BorderThickness="0"
                                         loc:Loc.Name="打开 Nova 页"
                                         loc:Loc.Tip="打开 Nova 页（许可层 / 操作日志 / LLM 设置）"
                                         Click="NovaPanelSettings_Click">
                            <FontIcon FontFamily="{StaticResource ScIconFont}" Glyph="&#xEC04;" FontSize="13"
                                      Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                        </ctrl:GlowButton>
                    </Grid>

                    <!-- 未登录：引导去 Nova 页登录 -->
                    <StackPanel Grid.Row="1" x:Name="NovaPanelLogin" Spacing="10"
                                VerticalAlignment="Center" Visibility="Collapsed">
                        <TextBlock loc:Loc.Text="Nova 尚未登录" FontWeight="Medium" />
                        <TextBlock loc:Loc.Text="登录 Starcloud ID 后可使用云端模型，以及邀请、时刻等在线能力；凭据只保存在本机。"
                                   FontSize="12" TextWrapping="Wrap"
                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                        <Button Style="{StaticResource ScAccentButtonStyle}" loc:Loc.Text="去 Nova 页登录"
                                Click="NovaPanelLogin_Click" />
                    </StackPanel>

                    <!-- 已登录：对话（复用 NovaChatView） -->
                    <ctrl:NovaChatView Grid.Row="1" x:Name="NovaPanelChat" />
                </Grid>
            </Border>
        </Popup>

        <!-- 浮窗提醒：替代原状态栏 Nova 指示 -->
        <TeachingTip x:Name="NovaToastTip" Grid.Row="0" IsOpen="False"
                     PreferredPlacement="Bottom" IsLightDismissEnabled="True" Title="Nova" />

        <!-- 插件通知（launcher:notification）：右下角自动收起的信息条 -->
        <InfoBar x:Name="PluginNotifyTip" Grid.Row="0" IsOpen="False" IsClosable="True"
                 Severity="Informational" HorizontalAlignment="Right" VerticalAlignment="Bottom"
                 Margin="0,0,24,24" MaxWidth="420" />

        <!-- 设备上下线横幅（跨设备互联的"活"信号）：右上角滑入，3 秒后滑出；点击直达设备页。
             进出场走合成层平移+淡入（MotionFx），动效关闭时直接落位。 -->
        <Border x:Name="DeviceBanner" Grid.RowSpan="2" HorizontalAlignment="Right" VerticalAlignment="Top"
                Margin="0,56,16,0" Padding="14,10" CornerRadius="12"
                Background="{ThemeResource GlassCardBrush}"
                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                BorderThickness="1" Visibility="Collapsed" IsHitTestVisible="True"
                Tapped="DeviceBanner_Tapped">
            <StackPanel Orientation="Horizontal" Spacing="10">
                <Ellipse x:Name="DeviceBannerDot" Width="8" Height="8" VerticalAlignment="Center"
                         Fill="{ThemeResource SystemFillColorSuccessBrush}" />
                <TextBlock x:Name="DeviceBannerText" FontSize="13" VerticalAlignment="Center" />
            </StackPanel>
        </Border>
    </Grid>
</Window>
