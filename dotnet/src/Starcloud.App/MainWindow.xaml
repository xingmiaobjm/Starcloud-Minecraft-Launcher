<?xml version="1.0" encoding="utf-8"?>
<Window
    x:Class="Starcloud.App.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:Starcloud.App.Views"
    xmlns:loc="using:Starcloud.App.Localization"
    Title="Starcloud Minecraft Launcher">

    <Grid x:Name="RootGrid">
        <Grid.RowDefinitions>
            <RowDefinition Height="48" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Grid.Resources>
            <!-- 自绘窗口按钮（SVG 路径图标）：尺寸与系统 caption 一致（46x48），
                 hover 走 Button 默认的浅色底，仅去圆角/描边；关闭按钮 hover 变红。 -->
            <Style x:Key="CaptionButtonStyle" TargetType="Button">
                <Setter Property="Width" Value="46" />
                <Setter Property="Height" Value="48" />
                <Setter Property="MinWidth" Value="0" />
                <Setter Property="MinHeight" Value="0" />
                <Setter Property="Padding" Value="0" />
                <Setter Property="CornerRadius" Value="0" />
                <Setter Property="BorderThickness" Value="0" />
                <Setter Property="Background" Value="Transparent" />
                <Setter Property="Foreground" Value="{ThemeResource TextFillColorPrimaryBrush}" />
                <Setter Property="HorizontalContentAlignment" Value="Center" />
                <Setter Property="VerticalContentAlignment" Value="Center" />
            </Style>
        </Grid.Resources>

        <!-- 自定义背景（D1）：亚克力之下、内容之上的三层——清晰图 / 模糊层 / 毛玻璃遮罩 -->
        <Grid x:Name="BackgroundLayer" Grid.RowSpan="2"
              IsHitTestVisible="False" Visibility="Collapsed">
            <Image x:Name="BackgroundImage" Stretch="UniformToFill" Opacity="0.7" />
            <Border x:Name="BackgroundBlurHost" />
            <Border x:Name="BackgroundMask" />
        </Grid>

        <!-- 标题栏：品牌左 + 系统按钮右（ExtendsContentIntoTitleBar）；不透明实色，不透视背景 -->
        <Grid x:Name="AppTitleBar" Grid.Row="0" Background="{ThemeResource AppPaneBackgroundBrush}">
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="16,0,0,0" Spacing="10">
                <FontIcon Glyph="&#xE728;" FontSize="16" Foreground="{ThemeResource BrandBlueBrush}" />
                <TextBlock Text="Starcloud" FontWeight="SemiBold" FontSize="14"
                           VerticalAlignment="Center" />
                <!-- 测试版标识：启动器自身版本号（读 csproj <Version>，见 MainWindow.xaml.cs） -->
                <Border CornerRadius="6" Padding="6,2" VerticalAlignment="Center"
                        Background="{ThemeResource ControlFillColorSecondaryBrush}">
                    <TextBlock x:Name="VersionBadgeText" FontSize="11"
                               Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                               VerticalAlignment="Center" />
                </Border>
            </StackPanel>
        </Grid>

        <!-- 顶栏右侧：NovaOrb（点击展开面板）+ 个人中心入口 + 自绘窗口按钮（关闭/最大化/最小化） -->
        <StackPanel Orientation="Horizontal" Spacing="0"
                    Grid.Row="0" HorizontalAlignment="Right" VerticalAlignment="Stretch">
            <Button x:Name="NovaOrb" Width="44" Height="36" VerticalAlignment="Center" Margin="0,0,6,0"
                     Padding="0" CornerRadius="8"
                     Background="Transparent" BorderThickness="0"
                     local:HoverShadowBehavior.IsEnabled="True"
                     local:HoverShadowBehavior.Carrier="{Binding ElementName=NovaShadow}"
                     loc:Loc.Name="Nova 助手"
                    loc:Loc.Tip="Nova：待命"
                    Click="NovaOrb_Click">
                <Grid Width="32" Height="32">
                    <!-- 阴影载体：比卡片略大，悬停时在卡片背后投出阴影（画在本层，不会糊到卡片上） -->
                    <Grid x:Name="NovaShadow" Opacity="0" IsHitTestVisible="False">
                        <Border CornerRadius="14" Background="#0F000000" RenderTransformOrigin="0.5,0.5">
                            <Border.RenderTransform><ScaleTransform ScaleX="1.5" ScaleY="1.5" /></Border.RenderTransform>
                        </Border>
                        <Border CornerRadius="12" Background="#17000000" RenderTransformOrigin="0.5,0.5">
                            <Border.RenderTransform><ScaleTransform ScaleX="1.25" ScaleY="1.25" /></Border.RenderTransform>
                        </Border>
                        <Border CornerRadius="10" Background="#1F000000" RenderTransformOrigin="0.5,0.5">
                            <Border.RenderTransform><ScaleTransform ScaleX="1.08" ScaleY="1.08" /></Border.RenderTransform>
                        </Border>
                    </Grid>
                    <Border CornerRadius="8"
                            Background="{ThemeResource GlassCardBrush}"
                            BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                            BorderThickness="1" />
                    <FontIcon x:Name="NovaOrbGlyph" Glyph="&#xE99A;" FontSize="15"
                              Foreground="{ThemeResource TextFillColorPrimaryBrush}" />
                    <!-- 有提案：右上角 amber 小圆点 -->
                    <Ellipse x:Name="NovaOrbDot" Width="8" Height="8" Fill="#F59E0B"
                             HorizontalAlignment="Right" VerticalAlignment="Top"
                             Margin="0,3,3,0" Visibility="Collapsed" />
                </Grid>
            </Button>

            <!-- 调度中心入口：原 Starcloud ID 账户按钮旁，徽标 = 运行中任务数 -->
              <Button x:Name="TaskCenterBtn" Width="44" Height="36" VerticalAlignment="Center" Margin="0,0,6,0"
                      Padding="0" CornerRadius="8"
                      Background="Transparent" BorderThickness="0"
                      local:HoverShadowBehavior.IsEnabled="True"
                      local:HoverShadowBehavior.Carrier="{Binding ElementName=TaskCenterShadow}"
                      loc:Loc.Name="调度中心" loc:Loc.Tip="调度中心"
                     Click="TaskCenterBtn_Click">
                <Grid Width="32" Height="32">
                    <Grid x:Name="TaskCenterShadow" Opacity="0" IsHitTestVisible="False">
                        <Border CornerRadius="14" Background="#0F000000" RenderTransformOrigin="0.5,0.5">
                            <Border.RenderTransform><ScaleTransform ScaleX="1.5" ScaleY="1.5" /></Border.RenderTransform>
                        </Border>
                        <Border CornerRadius="12" Background="#17000000" RenderTransformOrigin="0.5,0.5">
                            <Border.RenderTransform><ScaleTransform ScaleX="1.25" ScaleY="1.25" /></Border.RenderTransform>
                        </Border>
                        <Border CornerRadius="10" Background="#1F000000" RenderTransformOrigin="0.5,0.5">
                            <Border.RenderTransform><ScaleTransform ScaleX="1.08" ScaleY="1.08" /></Border.RenderTransform>
                        </Border>
                    </Grid>
                    <Border CornerRadius="8"
                            Background="{ThemeResource GlassCardBrush}"
                            BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                            BorderThickness="1" />
                    <FontIcon Glyph="&#xE9F5;" FontSize="14"
                              Foreground="{ThemeResource TextFillColorPrimaryBrush}" />
                    <!-- 徽标走主题强调色（暗色主题为品牌绿），accent 面上强制黑字加粗 -->
                    <Border x:Name="TaskBadge" Background="{ThemeResource AccentFillColorDefaultBrush}"
                            CornerRadius="7" MinWidth="15" Height="15"
                            HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,-2,-3,0"
                            Padding="3,0" Visibility="Collapsed">
                        <TextBlock x:Name="TaskBadgeText" FontSize="9" FontWeight="Bold"
                                   Foreground="{ThemeResource TextOnAccentFillColorPrimaryBrush}"
                                   HorizontalAlignment="Center" />
                    </Border>
                </Grid>
            </Button>

            <Button x:Name="AccountButton" Width="44" Height="36" VerticalAlignment="Center" Margin="0,0,8,0"
                    Padding="0" CornerRadius="8"
                    Background="Transparent" BorderThickness="0"
                    local:HoverShadowBehavior.IsEnabled="True"
                    local:HoverShadowBehavior.Carrier="{Binding ElementName=AccountShadow}"
                    loc:Loc.Name="个人中心"
                    loc:Loc.Tip="个人中心"
                    Click="AccountButton_Click">
                <Grid Width="32" Height="32">
                    <Grid x:Name="AccountShadow" Opacity="0" IsHitTestVisible="False">
                        <Border CornerRadius="14" Background="#0F000000" RenderTransformOrigin="0.5,0.5">
                            <Border.RenderTransform><ScaleTransform ScaleX="1.5" ScaleY="1.5" /></Border.RenderTransform>
                        </Border>
                        <Border CornerRadius="12" Background="#17000000" RenderTransformOrigin="0.5,0.5">
                            <Border.RenderTransform><ScaleTransform ScaleX="1.25" ScaleY="1.25" /></Border.RenderTransform>
                        </Border>
                        <Border CornerRadius="10" Background="#1F000000" RenderTransformOrigin="0.5,0.5">
                            <Border.RenderTransform><ScaleTransform ScaleX="1.08" ScaleY="1.08" /></Border.RenderTransform>
                        </Border>
                    </Grid>
                    <Ellipse Fill="{ThemeResource CardBackgroundFillColorSecondaryBrush}" />
                    <TextBlock x:Name="AccountAvatarText" FontSize="13" FontWeight="SemiBold"
                               HorizontalAlignment="Center" VerticalAlignment="Center" />
                    <FontIcon x:Name="AccountAvatarGlyph" Glyph="&#xE77B;" FontSize="15"
                              Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                </Grid>
            </Button>

            <!-- 窗口按钮：系统 caption 已隐藏（见 MainWindow.xaml.cs），图标为内联 SVG 路径。
                 几何体必须内联在 PathIcon.Data 里——放在 ResourceDictionary 再 StaticResource
                 引用会在运行期抛 XamlParseException（Failed to assign to property 'PathIcon.Data'）。 -->
            <Button x:Name="MinimizeButton" Style="{StaticResource CaptionButtonStyle}"
                    loc:Loc.Name="最小化" loc:Loc.Tip="最小化" Click="MinimizeButton_Click">
                <PathIcon Width="10" Height="10">
                    <PathIcon.Data>
                        <PathGeometry>
                            <PathFigure StartPoint="0,4.5" IsClosed="True">
                                <LineSegment Point="10,4.5" />
                                <LineSegment Point="10,5.5" />
                                <LineSegment Point="0,5.5" />
                            </PathFigure>
                        </PathGeometry>
                    </PathIcon.Data>
                </PathIcon>
            </Button>
            <Button x:Name="MaximizeButton" Style="{StaticResource CaptionButtonStyle}"
                    loc:Loc.Name="最大化" loc:Loc.Tip="最大化" Click="MaximizeButton_Click">
                <!-- 最大化 / 还原两个图标叠放，按窗口状态切显隐（见 UpdateMaximizeGlyph） -->
                <Grid Width="10" Height="10">
                    <PathIcon x:Name="MaximizeIcon" Width="10" Height="10">
                        <PathIcon.Data>
                            <PathGeometry>
                                <PathFigure StartPoint="0,0" IsClosed="True">
                                    <LineSegment Point="10,0" />
                                    <LineSegment Point="10,10" />
                                    <LineSegment Point="0,10" />
                                </PathFigure>
                                <PathFigure StartPoint="1,1" IsClosed="True">
                                    <LineSegment Point="9,1" />
                                    <LineSegment Point="9,9" />
                                    <LineSegment Point="1,9" />
                                </PathFigure>
                            </PathGeometry>
                        </PathIcon.Data>
                    </PathIcon>
                    <PathIcon x:Name="RestoreIcon" Width="10" Height="10" Visibility="Collapsed">
                        <PathIcon.Data>
                            <PathGeometry>
                                <!-- 右上角窗口的左上露角 -->
                                <PathFigure StartPoint="2,0" IsClosed="True">
                                    <LineSegment Point="10,0" />
                                    <LineSegment Point="10,8" />
                                    <LineSegment Point="9,8" />
                                    <LineSegment Point="9,1" />
                                    <LineSegment Point="2,1" />
                                </PathFigure>
                                <!-- 左下角窗口（外框 + 内框挖空） -->
                                <PathFigure StartPoint="0,2" IsClosed="True">
                                    <LineSegment Point="8,2" />
                                    <LineSegment Point="8,10" />
                                    <LineSegment Point="0,10" />
                                </PathFigure>
                                <PathFigure StartPoint="1,3" IsClosed="True">
                                    <LineSegment Point="7,3" />
                                    <LineSegment Point="7,9" />
                                    <LineSegment Point="1,9" />
                                </PathFigure>
                            </PathGeometry>
                        </PathIcon.Data>
                    </PathIcon>
                </Grid>
            </Button>
            <Button x:Name="CloseButton" Style="{StaticResource CaptionButtonStyle}"
                    loc:Loc.Name="关闭" loc:Loc.Tip="关闭" Click="CloseButton_Click">
                <Button.Resources>
                    <!-- 关闭按钮 hover/按下：红底白字（与系统一致） -->
                    <SolidColorBrush x:Key="ButtonBackgroundPointerOver" Color="#C42B1C" />
                    <SolidColorBrush x:Key="ButtonBackgroundPressed" Color="#B22A1C" />
                    <SolidColorBrush x:Key="ButtonForegroundPointerOver" Color="#FFFFFFFF" />
                    <SolidColorBrush x:Key="ButtonForegroundPressed" Color="#FFFFFFFF" />
                    <SolidColorBrush x:Key="ButtonBorderBrushPointerOver" Color="Transparent" />
                    <SolidColorBrush x:Key="ButtonBorderBrushPressed" Color="Transparent" />
                </Button.Resources>
                <PathIcon Width="10" Height="10">
                    <PathIcon.Data>
                        <PathGeometry>
                            <PathFigure StartPoint="0,0" IsClosed="True">
                                <LineSegment Point="1.2,0" />
                                <LineSegment Point="10,8.8" />
                                <LineSegment Point="10,10" />
                                <LineSegment Point="8.8,10" />
                                <LineSegment Point="0,1.2" />
                            </PathFigure>
                            <PathFigure StartPoint="8.8,0" IsClosed="True">
                                <LineSegment Point="10,0" />
                                <LineSegment Point="10,1.2" />
                                <LineSegment Point="1.2,10" />
                                <LineSegment Point="0,10" />
                                <LineSegment Point="0,8.8" />
                            </PathFigure>
                        </PathGeometry>
                    </PathIcon.Data>
                </PathIcon>
            </Button>
        </StackPanel>

        <NavigationView
            x:Name="Nav"
            Grid.Row="1"
            PaneDisplayMode="LeftCompact"
            IsPaneOpen="False"
            OpenPaneLength="232"
            IsBackButtonVisible="Collapsed"
            IsSettingsVisible="False"
            IsTitleBarAutoPaddingEnabled="False"
            SelectionChanged="Nav_SelectionChanged">
            <!-- 左侧导航栏底色：模板里 RootSplitView 用 {ThemeResource NavigationViewDefaultPaneBackground}
                 / NavigationViewExpandedPaneBackground 取色，这两个 key 由框架主题字典定义且优先级高于
                 应用级 ThemeDictionaries，只能在控件级资源里覆盖（否则侧栏仍透出亚克力）。
                 取值与 App.xaml 的 AppPaneBackgroundBrush 一致：浅色 #F6F6F6，深色 #161616。
                 注意：内容区 NavigationViewContentBackground 保持框架默认（LayerFillColorDefaultBrush，半透明），
                 让窗口的亚克力毛玻璃能从内容区透出来；一旦把它刷成不透明实色，整窗毛玻璃就没了。 -->
            <NavigationView.Resources>
                <ResourceDictionary>
                    <ResourceDictionary.ThemeDictionaries>
                        <ResourceDictionary x:Key="Light">
                            <SolidColorBrush x:Key="NavigationViewDefaultPaneBackground" Color="#FFF6F6F6" />
                            <SolidColorBrush x:Key="NavigationViewExpandedPaneBackground" Color="#FFF6F6F6" />
                        </ResourceDictionary>
                        <ResourceDictionary x:Key="Dark">
                            <SolidColorBrush x:Key="NavigationViewDefaultPaneBackground" Color="#FF161616" />
                            <SolidColorBrush x:Key="NavigationViewExpandedPaneBackground" Color="#FF161616" />
                        </ResourceDictionary>
                    </ResourceDictionary.ThemeDictionaries>

                    <!-- 去掉模板自带的 1px 描边：它们用深色 Separator/Stroke 画色，
                         在标题栏 / 侧栏 / 内容区交界处看起来就是一条条黑色拼接缝。
                         ① RootSplitView 的四边描边（NavigationViewBorderThickness 默认 1）；
                         ② ContentGrid 的上/左两道描边（默认 1,1,0,0）。 -->
                    <Thickness x:Key="NavigationViewBorderThickness">0</Thickness>
                    <Thickness x:Key="NavigationViewContentGridBorderThickness">0</Thickness>
                    <SolidColorBrush x:Key="NavigationViewContentGridBorderBrush" Color="Transparent" />
                    <!-- 内容区左上角默认有 8px 圆角（露出圆角外的亚克力），拉平以贴齐边框 -->
                    <CornerRadius x:Key="NavigationViewContentGridCornerRadius">0</CornerRadius>
                </ResourceDictionary>
            </NavigationView.Resources>
            <NavigationView.MenuItems>
                <!-- 分组排列：游戏（首页/版本/下载/存档）→ 分隔线 → 个人与扩展（账户/插件/Nova）；
                     设置与日志固定在底部 FooterMenuItems（设置全导航最底） -->
                <NavigationViewItem loc:Loc.Text="首页" Tag="home" Icon="Home" />
                <NavigationViewItem loc:Loc.Text="版本" Tag="versions">
                    <NavigationViewItem.Icon>
                        <FontIcon Glyph="&#xE81C;" />
                    </NavigationViewItem.Icon>
                </NavigationViewItem>
                <NavigationViewItem loc:Loc.Text="下载" Tag="download">
                    <NavigationViewItem.Icon>
                        <FontIcon Glyph="&#xE896;" />
                    </NavigationViewItem.Icon>
                </NavigationViewItem>
                <NavigationViewItem loc:Loc.Text="存档" Tag="saves">
                    <NavigationViewItem.Icon>
                        <FontIcon Glyph="&#xE8B7;" />
                    </NavigationViewItem.Icon>
                </NavigationViewItem>
                <NavigationViewItemSeparator />
                <NavigationViewItem loc:Loc.Text="账户" Tag="accounts">
                    <NavigationViewItem.Icon>
                        <FontIcon Glyph="&#xE77B;" />
                    </NavigationViewItem.Icon>
                </NavigationViewItem>
                <NavigationViewItem loc:Loc.Text="插件" Tag="plugins">
                    <NavigationViewItem.Icon>
                        <FontIcon Glyph="&#xE71D;" />
                    </NavigationViewItem.Icon>
                </NavigationViewItem>
                <NavigationViewItem Content="Nova" Tag="ai">
                    <NavigationViewItem.Icon>
                        <FontIcon Glyph="&#xE99A;" />
                    </NavigationViewItem.Icon>
                </NavigationViewItem>
            </NavigationView.MenuItems>
            <NavigationView.FooterMenuItems>
                <NavigationViewItem loc:Loc.Text="启动器日志" Tag="logs">
                    <NavigationViewItem.Icon>
                        <FontIcon Glyph="&#xE7C3;" />
                    </NavigationViewItem.Icon>
                </NavigationViewItem>
                <NavigationViewItem loc:Loc.Text="设置" Tag="settings">
                    <NavigationViewItem.Icon>
                        <FontIcon Glyph="&#xE713;" />
                    </NavigationViewItem.Icon>
                </NavigationViewItem>
            </NavigationView.FooterMenuItems>

            <Grid Padding="32,12,24,24">
                <Frame x:Name="ContentFrame" Background="Transparent" />
            </Grid>
        </NavigationView>

        <!-- 调度中心（右侧任务抽屉）：左遮罩（点击关闭）+ 432px 面板。
             结构 = 标题行（标题 / 关闭）→ 状态行 → 两段：调度队列（正在跑的任务）+ 历史通知（时间流水）。
             任务结束不留在队列里，而是落成一条带时间的通知。
             Esc 走 KeyboardAccelerator（不依赖焦点）；Tab 由 TabFocusNavigation="Cycle" 锁在抽屉内；
             入场动效由 MotionService 开关控制（关闭动效时不加任何转场）。 -->
        <!-- KeyboardAcceleratorPlacementMode="Hidden"：加速键照常生效，但不渲染顶部的「Esc」键位提示徽标 -->
        <Grid x:Name="TaskCenterOverlay" Grid.Row="1" Visibility="Collapsed"
              KeyboardAcceleratorPlacementMode="Hidden">
            <Grid.KeyboardAccelerators>
                <KeyboardAccelerator Key="Escape" Invoked="TaskCenterEscape_Invoked" />
            </Grid.KeyboardAccelerators>
            <Rectangle x:Name="TaskCenterScrim" Fill="#5A000000"
                       Tapped="TaskCenterScrim_Tapped" />
            <Border x:Name="TaskCenterDrawer" Width="600" HorizontalAlignment="Right"
                    Background="{ThemeResource AppPaneBackgroundBrush}"
                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                    BorderThickness="1,0,0,0">
                <Grid Margin="20,16,14,12" RowSpacing="10" TabFocusNavigation="Cycle">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <!-- 标题行 -->
                    <Grid Grid.Row="0" ColumnSpacing="10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Orientation="Horizontal" Spacing="9" VerticalAlignment="Center">
                            <FontIcon Glyph="&#xE9F5;" FontSize="15"
                                      Foreground="{ThemeResource AccentFillColorDefaultBrush}" />
                            <TextBlock loc:Loc.Text="调度中心" FontSize="17" FontWeight="SemiBold"
                                       VerticalAlignment="Center" />
                        </StackPanel>
                        <Button x:Name="TaskCenterCloseBtn" Grid.Column="1"
                                Padding="8" MinWidth="0" MinHeight="0" VerticalAlignment="Center"
                                Background="Transparent" BorderThickness="0"
                                loc:Loc.Name="关闭" Click="TaskCenterClose_Click">
                            <FontIcon Glyph="&#xE711;" FontSize="13"
                                      Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                        </Button>
                    </Grid>

                    <!-- 状态行：进行中任务数 / 记录条数 -->
                    <TextBlock Grid.Row="1" x:Name="TaskSummaryText" FontSize="11"
                               Margin="2,-6,0,0" TextWrapping="NoWrap"
                               Foreground="{ThemeResource TextFillColorSecondaryBrush}" />

                    <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto"
                                  Padding="0,0,6,0" loc:Loc.Name="任务列表">
                        <StackPanel>
                            <!-- 调度队列：正在执行的任务卡（进度 / 速度 / 多源贡献带） -->
                            <TextBlock loc:Loc.Text="调度队列" FontSize="14" FontWeight="SemiBold"
                                       Margin="2,0,0,8" />
                            <StackPanel x:Name="TaskRunningHost" Spacing="2" />

                            <!-- 队列为空：极简空态（图标 + 无） -->
                            <StackPanel x:Name="QueueEmptyHost" Spacing="8" Margin="0,30,0,26">
                                <FontIcon Glyph="&#xE8FD;" FontSize="22" HorizontalAlignment="Center"
                                          Foreground="{ThemeResource TextFillColorTertiaryBrush}" />
                                <TextBlock loc:Loc.Text="无" FontSize="13" HorizontalAlignment="Center"
                                           Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                            </StackPanel>

                            <!-- 历史通知：任务收尾与启动器提示的时间流水 -->
                            <Grid Margin="2,20,0,8">
                                <TextBlock loc:Loc.Text="历史通知" FontSize="14" FontWeight="SemiBold"
                                           VerticalAlignment="Center" />
                                <Button x:Name="NoticeClearBtn" HorizontalAlignment="Right"
                                        Visibility="Collapsed" loc:Loc.Text="清空通知"
                                        FontSize="12" Padding="8,2" MinWidth="0" MinHeight="0"
                                        VerticalAlignment="Center"
                                        Background="Transparent" BorderThickness="0"
                                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                        Click="NoticeClear_Click" />
                            </Grid>
                            <StackPanel x:Name="NoticeHost" Spacing="7" />
                        </StackPanel>
                    </ScrollViewer>
                </Grid>
            </Border>
        </Grid>

        <!-- 状态栏（实例指示）已移除：底部不再有「未选择实例」条 -->

        <!-- ① Nova 面板（顶栏 NovaOrb 下方弹出，440px 毛玻璃）。
             注意：不要设 ShouldConstrainToRootBounds=False —— 那会命中 WinUI 的 IME bug（中文只出拼音字母），
             面板因此保持「限制在窗口内」。 -->
        <Popup x:Name="NovaPopup" IsLightDismissEnabled="True" AllowFocusOnInteraction="True">
            <Border x:Name="NovaPanelHost" Width="440" CornerRadius="20" Padding="16"
                    Background="{ThemeResource SolidBackgroundFillColorBaseBrush}"
                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                    BorderThickness="1">
                <Grid RowSpacing="10">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <!-- 标头：头像 + 名字 + 副标题 + 去 Nova 页 -->
                    <Grid Grid.Row="0" ColumnSpacing="10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <Border Grid.Column="0" Width="32" Height="32" CornerRadius="8"
                                Background="{ThemeResource LayerFillColorDefaultBrush}"
                                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                BorderThickness="1">
                            <FontIcon Glyph="&#xE99A;" FontSize="15"
                                      Foreground="{ThemeResource BrandBlueBrush}" />
                        </Border>
                        <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="1">
                            <TextBlock Text="Nova" FontWeight="SemiBold" FontSize="14" />
                            <TextBlock loc:Loc.Text="启动器里的 AI 助手，会干活的那种" FontSize="11"
                                       Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                       TextTrimming="CharacterEllipsis" />
                        </StackPanel>
                        <Button Grid.Column="2" Padding="6,2" MinWidth="0" VerticalAlignment="Center"
                                Background="Transparent" BorderThickness="0"
                                loc:Loc.Name="打开 Nova 页"
                                loc:Loc.Tip="打开 Nova 页（许可层 / 流水 / LLM 设置）"
                                Click="NovaPanelSettings_Click">
                            <FontIcon Glyph="&#xE713;" FontSize="13"
                                      Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                        </Button>
                    </Grid>

                    <!-- 未登录：引导去 Nova 页登录 -->
                    <StackPanel Grid.Row="1" x:Name="NovaPanelLogin" Spacing="10"
                                VerticalAlignment="Center" Visibility="Collapsed">
                        <TextBlock loc:Loc.Text="Nova 还没上线" FontWeight="SemiBold" />
                        <TextBlock loc:Loc.Text="登录 Starcloud ID 后，我才能帮你找包、修崩溃、调帧数——你说一句就行。"
                                   FontSize="12" TextWrapping="Wrap"
                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                        <Button Style="{StaticResource AccentButtonStyle}" loc:Loc.Text="去 Nova 页登录"
                                Click="NovaPanelLogin_Click" />
                    </StackPanel>

                    <!-- 已登录：对话（复用 NovaChatView） -->
                    <local:NovaChatView Grid.Row="1" x:Name="NovaPanelChat" />
                </Grid>
            </Border>
        </Popup>

        <!-- 浮窗提醒：替代原状态栏 Nova 指示 -->
        <TeachingTip x:Name="NovaToastTip" Grid.Row="0" IsOpen="False"
                     PreferredPlacement="Bottom" IsLightDismissEnabled="True" Title="Nova" />

        <!-- 插件通知（launcher:notification）：右下角自动收起的信息条 -->
        <InfoBar x:Name="PluginNotifyTip" Grid.Row="0" IsOpen="False" IsClosable="True"
                 Severity="Informational" HorizontalAlignment="Right" VerticalAlignment="Bottom"
                 Margin="0,0,24,24" MaxWidth="420" />
    </Grid>
</Window>
