<Application
    x:Class="Starcloud.App.App"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <XamlControlsResources xmlns="using:Microsoft.UI.Xaml.Controls" />
            </ResourceDictionary.MergedDictionaries>

            <!-- 品牌强调色：亮黄 #FFB900（覆盖系统 accent 及其色阶，供按钮/选中态/滑块使用） -->
            <Color x:Key="SystemAccentColor">#FFB900</Color>
            <Color x:Key="SystemAccentColorLight1">#FFC633</Color>
            <Color x:Key="SystemAccentColorLight2">#FFD466</Color>
            <Color x:Key="SystemAccentColorLight3">#FFE399</Color>
            <Color x:Key="SystemAccentColorDark1">#DBA000</Color>
            <Color x:Key="SystemAccentColorDark2">#B78600</Color>
            <Color x:Key="SystemAccentColorDark3">#8F6800</Color>

            <!-- 大圆角：控件（按钮/输入框）8，卡片 16，弹出层 12 -->
            <CornerRadius x:Key="ControlCornerRadius">8</CornerRadius>
            <CornerRadius x:Key="CardCornerRadius">16</CornerRadius>
            <CornerRadius x:Key="OverlayCornerRadius">12</CornerRadius>

            <!-- 品牌蓝 #B0CCF1：深色主题直接使用；浅色主题加深同色相以保证对比度 -->
            <!-- 品牌黄 #FFB900 亮度高，浅/深主题下 accent 面上必须用黑字（默认白字对比仅约 1.6:1） -->
            <ResourceDictionary.ThemeDictionaries>
                <ResourceDictionary x:Key="Light">
                    <SolidColorBrush x:Key="BrandBlueBrush" Color="#4C7FC4" />
                    <SolidColorBrush x:Key="BrandTintBrush" Color="#33B0CCF1" />
                    <SolidColorBrush x:Key="TextOnAccentFillColorPrimaryBrush" Color="#E6000000" />
                    <SolidColorBrush x:Key="TextOnAccentFillColorSecondaryBrush" Color="#B3000000" />
                    <SolidColorBrush x:Key="TextOnAccentFillColorDisabledBrush" Color="#5C000000" />
                </ResourceDictionary>
                <ResourceDictionary x:Key="Dark">
                    <SolidColorBrush x:Key="BrandBlueBrush" Color="#B0CCF1" />
                    <SolidColorBrush x:Key="BrandTintBrush" Color="#26B0CCF1" />
                    <SolidColorBrush x:Key="TextOnAccentFillColorPrimaryBrush" Color="#E6000000" />
                    <SolidColorBrush x:Key="TextOnAccentFillColorSecondaryBrush" Color="#B3000000" />
                    <SolidColorBrush x:Key="TextOnAccentFillColorDisabledBrush" Color="#5C000000" />
                </ResourceDictionary>
            </ResourceDictionary.ThemeDictionaries>
        </ResourceDictionary>
    </Application.Resources>
</Application>
