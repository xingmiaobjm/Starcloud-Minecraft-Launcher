# ─────────────────────────── 仓库级 ───────────────────────────
# 本地环境
.env
.env.local
.vscode/
.idea/
.DS_Store
Thumbs.db

# 阶段改动备份（开发约定：动工前把涉及文件复制到 backups/<日期>-<阶段>/）
/backups/

# 打包产物归档（releases/ 存放所有历史安装包，体积大不入库）
/releases/

# 日志与运行时数据
*.log
logs/
launcher_data/

# 第三方联机核心（陶瓦联机 / EasyTier 等）：许可要求随装随下，
# 既不随安装包分发，也不进仓库（运行时落在 %APPDATA%\starcloud-launcher\multiplayer）
terracotta*.exe
terracotta*.dll
easytier*
**/multiplayer/core/
# 插件运行时数据目录（本地运行产生）；注意用前导斜杠限定根目录，
# 否则会连带忽略源码目录 dotnet/src/Starcloud.Core/Plugins/
/plugins/
/legacy/plugins/

# ─────────────────── dotnet/  Windows 主产品 ───────────────────
dotnet/**/bin/
dotnet/**/obj/
dotnet/**/bin_verify/
dotnet/.vs/
dotnet/**/*.user
dotnet/AppPackages/

# C# 桥接宿主的发布产物（dotnet publish 生成，可随时重建；
# Flutter 端运行时直接拉起，不随源码入库）
/bridge-linux-x64/
/bridge-win-x64/
/bridge-osx-x64/

# ─────────────────── starcloud-multiplayer/  联机模块 ───────────────────
starcloud-multiplayer/**/bin/
starcloud-multiplayer/**/obj/
starcloud-multiplayer/.vs/
starcloud-multiplayer/**/*.user

# ─────────────────── 独立子项目与工具目录（各自独立仓库/不入库）───────────────────
# 安卓壳是独立交付物，与桌面主产品分仓维护
# ── android/ 端：提交源码，构建产物与本地产物不入库 ──
/android/**/bin/
/android/**/obj/
/android/**/build/
/android/**/.gradle/
/android/**/.kotlin/
/android/**/.idea/
/android/**/out/
/android/**/pkgs/
/android/**/tools/
/android/**/node_modules/
/android/local.properties
/android/**/*.binlog
/android/**/*.apk
/android/**/*.aab
/android/**/*.log
/android/spikes/fcl-src/
# 组件包（JRE / LWJGL / Mesa）由 fetch-components.ps1 现场下载，不进仓库
/android/**/assets/components/
/android/spikes/s1-jvm/runtime/
/android/**/*.tar.xz
/android/**/*.zip
# WorkBuddy 工作区元数据（记忆、会话日志）
/.workbuddy/

# ─────────────────── crossplatform/  跨平台版（已归档至 legacy/crossplatform-uno/）───────────────────
crossplatform/**/bin/
crossplatform/**/obj/
crossplatform/**/*.user
crossplatform/.vs/

# ─────────────────── flutter/  跨平台版（Flutter + fluent_ui）───────────────────
# 构建产物与本地工具状态（可随时重建）
flutter/build/
flutter/.dart_tool/
flutter/.flutter-plugins*
flutter/.packages
# 平台脚手架里按需生成、因机器而异的产物
flutter/linux/flutter/ephemeral/
flutter/windows/flutter/ephemeral/
flutter/macos/Flutter/ephemeral/
# IDE（pubspec.lock 是应用锁定文件，照 Flutter 惯例入库）
flutter/.idea/
flutter/*.iml

# ─────────────── legacy/  旧实现归档（Rust+Tauri、Uno 跨平台） ───────────────
/legacy/target/
/legacy/node_modules/
/legacy/ui/node_modules/
/legacy/ui/dist/
/legacy/src-tauri/target/
/legacy/src-tauri/gen/
/legacy/package.json
**/*.rs.bk
legacy/Cargo.lock.orig
/legacy/crossplatform-uno/**/bin/
/legacy/crossplatform-uno/**/obj/
/legacy/crossplatform-uno/**/*.user
/legacy/crossplatform-uno/.vs/

# ─────────────────── 本地工具状态与素材库 ───────────────────
/.agents/
/.impeccable/
/.superpowers/
/.trae/
/.zcode/
**/.cxx/
/.workbuddy/
/.claude/
/.cursor/
/.windsurf/
/skills-lock.json
/MC-Icons/

# ─────────────────── 本地密钥（构建期注入，绝不入库）───────────────────
# 官方分发版本内置的 CurseForge API Key 放这里；只有说明文档入库
/secrets/*
!/secrets/README.md

# ─────────────────── 临时构建与调试输出（可随时重建）───────────────────
/build_log.txt
/build_output.txt
/launch_output.txt
/tauri_build_log.txt
/legacy/src-tauri/cargo_build_log.txt
/test_output.txt
/stdout.txt
/stderr.txt
/legacy/ui/mirror_test_out.txt
/adoptium_response.json
/glass-check.png

# 本地化工具中间产物（由 tools/extract-loc-keys.ps1 生成，可随时重建）
/loc-keys.txt

# electron 实验目录的依赖与产物（路径过长会导致 git add 失败）
electron/node_modules/
electron/dist/

# 巨型构建产物与实验目录（不随源码上传）
/target/
/src-tauri/target/
/web/
*.csproj.bak

# electron 打包产物（可随时重建）
electron/release/
electron/out/
electron/build/icon.png

# generated by build-installer.ps1 (per-publish file list)
tools/installer-payload.nsh

# 其它 AI 工具本地目录
.claude/
.cursor/
.windsurf/
.continue/
.copilot/
.aider*
.specstory/
