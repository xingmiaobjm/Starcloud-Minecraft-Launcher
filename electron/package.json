{
  "name": "starcloud-launcher-linux",
  "version": "0.1.0",
  "description": "Starcloud Minecraft Launcher — Linux (Electron + Fluent UI React)",
  "main": "out/main/index.js",
  "private": true,
  "scripts": {
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "start": "electron-vite preview",
    "package": "electron-vite build && electron-builder --config electron-builder.yml --linux",
    "package:dir": "electron-vite build && electron-builder --config electron-builder.yml --linux --dir",
    "dev:web": "vite --port 5173 --open"
  },
  "dependencies": {
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@types/node": "^20.14.0",
    "@types/react": "^18.3.0",
    "@types/react-dom": "^18.3.0",
    "@vitejs/plugin-react": "^4.3.4",
    "electron": "^33.2.0",
    "electron-vite": "^2.3.0",
    "typescript": "^5.6.0",
    "vite": "^5.4.0",
    "electron-builder": "^25.1.8"
  },
  "author": {
    "name": "Starcloud",
    "email": "dev@starcloud.local"
  },
  "homepage": "https://github.com/starcloud/launcher",
  "repository": {
    "type": "git",
    "url": "https://github.com/starcloud/launcher.git"
  }
}
